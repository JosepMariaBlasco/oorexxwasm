# ooRexx Playground (Apache 2.4; needs mod_headers, optionally mod_deflate)
#
# The interpreter uses threads, i.e. SharedArrayBuffer, which browsers only
# allow in a cross-origin isolated page: these two headers are mandatory.
# Every resource of the page is same-origin (fonts included), so require-corp
# costs nothing.
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # small files, rebuilt now and then: always revalidate (cheap 304s)
  Header set Cache-Control "no-cache"
</IfModule>

AddType application/wasm .wasm
AddType application/octet-stream .data
AddType text/javascript .js
AddType font/woff2 .woff2
AddType application/json .json

# rexx.wasm and rexx.data (the ooRexx image and classes) compress to ~40%,
# rexx-parser.json (the Rexx Parser) to ~15%
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/wasm application/octet-stream
</IfModule>

# No "Options" or "DirectoryIndex" here: they need AllowOverride Options /
# Indexes, which many servers do not grant (500 Internal Server Error).
