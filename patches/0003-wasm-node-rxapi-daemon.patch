+
+// WASM: use the in-process server instead of the Node rxapi daemon (browser,
+// ORX_WASM_RXAPI=inprocess, or the daemon could not be started/reached)
+bool SysLocalAPIManager::useInProcessServer = false;
+
+/**
+ * WASM: give up on the daemon and switch to the in-process server.
+ *
+ * @return true if this is a change (the caller can retry the connection).
+ */
+bool SysLocalAPIManager::fallBackToInProcessServer()
+{
+    if (useInProcessServer)
+    {
+        return false;
+    }
+    SysNodeConnection::trace("fallback to the in-process server");
+    useInProcessServer = true;
+    return true;
+}
