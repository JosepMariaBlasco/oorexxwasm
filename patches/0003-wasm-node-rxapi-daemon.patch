+#include <stdlib.h>
+#include "CSStream.hpp"
+
+class SysNodeConnection
+{
+public:
+    // true when running under Node with the net module (not in a browser)
+    static bool available();
+    // path of the WASM rxapi daemon socket for this user
+    static const char *serviceName();
+    // launch the daemon (detached); false if it cannot be launched
+    static bool startDaemon();
+    // ORX_WASM_RXAPI_DEBUG set: trace connection events to stderr
+    static void trace(const char *what, const char *detail = "", long value = 0);
+};
+
+
+struct NodeRing;           // receive ring, see SysNodeConnection.cpp
+
+class SysNodeSocketConnection : public ApiConnection
+{
+public:
+    SysNodeSocketConnection() : ApiConnection(), id(0), fd(-1), ring(NULL) { }
+    SysNodeSocketConnection(int i, int f, NodeRing *r) : ApiConnection(), id(i), fd(f), ring(r) { }
+    ~SysNodeSocketConnection() override { disconnect(); }
+
+    bool connect(const char *path);
+    bool read(void *buf, size_t bufsize, size_t *bytesread) override;
+    bool write(void *buf, size_t bufsize, size_t *byteswritten) override;
+    bool write(void *buf, size_t bufsize, void *buf2, size_t buf2size, size_t *byteswritten) override;
+    bool disconnect() override;
+
+protected:
+    int id;                // JS-side socket id, 0 when not connected
+    int fd;                // its host file descriptor (-1: unknown), written
+                           // directly from the calling thread
+    NodeRing *ring;        // receive ring filled by the main thread
+
+    int readRing(void *buf, size_t bufsize);
+};
+
+
+class SysNodeServerConnectionManager : public ServerConnectionManager
+{
+public:
+    SysNodeServerConnectionManager() : ServerConnectionManager(), id(0) { }
+    ~SysNodeServerConnectionManager() override { disconnect(); }
+
+    // 1 listening, 0 another live daemon owns the service, -1 error
+    int bind(const char *path);
+    ApiConnection *acceptConnection() override;
+    bool disconnect() override;
+
+protected:
+    int id;                // JS-side server id
+};
+
+
+// entry point of the daemon mode of the WASM rexx executable
+int orxWasmRxapiMain();
+
+#endif
+#endif
