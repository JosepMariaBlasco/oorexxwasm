diff --git a/common/platform/unix/SysProcess.cpp b/common/platform/unix/SysProcess.cpp
index 5481206..01c7232 100644
--- a/common/platform/unix/SysProcess.cpp
+++ b/common/platform/unix/SysProcess.cpp
@@ -269,6 +269,37 @@ EM_JS(int, wasmScriptDirectory, (char *buf, int size), {
 });
 #endif
 
+#if defined(__EMSCRIPTEN__)
+/*
+ * WASM: getpid()/getppid() return Emscripten's constants (42/41).  Under
+ * Node use the real process ids: the rxapi daemon keys sessions by pid, so
+ * all WASM processes would otherwise share one session; SysQueryProcess and
+ * friends report them too.  These override weak definitions in libc.
+ */
+EM_JS(int, wasmProcessId, (int parent), {
+    if (typeof process === 'object' && process.versions && process.versions.node)
+    {
+        return parent ? process.ppid : process.pid;
+    }
+    return parent ? 41 : 42;
+});
+
+extern "C" pid_t __syscall_getpid()
+{
+    static pid_t pid = 0;
+    if (pid == 0)
+    {
+        pid = (pid_t)wasmProcessId(0);
+    }
+    return pid;
+}
+
+extern "C" pid_t __syscall_getppid()
+{
+    return (pid_t)wasmProcessId(1);
+}
+#endif
+
 
