diff --git a/rexxapi/common/platform/unix/SysNodeConnection.cpp b/rexxapi/common/platform/unix/SysNodeConnection.cpp
new file mode 100644
index 0000000..e2bbb47
--- /dev/null
+++ b/rexxapi/common/platform/unix/SysNodeConnection.cpp
@@ -0,0 +1,782 @@
+/*----------------------------------------------------------------------------*/
+/*                                                                            */
+/* Copyright (c) 2026 Rexx Language Association. All rights reserved.         */
+/*                                                                            */
+/* This program and the accompanying materials are made available under      */
+/* the terms of the Common Public License v1.0 which accompanies this         */
+/* distribution. A copy is also available at the following address:          */
+/* https://www.oorexx.org/license.html                                        */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+/*                                                                            */
+/* WASM under Node: RexxAPI over a Unix domain socket (client and daemon).    */
+/*                                                                            */
+/* Native ooRexx processes share queues, registrations and the macrospace     */
+/* through the rxapi daemon.  In the WASM build each process used to have its */
+/* own in-process server (SysLoopbackConnection), so a child `rexx` or        */
+/* `rxqueue` could not see the session queue of its parent (RXQUEUESESSION is */
+/* a server handle).  Under Node we now do what native does: the same        */
+/* rexx.js started as `rexx.js --orx-wasm-rxapi` is the daemon, listening on */
+/* a Unix socket next to the native one (".ooRexx-V.R.M-wasm-USER.service"),  */
+/* and clients connect to it; the daemon is launched on first use, detached. */
+/*                                                                            */
+/* Sockets live on the JS main thread (Node's net is asynchronous and needs  */
+/* the event loop, which is free: the interpreter runs on a pthread).        */
+/* Connect, listen, accept and close are proxied to the main thread with     */
+/* emscripten_proxy_sync_with_ctx(); the JS side completes them              */
+/* asynchronously and calls orxNetFinish(ctx), releasing the blocked caller. */
+/* The data path avoids those round trips (each costs a postMessage wakeup  */
+/* of the main thread): write() calls write(2) on the socket's host fd       */
+/* directly from the calling thread (fs.writeSync), and the main thread      */
+/* copies incoming data into a per-connection receive ring in wasm memory    */
+/* (NodeRing) that read() consumes, sleeping on a futex when it is empty.    */
+/* Thus read() blocks like recv(), one server thread per connection works as */
+/* in the native APIServer, and blocking PULLs only block their own thread.  */
+/*                                                                            */
+/* Note: EM_JS bodies lose backslashes: no escapes in the JS code here.      */
+/*                                                                            */
+/* Fallbacks: in the browser, or with ORX_WASM_RXAPI=inprocess, or when the  */
+/* daemon cannot be reached, the in-process server is used as before.         */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+
+#if defined(__EMSCRIPTEN__)
+
+#include "SysNodeConnection.hpp"
+#include "APIServer.hpp"
+#include "ServiceException.hpp"
+#include "rexx.h"
+#include <emscripten.h>
+#include <emscripten/proxying.h>
+#include <emscripten/threading.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include <unistd.h>
+
+namespace
+{
+// operation codes, shared with the JS side
+enum
+{
+    OP_CONNECT = 1,
+    OP_READ = 2,
+    OP_WRITE = 3,
+    OP_CLOSE = 4,
+    OP_LISTEN = 5,
+    OP_ACCEPT = 6,
+    OP_CLOSE_SERVER = 7,
+    OP_START_DAEMON = 8,
+    OP_PUMP = 9
+};
+
+// one proxied operation; all fields 32 bits (wasm32), read by JS by offset:
+// op 0, id 4, path 8, buf 12, size 16, result 20, buf2 24, size2 28
+struct NodeOp
+{
+    int32_t op;
+    int32_t id;
+    const char *path;
+    void *buf;
+    int32_t size;
+    int32_t result;
+    void *buf2;
+    int32_t size2;
+};
+}
+
+/*
+ * Receive ring of a connection: the main thread copies incoming socket data
+ * into it (single producer) and the thread reading the connection consumes
+ * it (single consumer) without a round trip to the main thread.  head and
+ * tail are byte counters (mod 2^32); seq changes (and is notified) on every
+ * producer update, so a reader can sleep on it without missing one.
+ * Layout read by JS by offset: seq 0, head 4, tail 8, state 12, data 16.
+ */
+#define NODE_RING_SIZE 65536          // power of two
+#define NODE_RING_CLOSED  1           // end of file / error: no more data
+#define NODE_RING_PENDING 2           // more data waits on the JS side (ring was full)
+struct NodeRing
+{
+    int32_t seq;
+    uint32_t head;
+    uint32_t tail;
+    int32_t state;
+    uint8_t data[NODE_RING_SIZE];
+};
+
+
+/**
+ * Called by the JS side (on the main thread) when an operation is complete.
+ */
+extern "C" EMSCRIPTEN_KEEPALIVE void orxNetFinish(em_proxying_ctx *ctx)
+{
+    emscripten_proxy_finish(ctx);
+}
+
+
+// Start operation `op` on the main thread; ctx is finished when it is done
+// (possibly later, from an event handler).  ctx is 0 for a synchronous call
+// made on the main thread itself (only used for OP_CLOSE).
+EM_JS(void, orxNetStart, (em_proxying_ctx *ctx, void *op), {
+    var net = require('net');
+    var fs = require('fs');
+    var st = globalThis.__orxNet;
+    if (!st)
+    {
+        st = globalThis.__orxNet = { next: 1, socks: new Map(), servers: new Map() };
+    }
+    var i32 = function() { return new Int32Array(wasmMemory.buffer); };
+    var p = op >> 2;
+    var code = i32()[p];
+    var id = i32()[p + 1];
+    var done = function(result) {
+        i32()[p + 5] = result;
+        if (ctx) _orxNetFinish(ctx);
+    };
+
+    // register a connected socket, return its id
+    var addSocket = function(sock) {
+        var s = { sock: sock, chunks: [], closed: false, reader: null, ring: 0 };
+        var sid = st.next++;
+        st.socks.set(sid, s);
+        // deliver data to a waiting reader (one per connection at a time)
+        var serve = function() {
+            var r = s.reader;
+            if (!r) return;
+            if (s.chunks.length > 0)
+            {
+                var c = s.chunks[0];
+                var n = Math.min(r.size, c.length);
+                new Uint8Array(wasmMemory.buffer).set(c.subarray(0, n), r.buf);
+                if (n === c.length) s.chunks.shift(); else s.chunks[0] = c.subarray(n);
+                s.reader = null;
+                r.finish(n);
+            }
+            else if (s.closed)
+            {
+                s.reader = null;
+                r.finish(0);
+            }
+        };
+        // copy pending chunks into the receive ring (NodeRing), if attached
+        var pump = function() {
+            var r = s.ring;
+            if (!r) return;
+            var m = i32(), q = r >> 2, size = 65536;
+            var head = Atomics.load(m, q + 1) >>> 0;
+            var tail = Atomics.load(m, q + 2) >>> 0;
+            var u8 = new Uint8Array(wasmMemory.buffer);
+            while (s.chunks.length > 0)
+            {
+                var room = size - ((head - tail) >>> 0);
+                if (room <= 0) break;
+                var c = s.chunks[0];
+                var n = Math.min(room, c.length);
+                var at = head & (size - 1);
+                var first = Math.min(n, size - at);
+                u8.set(c.subarray(0, first), r + 16 + at);
+                if (n > first) u8.set(c.subarray(first, n), r + 16);
+                head = (head + n) >>> 0;
+                if (n === c.length) s.chunks.shift(); else s.chunks[0] = c.subarray(n);
+            }
+            Atomics.store(m, q + 1, head | 0);
+            var state = (s.closed && s.chunks.length === 0 ? 1 : 0) | (s.chunks.length > 0 ? 2 : 0);
+            Atomics.store(m, q + 3, state);
+            Atomics.add(m, q, 1);
+            Atomics.notify(m, q);
+        };
+        s.pump = pump;
+        var arrive = function() { if (s.ring) pump(); else serve(); };
+        s.serve = serve;
+        sock.on('data', function(d) { s.chunks.push(d); arrive(); });
+        sock.on('end', function() { s.closed = true; arrive(); });
+        sock.on('close', function() { s.closed = true; arrive(); });
+        sock.on('error', function() { s.closed = true; arrive(); });
+        return sid;
+    };
+
+    switch (code)
+    {
+        case 1:                                     // CONNECT path
+        {
+            var path = UTF8ToString(i32()[p + 2]);
+            var sock = net.createConnection(path);
+            var settled = false;
+            sock.once('connect', function() {
+                if (settled) return;
+                settled = true;
+                i32()[p + 7] = (sock._handle && sock._handle.fd >= 0) ? sock._handle.fd : -1;
+                var sid = addSocket(sock);
+                var a = st.socks.get(sid);
+                a.ring = i32()[p + 3];
+                a.pump();
+                done(sid);
+            });
+            sock.once('error', function() {
+                if (settled) return;
+                settled = true;
+                sock.destroy();
+                done(-1);
+            });
+            return;
+        }
+        case 2:                                     // READ id buf size
+        {
+            var s = st.socks.get(id);
+            if (!s) { done(-1); return; }
+            s.reader = { buf: i32()[p + 3], size: i32()[p + 4], finish: done };
+            s.serve();
+            return;
+        }
+        case 3:                                     // WRITE id buf size [buf2 size2]
+        {
+            var s = st.socks.get(id);
+            if (!s || s.closed || s.sock.destroyed) { done(-1); return; }
+            var u8 = new Uint8Array(wasmMemory.buffer);
+            var b1 = i32()[p + 3], n1 = i32()[p + 4], b2 = i32()[p + 6], n2 = i32()[p + 7];
+            var data = Buffer.alloc(n1 + n2);
+            data.set(u8.subarray(b1, b1 + n1), 0);
+            if (n2 > 0) data.set(u8.subarray(b2, b2 + n2), n1);
+            s.sock.write(data, function(err) { done(err ? -1 : n1 + n2); });
+            return;
+        }
+        case 9:                                     // PUMP id: refill the ring
+        {
+            var s = st.socks.get(id);
+            if (!s || !s.ring) { done(-1); return; }
+            s.pump();
+            done(0);
+            return;
+        }
+        case 4:                                     // CLOSE id
+        {
+            var s = st.socks.get(id);
+            if (s) { st.socks.delete(id); s.ring = 0; s.sock.destroy(); }
+            done(0);
+            return;
+        }
+        case 5:                                     // LISTEN path
+        {
+            var path = UTF8ToString(i32()[p + 2]);
+            var lock = path + '.lock';
+            var listen = function() {
+                // single daemon per service: a lock file holding our pid
+                try
+                {
+                    var fd = fs.openSync(lock, 'wx', 0o600);
+                    fs.writeSync(fd, String(process.pid));
+                    fs.closeSync(fd);
+                }
+                catch (e)
+                {
+                    var other = 0;
+                    try { other = parseInt(fs.readFileSync(lock, 'utf8'), 10) || 0; } catch (e2) {}
+                    // nobody is listening (the probe failed): the lock only
+                    // counts if its owner is a live process (not a zombie,
+                    // which kill(pid, 0) still reports) that is still
+                    // starting up, i.e. the lock is recent
+                    var alive = false;
+                    if (other > 0 && other !== process.pid)
+                    {
+                        try { process.kill(other, 0); alive = true; } catch (e3) { alive = e3.code === 'EPERM'; }
+                        try
+                        {
+                            // "pid (comm) S ...": the state follows the last ')'
+                            // (no regex: EM_JS drops backslashes)
+                            var stat = fs.readFileSync('/proc/' + other + '/stat', 'utf8');
+                            if (stat.charAt(stat.lastIndexOf(')') + 2) === 'Z') alive = false;
+                        }
+                        catch (e5) {}
+                        try { if (Date.now() - fs.statSync(lock).mtimeMs > 10000) alive = false; }
+                        catch (e6) {}
+                    }
+                    if (alive) { done(0); return; }
+                    try { fs.writeFileSync(lock, String(process.pid), { mode: 0o600 }); }
+                    catch (e4) { done(-1); return; }
+                }
+                try { fs.unlinkSync(path); } catch (e) {}
+                var srv = { server: null, pending: [], waiter: null, path: path, lock: lock };
+                var server = net.createServer(function(sock) {
+                    var sid = addSocket(sock);
+                    if (srv.waiter) { var w = srv.waiter; srv.waiter = null; w(sid); }
+                    else srv.pending.push(sid);
+                });
+                srv.server = server;
+                server.once('error', function() {
+                    try { fs.unlinkSync(lock); } catch (e) {}
+                    done(-1);
+                });
+                server.listen(path, function() {
+                    try { fs.chmodSync(path, 0o600); } catch (e) {}
+                    var ino = 0;
+                    try { ino = fs.statSync(path).ino; } catch (e) {}
+                    // if our socket file disappears or is replaced, nobody can
+                    // reach us any more: go away instead of lingering
+                    var timer = setInterval(function() {
+                        var gone = true;
+                        try { gone = fs.statSync(path).ino !== ino; } catch (e) {}
+                        if (gone) process.exit(0);
+                    }, 30000);
+                    if (timer.unref) timer.unref();
+                    var sid = st.next++;
+                    st.servers.set(sid, srv);
+                    done(sid);
+                });
+            };
+            // is a daemon already answering on this path?
+            var probe = net.createConnection(path);
+            probe.once('connect', function() { probe.destroy(); done(0); });
+            probe.once('error', function() { probe.destroy(); listen(); });
+            return;
+        }
+        case 6:                                     // ACCEPT server-id
+        {
+            var srv = st.servers.get(id);
+            if (!srv) { done(-1); return; }
+            var withFd = function(sid) {
+                var a = st.socks.get(sid);
+                i32()[p + 7] = (a && a.sock._handle && a.sock._handle.fd >= 0) ? a.sock._handle.fd : -1;
+                if (a) { a.ring = i32()[p + 3]; a.pump(); }
+                done(sid);
+            };
+            if (srv.pending.length > 0) { withFd(srv.pending.shift()); return; }
+            srv.waiter = withFd;
+            return;
+        }
+        case 7:                                     // CLOSE_SERVER server-id
+        {
+            var srv = st.servers.get(id);
+            if (srv)
+            {
+                st.servers.delete(id);
+                try { srv.server.close(); } catch (e) {}
+                try { fs.unlinkSync(srv.path); } catch (e) {}
+                try { fs.unlinkSync(srv.lock); } catch (e) {}
+                if (srv.waiter) { var w = srv.waiter; srv.waiter = null; w(-1); }
+            }
+            done(0);
+            return;
+        }
+        case 8:                                     // START_DAEMON
+        {
+            try
+            {
+                var script = (typeof scriptDirectory === 'string' ? scriptDirectory : "") + 'rexx.js';
+                if (!fs.existsSync(script)) { done(0); return; }
+                // with ORX_WASM_RXAPI_DEBUG the daemon's trace goes to a log
+                var err = 'ignore';
+                if (process.env.ORX_WASM_RXAPI_DEBUG)
+                {
+                    try { err = fs.openSync(require('os').tmpdir() + '/orx-wasm-rxapi-debug.log', 'a'); }
+                    catch (e) { err = 'ignore'; }
+                }
+                var child = require('child_process').spawn(process.execPath,
+                    [script, '--orx-wasm-rxapi'],
+                    { detached: true, stdio: ['ignore', 'ignore', err], cwd: '/' });
+                if (typeof err === 'number') fs.closeSync(err);
+                child.on('error', function() {});
+                child.unref();
+                done(1);
+            }
+            catch (e)
+            {
+                done(0);
+            }
+            return;
+        }
+    }
+    done(-1);
+});
+
+
+namespace
+{
+void runOnMain(em_proxying_ctx *ctx, void *arg)
+{
+    orxNetStart(ctx, (NodeOp *)arg);
+}
+
+/**
+ * Run a socket operation on the main thread and wait for its completion.
+ */
+int32_t nodeOp(NodeOp &op)
+{
+    op.result = -1;
+    if (emscripten_is_main_runtime_thread())
+    {
+        // the main thread cannot wait for its own event loop; only the
+        // synchronous operations can be done here (e.g. closing connections
+        // from the exit-time destructor)
+        if (op.op == OP_CLOSE || op.op == OP_CLOSE_SERVER)
+        {
+            orxNetStart(NULL, &op);
+            return op.result;
+        }
+        return -1;
+    }
+    if (!emscripten_proxy_sync_with_ctx(emscripten_proxy_get_system_queue(),
+                                        emscripten_main_runtime_thread_id(), runOnMain, &op))
+    {
+        return -1;
+    }
+    return op.result;
+}
+}
+
+
+/**
+ * Write buf (+ buf2) to the host socket fd from the calling pthread, with
+ * synchronous fs.writeSync (the socket is non-blocking: on EAGAIN wait a
+ * little and retry).  Returns the bytes written or -1.
+ */
+EM_JS(int, orxNetWriteDirect, (int fd, void *buf, int n1, void *buf2, int n2), {
+    var fs = (process.getBuiltinModule || require)('fs');
+    var nap = globalThis.__orxNap || (globalThis.__orxNap = new Int32Array(new SharedArrayBuffer(4)));
+    var u8 = new Uint8Array(wasmMemory.buffer);
+    var parts = [[buf, n1], [buf2, n2]];
+    for (var k = 0; k < 2; k++)
+    {
+        var off = parts[k][0], left = parts[k][1];
+        while (left > 0)
+        {
+            try
+            {
+                var w = fs.writeSync(fd, u8, off, left);
+                off += w; left -= w;
+            }
+            catch (e)
+            {
+                if (e.code !== 'EAGAIN') return -1;
+                Atomics.wait(nap, 0, 0, 0.2);
+            }
+        }
+    }
+    return n1 + n2;
+});
+
+
+/**
+ * Node with the net module?  Checked once.
+ */
+EM_JS(int, orxNetAvailable, (), {
+    return (typeof process === 'object' && process.versions && process.versions.node &&
+            typeof require === 'function') ? 1 : 0;
+});
+
+bool SysNodeConnection::available()
+{
+    static int avail = -1;
+    if (avail < 0)
+    {
+        const char *mode = getenv("ORX_WASM_RXAPI");
+        avail = (mode != NULL && strcmp(mode, "inprocess") == 0) ? 0 : orxNetAvailable();
+    }
+    return avail == 1;
+}
+
+
+// the service path, computed from the host environment (the MEMFS build does
+// not see it): XDG_RUNTIME_DIR, else TMPDIR, else /tmp, as native rxapi does
+EM_JS(int, orxNetServiceName, (char *buf, int size, int ver, int rel, int mod), {
+    var fs = require('fs');
+    var os = require('os');
+    var dir = '/tmp';
+    var list = [process.env.XDG_RUNTIME_DIR, process.env.TMPDIR];
+    for (var i = 0; i < list.length; i++)
+    {
+        var d = list[i];
+        try { if (d && d.length < 80 && fs.statSync(d).isDirectory()) { dir = d; break; } }
+        catch (e) {}
+    }
+    var user;
+    try { user = os.userInfo().username; } catch (e) { user = String(process.getuid ? process.getuid() : 0); }
+    var name = dir + '/.ooRexx-' + ver + '.' + rel + '.' + mod + '-wasm-' + user + '.service';
+    if (lengthBytesUTF8(name) >= size) return 0;
+    stringToUTF8(name, buf, size);
+    return 1;
+});
+
+const char *SysNodeConnection::serviceName()
+{
+    static char *name = NULL;
+    if (name == NULL)
+    {
+        char buffer[512];
+        if (!orxNetServiceName(buffer, sizeof(buffer), ORX_VER, ORX_REL, ORX_MOD))
+        {
+            return NULL;
+        }
+        name = strdup(buffer);
+    }
+    return name;
+}
+
+
+void SysNodeConnection::trace(const char *what, const char *detail, long value)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        enabled = getenv("ORX_WASM_RXAPI_DEBUG") != NULL ? 1 : 0;
+    }
+    if (enabled)
+    {
+        fprintf(stderr, "[rxapi-wasm %d] %s %s %ld\n", (int)getpid(), what, detail, value);
+    }
+}
+
+
+bool SysNodeConnection::startDaemon()
+{
+    NodeOp op = { OP_START_DAEMON, 0, NULL, NULL, 0, 0, NULL, 0 };
+    int32_t result = nodeOp(op);
+    trace("start daemon", "", result);
+    return result == 1;
+}
+
+
+bool SysNodeSocketConnection::connect(const char *path)
+{
+    if (path == NULL)
+    {
+        errcode = CSERROR_CONNX_FAILED;
+        return false;
+    }
+    if (ring == NULL)
+    {
+        ring = (NodeRing *)calloc(1, sizeof(NodeRing));
+    }
+    NodeOp op = { OP_CONNECT, 0, path, ring, 0, 0, NULL, 0 };
+    int32_t result = nodeOp(op);
+    SysNodeConnection::trace("connect", path, result);
+    if (result <= 0)
+    {
+        errcode = CSERROR_CONNX_FAILED;
+        return false;
+    }
+    id = result;
+    fd = op.size2;
+    errcode = CSERROR_OK;
+    return true;
+}
+
+
+bool SysNodeSocketConnection::read(void *buf, size_t bufsize, size_t *bytesread)
+{
+    *bytesread = 0;
+    if (id == 0)
+    {
+        errcode = CSERROR_IO_FAILED;
+        return false;
+    }
+    if (bufsize == 0)
+    {
+        return true;
+    }
+    int32_t result;
+    if (ring != NULL && !emscripten_is_main_runtime_thread())
+    {
+        result = readRing(buf, bufsize);
+    }
+    else
+    {
+        NodeOp op = { OP_READ, id, NULL, buf, (int32_t)bufsize, 0, NULL, 0 };
+        result = nodeOp(op);
+    }
+    if (result < 0)
+    {
+        errcode = CSERROR_IO_FAILED;
+        return false;
+    }
+    // 0 is end of file, like recv(); the caller handles it
+    *bytesread = (size_t)result;
+    errcode = CSERROR_OK;
+    return true;
+}
+
+
+/**
+ * Read from the receive ring: what is there (up to bufsize), else sleep until
+ * the main thread adds data.  0 at end of file, -1 on failure.
+ */
+int SysNodeSocketConnection::readRing(void *buf, size_t bufsize)
+{
+    for (;;)
+    {
+        int32_t seq = __atomic_load_n(&ring->seq, __ATOMIC_SEQ_CST);
+        uint32_t head = __atomic_load_n(&ring->head, __ATOMIC_SEQ_CST);
+        uint32_t tail = ring->tail;
+        uint32_t avail = head - tail;
+        if (avail > 0)
+        {
+            uint32_t n = avail < bufsize ? avail : (uint32_t)bufsize;
+            uint32_t at = tail & (NODE_RING_SIZE - 1);
+            uint32_t first = n < NODE_RING_SIZE - at ? n : NODE_RING_SIZE - at;
+            memcpy(buf, ring->data + at, first);
+            if (n > first)
+            {
+                memcpy((char *)buf + first, ring->data, n - first);
+            }
+            __atomic_store_n(&ring->tail, tail + n, __ATOMIC_SEQ_CST);
+            return (int32_t)n;
+        }
+        int32_t state = __atomic_load_n(&ring->state, __ATOMIC_SEQ_CST);
+        if (state & NODE_RING_PENDING)
+        {
+            // the ring was full: have the main thread move the rest in
+            NodeOp op = { OP_PUMP, id, NULL, NULL, 0, 0, NULL, 0 };
+            if (nodeOp(op) < 0)
+            {
+                return -1;
+            }
+            continue;
+        }
+        if (state & NODE_RING_CLOSED)
+        {
+            return 0;
+        }
+        // sleep until the producer changes seq (the timeout is only a safety net)
+        emscripten_futex_wait(&ring->seq, (uint32_t)seq, 1000.0);
+    }
+}
+
+
+bool SysNodeSocketConnection::write(void *buf, size_t bufsize, size_t *byteswritten)
+{
+    return write(buf, bufsize, NULL, 0, byteswritten);
+}
+
+
+bool SysNodeSocketConnection::write(void *buf, size_t bufsize, void *buf2, size_t buf2size, size_t *byteswritten)
+{
+    *byteswritten = 0;
+    if (id == 0)
+    {
+        errcode = CSERROR_IO_FAILED;
+        return false;
+    }
+    int32_t result;
+    if (fd >= 0 && !emscripten_is_main_runtime_thread())
+    {
+        // write(2) straight from this thread: no round trip to the main
+        // thread (the main thread only ever reads this socket)
+        result = orxNetWriteDirect(fd, buf, (int32_t)bufsize, buf2, (int32_t)buf2size);
+    }
+    else
+    {
+        NodeOp op = { OP_WRITE, id, NULL, buf, (int32_t)bufsize, 0, buf2, (int32_t)buf2size };
+        result = nodeOp(op);
+    }
+    if (result < 0)
+    {
+        errcode = CSERROR_IO_FAILED;
+        return false;
+    }
+    *byteswritten = (size_t)result;
+    errcode = CSERROR_OK;
+    return true;
+}
+
+
+bool SysNodeSocketConnection::disconnect()
+{
+    if (id != 0)
+    {
+        NodeOp op = { OP_CLOSE, id, NULL, NULL, 0, 0, NULL, 0 };
+        nodeOp(op);
+        id = 0;
+    }
+    // the JS side no longer writes into the ring once closed
+    free(ring);
+    ring = NULL;
+    return true;
+}
+
+
+int SysNodeServerConnectionManager::bind(const char *path)
+{
+    if (path == NULL)
+    {
+        errcode = CSERROR_OPEN_FAILED;
+        return -1;
+    }
+    NodeOp op = { OP_LISTEN, 0, path, NULL, 0, 0, NULL, 0 };
+    int32_t result = nodeOp(op);
+    SysNodeConnection::trace("listen", path, result);
+    if (result > 0)
+    {
+        id = result;
+        errcode = CSERROR_OK;
+        return 1;
+    }
+    errcode = CSERROR_OPEN_FAILED;
+    return result == 0 ? 0 : -1;
+}
+
+
+ApiConnection *SysNodeServerConnectionManager::acceptConnection()
+{
+    if (id == 0)
+    {
+        return NULL;
+    }
+    NodeRing *ring = (NodeRing *)calloc(1, sizeof(NodeRing));
+    NodeOp op = { OP_ACCEPT, id, NULL, ring, 0, 0, NULL, 0 };
+    int32_t result = nodeOp(op);
+    if (result <= 0)
+    {
+        free(ring);
+        errcode = CSERROR_CONNX_FAILED;
+        return NULL;
+    }
+    return new SysNodeSocketConnection(result, op.size2, ring);
+}
+
+
+bool SysNodeServerConnectionManager::disconnect()
+{
+    if (id != 0)
+    {
+        NodeOp op = { OP_CLOSE_SERVER, id, NULL, NULL, 0, 0, NULL, 0 };
+        nodeOp(op);
+        id = 0;
+    }
+    return true;
+}
+
+
+/**
+ * The daemon: `rexx.js --orx-wasm-rxapi`.  Equivalent of the native rxapi
+ * main (server/platform/unix/APIService.cpp), with the Node transport.
+ * Exits quietly if another daemon already serves this user.
+ */
+int orxWasmRxapiMain()
+{
+    if (!SysNodeConnection::available())
+    {
+        return 1;
+    }
+    SysNodeServerConnectionManager *manager = new SysNodeServerConnectionManager();
+    int bound = manager->bind(SysNodeConnection::serviceName());
+    if (bound != 1)
+    {
+        delete manager;
+        return bound == 0 ? 0 : 1;
+    }
+    APIServer server;
+    server.initServer(manager);
+    try
+    {
+        server.listenForConnections();
+    }
+    catch (ServiceException *e)
+    {
+        delete e;
+    }
+    server.terminateServer();      // deletes the manager (socket and lock file removed)
+    return 0;
+}
+
+#endif
