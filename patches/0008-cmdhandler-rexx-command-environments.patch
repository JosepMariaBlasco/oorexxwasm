new file mode 100644
index 0000000..816515c
--- /dev/null
+++ b/extensions/cmdhandler/cmdhandler.cls
@@ -0,0 +1,175 @@
+/*----------------------------------------------------------------------------*/
+/*                                                                            */
+/* Copyright (c) 2026 Rexx Language Association. All rights reserved.         */
+/*                                                                            */
+/* This program and the accompanying materials are made available under       */
+/* the terms of the Common Public License v1.0 which accompanies this         */
+/* distribution. A copy is also available at the following address:          */
+/* https://www.oorexx.org/license.html                                        */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+/*
+ * cmdhandler.cls: command environments (ADDRESS) written in Rexx.
+ *
+ *    ::requires "cmdhandler.cls"
+ *    .CommandHandler~register("DEMO", .Demo~new)
+ *    address demo "UPPER" with input stem in. output stem out.
+ *
+ *    ::class Demo subclass CommandHandler      -- or: subclass X inherit CommandHandler
+ *    ::method command
+ *      use arg command, context                -- a .CommandContext
+ *      ...
+ *      return 0                                -- becomes RC
+ *
+ * The handler is an object of a class that inherits .CommandHandler, a mixin
+ * class whose COMMAND method is abstract.  For every command the handler
+ * object gets ~command(command, context).
+ * Its result is RC (0 when it returns nothing).  The .CommandContext, valid
+ * only while that command runs, gives:
+ *
+ *    ~lineIn                next line of WITH INPUT, .nil at the end
+ *    ~lines                 all the remaining input lines (an Array)
+ *    ~output(lines)         a string or a collection of lines to WITH OUTPUT
+ *    ~error(lines)          the same to WITH ERROR
+ *                           (not redirected: to .output / .error, as a
+ *                           command's own output would go to the console)
+ *    ~isRedirected(which)   "Input", "Output", "Error" or "Same"
+ *    ~getVar(name)          a variable of the code that issued the command
+ *                           (.nil when it has no value), ~hasVar(name)
+ *    ~setVar(name, value)   assigns it (simple, stem or compound; the tail of
+ *                           a compound name is resolved there, as in Rexx)
+ *    ~dropVar(name)         drops it
+ *    ~variables             a Directory with all of them
+ *    ~raiseError(rc)        the command raises ERROR with this RC (returns
+ *    ~raiseFailure(rc)      rc: "return context~raiseFailure(-1)")
+ *    ~environment           the ADDRESS name the command was sent to
+ *    ~isValid               whether the command is still running
+ *
+ * A SYNTAX error in ~command reaches the code that issued the command.
+ * .CommandHandler~register(name, .nil) removes the handler: the name then
+ * behaves as an unknown environment (FAILURE, RC 30).
+ *
+ * The registrations are in .local (one set per interpreter instance, as the
+ * command environments): .local~CommandHandlers, a Directory name -> handler,
+ * and .local~CommandContext, the context class.
+ */
+
+::requires "cmdhandler" LIBRARY
+::routine CmdHandler_Register external "LIBRARY cmdhandler CmdHandler_Register"
+
+
+::class CommandHandler public mixinclass Object
+
+-- the handler of ADDRESS name: an object whose class inherits .CommandHandler (.nil removes it)
+::method register class
+  use strict arg name, handler
+  name = name~request("String")
+  if name == .nil | name == "" then
+    raise syntax 93.900 array("register: the environment name must be a non-empty string")
+  if handler \== .nil then do
+    if \handler~isA(.CommandHandler) then
+      raise syntax 93.900 array("register: the handler's class must inherit .CommandHandler")
+  end
+  if .local~commandHandlers == .nil then do
+    .local~commandHandlers = .directory~new
+    .local~commandContext = .CommandContext
+  end
+  if handler == .nil then .local~commandHandlers~remove(name~upper)
+  else do
+    .local~commandHandlers[name~upper] = handler
+    call CmdHandler_Register name
+  end
+  return
+
+-- classes that inherit it implement it: use arg command, context; return RC
+::method command abstract
+
+
+::class CommandContext public
+
+::attribute environment get
+::attribute condition get
+
+::method init
+  expose cself environment condition
+  use strict arg cself, environment
+  condition = .nil
+
+::method lineIn  external "LIBRARY cmdhandler CmdContext_LineIn"
+::method isRedirected external "LIBRARY cmdhandler CmdContext_IsRedirected"
+::method isValid external "LIBRARY cmdhandler CmdContext_IsValid"
+::method write private external "LIBRARY cmdhandler CmdContext_Write"
+::method nativeGetVar private external "LIBRARY cmdhandler CmdContext_GetVar"
+::method nativeHasVar private external "LIBRARY cmdhandler CmdContext_HasVar"
+::method nativeSetVar private external "LIBRARY cmdhandler CmdContext_SetVar"
+::method nativeDropVar private external "LIBRARY cmdhandler CmdContext_DropVar"
+::method variables external "LIBRARY cmdhandler CmdContext_Variables"
+
+::method lines
+  lines = .array~new
+  do forever
+    line = self~lineIn
+    if line == .nil then leave
+    lines~append(line)
+  end
+  return lines
+
+::method output
+  use strict arg lines
+  self~send("O", lines)
+
+::method error
+  use strict arg lines
+  self~send("E", lines)
+
+-- write a string or each item of a collection to the output or the error
+::method send private
+  use strict arg stream, lines
+  if lines~isA(.String) then lines = .array~of(lines)
+  else lines = lines~makeArray
+  if stream == "O" then redirected = self~isRedirected("Output")
+  else redirected = self~isRedirected("Error")
+  do line over lines
+    if redirected then self~write(stream, line~string)
+    else if stream == "O" then .output~lineout(line~string)
+    else .error~lineout(line~string)
+  end
+
+::method getVar
+  use strict arg name
+  return self~nativeGetVar(self~varName(name))
+
+::method hasVar
+  use strict arg name
+  return self~nativeHasVar(self~varName(name))
+
+::method setVar
+  use strict arg name, value
+  self~nativeSetVar(self~varName(name), value)
+
+::method dropVar
+  use strict arg name
+  self~nativeDropVar(self~varName(name))
+
+-- a variable name (simple, stem or compound), or a SYNTAX error: the native
+-- API silently ignores names that are not variables
+::method varName private
+  use strict arg name
+  name = name~request("String")
+  if name \== .nil then do
+    first = name~left(1)
+    if name~dataType("V") & first \== "." & \first~dataType("W") then return name
+  end
+  raise syntax 93.900 array("not a Rexx variable name:" name)
+
+::method raiseError
+  expose condition
+  use strict arg rc
+  condition = "ERROR"
+  return rc
+
+::method raiseFailure
+  expose condition
+  use strict arg rc
+  condition = "FAILURE"
+  return rc
