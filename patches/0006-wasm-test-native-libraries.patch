 #endif
 
 int main (int argc, char **argv) {
@@ -110,6 +114,10 @@ int main (int argc, char **argv) {
         {
             return orxWasmRxapiMain();
         }
+        if (orxWasmExtraTool != NULL && orxWasmExtraTool(tool, argc - 1, argv + 1, &rc))
