+#/* OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,      */
+#/* SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED   */
+#/* TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA,        */
+#/* OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY     */
+#/* OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING    */
+#/* NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS         */
+#/* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.               */
+#/*                                                                            */
+#/*----------------------------------------------------------------------------*/
+# Variants of the Node and browser builds with the test suite's native
+# libraries linked in, to run the API test groups (API/classic, API/oo) of
+# the ooRexx test suite, which load them with ::METHOD ... EXTERNAL
+# "LIBRARY orxmethod ...", RxFuncAdd(..., 'orxclassic1', ...) and
+# RexxRegister*Dll(..., "orxexits", ...).  For testing only: the variants are
+# not meant to be installed.
+#
+# There is no dlopen in WebAssembly, so the libraries of testbinaries/
+# (orxfunction, orxmethod, orxclassic, orxclassic1, orxexits, orxinvocation)
+# are compiled into the executable and described by the table
+# orx_wasm_static_libraries() that SysLibrary looks up instead of
+# dlopen/dlsym.  The libraries define some of the same names (RexxGetPackage,
+# TestInt8Arg, ...): those get a prefix per library, the API macros that put
+# a name in a method or routine table are redefined to keep the name as
+# written, and the table maps the prefixed names back.  In the Node variant,
+# testbinaries/rexxinstance (run as a command by the ProcessInvocation and
+# ProcessRexxStart groups) is one more tool in the same rexx.wasm, as rexxc
+# is: rexx.js --orx-wasm-rexxinstance, and an OUTDIR/rexxinstance launcher.
+#
+# Usage: wasm/build-test.sh [BUILD_DIR=build-wasm] [node|web|both=both]
+#   (BUILD_DIR: a build made by wasm/build-wasm.sh; EM_CONFIG from it)
+# Output: BUILD_DIR/bin-node-test (build-node.sh's bin-node, plus the
+#   rexxinstance launcher) and/or BUILD_DIR/bin-web-test (build-web.sh's
+#   bin-web)
+set -euo pipefail
+SRC=$(cd "$(dirname "$0")/.." && pwd)
+BUILD=$(cd "${1:-$SRC/build-wasm}" && pwd)
+WHICH=${2:-both}
+case $WHICH in
+  node|web|both) ;;
+  *) echo "usage: wasm/build-test.sh [BUILD_DIR] [node|web|both]" >&2; exit 2 ;;
+esac
+export EM_CONFIG="$BUILD/.emscripten"
+
+EMXX=$(sed -E 's/ .*//' "$BUILD/CMakeFiles/rexx_exe.dir/link.txt")
+EMCC=${EMXX%++}cc
+LLVM=$(dirname "$EMXX")/../bin
+WORK=$BUILD/testbinaries-wasm; rm -rf "$WORK"; mkdir -p "$WORK"
+FLAGS=(-O2 -pthread -fwasm-exceptions -sWASM_LEGACY_EXCEPTIONS=0 -DHAVE_CONFIG_H -DOPSYS_EMSCRIPTEN
+       -I"$SRC/api" -I"$SRC/api/platform/unix" -I"$BUILD" -I"$SRC/testbinaries")
+# library:source, as in testbinaries/CMakeLists.txt (orxexits has two)
+UNITS="orxfunction:orxfunction.cpp orxmethod:orxmethod.cpp orxclassic:orxclassic.cpp
+       orxclassic1:orxclassic1.c orxexits:orxclassicexits.cpp orxexits:orxinstance.cpp
+       orxinvocation:orxinvocation.cpp"
+
+compile() {   # compile SOURCE OBJECT [flags]
+  local src=$1 obj=$2; shift 2
+  case $src in
+    *.c) "$EMCC" "${FLAGS[@]}" "$@" -c "$src" -o "$obj" ;;
+    *)   "$EMXX" -std=gnu++11 "${FLAGS[@]}" "$@" -c "$src" -o "$obj" ;;
+  esac
+}
+
+# pass 1: the names each library defines; those defined by more than one
+# library (as identifiers: C++ names demangled) get a prefix in pass 2
+n=0
+for unit in $UNITS; do
+  lib=${unit%%:*} src=${unit#*:} n=$((n + 1))
+  compile "$SRC/testbinaries/$src" "$WORK/probe-$n.o"
+  "$LLVM/llvm-nm" --defined-only --extern-only "$WORK/probe-$n.o" |
+    awk -v lib="$lib" '$2 ~ /^[TDBR]$/ {print lib, $3}'
+done | sort -u > "$WORK/defined.txt"
+CLASHES=$(awk '{print $2}' "$WORK/defined.txt" | sort | uniq -d | "$LLVM/llvm-cxxfilt" |
+          sed -E 's/\(.*//; s/.*:://' | sort -u)
+
+# pass 2: each source and its symbol table in one translation unit, so that
+# every address is taken through the function's own declaration
+objects=() tables=()
+n=0
+for unit in $UNITS; do
+  lib=${unit%%:*} src=${unit#*:} n=$((n + 1))
+  case $src in *.c) ext=c ;; *) ext=cpp ;; esac
+  defs=()
+  for c in $CLASHES; do defs+=("-D$c=${lib}__$c"); done
+  table=orx_wasm_static_$n
+  wrapper=$WORK/$n-$lib.$ext
+  {
+    echo "#ifdef __cplusplus"
+    echo "#include <oorexxapi.h>"
+    echo "#undef REXX_METHOD"
+    echo "#define REXX_METHOD(n, e) { METHOD_TYPED_STYLE, 0, #n, (void *)e, 0, 0 }"
+    echo "#undef REXX_TYPED_ROUTINE"
+    echo "#define REXX_TYPED_ROUTINE(n, e) { ROUTINE_TYPED_STYLE, 0, #n, (void *)e, 0, 0 }"
+    echo "#undef REXX_CLASSIC_ROUTINE"
+    echo "#define REXX_CLASSIC_ROUTINE(n, e) { ROUTINE_CLASSIC_STYLE, 0, #n, (void *)e, 0, 0 }"
+    echo "#endif"
+    echo "#include \"$SRC/testbinaries/$src\""
+  } > "$wrapper"
+  compile "$wrapper" "$WORK/probe.o" "${defs[@]}"
+  syms=$("$LLVM/llvm-nm" --defined-only --extern-only "$WORK/probe.o" |
+         awk '$2 == "T" && $3 !~ /^(_Z|__)/ {print $3}' | sort -u)
+  {
+    echo "#ifdef __cplusplus"
+    echo "extern \"C\" {"
+    echo "#endif"
+    echo "typedef struct { const char *name; void *address; } OrxWasmStaticSymbol;"
+    echo "extern const OrxWasmStaticSymbol $table[];"
+    echo "const OrxWasmStaticSymbol $table[] = {"
+    for s in $syms; do echo "    { \"${s#"${lib}__"}\", (void *)&$s },"; done
+    echo "    { 0, 0 }"
+    echo "};"
+    echo "#ifdef __cplusplus"
+    echo "}"
+    echo "#endif"
+  } >> "$wrapper"
+  compile "$wrapper" "$WORK/$n-$lib.o" "${defs[@]}"
+  objects+=("$WORK/$n-$lib.o")
+  tables+=("$lib:$table")
+done
+
+# the table SysLibrary looks up
+{
+  echo 'extern "C" {'
+  echo "typedef struct { const char *name; void *address; } OrxWasmStaticSymbol;"
+  echo "typedef struct { const char *name; const OrxWasmStaticSymbol *symbols; } OrxWasmStaticLibrary;"
+  for t in "${tables[@]}"; do echo "extern const OrxWasmStaticSymbol ${t#*:}[];"; done
+  echo "const OrxWasmStaticLibrary *orx_wasm_static_libraries(void)"
+  echo "{"
+  echo "    static const OrxWasmStaticLibrary libraries[] = {"
+  for t in "${tables[@]}"; do echo "        { \"${t%%:*}\", ${t#*:} },"; done
+  echo "        { 0, 0 }"
+  echo "    };"
+  echo "    return libraries;"
+  echo "}"
+  echo "}"
+} > "$WORK/static-libraries.cpp"
+compile "$WORK/static-libraries.cpp" "$WORK/static-libraries.o"
+objects+=("$WORK/static-libraries.o")
+
+if [[ $WHICH != web ]]; then
+  # rexxinstance, compiled with the names of orxexits (the library it links)
+  defs=()
+  for c in $CLASHES; do defs+=("-D$c=orxexits__$c"); done
+  compile "$SRC/testbinaries/rexxinstance.cpp" "$WORK/rexxinstance.o" "${defs[@]}" -Dmain=orxWasmRexxinstanceMain
+  cat > "$WORK/extra-tool.cpp" <<'CPP'
+#include <string.h>
+int orxWasmRexxinstanceMain(int argc, char **argv);
+// rexx.cpp: the tools a build adds (rexx.js --orx-wasm-TOOL)
+extern "C" bool orxWasmExtraTool(const char *tool, int argc, char **argv, int *rc)
+{
+    if (strcmp(tool, "rexxinstance") == 0)
+    {
+        *rc = orxWasmRexxinstanceMain(argc, argv);
+        return true;
+    }
+    return false;
+}
+CPP
+  compile "$WORK/extra-tool.cpp" "$WORK/extra-tool.o"
+  EXTRA_OBJECTS="${objects[*]} $WORK/rexxinstance.o $WORK/extra-tool.o" \
+    "$SRC/wasm/build-node.sh" "$BUILD" "$BUILD/bin-node-test"
+  cat > "$BUILD/bin-node-test/rexxinstance" <<'SH'
+#!/usr/bin/env bash
+DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+PATH="$DIR:$PATH" exec node "$DIR/rexx.js" --orx-wasm-rexxinstance "$@"
+SH
+  chmod +x "$BUILD/bin-node-test/rexxinstance"
+fi
+if [[ $WHICH != node ]]; then
+  EXTRA_OBJECTS="${objects[*]}" "$SRC/wasm/build-web.sh" "$BUILD" "$BUILD/bin-web-test"
+fi
