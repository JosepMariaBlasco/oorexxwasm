 wasm/README.md                        |  23 +++
 wasm/build-node.sh                    |   4 +-
 wasm/build-test.sh                    | 198 ++++++++++++++++++++++++++
 wasm/build-web.sh                     |   4 +-
 5 files changed, 235 insertions(+), 2 deletions(-)
