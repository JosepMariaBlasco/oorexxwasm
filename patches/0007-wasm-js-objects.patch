+// A stand-in for ooRexx-debugger.js (tests/web-api.py, "rexx scripts debug"):
+// it records what ooRexx.js calls, adds a file to the session, and counts the
+// scripts that run instrumented (on line 1, so that no line moves).
+ooRexx.debugger = {
+  calls: [],
+  prepare(options) {
+    this.calls.push('prepare');
+    options.files = Object.assign({}, options.files, { '/tmp/debugger.txt': 'prepared' });
+  },
+  async attach(session) {
+    this.calls.push('attach');
+    await session.eval('.local~debugger.seen = 0');
+  },
+  instrument(name, source) {
+    this.calls.push('instrument ' + name);
+    return '.local~debugger.seen = .local~debugger.seen + 1;' + source;
+  },
+};
