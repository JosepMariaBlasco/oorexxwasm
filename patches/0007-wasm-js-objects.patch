+/*
+ * ooRexx/WASM: the native packages a particular build links in besides the
+ * interpreter's own, loaded on the first ::REQUIRES "name" LIBRARY (the hook
+ * orx_wasm_extra_packages() in interpreter/package/PackageManager.cpp).
+ *
+ * Each package lives in its own file and is found through a weak symbol, so
+ * a build lists only what it links: the browser build and the Node
+ * command-line build have "js" (the JavaScript bridge, web-js.cpp).
+ */
+
+#include <oorexxapi.h>
+
+extern "C"
+{
+RexxPackageEntry *orx_wasm_js_package(void) __attribute__((weak));
+
+const RexxLibraryPackage *orx_wasm_extra_packages(void)
+{
+    static RexxLibraryPackage packages[2];
+    static bool ready = false;
+    if (!ready)
+    {
+        size_t n = 0;
+        if (orx_wasm_js_package != NULL) packages[n++] = { "js", orx_wasm_js_package() };
+        packages[n] = { NULL, NULL };
+        ready = true;
+    }
+    return packages;
+}
+}
