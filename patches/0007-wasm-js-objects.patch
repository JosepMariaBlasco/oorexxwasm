+        if (name === null) {
+          if (typeof t !== 'function') throw new TypeError(an(className(t)) + ' is not a function');
+          return Reflect.apply(t, undefined, args);
+        }
+        const f = t[name];
+        if (typeof f !== 'function') throw new TypeError(name + ' is not a function');
+        return Reflect.apply(f, t, args);
+      }
+      case 7: { const t = val(r, 'the target'), args = val(r, ARGS); return Reflect.construct(t, args); }
+      case 8: {
+        const t = val(r);
+        if (t === null || (typeof t !== 'object' && typeof t !== 'function') || typeof t.then !== 'function') return t;
+        pending = Promise.resolve(t);
+        return PENDING;
+      }
+      case 9: { const t = val(r, 'the target'), what = r.str(), arg = val(r, 'the argument'); return info(t, what, arg); }
+      case 10: {
+        if (!isNode) throw new Error('require() is only available under Node');
+        return requireFromCwd(r.text('the module name'));
+      }
+      case 11: return importModule(r.text('the module name'));
+      case 12: return val(r, 'the value');
+      case 13: {
+        const base = val(r, 'the base'), name = r.text('the class name'), rexxNames = val(r), exact = val(r, 'the names');
+        return extend(base, name, rexxNames, exact);
+      }
+      case 14: { const ext = val(r), peer = Number(r.str()), args = val(r, ARGS); return construct(ext, peer, args); }
+      case 15: {
+        const t = val(r), ext = val(r), kind = r.str(), k = r.str(), args = val(r, ARGS);
+        return superMember(t, ext, kind, k, args);
+      }
+      case 17: {                                  // SESSION: for ooRexx.js's start()
+        const v = val(r);
+        if (typeof hooks.session !== 'function') throw new Error('nobody is waiting for a session here');
+        hooks.session(v);
+        return undefined;
+      }
+    }
+    throw new Error('unknown op ' + op);
+  }
+
+  function okReply(v) {
+    const w = new Writer();
+    w.rec('R', '');
+    if (v instanceof BytesForRexx) w.rec('S', v.b.slice());
+    else put(w, v);
+    return w.bytes();
+  }
+  function errReply(e) {
+    const w = new Writer();
+    // a string that is not text (see text()): D + the message, for SYNTAX
+    // 23.900 (an invalid data string, not an exception of JavaScript's)
+    if (e && e[NOT_TEXT]) { w.rec('D', e.message); return w.bytes(); }
+    // a RexxError of a Rexx SYNTAX condition, let through: J + the condition,
+    // raised again as itself
+    if (e instanceof RexxError) {
+      const pid = e[CONDITION] !== undefined ? proxyId.get(e[CONDITION]) : undefined;
+      if (pid !== undefined) { w.rec('J', ''); w.rec('R', String(pid)); return w.bytes(); }
+    }
+    let msg;
+    try {
+      msg = e instanceof Error || (e && typeof e === 'object' && 'message' in e && 'name' in e)
+        ? e.name + ': ' + e.message : String(e);
+    } catch (x) { msg = 'an exception'; }
+    w.rec('E', msg);
+    try { put(w, e); } catch (x) { w.rec('N', ''); }
+    // and its stack, when it has one (condition("O")~additional[3])
+    let stack;
+    try { stack = e !== null && typeof e === 'object' && typeof e.stack === 'string' ? e.stack : undefined; } catch (x) { /* none */ }
+    if (stack) w.rec('S', stack);
+    return w.bytes();
+  }
+
+  // one request (the records after any X): its reply, now or later (a Promise)
+  function handleRequest(op, bytes) {
+    let v;
+    try { v = run(op, new Reader(bytes)); } catch (e) { return errReply(e); }
+    if (v === PENDING) {
+      const p = pending; pending = null;
+      return p.then((x) => okReply(x), (e) => errReply(e));
+    }
+    try { return okReply(v); } catch (e) { return errReply(e); }
+  }
+  // a reply for an error of the bridge itself (no thrown value)
+  function errorText(msg) {
+    const w = new Writer();
+    w.rec('E', msg); w.rec('N', '');
+    return w.bytes();
+  }
+
+  return { realm: REALM, handle: handleRequest, release, close, errorText, Reader };
+  };
+})();
