+call charout , "after release:"; do forever; ev = .js~nextEvent(0.1); if ev == .nil then leave; call charout , "" ev~arguments[1]~detail; end; say
+::requires "js.cls"
+EOF
+check "JavaScript iteration (DO OVER, DO WITH), event options latest and max, release" '^a=1 b=2 $' '^1=x 2=y $' '^p=7$' \
