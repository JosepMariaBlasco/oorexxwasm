+// the target record of a method: this .JSObject
+static void target(RexxMethodContext *context, std::string &out)
+{
+    RexxObjectPtr ref = context->GetObjectVariable("JSREF");
+    putRec(out, 'O', ref == NULLOBJECT ? "" : context->ObjectToStringValue(ref));
+}
+
+static void args(RexxThreadContext *c, std::string &out, RexxArrayObject list, size_t from)
+{
+    size_t size = list == NULLOBJECT ? 0 : c->ArraySize(list);
+    size_t n = size >= from ? size - from + 1 : 0;
+    putRec(out, 'A', std::to_string(n));
+    for (size_t i = from; i <= size; i++) fromRexx(c, out, c->ArrayAt(list, i));
+}
