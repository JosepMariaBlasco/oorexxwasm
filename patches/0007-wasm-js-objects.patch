+  // the realm a request is for (r: just after the X records)
+  function realmOf(op, r) {
+    if (op === 1) return r.str();
+    if (op === 17) return 'page';                  // SESSION: for ooRexx.js
+    if (((op >= 2 && op <= 9) || (op >= 13 && op <= 16)) && r.more() && r.peek() === 'O') {
