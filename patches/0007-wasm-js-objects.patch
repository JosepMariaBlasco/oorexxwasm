+// JsLoopGeneration(): for JsNextEvent's stop check
+RexxRoutine0(size_t, JsLoopGeneration)
+{
+    std::lock_guard<std::mutex> lock(eventLock);
+    return stopGeneration;
+}
+
+// JsStopLoops(): every JsNextEvent waiting with an older generation returns .nil
+RexxRoutine0(int, JsStopLoops)
+{
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        stopGeneration++;
+    }
+    eventCond.notify_all();
+    return 0;
+}
+
+// a call from the page (C "call id" + the call): run it, and its answer goes
+// back for the call's Promise (Module.jsCallReply, on the main runtime thread,
+// copies it and frees it)
+static void pageCall(RexxThreadContext *c, const std::string &ev, std::exception_ptr &escaped)
+{
+    size_t pos = 0;
+    Rec r;
+    if (!nextRec(ev, pos, r)) return;
+    double id = strtod(r.data.c_str(), NULL);
+    std::string answer = runCallbackGuarded(c, ev.substr(pos), escaped);
+    int32_t len = 0;
+    char *copy = replyCopy(answer, &len);
+    MAIN_THREAD_ASYNC_EM_ASM({ Module['jsCallReply']($0, $1, $2); }, id, copy, len);
+}
+
+// a thread waiting for JavaScript: the first call from the page queued, run
+// (false: none)
+static bool runQueuedCall(RexxThreadContext *c, std::exception_ptr &escaped)
+{
+    std::string ev;
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        for (auto it = events.begin(); it != events.end(); ++it)
+        {
+            if (!it->empty() && (*it)[0] == 'C')
+            {
+                ev = std::move(*it);
+                events.erase(it);
+                __atomic_sub_fetch(&queuedCalls, 1, __ATOMIC_SEQ_CST);
+                break;
+            }
+        }
+    }
+    if (ev.empty()) return false;
+    pageCall(c, ev, escaped);
+    return true;
+}
+
+// JsNextEvent([seconds] [, generation]): the next event (a .JSEvent), or .nil
+// when the seconds are over (none: no limit) or, given a generation, when
+// JsStopLoops was called since
+RexxRoutine2(RexxObjectPtr, JsNextEvent, OPTIONAL_double, seconds, OPTIONAL_RexxObjectPtr, gen)
+{
+    size_t generation = 0;
+    bool loop = gen != NULLOBJECT && context->ObjectToStringSize(gen, &generation);
+    bool forever = argumentOmitted(1) || seconds < 0;
+    auto deadline = std::chrono::steady_clock::now() +
+        std::chrono::microseconds(forever ? 0 : (long long)(seconds * 1e6));
+    for (;;)
+    {
+        std::string ev;
+        RexxObjectPtr handler = NULLOBJECT;
+        releaseUnpinned(context->threadContext);    // also the pairs JavaScript collected
+        {
+            std::unique_lock<std::mutex> lock(eventLock);
+            auto ready = [&] { return !events.empty() || !deadPeers.empty() || (loop && stopGeneration != generation); };
+            if (forever) eventCond.wait(lock, ready);
+            else if (!eventCond.wait_until(lock, deadline, ready)) return context->Nil();
+            if (loop && stopGeneration != generation) return context->Nil();
+            if (events.empty()) continue;                               // pairs to release
+            ev = std::move(events.front());
+            events.pop_front();
+            size_t pos = 0;
+            Rec r;
+            if (!ev.empty() && ev[0] == 'C')                            // a call: run below
+            {
+                __atomic_sub_fetch(&queuedCalls, 1, __ATOMIC_SEQ_CST);
+            }
+            else if (nextRec(ev, pos, r) && r.tag == 'H')
+            {
+                auto it = pinned.find(strtoul(r.data.c_str(), NULL, 10));
+                if (it != pinned.end()) handler = it->second;
+            }
+        }
+        if (!ev.empty() && ev[0] == 'C')
+        {
+            // answered either way; a condition on its way to a trap of the
+            // code that takes events goes on now
+            std::exception_ptr escaped;
+            pageCall(context->threadContext, ev, escaped);
+            if (escaped) std::rethrow_exception(escaped);
+            continue;
+        }
+        if (handler == NULLOBJECT) { dropEvent(ev); continue; }     // released meanwhile
+        size_t pos = 0;
+        Rec r;
+        nextRec(ev, pos, r);                                       // H
+        RexxObjectPtr args = toRexx(context->threadContext, ev, pos);
+        RexxObjectPtr event = context->SendMessage2(jsEventClass, "NEW", handler, args);
+        // its function collected (handlerCollected): unpinned with its last event
+        size_t id = strtoul(r.data.c_str(), NULL, 10);
+        {
+            std::lock_guard<std::mutex> lock(eventLock);
+            if (collectedHandlers.count(id) > 0)
+            {
+                bool more = false;
+                for (const std::string &e : events) if (eventHandler(e, NULL, NULL) == id) { more = true; break; }
+                if (!more)
+                {
+                    collectedHandlers.erase(id);
+                    auto p = pinned.find(id);
+                    if (p != pinned.end()) { unpinned.push_back(p->second); pinned.erase(p); }
+                }
+            }
+        }
+        return event;
+    }
+}
