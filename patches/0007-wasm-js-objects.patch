+::method newObject unguarded        -- a new plain JavaScript object: from a Directory/StringTable, or names and values
+  signal on syntax
+  if arg() <= 1 then do
+    use strict arg d = (.directory~new)
+    return JsValue(d)
+  end
+  -- .js~newObject(name, value, ...): the names exact (a StringTable keeps them)
+  if arg() // 2 \= 0 then raise syntax 98.900 array(".js~newObject: names and values go in pairs, found" arg() "arguments")
+  d = .StringTable~new
+  do i = 1 to arg() by 2
+    if \arg(i, "E") then raise syntax 98.900 array(".js~newObject: argument" i "(a name) is missing")
+    d[arg(i)] = arg(i + 1)
+  end
+  return JsValue(d)
+syntax: raise propagate
+::method extend unguarded           -- .js~extend(class, base [, names...]): see Classes above
+  signal on syntax
+  use strict arg cls, base, ...
+  if \cls~isA(.Class) then raise syntax 98.900 array(".js~extend: the first argument must be a class, found" cls)
+  if \cls~isSubclassOf(.JSObject) | cls == .JSGlobal then
+    raise syntax 98.900 array(".js~extend:" cls~id "must be a subclass of JSObject")
+  if cls~jsExtension \== .nil then
+    raise syntax 98.900 array(".js~extend:" cls~id "already extends" cls~jsExtension)
+  if \base~isA(.JSObject) & \base~isA(.String) then
+    raise syntax 98.900 array(".js~extend: the base must be a JSObject (a class) or the name of one, found" base)
+  -- the methods of the class and of its superclasses below JSObject, public
+  names = .Set~new
+  c = cls
+  do while c \== .JSObject
+    sup = c~methods(.nil)
+    do while sup~available
+      if sup~item \== .nil, \sup~item~isPrivate then names~put(sup~index)
+      sup~next
+    end
+    c = c~superClass
+  end
+  names~removeItem("INIT"); names~removeItem("UNINIT"); names~removeItem("UNKNOWN")
+  exact = .array~new
+  do i = 3 to arg()
+    exact~append(arg(i)~string)
+  end
+  r = JsExtend(base, cls~id, names~makeArray, exact)
+  ext = r[1]
+  -- self~name:super, the base's member: a mixin's private methods, after
+  -- JSObject in the search order (so found before its UNKNOWN)
+  mixin = .Object~mixinClass(cls~id "BASE")
+  extref = "'" || ext~jsRef~changeStr("09"x, "'||'09'x||'") || "'"
+  do o over r[2]
+    parse var o kind "09"x jsname "09"x rexxname "09"x hasBase
+    jsname = jsname~changeStr("'", "''")
+    if hasBase \== 1 then iterate
+    -- the class's own JavaScript class (ext), not that of the instance's class
+    if kind == "S" then
+      src = "signal on syntax; use arg v; call JsSuper self," extref", 'S', '"jsname"', .array~of(v);" -
+            "return; syntax: raise propagate"
+    else
+      src = "signal on syntax; return JsSuper(self," extref", '"kind"', '"jsname"', arg(1, 'A'));" -
+            "syntax: raise propagate"
+    m = .Method~new(rexxname, src, .context~package)
+    m~setPrivate
+    mixin~define(rexxname, m)
+  end
+  cls~inherit(mixin)
+  cls~jsSetExtension(ext)
+  return ext
+syntax: raise propagate
+::method handler unguarded          -- .js~handler(object, message [, options]): see Events above
+  signal on syntax
+  use strict arg target, message, options = ""
+  return .JSHandler~new(target, message, options)
+syntax: raise propagate
+::method nextEvent unguarded        -- the next event (a .JSEvent), or .nil after seconds
+  signal on syntax
+  use strict arg seconds = (-1)
+  if \datatype(seconds, "N") then raise syntax 98.900 array(".js~nextEvent: seconds must be a number, found" seconds)
+  if seconds < 0 then return JsNextEvent()
