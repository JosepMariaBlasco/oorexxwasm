+++ b/wasm/tests/js-booleans.rex
@@ -0,0 +1,71 @@
+/* js-booleans.rex: booleans across the JavaScript bridge (.Boolean,        */
+/* boolean.cls), in the realm where Rexx runs: the worker's in the browser, */
+/* Node's under Node.  A .Boolean goes to JavaScript as a boolean, and a    */
+/* JavaScript boolean comes to Rexx as .Boolean~true or .Boolean~false.     */
+/* Prints one line per check; exits 1 if any fails.                         */
+.local~ok = 0; .local~bad = 0
+.local~fn = .js~Function~new("args", "body", "return new Function(...args.split(','), body)")
+show = F("x", "return typeof x + ' ' + x")
+id = F("x", "return x")
+
+-- Rexx to JavaScript
+call check ".Boolean~true is true", show~call(.nil, .Boolean~true) == "boolean true"
+call check ".Boolean~false is false", show~call(.nil, .Boolean~false) == "boolean false"
+call check ".js~true, .js~false are .Boolean's", .js~true == .Boolean~true & .js~true~isA(.Boolean) & -
+  .js~false~isA(.Boolean) & .js~false~value == 0
+call check ".js~bool(a > b) is .Boolean~of", .js~bool(3 > 2) == .Boolean~true & show~call(.nil, .js~bool(2 > 3)) == "boolean false"
+call check ".js~box('BOolean', x) too", .js~box("bo", 1)~isA(.Boolean) & show~call(.nil, .js~box("Boolean", 0)) == "boolean false"
+signal on syntax name s1
+x = .js~bool("true")
+s1:
+call check ".js~bool takes a Rexx logical value only (34.900)", condition("O")~code == "34.900"
+call check ".true is still the string 1", show~call(.nil, .true) == "string 1"
+call check "a subclass of .Boolean is a boolean too", show~call(.nil, .MyBool~false) == "boolean false"
+d = .directory~new; d["on"] = .Boolean~true; d["off"] = .Boolean~false
+call check "inside a Directory, as JSON", F("o", "return JSON.stringify(o)")~call(.nil, d) == '{"off":false,"on":true}' | -
+  F("o", "return JSON.stringify(o)")~call(.nil, d) == '{"on":true,"off":false}'
+call check "inside an Array", F("a", "return a.map((x) => typeof x).join()")~call(.nil, .array~of(.js~true, 1)) == "boolean,string"
+
+-- JavaScript to Rexx
+t = F("", "return true")~call(.nil); f = F("", "return false")~call(.nil)
+call check "true comes as .Boolean~true", t~isA(.Boolean) & t == .Boolean~true & t~class == .Boolean
+call check "false comes as .Boolean~false", f~isA(.Boolean) & f~value == 0
+call check "the very instances", .Boolean~true~identityHash == t~identityHash
+ok = 0; if t then ok = 1; if f then ok = 0
+call check "IF takes them", ok == 1
+call check "they are 1 and 0 for Rexx", t == 1 & f = 0 & t + f == 1 & \f & (t & \f) & datatype(t, "O")
+s.t = "yes"; s.1 = "one"
+call check "as a stem tail, 1", s.t == "one"
+call check "round trip: a JavaScript boolean stays one", show~call(.nil, id~call(.nil, .js~false)) == "boolean false"
+a = F("", "return [true, false, 1]")~call(.nil)~makeArray
+call check "in an array made a Rexx Array", a[1]~isA(.Boolean) & a[2]~isA(.Boolean) & \a[3]~isA(.Boolean)
+o = .js~newObject("x", 1)
+call check "~js.hasProperty gives one", o~js.hasProperty("x")~isA(.Boolean) & o~js.hasProperty("x") & \o~js.hasProperty("y")
+call check "arguments of a call of Rexx", F("o", "return o.kind(true, false, 1)")~call(.nil, .Thing~new) == "Boolean Boolean String"
+call check ".js~unbox(.Boolean) is its value, a string", .js~unbox(.Boolean~true) == 1 & .js~unbox(.Boolean~true)~isA(.String)
+call check ".js~unbox(new Boolean(false)) is 0", .js~unbox(F("", "return new Boolean(false)")~call(.nil)) == "0"
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+F: procedure                        -- F(params, body): a JavaScript function
+  return .fn~call(.nil, arg(1), arg(2))
+
+check: procedure
+  parse arg what, ok
+  if ok == 1 then do; .local~ok += 1; say "ok  " what; end
+  else do; .local~bad += 1; say "FAIL" what; end
+  return
+
+::class MyBool subclass Boolean
+
+::class Thing
+::method kind
+  r = ""
+  do a over arg(1, "A")
+    r = r a~class~id
+  end
+  return r~strip
+
+::requires "js.cls"
diff --git a/wasm/tests/js-errors.rex b/wasm/tests/js-errors.rex
new file mode 100644
index 0000000..a08d2c9
--- /dev/null
+++ b/wasm/tests/js-errors.rex
@@ -0,0 +1,222 @@
+/* js-errors.rex: tests of errors and text across the JavaScript bridge      */
+/* (wasm/js-realm.js, wasm/web-js.cpp), in the realm where Rexx runs: the    */
+/* worker's in the browser, Node's under Node.  A Rexx condition in          */
+/* JavaScript (RexxError and its fields, cause), a JavaScript exception in   */
+/* Rexx (condition("O")~additional), and strings that are not text (not      */
+/* UTF-8, lone surrogates).  Prints one line per check; exits 1 if any      */
+/* fails.                                                                    */
+.local~ok = 0; .local~bad = 0
+.local~fn = .js~Function~new("args", "body", "return new Function(...args.split(','), body)")
+o = .Thing~new
+
+-- A Rexx condition in JavaScript: a RexxError with the condition's fields
+fields = F("o", "try { o.add('lots'); return 'no error' } catch (e) {" -
+  "return [e.name, e instanceof Error, e.condition, e.code, typeof e.rc, e.rc, typeof e.line, e.line > 0," -
+  "typeof e.errorText, e.errorText.length > 0, typeof e.program, e.program.length > 0," -
+  "typeof e.traceback, e.traceback.includes('*-*'), 'cause' in e, e.message.startsWith('Error 41.1: ')].join(' ') }")
+r = fields~call(.nil, o)
+call check "a condition is a RexxError, an Error", r~word(1) == "RexxError" & r~word(2) == "true"
+call check "condition, code (a string), rc (a number)", r~subword(3, 4) == "SYNTAX 41.1 number 41"
+call check "line, a number", r~subword(7, 2) == "number true"
+call check "errorText, program: strings", r~subword(9, 4) == "string true string true"
+call check "traceback: the lines, as Rexx shows them", r~subword(13, 2) == "string true"
+call check "no cause for a condition of Rexx's own", r~word(15) == "false"
+call check "the message is as it was", r~word(16) == "true"
+r = F("o", "try { o.add('lots') } catch (e) { return e.traceback.split('\n').length + ' ' + e.line }")~call(.nil, o)
+call check "the traceback has a line per level", r~word(1) >= 1 & datatype(r~word(2), "W")
+r = F("o", "try { o.mine(); return 'no error' } catch (e) { return e.code + ' ' + ('cause' in e) }")~call(.nil, o)
+call check "a 98.900 raised by Rexx: no cause", r == "98.900 false"
+r = F("o", "try { o.halt(); return 'no error' } catch (e) { return e.name + ' ' + e.condition + ' ' + e.code }")~call(.nil, o)
+call check "a HALT nobody traps arrives as SYNTAX 4.1", r == "RexxError SYNTAX 4.1"
+
+-- Through Rexx and back: the JavaScript exception is the RexxError's cause
+r = F("o", "const err = new TypeError('from JS');" -
+  "try { o.callBack(() => { throw err; }); return 'no error' } catch (e) {" -
+  "return [e.name, e.code, e.cause === err, e.cause instanceof TypeError].join(' ') }")~call(.nil, o)
+call check "round trip: cause is the very object thrown", r == "RexxError 98.900 true true"
+r = F("o", "try { o.callBack(() => { throw 42; }) } catch (e) { return typeof e.cause + ' ' + e.cause }")~call(.nil, o)
+call check "round trip: a thrown primitive comes back as its string", r == "string 42"
+r = F("o", "const err = new RangeError('deep');" -
+  "try { o.callBack(() => o.callBack(() => { throw err; })) } catch (e) {" -
+  "return [e.code, e.cause === err].join(' ') }")~call(.nil, o)
+call check "round trip twice: still the very object thrown, no chain", r == "98.900 true"
+r = F("o", "const err = new TypeError('trapped');" -
+  "try { o.propagate(() => { throw err; }) } catch (e) { return (e.cause === err) + '' }")~call(.nil, o)
+call check "round trip through RAISE PROPAGATE", r == "true"
+
+-- Through JavaScript and back: a Rexx condition that JavaScript lets through
+-- is raised again as itself, not as a JavaScript error
+signal on syntax name rt0
+o~add("lots")
+rt0:
+direct = condition("O")~code condition("O")~additional[1]
+r = errorOf(F("o", "o.add('lots')"), .array~of(.nil, o))
+call check "back to Rexx: the condition itself (41.1, the same message)", r == direct & r~word(1) == "41.1"
+r = errorOf(F("o", "o.mine()"), .array~of(.nil, o))
+call check "back to Rexx: a 98.900 of Rexx's own, as it was", r == "98.900 a Rexx error of its own"
+r = errorOf(F("o", "try { o.add('lots') } catch (e) { throw e }"), .array~of(.nil, o))
+call check "back to Rexx: caught and thrown again, still itself", r == direct
+signal on syntax name rt2
+o~descr
+rt2:
+c = condition("O"); direct = c~code "|" c~description "|" c~additional[1] "|" c~result
+signal on syntax name rt3
+F("o", "o.descr()")~call(.nil, o)
+rt3:
+c = condition("O")
+call check "back to Rexx: its description and result too", -
+  c~code "|" c~description "|" c~additional[1] "|" c~result == direct & direct == "98.900 | my description | given | 5"
+-- any other condition reaches the caller's trap as without JavaScript in between
+.local~userTrapped = ""
+call userThroughJs o
+call check "a USER condition through JavaScript: the caller's SIGNAL ON, as itself", -
+  .local~userTrapped == "USER MINE | the description | two | (none)"
+call check "... and JavaScript is not left waiting: it was told, and goes on", -
+  .js~Promise~resolve(5)~await == 5 & .js~lastSignalled~pos("went past this call") > 0
+call on user mine name callOnUser
+r = F("o", "return 'JavaScript went on: ' + o.user()")~call(.nil, o)
+call off user mine
+call check "a USER condition through JavaScript: the caller's CALL ON, then JavaScript goes on", -
+  .local~userTrapped == "CALL ON the description" & r == "JavaScript went on: 7"
+call check "an untrapped USER condition: nothing, JavaScript gets the result", -
+  F("o", "return o.user()")~call(.nil, o) == 7
+signal on syntax name rt1
+F("o", "o.callBack(() => { throw new TypeError('inner') })")~call(.nil, o)
+rt1:
+a = condition("O")~additional
+call check "back to Rexx twice: the JavaScript exception, [2] the TypeError", -
+  a[1] == "JavaScript error: TypeError: inner" & a[2]~isA(.JSObject) & a[2]~message == "inner"
+r = errorOf(F("", "throw new RexxError('made in JavaScript')"), .array~of(.nil))
+call check "a RexxError JavaScript made itself: a JavaScript error", r == "98.900 JavaScript error: RexxError: made in JavaScript"
+
+-- A JavaScript exception in Rexx: additional [1] message, [2] what was thrown, [3] its stack
+signal on syntax name s1
+F("", "throw new TypeError('boom')")~call(.nil)
+s1:
+c = condition("O")
+call check "a JavaScript exception: SYNTAX 98.900", c~code == "98.900"
+a = c~additional
+call check "additional[1]: the message", a[1] == "JavaScript error: TypeError: boom"
+call check "additional[2]: the thrown object", a[2]~isA(.JSObject) & a[2]~message == "boom"
+call check "additional[3]: its stack, as text", a~items == 3 & a[3]~isA(.String) & a[3]~length > 0
+signal on syntax name s2
+F("", "throw 42")~call(.nil)
+s2:
+a = condition("O")~additional
+call check "a thrown primitive: no stack, two items", a~items == 2 & a[2] == 42
+signal on syntax name s3
+.js~Promise~reject(.js~Error~new("rejected"))~await
+s3:
+a = condition("O")~additional
+call check "a rejected Promise: the stack too", a~items == 3 & a[2]~message == "rejected"
+
+-- Text: a Rexx string goes to JavaScript as UTF-8 text
+call check "UTF-8 goes as text", F("s", "return s.length + ' ' + s.codePointAt(0)")~call(.nil, "c3a9"x) == "1 233"
+call check "UTF-8 comes back the same", F("s", "return s")~call(.nil, "e282ac"x) == "e282ac"x
+r = errorOf(F("s", "return s"), .array~of(.nil, "ff"x))
+call check "not UTF-8: SYNTAX 23.900, not U+FFFD", r~left(6) == "23.900" & -
+  r~pos("argument 2 is not valid UTF-8 (byte 1 is 'FF'x)") > 0 & r~pos(".js~bytes") > 0
+signal on syntax name s6
+x = F("s", "return s")~call(.nil, "ff"x)
+s6:
+c = condition("O")
+call check "an invalid data string, not a JavaScript error: only the message", -
+  c~errortext == "Invalid data string." & c~additional~items == 1 & c~additional[1]~left(8) == "argument"
+r = errorOf(F("s", "return s"), .array~of(.nil, "abc" || "c3"x))
+call check "a truncated sequence: the byte where it fails", r~pos("argument 2 is not valid UTF-8 (byte 4 is 'C3'x)") > 0
+r = errorOf(F("s", "return s"), .array~of(.nil, "eda080"x))
+call check "an encoded surrogate is not UTF-8", r~pos("(byte 1 is 'ED'x)") > 0
+d = .directory~new; d["k"] = "x" || "80"x
+r = errorOf(F("d", "return d"), .array~of(.nil, d))
+call check "inside a Directory: the item named", r~pos('the item at "k" of argument 2 is not valid UTF-8') > 0
+r = errorOf(F("a", "return a"), .array~of(.nil, .array~of("ok", "fe"x)))
+call check "inside an Array: the item named", r~pos("item 2 of argument 2 is not valid UTF-8") > 0
+signal on syntax name s4
+x = .js~Object~new; x["p" || "ff"x] = 1
+s4:
+call check "a property name", condition("O")~additional[1]~pos("the name is not valid UTF-8") > 0
+call check ".js~bytes passes the bytes", F("b", "return b.constructor.name + ' ' + b[0]")~call(.nil, .js~bytes("ff"x)) == "Uint8Array 255"
+call check "a Rexx object's string may be any bytes (RexxProxy)", F("o", "return typeof o")~call(.nil, .Bytes~new) == "object"
+
+-- A JavaScript string comes to Rexx as UTF-8: it must be well-formed
+call check "a surrogate pair comes as UTF-8", F("", "return '😀'")~call(.nil) == "f09f9880"x
+r = errorOf(F("", "return 'ab\uD800'"), .array~of(.nil))
+call check "a lone surrogate: SYNTAX 23.900", r~left(6) == "23.900" & r~pos("code unit 3 is a lone surrogate, U+D800") > 0
+signal on syntax name s5
+x = F("", "return ['ok', '\uDC00']")~call(.nil)~makeArray
+s5:
+call check "a lone low surrogate in an array made a Rexx Array", -
+  condition("O")~additional[1]~pos("code unit 1 is a lone surrogate, U+DC00") > 0
+r = F("o", "try { o.add('\uD800'); return 'no error' } catch (e) { return e.name + ' ' + (e instanceof RexxError) }")~call(.nil, o)
+call check "an argument for Rexx with a lone surrogate: a TypeError in JavaScript", r == "TypeError false"
+r = F("o", "try { o.binary(); return 'no error' } catch (e) { return e.name + ' ' + e.message }")~call(.nil, o)
+call check "a result for JavaScript that is not UTF-8: a TypeError", r~word(1) == "TypeError" & -
+  r~pos("the result is not valid UTF-8") > 0
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+F: procedure                        -- F(params, body): a JavaScript function
+  return .fn~call(.nil, arg(1), arg(2))
+
+userThroughJs: procedure            -- SIGNAL ON USER MINE around a call of JavaScript that raises it
+  use arg o
+  signal on user mine name userSignalled
+  F("o", "try { o.user() } catch (e) { globalThis.lastSignalled = e.message; throw e }")~call(.nil, o)
+  return
+userSignalled:
+  c = condition("O")
+  r = c~result; if r == .nil then r = "(none)"
+  .local~userTrapped = c~condition "|" c~description "|" c~additional[2] "|" r
+  return
+
+callOnUser:
+  .local~userTrapped = "CALL ON" condition("D")
+  return
+
+errorOf: procedure                  -- f~call(args...): "code message" of its condition
+  use arg f, args
+  signal on syntax
+  f~sendWith("CALL", args)
+  return "no error"
+syntax:
+  c = condition("O")
+  return c~code c~additional[1]
+
+check: procedure
+  parse arg what, ok
+  if ok == 1 then do; .local~ok += 1; say "ok  " what; end
+  else do; .local~bad += 1; say "FAIL" what; end
+  return
+
+::class Thing
+::method add
+  use arg n
+  return 1 + n
+::method mine
+  raise syntax 98.900 array("a Rexx error of its own")
+::method halt
+  raise halt
+::method callBack
+  use arg f
+  return f~call(.nil)
+::method propagate
+  use arg f
+  signal on syntax
+  return f~call(.nil)
+syntax: raise propagate
+::method descr
+  raise syntax 98.900 additional ("given") description "my description" return 5
+::method user
+  raise user mine description "the description" additional ("one", "two") return 7
+::method binary
+  return "ff"x
+
+::class Bytes
+::method makeString
+  return "ab" || "ff"x
+::method string
+  return "ab" || "ff"x
+
+::requires "js.cls"
diff --git a/wasm/tests/js-extend-gc.rex b/wasm/tests/js-extend-gc.rex
new file mode 100644
index 0000000..d84307a
--- /dev/null
+++ b/wasm/tests/js-extend-gc.rex
@@ -0,0 +1,111 @@
+/* js-extend-gc.rex: the pairs of .js~extend (a Rexx object and its           */
+/* JavaScript object) are released by the two collectors, with no            */
+/* .js~detach: a pair lives while Rexx holds the Rexx object or JavaScript    */
+/* holds its object.  Node with --expose-gc (JavaScript's collector is run    */
+/* by globalThis.gc(); Rexx's by making garbage).  Prints one line per        */
+/* check; exits 1 if any fails.                                               */
+.local~ok = 0; .local~bad = 0; .local~uninits = 0
+js = .js
+mk = js~Function~new("src", "return new Function(src)()")
+js["Car"] = mk~call(.nil, "return class Car {" -
+  "  constructor(name) { this.name = name; }" -
+  "  describe() { return this.name + ' says ' + this.sound(); }" -
+  "  sound() { return 'beep'; }" -
+  "}")
+.js~extend(.Pet, "Car")
+
+-- 1. nobody holds them: the class's UNINIT runs, once each
+do i = 1 to 200; p = .Pet~new("a" i); end
+drop p
+call collect
+call check "dropped by both sides: all 200 released, UNINIT once each", .uninits == 200, .uninits
+
+-- 2. JavaScript holds them alone: they live, and their overrides run
+.local~uninits = 0
+keep = js~newArray
+do i = 1 to 100; keep~push(.Pet~new("k" i)); end
+call collect
+call check "held by JavaScript alone: none released", .uninits == 0, .uninits
+says = mk~call(.nil, "return (a) => a.map((o) => o.describe()).join(',')")~call(.nil, keep)
+call check "held by JavaScript alone: JavaScript calls their overrides", -
+  says~countStr("woof") == 100, says~left(60)
+call collect
+call check "after those calls, still none released", .uninits == 0, .uninits
+-- then JavaScript lets them go too
+keep~length = 0
+drop keep
+call collect
+call check "then dropped by JavaScript: all 100 released", .uninits == 100, .uninits
+
+-- 3. Rexx holds one alone: it lives, and so does its JavaScript object
+.local~uninits = 0
+r = .Pet~new("rexx")
+call collect
+call check "held by Rexx alone: not released, its JavaScript object works", -
+  .uninits == 0 & r~describe == "rexx says woof"
+
+-- 4. JavaScript holds it, then Rexx takes it back and JavaScript lets go
+js["box"] = .js~newArray(.Pet~new("back"))
+call collect
+b = js["box"][1]                    -- comes back to Rexx (held by JavaScript until now)
+js["box"] = .js~undefined
+call collect
+call check "taken back by Rexx: it lives, overrides and all", -
+  b~isA(.Pet) & b~describe == "back says woof" & .uninits == 0, .uninits
+drop b r
+call collect
+call check "then dropped by Rexx too: both released", .uninits == 2, .uninits
+
+-- 5. a subclass of an extending class: the UNINIT it inherits runs in its
+-- own class's scope (it sees the variables INIT set there), and a method of
+-- the subclass named RUN is not called in its place
+.local~uninits = 0; .local~ranRun = 0
+do i = 1 to 50; p = .Puppy~new("p" i); end
+drop p
+call collect
+call check "a subclass: the inherited UNINIT sees its variables, all 50 released", -
+  .uninits == 50 & .ranRun == 0, .uninits .ranRun
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+check: procedure
+  use arg name, ok, detail
+  if ok then do; .local~ok += 1; say "ok   " name; end
+  else do; .local~bad += 1; say "FAIL " name "("detail")"; end
+  return
+
+-- both collectors, a few rounds: Rexx's (garbage), a request (it takes what
+-- Rexx found to JavaScript), JavaScript's, a request (what JavaScript found
+-- comes back)
+collect: procedure
+  gc = .js~Function~new("globalThis.gc(); return 1")
+  do 3
+    do k = 1 to 20; a = .array~new; do j = 1 to 50000; a[j] = .mutableBuffer~new("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"); end; drop a; end
+    x = .js~Math~max(1, 2)
+    do 3; x = gc~call(.nil); call SysSleep 0.05; end
+    x = .js~Math~max(1, 2)
+  end
+  return
+
+::requires "js.cls"
+
+::class Pet subclass JSObject
+::method init                       -- a variable for UNINIT (counted only if it sees it)
+  expose tag
+  tag = "mine"
+  forward class (super)
+::method sound                      -- Car's describe() calls it
+  return "woof"
+::method uninit                     -- the class's UNINIT: once, when the pair is over
+  expose tag
+  if tag == "mine" then .local~uninits += 1
+
+::class Puppy subclass Pet
+::method init
+  expose age
+  age = 1
+  forward class (super)
+::method run                        -- not to be confused with Object's RUN
+  .local~ranRun += 1
diff --git a/wasm/tests/js-extend.rex b/wasm/tests/js-extend.rex
new file mode 100644
index 0000000..f3cfe7a
--- /dev/null
+++ b/wasm/tests/js-extend.rex
@@ -0,0 +1,157 @@
+/* js-extend.rex: tests of Rexx classes extending JavaScript classes          */
+/* (.js~extend, wasm/web/js.cls), in the realm where Rexx runs: the worker's   */
+/* in the browser, Node's under Node.  Prints one line per check; exits 1 if  */
+/* any fails.                                                                 */
+.local~ok = 0; .local~bad = 0
+js = .js
+mk = js~Function~new("src", "return new Function(src)()")   -- a value made by a JavaScript script
+
+-- a JavaScript class, with a method that calls another (age), a getter and
+-- setter (label), a constructor that calls an overridable method (kind)
+car = mk~call(.nil, "return class Car {" -
+  "  constructor(name, year) { this.name = name; this.year = year; this.made = this.kind(); }" -
+  "  age() { return 2026 - this.year; }" -
+  "  describe() { return this.name + ' is ' + this.age(); }" -
+  "  kind() { return 'car'; }" -
+  "  honk() { return 'beep'; }" -
+  "  get label() { return '[' + this.name + ']'; }" -
+  "  set label(v) { this.name = v; }" -
+  "  static wheels() { return 4; }" -
+  "}")
+js["Car"] = car
+
+ext = .js~extend(.MyCar, "Car")
+call check "extend answers a JavaScript class", ext~js.typeOf == "function"
+call check "its name is the Rexx class's", ext["name"] == "MYCAR"
+call check "it extends the base", ext["prototype"]~js.instanceOf(car)
+
+c = .MyCar~new("Seat", 2020)
+call check "an instance is a JSObject and a MyCar", c~isA(.JSObject) & c~isA(.MyCar)
+call check "the JavaScript object is a Car", c~js.instanceOf(car) & c~js.instanceOf(ext)
+call check "Rexx calls its own method", c~age == 7
+call check "JavaScript calls the override (describe -> this.age())", c~describe == "Seat is 7"
+call check "~name:super reaches JavaScript's age()", c~baseAge == 6
+call check "a method not overridden is JavaScript's", c~honk == "beep"
+call check "INIT ran and passed the arguments on", c~inits == 1 & c["year"] == 2020
+call check "the base constructor reached the override (self usable)", c["made"] == "rexx kind of Seat"
+call check "getter overridden", c["label"] == "<Seat>"
+call check "getter: ~label:super", c~superLabel == "[Seat]"
+c["label"] = "Ibiza"
+call check "setter overridden (Rexx saw it, then the base's)", c~lastSet == "Ibiza" & c["name"] == "IBIZA"
+
+-- identity: the instance comes back from JavaScript as the Rexx object itself
+a = js~newArray(c, "x")
+back = a[1]
+call check "identity: back from JavaScript as the same Rexx object", back == c & back~isA(.MyCar)
+call check "identity: the same object, Rexx's ==", back~identityHash == c~identityHash
+
+-- a condition in an override is a RexxError in JavaScript
+probe = mk~call(.nil, "return (o) => { try { o.age(); return 'no error' } catch (e) { return e.name + ': ' + e.message } }")
+c~failNext = 1
+r = probe~call(.nil, c)
+call check "a condition is a RexxError in JavaScript", r~left(10) == "RexxError:" & r~pos("Error 41") > 0
+call check "and it does not stay", c~describe == "IBIZA is 7"
+
+-- a JavaScript caller with its own array of them: sort with a method of the instances
+cars = js~newArray(.MyCar~new("B", 2001), .MyCar~new("A", 2010), .MyCar~new("C", 1990))
+sorter = mk~call(.nil, "return (l) => l.sort((x, y) => x.age() - y.age()).map((x) => x.name).join(',')")
+call check "JavaScript sorts by the Rexx override", sorter~call(.nil, cars) == "A,B,C"
+
+-- exact names the base does not have
+.js~extend(.Greeter, js~Object, "greetMe")
+g = .Greeter~new
+call check "an exact name added: JavaScript calls it", mk~call(.nil, "return (o) => o.greetMe('Ana')")~call(.nil, g) == "hola Ana"
+call check "without the exact name it is not there", mk~call(.nil, "return (o) => typeof o.other")~call(.nil, g) == "undefined"
+
+-- a Rexx subclass of the extending class
+s = .SportsCar~new("Cupra", 2024)
+call check "a Rexx subclass: JavaScript reaches the inherited override", s~describe == "Cupra is 3"
+call check "a Rexx subclass: ~kind:super is MyCar's", s~kind == "fast rexx kind of Cupra"
+
+-- made by JavaScript (no Rexx object): the base's behaviour
+plain = ext~new("Plain", 2000)
+call check "made by JavaScript: no Rexx object, the base's methods", plain~describe == "Plain is 26" & \plain~isA(.MyCar)
+
+-- held by JavaScript alone, then by Rexx again (no .js~detach: the
+-- collectors release a pair; js-extend-gc.rex, with --expose-gc)
+d = .MyCar~new("Kept", 2016)
+js["keptCar"] = d
+drop d
+d = js["keptCar"]
+call check "held by JavaScript alone, it comes back as itself", d~isA(.MyCar)
+call check "and its overrides still run", d~describe == "Kept is 11"
+call check "JavaScript calls them too", mk~call(.nil, "return () => keptCar.describe()")~call(.nil) == "Kept is 11"
+
+-- errors
+signal on syntax name e1
+.js~extend(.MyCar, "Car")
+call check "extending twice is an error", .false
+e1: call check "extending twice is an error", condition("O")~code == 98.900
+signal on syntax name e2
+.js~extend(.NotJs, "Car")
+call check "a class that is not a JSObject is refused", .false
+e2: call check "a class that is not a JSObject is refused", condition("O")~message~pos("JSObject") > 0
+signal on syntax name e3
+.js~extend(.Lone, "NoSuchClassAnywhere")
+call check "an unknown base is an error", .false
+e3: call check "an unknown base is an error", condition("O")~code == 98.900
+signal on syntax name e4
+.js~extend(.Lone, js~Math)
+call check "a base that is not a class is an error", .false
+e4: call check "a base that is not a class is an error", condition("O")~message~pos("not a class") > 0
+signal off syntax
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+check: procedure
+  use arg name, ok
+  if ok then do; .local~ok += 1; say "ok   " name; end
+  else do; .local~bad += 1; say "FAIL " name; end
+  return
+
+::requires "js.cls"
+
+::class MyCar subclass JSObject
+::attribute inits get
+::attribute lastSet get
+::attribute failNext set
+::method init
+  expose inits
+  use arg name, year
+  inits = 0
+  self~init:super(name, year)
+  inits += 1
+::method age
+  expose failNext
+  if failNext == 1 then do
+    failNext = 0
+    return 1 + "no number"
+  end
+  return self~age:super + 1
+::method baseAge
+  return self~age:super
+::method kind                       -- called by Car's constructor
+  return "rexx kind of" self["name"]
+::method label                      -- the getter
+  return "<"self["name"]">"
+::method superLabel
+  return self~label:super
+::method "LABEL="                   -- the setter
+  expose lastSet
+  use arg v
+  lastSet = v
+  self~"LABEL=":super(v~upper)
+
+::class SportsCar subclass MyCar
+::method kind
+  return "fast" self~kind:super
+
+::class Greeter subclass JSObject
+::method greetMe
+  use arg who
+  return "hola" who
+
+::class NotJs
+::class Lone subclass JSObject
diff --git a/wasm/tests/js-floats.rex b/wasm/tests/js-floats.rex
new file mode 100644
index 0000000..05a3474
--- /dev/null
+++ b/wasm/tests/js-floats.rex
@@ -0,0 +1,112 @@
+/* js-floats.rex: the text of a JavaScript number in Rexx, in the realm     */
+/* where Rexx runs: the worker's in the browser, Node's under Node.  A      */
+/* number arrives with the shortest digits that read back as the same       */
+/* double, written as ooRexx writes x + 0 under NUMERIC DIGITS 17: plain    */
+/* digits unless the integer part needs more than 17 places or the decimals */
+/* more than 34; no ".0"; -0 kept; NaN and the infinities as ooRexx spells  */
+/* them, "nan", "+infinity", "-infinity".  .js~num reads every form back.   */
+/* A Rexx number that does not fit a JavaScript number is a RangeError.    */
+/* Prints one line per check; exits 1 if any fails.                         */
+.local~ok = 0; .local~bad = 0
+.local~fn = .js~Function~new("args", "body", "return new Function(...args.split(','), body)")
+num = F("e", "return Function('return ' + e)()")   -- a JavaScript number from an expression
+
+-- literal, then its text in Rexx; the double nearest 1.2345678901234567e-10
+-- has the shortest digits 1.2345678901234568e-10
+t = .array~of("1e16", "10000000000000000", "1e17", "1E+17", "1.5e17", "1.5E+17", -
+  "1e21", "1E+21", "1e-7", "0.0000001", "1e-20", "0.00000000000000000001", -
+  "1e-34", "0.0000000000000000000000000000000001", "1e-35", "1E-35", -
+  "1.2345678901234567e-10", "0.00000000012345678901234568", -
+  "1.2345678901234567e-20", "1.2345678901234567E-20", -
+  "1.7976931348623157e308", "1.7976931348623157E+308", "5e-324", "5E-324", -
+  "0.30000000000000004", "0.30000000000000004", "-1.5e-35", "-1.5E-35")
+do i = 1 to t~items by 2
+  v = num~call(.nil, t[i])
+  call check t[i] "arrives as" t[i + 1], v == t[i + 1]
+end
+call check "an integer float has no .0 (1.0 is 1, 2**53 is 9007199254740992)", -
+  num~call(.nil, "1.0") == "1" & num~call(.nil, "2**53") == "9007199254740992"
+call check "-0 is kept", num~call(.nil, "-0") == "-0"
+call check "NaN, Infinity, -Infinity arrive as nan, +infinity, -infinity", -
+  num~call(.nil, "NaN") == "nan" & num~call(.nil, "Infinity") == "+infinity" & -
+  num~call(.nil, "-Infinity") == "-infinity"
+call check "nan and the infinities are not Rexx numbers", -
+  datatype(num~call(.nil, "NaN"), "N") = 0 & datatype(num~call(.nil, "Infinity"), "N") = 0
+
+-- 2000 doubles of every magnitude: the text is ooRexx's own x + 0 on the
+-- shortest digits, and it reads back as the same double
+x = F("n", "let s = 7; const r = () => (s = (s * 1103515245 + 12345) % 2147483648) / 2147483648;" -
+  "const b = new DataView(new ArrayBuffer(8)); globalThis.floatsProbe = [];" -
+  "while (floatsProbe.length < n) { b.setUint32(0, r() * 2**32); b.setUint32(4, r() * 2**32);" -
+  " let v = b.getFloat64(0); if (floatsProbe.length % 2) v = Number((r() * 10).toFixed(1 + Math.floor(r() * 17)) + 'e' + (Math.floor(r() * 80) - 45));" -
+  " if (Number.isFinite(v) && v !== 0) floatsProbe.push(v); } return n")~call(.nil, 2000)
+value = F("i", "return floatsProbe[i]")
+digits = F("i", "return floatsProbe[i].toExponential()")
+same = F("i, x", "return Object.is(floatsProbe[i], x)")
+diff = 0; back = 0
+numeric digits 17
+do i = 0 to 1999
+  v = value~call(.nil, i)
+  if v \== digits~call(.nil, i) + 0 then diff += 1
+  if \same~call(.nil, i, .js~num(v)) then back += 1
+end
+numeric digits
+call check "2000 doubles: the text is x + 0 under NUMERIC DIGITS 17 (" || diff "different)", diff = 0
+call check "2000 doubles: .js~num reads each text back as the same double (" || back "different)", back = 0
+
+is = F("x, y", "return Object.is(x, Number(y))")
+call check ".js~num reads -0, nan, +infinity, -infinity back", -
+  is~call(.nil, .js~num("-0"), "-0") & is~call(.nil, .js~num("nan"), "NaN") & -
+  is~call(.nil, .js~num("+infinity"), "Infinity") & is~call(.nil, .js~num("-infinity"), "-Infinity")
+call check ".js~num also reads JavaScript's NaN, Infinity, -Infinity", -
+  is~call(.nil, .js~num("NaN"), "NaN") & is~call(.nil, .js~num("Infinity"), "Infinity") & -
+  is~call(.nil, .js~num("-Infinity"), "-Infinity")
+call check ".js~num: inf is not a number (SYNTAX 98.900)", tonum("inf") == "SYNTAX 98.900"
+
+-- out of range: an error that names the cause, not an infinity or a zero
+call check "too large: 1E+999, -1E+999, 1.8E+308 are a RangeError", -
+  range("1E+999") == "too large" & range("-1E+999") == "too large" & range("1.8E+308") == "too large"
+call check "too small: 1E-999, -1E-999 are a RangeError (not 0, -0)", -
+  range("1E-999") == "too small" & range("-1E-999") == "too small"
+call check "in range: 5E-324, 1.7976931348623157E+308, 0, -0, 0E+999", -
+  is~call(.nil, .js~num("5E-324"), "5e-324") & is~call(.nil, .js~num("1.7976931348623157E+308"), "1.7976931348623157e308") & -
+  is~call(.nil, .js~num("0"), "0") & is~call(.nil, .js~num("-0"), "-0") & is~call(.nil, .js~num("0E+999"), "0")
+call check ".js~box Double, Float, Number: the same errors", -
+  boxed("Double", "1E+999") == "too large" & boxed("Float", "1E-999") == "too small" & boxed("Number", "-1E+999") == "too large"
+
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+tonum: procedure                    -- .js~num(x) sent to JavaScript, or its condition
+  signal on syntax name bad
+  x = .fn~call(.nil, "x", "return typeof x")~call(.nil, .js~num(arg(1)))
+  return x
+bad: return "SYNTAX" condition("O")~code
+
+range: procedure                    -- .js~num(x): "too large", "too small", or what else happened
+  return boxed("", arg(1))
+
+boxed: procedure                    -- .js~box(type, x), or .js~num(x) if type is ""
+  use arg type, x
+  signal on syntax name boxbad
+  if type == "" then v = .js~num(x); else v = .js~box(type, x)
+  y = .fn~call(.nil, "x", "return typeof x")~call(.nil, v)
+  return "no error"
+boxbad:
+  c = condition("O")
+  if c~code \== "98.900" then return "SYNTAX" c~code
+  m = c~additional[1]
+  if pos("RangeError:", m) > 0 & pos("(too large)", m) > 0 then return "too large"
+  if pos("RangeError:", m) > 0 & pos("(too small:", m) > 0 then return "too small"
+  return m
+
+F: procedure                        -- F(params, body): a JavaScript function
+  return .fn~call(.nil, arg(1), arg(2))
+
+check: procedure
+  parse arg what, ok
+  if ok == 1 then do; .local~ok += 1; say "ok  " what; end
+  else do; .local~bad += 1; say "FAIL" what; end
+  return
+
+::requires "js.cls"
diff --git a/wasm/tests/js-proxy.rex b/wasm/tests/js-proxy.rex
new file mode 100644
index 0000000..c89f67e
--- /dev/null
+++ b/wasm/tests/js-proxy.rex
@@ -0,0 +1,127 @@
+/* js-proxy.rex: tests of Rexx objects in JavaScript (RexxProxy,           */
+/* wasm/js-realm.js), in the realm where Rexx runs: the worker's in the     */
+/* browser, Node's under Node.  Prints one line per check; exits 1 if any   */
+/* fails.                                                                   */
+.local~ok = 0; .local~bad = 0
+js = .js
+.local~fn = js~Function~new("args", "body", "return new Function(...args.split(','), body)")
+
+acct = .Account~new(100)
+
+typeOf = F("o", "return typeof o + ' ' + (o instanceof RexxProxy)")
+call check "a Rexx object is a RexxProxy in JavaScript", typeOf~call(.nil, acct) == "object true"
+call check "strings still go as strings", F("o", "return typeof o")~call(.nil, "abc") == "string"
+call check "numbers too (5 is an integer object inside Rexx)", F("o", "return typeof o")~call(.nil, 5) == "string"
+call check "Arrays still go as copies", F("o", "return Array.isArray(o) + ' ' + o.length")~call(.nil, .array~of(1, 2)) == "true 2"
+
+call check "direct call: o.deposit(50) sends DEPOSIT", F("o", "return o.deposit(50)")~call(.nil, acct) == 150
+call check "sendMessage(name, args)", F("o", "return o.sendMessage('deposit', [10])")~call(.nil, acct) == 160
+call check "sendMessage0..5", F("o", "return o.sendMessage0('balance') + '/' + o.sendMessage2('sum', 3, 4)")~call(.nil, acct) == "160/7"
+call check "a method with no result gives undefined", F("o", "return o.nothing() === undefined")~call(.nil, acct) == 1
+call check "arguments: JavaScript objects arrive as JSObjects", -
+  F("o", "return o.kindOf({a: 1}, [1], null, undefined, 5)")~call(.nil, acct) == "JSObject JSObject nil undefined 5"
+
+-- identity, both ways
+same = F("a, b", "return a === b")
+call check "identity: the same Rexx object is the same proxy", same~call(.nil, acct, acct) == 1
+keep = F("o", "globalThis.kept = o; return o")
+call check "round trip: the proxy comes back as the Rexx object", keep~call(.nil, acct) == acct
+call check "round trip later, from a JavaScript variable", js~kept == acct
+call check "kept and given again: still the same proxy", F("o", "return o === globalThis.kept")~call(.nil, acct) == 1
+
+-- the string
+call check "String(o) is the Rexx object's string", F("o", "return String(o) + '|' + `${o}`")~call(.nil, acct) == "an Account of 160|an Account of 160"
+call check "o.string() asks Rexx now", F("o", "return o.string()")~call(.nil, acct) == "an Account of 160"
+el = js~Object~new
+el["text"] = acct
+call check "a JavaScript property set to it holds the proxy", el["text"] == acct
+
+-- classes: JavaScript makes Rexx objects
+mk = F("C", "const a = C.new(7); return a.deposit(1)")
+call check "a class: C.new(7) in JavaScript", mk~call(.nil, .Account) == 8
+call check "a new object comes back as itself", F("C", "return C.new(3)")~call(.nil, .Account)~class == .Account
+
+-- conditions
+err = F("o", "try { o.deposit('lots'); return 'no error' } catch (e) { return e.name + ' ' + (e instanceof RexxError) + ' ' + e.message }")
+r = err~call(.nil, acct)
+call check "a condition is a RexxError", r~word(1) == "RexxError" & r~word(2) == "true" & r~pos("Error 41") > 0
+r = F("o", "try { o.noSuchMethod(); return 'no error' } catch (e) { return e.message }")~call(.nil, acct)
+call check "an unknown message is Error 97", r~pos("Error 97") > 0
+
+-- sendMessageScope
+s = .Savings~new(10)
+call check "the subclass's method", F("o", "return o.describe()")~call(.nil, s) == "savings 10"
+call check "sendMessageScope: from the superclass", F("o, C", "return o.sendMessageScope('describe', C)")~call(.nil, s, .Account) == "account 10"
+r = F("o", "try { o.sendMessageScope('describe', 'x'); return 'no error' } catch (e) { return e.name }")~call(.nil, s)
+call check "sendMessageScope: the scope must be a class", r == "TypeError"
+
+-- not a property bag; not a thenable
+r = F("o", "try { o.x = 1; return 'no error' } catch (e) { return e.name }")~call(.nil, acct)
+call check "setting a property is a TypeError", r == "TypeError"
+call check "not a thenable: a Promise of it resolves to it", js~Promise~resolve(acct)~await == acct
+call check "a function obtained twice is the same", F("o", "return o.deposit === o.deposit")~call(.nil, acct) == 1
+
+-- JavaScript keeps a list of Rexx objects and works with them
+list = js~newArray(.Account~new(5), .Account~new(1), .Account~new(3))
+sorted = F("l", "return l.sort((a, b) => a.balance() - b.balance()).map((a) => a.balance()).join(',')")
+call check "JavaScript sorts Rexx objects by a Rexx method", sorted~call(.nil, list) == "1,3,5"
+
+-- JavaScript calls on its own (a timer): on a thread of its own
+later = .Account~new(0)
+F("o", "setTimeout(() => o.deposit(42), 5)")~call(.nil, later)
+do 100 while later~balance == 0; call SysSleep 0.02; end
+call check "a timer calls a Rexx object's method", later~balance == 42
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+F: procedure                        -- F(params, body): a JavaScript function
+  return .fn~call(.nil, arg(1), arg(2))
+
+check: procedure
+  use arg name, ok
+  if ok then do; .local~ok += 1; say "ok   " name; end
+  else do; .local~bad += 1; say "FAIL " name; end
+  return
+
+::requires "js.cls"
+
+::class Account
+::attribute balance get
+::method init
+  expose balance
+  use strict arg balance
+::method deposit
+  expose balance
+  use strict arg amount
+  balance += amount
+  return balance
+::method sum
+  use arg a, b
+  return a + b
+::method nothing
+  return
+::method kindOf
+  out = ""
+  do i = 1 to arg()
+    a = arg(i)
+    select
+      when a~isA(.JSObject) then out ||= " JSObject"
+      when a == .nil then out ||= " nil"
+      when a == .js~undefined then out ||= " undefined"
+      otherwise out ||= " "a
+    end
+  end
+  return out~strip
+::method describe
+  expose balance
+  return "account" balance
+::method string
+  expose balance
+  return "an Account of" balance
+
+::class Savings subclass Account
+::method describe
+  expose balance
+  return "savings" self~balance
diff --git a/wasm/tests/qualify-node-cli.sh b/wasm/tests/qualify-node-cli.sh
index e1c1cd8..2820fd6 100755
--- a/wasm/tests/qualify-node-cli.sh
+++ b/wasm/tests/qualify-node-cli.sh
@@ -200,6 +200,222 @@ check "sockets: UDP between processes" '^reply=HELLO UDP$' -- \
 check "name resolution (host resolver)" '^localhost=1 127\.0\.0\.1$' '^invalid=0$' '^reverse=1 ' "^hostname=$(hostname)\$" '^hostid=[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' -- \
   "$X dns.rex"
 
+# --- JavaScript objects (js.cls, realm "node")
+mkdir -p "$T/node_modules/qmod"
+echo 'module.exports = { greet: (n) => "hi " + n, Counter: class { constructor() { this.n = 0 } inc() { return ++this.n } } };' \
+  > "$T/node_modules/qmod/index.js"
+echo 'export const twice = (x) => 2 * x;' > "$T/esm.mjs"
+cat > "$T/js.rex" <<'EOF'
+say .js .js~Math~max(3, 7) .js~process~platform
+q = .js~require("qmod"); say q~greet("rexx")
+c = q~Counter~new; c~inc; say "count="c~inc
+m = .js~import("./esm.mjs")~await; say "twice="m~twice(.js~num(21))
+fs = .js~require("node:fs"); say "exists="fs~existsSync("js.rex")
+say "await=".js~eval("new Promise(r => setTimeout(() => r('later'), 50))")~await
+signal on syntax; .js~JSON~parse("{")
+syntax: say "error="condition("O")~code condition("O")~additional[2]~name
+::requires "js.cls"
+EOF
+check "JavaScript objects: require (npm), import, await, errors" '^a JSObject \(global, node\) 7 ' '^hi rexx$' '^count=2$' \
+  '^twice=42$' '^exists=1$' '^await=later$' '^error=98\.900 SyntaxError$' -- "$X js.rex"
+
+# handlers: an HTTP server answered from Rexx (a synchronous handler, run on
+# its own thread as each request comes), a comparator for sort (run on the
+# thread that sorts); queued: several threads taking events, release; the
+# program's end ends the process although the server still listens
+cat > "$T/jsev.rex" <<'EOF'
+srv = .js~require("node:http")~createServer(.js~handler(.web~new, "request"))
+srv~listen(0, "127.0.0.1")
+do while srv~address == .nil; call SysSleep 0.05; end
+do i = 1 to 3
+  say .js~fetch("http://127.0.0.1:"srv~address~port"/q?i="i)~await~text~await
+end
+a = .js~newArray(.js~num(3), .js~num(1), .js~num(2)); a~sort(.js~handler(.web~new, "compare"))
+say "sorted="a~join(",")
+h = .js~handler(.nil, "string", "queued"); t = .js~setInterval(h, 5)
+w = .array~new; do i = 1 to 3; w[i] = .taker~new~start("take"); end
+n = 0; do i = 1 to 3; n += w[i]~result; end
+h~release; call SysSleep 0.05; say "taken="n "after release:" .js~nextEvent(0.2)
+::requires "js.cls"
+::class web
+::method request
+  use arg req, res
+  res~end("rexx answered" req~method req~url)
+::method compare
+  use arg x, y
+  return .js~num(x - y)
+::class taker
+::method take
+  n = 0; do 5; if .js~nextEvent(5) \== .nil then n += 1; end
+  return n
+EOF
+cat > "$T/jsover.rex" <<'EOF'
+m = .js~Map~new; m~set("a", 1); m~set("b", 2)
+do with index k item v over m; call charout , k"="v" "; end; say
+do with index i item v over .js~JSON~parse('["x","y"]'); call charout , i"="v" "; end; say
+do with index k item v over .js~JSON~parse('{"p":7}'); say k"="v; end
+signal on syntax; do x over .js~newObject; end
