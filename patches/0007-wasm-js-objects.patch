+    const p = _js_alloc(bytes.length + 1);
+    views();
+    HEAPU8.set(bytes, p);
+    _js_event(p, bytes.length);
+  }
+  Module['jsEvent'] = emit;
+
+  // a call of Rexx from the page (the page cannot wait): queued as an event,
+  // C "id" + the call; the answer, from web-js.cpp's pageCall, goes back to
+  // the page for the call's Promise
