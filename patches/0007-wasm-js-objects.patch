+  signal on syntax
+  use strict arg name
+  return JsGlobal(self~realm)["Reflect"]~js.invokeStrict("get", self, name)
+syntax: raise propagate
+::method js.setStrict unguarded    -- set or make the property name, exact
+  signal on syntax
