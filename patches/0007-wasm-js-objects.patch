+  function requireFromCwd(name) {
+    if (!nodeRequire) nodeRequire = require('node:module').createRequire;
+    return nodeRequire(require('node:path').join(process.cwd(), 'rexx-program.js'))(name);
+  }
+  const dynamicImport = new Function('s', 'return import(s)');
+  function importModule(name) {
+    if (isNode && /^\.{0,2}\//.test(name)) {
+      name = require('node:url').pathToFileURL(require('node:path').resolve(process.cwd(), name)).href;
+    }
+    return dynamicImport(name);
+  }
+
+  const PENDING = {};
+  let pending = null;
+  function run(op, r) {
+    while (r.more() && r.peek() === 'X') {
+      const [realm, id] = r.str().split('\t');
+      if (realm === REALM) release(Number(id));
+    }
+    switch (op) {
+      case 1: {                                   // GLOBAL realm
+        const realm = r.str();
+        if (realm === REALM) return globalThis;
+        throw new Error('there is no JavaScript realm "' + realm + '" here (this is realm "' + REALM + '")');
+      }
+      case 2: { const t = val(r), name = r.str(), args = val(r); return message(t, name, args); }
+      case 3: { const t = val(r), name = r.str(); return t[name]; }
+      case 4: { const t = val(r), name = r.str(), v = val(r); t[name] = v; return undefined; }
+      case 5: {
+        const t = val(r), upper = r.str(), v = val(r);
+        const name = resolve(t, upper);
+        if (name === undefined) {
+          throw new TypeError(an(className(t)) + ' has no property ' + upper +
+            ' (o["exactName"] = value creates one)');
+        }
+        t[name] = v;
+        return undefined;
+      }
+      case 6: {
+        const t = val(r), name = val(r), args = val(r);
+        if (name === null) {
+          if (typeof t !== 'function') throw new TypeError(an(className(t)) + ' is not a function');
+          return Reflect.apply(t, undefined, args);
+        }
+        const f = t[name];
+        if (typeof f !== 'function') throw new TypeError(name + ' is not a function');
+        return Reflect.apply(f, t, args);
+      }
+      case 7: { const t = val(r), args = val(r); return Reflect.construct(t, args); }
+      case 8: {
+        const t = val(r);
+        if (t === null || (typeof t !== 'object' && typeof t !== 'function') || typeof t.then !== 'function') return t;
+        pending = Promise.resolve(t);
+        return PENDING;
+      }
+      case 9: { const t = val(r), what = r.str(), arg = val(r); return info(t, what, arg); }
+      case 10: {
+        if (!isNode) throw new Error('require() is only available under Node');
+        return requireFromCwd(r.str());
+      }
+      case 11: return importModule(r.str());
+      case 12: return val(r);
+    }
+    throw new Error('unknown op ' + op);
+  }
+
+  function okReply(v) {
+    const w = new Writer();
+    w.rec('R', '');
+    if (v instanceof BytesForRexx) w.rec('S', v.b.slice());
+    else put(w, v);
+    return w.bytes();
+  }
+  function errReply(e) {
+    const w = new Writer();
+    let msg;
+    try {
+      msg = e instanceof Error || (e && typeof e === 'object' && 'message' in e && 'name' in e)
+        ? e.name + ': ' + e.message : String(e);
+    } catch (x) { msg = 'an exception'; }
+    w.rec('E', msg);
+    try { put(w, e); } catch (x) { w.rec('N', ''); }
+    return w.bytes();
+  }
+
+  // one request (the records after any X): its reply, now or later (a Promise)
+  function handleRequest(op, bytes) {
+    let v;
+    try { v = run(op, new Reader(bytes)); } catch (e) { return errReply(e); }
+    if (v === PENDING) {
+      const p = pending; pending = null;
+      return p.then((x) => okReply(x), (e) => errReply(e));
+    }
+    try { return okReply(v); } catch (e) { return errReply(e); }
+  }
+  // a reply for an error of the bridge itself (no thrown value)
+  function errorText(msg) {
+    const w = new Writer();
+    w.rec('E', msg); w.rec('N', '');
+    return w.bytes();
+  }
+
+  return { realm: REALM, handle: handleRequest, release, close, errorText, Reader };
+  };
+})();
