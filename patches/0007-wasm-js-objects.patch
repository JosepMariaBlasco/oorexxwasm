+
+// ready for JavaScript's own calls of Rexx (the server thread): for
+// synchronous handlers, overrides and proxies
+static void serverSetup(RexxThreadContext *c)
+{
+    static std::once_flag once;
+    jsInstance = c->instance;
+    // the stack of a Rexx thread (std::thread's default, 64 KiB, overflows
+    // silently: WebAssembly has no guard page)
+    std::call_once(once, [] {
+        pthread_attr_t attr;
+        pthread_attr_init(&attr);
+        pthread_attr_setstacksize(&attr, 8 * 1024 * 1024);
+        pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+        pthread_t t;
+        pthread_create(&t, &attr, serverMain, NULL);
+        pthread_attr_destroy(&attr);
+    });
+    while (__atomic_load_n(&serverThread, __ATOMIC_SEQ_CST) == 0) emscripten_futex_wait(&serverThread, 0, 10.0);
+}
+
+// JsSyncSetup(): ready for synchronous handlers
+RexxRoutine0(int, JsSyncSetup)
+{
+    serverSetup(context->threadContext);
+    return 0;
+}
