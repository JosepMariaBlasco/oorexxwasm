+} // extern "C"
+
+enum JsOp
+{
+    OP_GLOBAL = 1,      // realm                       -> its globalThis
+    OP_MESSAGE = 2,     // target, NAME, args          -> the Rexx message NAME
+    OP_GET = 3,         // target, name                -> target[name]
+    OP_SET = 4,         // target, name, value         -> target[name] = value
+    OP_SETMESSAGE = 5,  // target, NAME, value         -> the Rexx message NAME=
+    OP_CALL = 6,        // target, name, args          -> target[name](...args), or target(...args)
+    OP_NEW = 7,         // target, args                -> new target(...args)
+    OP_AWAIT = 8,       // target                      -> the settled value
+    OP_INFO = 9,        // target, what, arg           -> typeof, class, keys, ...
+    OP_REQUIRE = 10,    // name                        -> require(name) (Node)
+    OP_IMPORT = 11,     // name                        -> import(name), a Promise
+    OP_VALUE = 12,      // value                       -> the value as JavaScript has it
+};
+
+// ---- records ----------------------------------------------------------------
+
+struct Rec { char tag; std::string data; };
+
+static bool nextRec(const std::string &s, size_t &pos, Rec &rec)
+{
+    if (pos >= s.size()) return false;
+    rec.tag = s[pos++];
+    size_t colon = s.find(':', pos);
+    if (colon == std::string::npos) { pos = s.size(); return false; }
+    size_t len = strtoul(s.substr(pos, colon - pos).c_str(), NULL, 10);
+    rec.data = s.substr(colon + 1, len);
+    pos = colon + 1 + len;
+    return true;
+}
+
+static void putRec(std::string &s, char tag, const std::string &data)
+{
+    s += tag;
+    s += std::to_string(data.size());
+    s += ':';
+    s += data;
+}
+
+// pass a request to the main runtime thread and wait for the reply
+static std::string jsCall(int op, const std::string &data)
+{
+    JsRequest req = {};
+    req.op = op;
+    req.data = data.data();
+    req.dataLen = (int32_t)data.size();
+    if (!emscripten_proxy_sync_with_ctx(emscripten_proxy_get_system_queue(),
+                                        emscripten_main_runtime_thread_id(), jsOnMain, &req))
+    {
+        std::string r;
+        putRec(r, 'E', "the JavaScript realm is not reachable");
+        putRec(r, 'N', "");
+        return r;
+    }
+    std::string r(req.reply ? req.reply : "", req.replyLen);
+    free(req.reply);
+    return r;
+}
+
+
+static RexxObjectPtr jsObjectClass = NULLOBJECT;    // .JSObject, see JsSetup()
+static RexxObjectPtr jsTypedClass = NULLOBJECT;     // .JSTyped: .js~num(x) and friends
+static RexxObjectPtr jsUndefined = NULLOBJECT;      // .js~undefined, the one object
+static RexxObjectPtr jsHandlerClass = NULLOBJECT;   // .JSHandler: .js~handler(obj, msg)
+static RexxObjectPtr jsEventClass = NULLOBJECT;     // .JSEvent: what .js~nextEvent gives
+
+// ---- events -------------------------------------------------------------------
+
+static std::mutex eventLock;                        // guards everything below
+static std::condition_variable eventCond;
+static std::deque<std::string> events;              // H id + A args, as JavaScript sent them
+static std::map<size_t, RexxObjectPtr> pinned;      // handler id -> its .JSHandler (a global reference)
+static size_t lastHandlerId = 0;
+static size_t stopGeneration = 0;                   // .js~stopEventLoop ends the loops started before
+
+static void dropEvent(const std::string &ev);
+
+// the handler id of an event, whether it has option latest ("id<tab>L"),
+// and its option max n ("id<tab>Mn", 0 when none)
+static size_t eventHandler(const std::string &ev, bool *latest = NULL, size_t *max = NULL)
+{
+    if (ev.empty() || ev[0] != 'H') return 0;
+    size_t colon = ev.find(':'), len = strtoul(ev.c_str() + 1, NULL, 10);
+    std::string d = ev.substr(colon + 1, len);
+    if (latest) *latest = d.size() > 2 && d.compare(d.size() - 2, 2, "\tL") == 0;
+    if (max)
+    {
+        size_t t = d.find("\tM");
+        *max = t == std::string::npos ? 0 : strtoul(d.c_str() + t + 2, NULL, 10);
+    }
+    return strtoul(d.c_str(), NULL, 10);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void js_event(char *data, int len)
+{
+    std::string ev(data, len), old;
+    free(data);
+    bool latest = false;
+    size_t max = 0;
+    size_t id = eventHandler(ev, &latest, &max);
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        bool replaced = false;
+        if (pinned.find(id) == pinned.end())    // released: nobody will take it
+        {
+            old.swap(ev);
+            replaced = true;
+        }
+        else if (latest)       // option latest: one waiting event per handler, the newest
+        {
+            for (std::string &q : events)
+            {
+                if (eventHandler(q) == id) { old.swap(q); q = std::move(ev); replaced = true; break; }
+            }
+        }
+        else if (max > 0)      // option max n: drop the handler's oldest when n wait
+        {
+            size_t waiting = 0;
+            for (const std::string &q : events) if (eventHandler(q) == id) waiting++;
+            if (waiting >= max)
+            {
+                for (auto it = events.begin(); it != events.end(); ++it)
+                {
+                    if (eventHandler(*it) == id) { old.swap(*it); events.erase(it); break; }
+                }
+            }
+        }
+        if (!replaced) events.push_back(std::move(ev));
+    }
+    if (!old.empty()) dropEvent(old);
+    eventCond.notify_all();
+}
+
+// handles whose .JSObject went away (UNINIT), released with the next request
+static std::mutex releaseLock;
+static std::vector<std::string> released;
+
+static std::string newRequest()
+{
+    std::string s;
+    std::lock_guard<std::mutex> lock(releaseLock);
+    for (const std::string &r : released) putRec(s, 'X', r);
+    released.clear();
+    return s;
+}
+
+// build the Rexx object for the value record at pos
+static RexxObjectPtr toRexx(RexxThreadContext *c, const std::string &s, size_t &pos)
+{
+    Rec r;
+    if (!nextRec(s, pos, r)) return c->Nil();
+    switch (r.tag)
+    {
+        case 'S': return c->String(r.data.data(), r.data.size());
+        case 'U': return jsUndefined != NULLOBJECT ? jsUndefined : c->Nil();
+        case 'O':
+        {
+            size_t t1 = r.data.find('\t'), t2 = r.data.find('\t', t1 + 1);
+            if (jsObjectClass == NULLOBJECT || t1 == std::string::npos || t2 == std::string::npos)
+            {
+                return c->String(r.data.c_str());
+            }
+            RexxArrayObject args = c->ArrayOfThree(c->String(r.data.substr(0, t1).c_str()),
+                                                   c->String(r.data.substr(t1 + 1, t2 - t1 - 1).c_str()),
+                                                   c->String(r.data.substr(t2 + 1).c_str()));
+            return c->SendMessage(jsObjectClass, "NEW", args);
+        }
+        case 'A':
+        {
+            size_t n = strtoul(r.data.c_str(), NULL, 10);
+            RexxArrayObject a = c->NewArray(n);
+            for (size_t i = 1; i <= n; i++) c->ArrayPut(a, toRexx(c, s, pos), i);
+            return a;
+        }
+        default: return c->Nil();
+    }
+}
+
+static bool isA(RexxThreadContext *c, RexxObjectPtr v, RexxObjectPtr cls)
+{
+    return cls != NULLOBJECT && c->IsInstanceOf(v, (RexxClassObject)cls);
+}
+
+// encode a Rexx value for JavaScript
+static void fromRexx(RexxThreadContext *c, std::string &out, RexxObjectPtr v, int depth = 0)
+{
+    if (v == NULLOBJECT) { putRec(out, 'U', ""); return; }
+    if (v == c->Nil()) { putRec(out, 'N', ""); return; }
+    if (depth > 64) { putRec(out, 'N', ""); return; }        // a cycle: cut it
+    if (isA(c, v, jsObjectClass))
+    {
+        putRec(out, 'O', c->ObjectToStringValue(c->SendMessage0(v, "JSREF")));
+        return;
+    }
+    if (isA(c, v, jsHandlerClass))
+    {
+        size_t id = 0;
+        c->ObjectToStringSize(c->SendMessage0(v, "ID"), &id);
+        std::string options = c->ObjectToStringValue(c->SendMessage0(v, "OPTIONS"));
+        {
+            std::lock_guard<std::mutex> lock(eventLock);
+            if (pinned.find(id) == pinned.end()) pinned[id] = c->RequestGlobalReference(v);
+        }
+        putRec(out, 'H', std::to_string(id) + "\t" + options);
+        return;
+    }
+    if (isA(c, v, jsTypedClass))
+    {
+        std::string kind = c->ObjectToStringValue(c->SendMessage0(v, "KIND"));
+        RexxObjectPtr val = c->SendMessage0(v, "VALUE");
+        std::string data = val == NULLOBJECT || val == c->Nil() ? "" : c->ObjectToStringValue(val);
+        putRec(out, kind.empty() ? 'U' : kind[0], data);
+        return;
+    }
+    if (c->IsArray(v))
+    {
+        size_t size = c->ArraySize((RexxArrayObject)v);
+        putRec(out, 'A', std::to_string(size));
+        for (size_t i = 1; i <= size; i++) fromRexx(c, out, c->ArrayAt((RexxArrayObject)v, i), depth + 1);
+        return;
+    }
+    if (c->IsDirectory(v) || c->IsStringTable(v))
+    {
+        RexxArrayObject keys = (RexxArrayObject)c->SendMessage0(v, "ALLINDEXES");
+        size_t n = c->ArrayItems(keys);
+        putRec(out, 'T', std::to_string(n));
+        for (size_t i = 1; i <= n; i++)
+        {
+            RexxObjectPtr k = c->ArrayAt(keys, i);
+            putRec(out, 'K', c->ObjectToStringValue(k));
+            fromRexx(c, out, c->SendMessage1(v, "AT", k), depth + 1);
+        }
+        return;
+    }
+    if (c->IsString(v))
+    {
+        RexxStringObject str = (RexxStringObject)v;
+        putRec(out, 'S', std::string(c->StringData(str), c->StringLength(str)));
+        return;
+    }
+    putRec(out, 'S', c->ObjectToStringValue(v));
+}
+
+// the result of a reply: its value, or a raised SYNTAX 98.900 condition
+static RexxObjectPtr result(RexxThreadContext *c, const std::string &reply)
+{
+    size_t pos = 0;
+    Rec r;
+    if (!nextRec(reply, pos, r)) return c->Nil();
+    if (r.tag == 'R') return toRexx(c, reply, pos);
+    // E: the message, then the thrown value (a .JSObject for an Error)
+    std::string msg = "JavaScript error: " + r.data;
+    RexxObjectPtr thrown = toRexx(c, reply, pos);
+    c->RaiseException(Rexx_Error_Execution_user_defined, c->ArrayOfTwo(c->String(msg.c_str()), thrown));
+    return NULLOBJECT;
+}
+
+static RexxObjectPtr request(RexxThreadContext *c, int op, const std::string &data)
+{
+    return result(c, jsCall(op, data));
+}
+
+// the target record of a method: this .JSObject
+static void target(RexxMethodContext *context, std::string &out)
+{
+    RexxObjectPtr ref = context->GetObjectVariable("JSREF");
+    putRec(out, 'O', ref == NULLOBJECT ? "" : context->ObjectToStringValue(ref));
+}
+
+static void args(RexxThreadContext *c, std::string &out, RexxArrayObject list, size_t from)
+{
+    size_t size = list == NULLOBJECT ? 0 : c->ArraySize(list);
+    size_t n = size >= from ? size - from + 1 : 0;
+    putRec(out, 'A', std::to_string(n));
+    for (size_t i = from; i <= size; i++) fromRexx(c, out, c->ArrayAt(list, i));
+}
+
+
+// ---- .JSObject's methods -------------------------------------------------------
+
+// UNKNOWN: o~name, o~name(args), o~name = value
+RexxMethod2(RexxObjectPtr, js_unknown, CSTRING, name, RexxArrayObject, list)
+{
+    RexxThreadContext *c = context->threadContext;
+    std::string n(name), s = newRequest();
+    target(context, s);
+    if (n.size() > 1 && n.back() == '=')
+    {
+        putRec(s, 'S', n.substr(0, n.size() - 1));
+        fromRexx(c, s, c->ArraySize(list) >= 1 ? c->ArrayAt(list, 1) : NULLOBJECT);
+        request(c, OP_SETMESSAGE, s);
+        return NULLOBJECT;
+    }
+    putRec(s, 'S', n);
+    args(c, s, list, 1);
+    return request(c, OP_MESSAGE, s);
+}
+
+// [](name): the property, case-exact
+RexxMethod1(RexxObjectPtr, js_get, RexxObjectPtr, name)
+{
+    std::string s = newRequest();
+    target(context, s);
+    putRec(s, 'S', context->ObjectToStringValue(name));
+    return request(context->threadContext, OP_GET, s);
+}
+
+// []=(value, name): set the property, case-exact (created if need be)
+RexxMethod2(RexxObjectPtr, js_put, OPTIONAL_RexxObjectPtr, value, RexxObjectPtr, name)
+{
+    std::string s = newRequest();
+    target(context, s);
+    putRec(s, 'S', context->ObjectToStringValue(name));
+    fromRexx(context->threadContext, s, value);
+    request(context->threadContext, OP_SET, s);
+    return NULLOBJECT;
+}
+
+// INVOKE(name, args...): call method name, case-exact; INVOKE(.nil, args...): call this function
+RexxMethod1(RexxObjectPtr, js_call, ARGLIST, list)
+{
+    RexxThreadContext *c = context->threadContext;
+    if (c->ArraySize(list) < 1 || c->ArrayAt(list, 1) == NULLOBJECT)
+    {
+        context->RaiseException1(Rexx_Error_Incorrect_method_minarg, context->WholeNumberToObject(1));
+        return NULLOBJECT;
+    }
+    std::string s = newRequest();
+    target(context, s);
+    RexxObjectPtr name = c->ArrayAt(list, 1);
+    if (name == c->Nil()) putRec(s, 'N', "");
+    else putRec(s, 'S', context->ObjectToStringValue(name));
+    args(c, s, list, 2);
+    return request(c, OP_CALL, s);
+}
+
+// NEW(args...): new this(...args)
+RexxMethod1(RexxObjectPtr, js_new, ARGLIST, list)
+{
+    std::string s = newRequest();
+    target(context, s);
+    args(context->threadContext, s, list, 1);
+    return request(context->threadContext, OP_NEW, s);
+}
+
+// AWAIT: wait for this Promise (or thenable); its value, or its rejection as an error
+RexxMethod0(RexxObjectPtr, js_await)
+{
+    std::string s = newRequest();
+    target(context, s);
+    return request(context->threadContext, OP_AWAIT, s);
+}
+
+// introspection: TYPEOF, CLASSNAME, PROPERTYNAMES, MAKEARRAY, SUPPLIER (its data), BYTESTRING,
+// INSTANCEOF(c), HASPROPERTY(n)
+static RexxObjectPtr info(RexxMethodContext *context, const char *what, RexxObjectPtr arg)
+{
+    std::string s = newRequest();
+    target(context, s);
+    putRec(s, 'S', what);
+    fromRexx(context->threadContext, s, arg);
+    return request(context->threadContext, OP_INFO, s);
+}
+
+RexxMethod0(RexxObjectPtr, js_typeof)    { return info(context, "typeof", NULLOBJECT); }
+RexxMethod0(RexxObjectPtr, js_classname) { return info(context, "class", NULLOBJECT); }
+RexxMethod0(RexxObjectPtr, js_keys)      { return info(context, "keys", NULLOBJECT); }
+RexxMethod0(RexxObjectPtr, js_makearray) { return info(context, "array", NULLOBJECT); }
+RexxMethod0(RexxObjectPtr, js_supplier)  { return info(context, "supplier", NULLOBJECT); }
+RexxMethod0(RexxObjectPtr, js_bytes)     { return info(context, "bytes", NULLOBJECT); }
+RexxMethod1(RexxObjectPtr, js_instanceof, RexxObjectPtr, cls) { return info(context, "instanceof", cls); }
+RexxMethod1(RexxObjectPtr, js_has, RexxObjectPtr, name)       { return info(context, "has", name); }
