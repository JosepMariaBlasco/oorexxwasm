+/** A JavaScript object (or function, array, Promise, symbol) of a realm. */
+::class JSObject public
+::method jsExtension class          -- the JavaScript class of this class (.js~extend), or .nil
+  expose jsextension                -- (kept in the class itself: nothing else holds the class)
+  if var("JSEXTENSION") then return jsextension
+  return .nil
+::method jsSetExtension class       -- for .js~extend
+  expose jsextension
+  use strict arg jsextension
+::method extensionOf class          -- the JavaScript class of a class or of a superclass, or .nil
+  use strict arg cls
+  do while cls \== .JSObject, cls~isSubclassOf(.JSObject)
+    ext = cls~jsExtension
+    if ext \== .nil then return ext
+    cls = cls~superClass
+  end
+  return .nil
+::method init
+  expose jsref jsrealm jsdisplay jsuninit
+  if self~class \== .JSObject then do
+    ext = .JSObject~extensionOf(self~class)
+    if ext \== .nil then do        -- .MyClass~new(args...): new MyClass(...args) in JavaScript
+      -- a pair (see Classes above): its class's UNINIT runs when the pair is
+      -- over (jsFinal), not when Rexx no longer holds it
+      jsuninit = self~instanceMethod("UNINIT")
+      if jsuninit == .JSObject~method("UNINIT") then jsuninit = .nil
+      self~setMethod("UNINIT", "nop")         -- (an object's own UNINIT cannot be removed)
+      signal on syntax
+      self~jsBind(JsConstruct(self, ext, arg(1, "A")))
+      self~jsArm
+      return
+    end
+  end
+  use strict arg jsrealm, id, jsdisplay
+  jsref = jsrealm || "09"x || id
+  return
+syntax: raise propagate
+::method jsBind unguarded           -- for the bridge: the JavaScript object of an extending class's instance
+  expose jsref jsrealm jsdisplay
+  use strict arg ref
+  if var("JSREF") then return
+  parse var ref realm "09"x id "09"x display
+  jsdisplay = display
+  jsrealm = realm
+  jsref = realm || "09"x || id
+::method jsArm unguarded            -- for the bridge: a new sentinel for a pair's Rexx object (Rexx holds it)
+  expose jssentinel
+  jssentinel = .JSPeerSentinel~new(self, JsPeerArm(self))
+  return self
+::method jsFinal unguarded          -- for the bridge: a pair is over: its class's UNINIT, and the handle
+  expose jsuninit jssentinel
+  drop jssentinel
+  if var("JSUNINIT") then if jsuninit \== .nil then do
+    u = jsuninit
+    drop jsuninit
+    signal on syntax
+    -- sent with its class as the scope: it then runs in that scope (it sees
+    -- the variables of that class), the object's "nop" is passed over, and a
+    -- method of the class named RUN is not in the way (self~run(u) had both
+    -- problems; setMethod(name, u, "OBJECT") would run it in the scope of the
+    -- object's class, not of a superclass that defines it)
+    .Message~new(self, .array~of("UNINIT", u~scope))~send
+  end
+syntax:
+  self~jsRelease
+::method jsRelease unguarded external "LIBRARY js js_uninit"
+::method jsRef                      -- realm<tab>id, for the bridge
+  expose jsref
+  return jsref
+::method realm                      -- worker, node (page)
+  expose jsrealm
+  return jsrealm
+::method string                     -- a JSObject (HTMLDivElement #12, worker)
+  expose jsdisplay jsrealm
+  return "a JSObject ("jsdisplay"," jsrealm")"
+::method "=="                       -- the same JavaScript object
+  expose jsref
+  use strict arg other
+  if \other~isA(.JSObject) then return .false
+  return other~jsRef == jsref
+::method "\=="
+  use strict arg other
+  return \(self == other)
+::method "="
+  forward message "=="
+::method "\="
+  forward message "\=="
+::method "<>"
+  forward message "\=="
+::method "><"
+  forward message "\=="
+::method hashCode
+  expose jsref
+  return jsref~hashCode
+::method unknown unguarded          external "LIBRARY js js_unknown"
+::method "[]" unguarded             external "LIBRARY js js_get"
+::method "[]=" unguarded            external "LIBRARY js js_put"
+::method at unguarded               external "LIBRARY js js_get"   -- AT is [] in Rexx
+::method put unguarded              external "LIBRARY js js_put"   -- PUT is []=
