+// ---- routines for js.cls ------------------------------------------------------------
+
+// JsSetup(.JSObject, .JSTyped, .JSHandler, .JSEvent, .js~undefined)
+RexxRoutine5(int, JsSetup, RexxObjectPtr, objectClass, RexxObjectPtr, typedClass,
+             RexxObjectPtr, handlerClass, RexxObjectPtr, eventClass, RexxObjectPtr, undefinedValue)
+{
+    if (jsUndefined == NULLOBJECT) jsUndefined = context->RequestGlobalReference(undefinedValue);
+    if (jsObjectClass == NULLOBJECT) jsObjectClass = context->RequestGlobalReference(objectClass);
+    if (jsTypedClass == NULLOBJECT) jsTypedClass = context->RequestGlobalReference(typedClass);
+    if (jsHandlerClass == NULLOBJECT) jsHandlerClass = context->RequestGlobalReference(handlerClass);
+    if (jsEventClass == NULLOBJECT) jsEventClass = context->RequestGlobalReference(eventClass);
+    return 0;
+}
+
+// JsHandlerId(): a new handler id
+RexxRoutine0(size_t, JsHandlerId)
+{
+    std::lock_guard<std::mutex> lock(eventLock);
+    return ++lastHandlerId;
+}
+
+// JsHandlerRelease(id): unpin it; its events still waiting, and those that
+// come later, are dropped (passed to JavaScript again, it starts afresh)
+RexxRoutine1(int, JsHandlerRelease, size_t, id)
+{
+    RexxObjectPtr h = NULLOBJECT;
+    std::vector<std::string> gone;
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        auto it = pinned.find(id);
+        if (it != pinned.end()) { h = it->second; pinned.erase(it); }
+        for (auto q = events.begin(); q != events.end(); )
+        {
+            if (eventHandler(*q) == id) { gone.push_back(std::move(*q)); q = events.erase(q); }
+            else ++q;
+        }
+    }
+    for (const std::string &ev : gone) dropEvent(ev);
+    if (h != NULLOBJECT) context->ReleaseGlobalReference(h);
+    return 0;
+}
+
+// the objects handed over with an event nobody will get: released
+static void dropEvent(const std::string &ev)
+{
+    size_t pos = 0;
+    Rec r;
+    std::lock_guard<std::mutex> lock(releaseLock);
+    while (nextRec(ev, pos, r))
+    {
+        if (r.tag != 'O') continue;
+        size_t t1 = r.data.find('\t'), t2 = r.data.find('\t', t1 + 1);
+        if (t1 != std::string::npos) released.push_back(r.data.substr(0, t2));
+    }
+}
+
+// JsLoopGeneration(): for JsNextEvent's stop check
+RexxRoutine0(size_t, JsLoopGeneration)
+{
+    std::lock_guard<std::mutex> lock(eventLock);
+    return stopGeneration;
+}
+
+// JsStopLoops(): every JsNextEvent waiting with an older generation returns .nil
+RexxRoutine0(int, JsStopLoops)
+{
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        stopGeneration++;
+    }
+    eventCond.notify_all();
+    return 0;
+}
+
+// JsNextEvent([seconds] [, generation]): the next event (a .JSEvent), or .nil
+// when the seconds are over (none: no limit) or, given a generation, when
+// JsStopLoops was called since
+RexxRoutine2(RexxObjectPtr, JsNextEvent, OPTIONAL_double, seconds, OPTIONAL_RexxObjectPtr, gen)
+{
+    size_t generation = 0;
+    bool loop = gen != NULLOBJECT && context->ObjectToStringSize(gen, &generation);
+    bool forever = argumentOmitted(1) || seconds < 0;
+    auto deadline = std::chrono::steady_clock::now() +
+        std::chrono::microseconds(forever ? 0 : (long long)(seconds * 1e6));
+    for (;;)
+    {
+        std::string ev;
+        RexxObjectPtr handler = NULLOBJECT;
+        {
+            std::unique_lock<std::mutex> lock(eventLock);
+            auto ready = [&] { return !events.empty() || (loop && stopGeneration != generation); };
+            if (forever) eventCond.wait(lock, ready);
+            else if (!eventCond.wait_until(lock, deadline, ready)) return context->Nil();
+            if (loop && stopGeneration != generation) return context->Nil();
+            ev = std::move(events.front());
+            events.pop_front();
+            size_t pos = 0;
+            Rec r;
+            if (nextRec(ev, pos, r) && r.tag == 'H')
+            {
+                auto it = pinned.find(strtoul(r.data.c_str(), NULL, 10));
+                if (it != pinned.end()) handler = it->second;
+            }
+        }
+        if (handler == NULLOBJECT) { dropEvent(ev); continue; }     // released meanwhile
+        size_t pos = 0;
+        Rec r;
+        nextRec(ev, pos, r);                                       // H
+        RexxObjectPtr args = toRexx(context->threadContext, ev, pos);
+        return context->SendMessage2(jsEventClass, "NEW", handler, args);
+    }
+}
+
+// JsDefaultRealm(): "node" under Node, else "worker"
+RexxRoutine0(RexxObjectPtr, JsDefaultRealm)
+{
+    return context->String(js_is_node() ? "node" : "worker");
+}
