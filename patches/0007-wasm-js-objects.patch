+::method js.propertyNames unguarded    external "LIBRARY js js_keys"
+::method makeArray unguarded        external "LIBRARY js js_makearray"
+-- an array or typed array answers ITEMS, SIZE, DIMENSION, DIMENSIONS and
+-- HASINDEX as a Rexx Array; any other object, as before (its property or
+-- method of that name, through UNKNOWN)
+::method jsInfo private unguarded   external "LIBRARY js js_info"
