+// JsValue(value): the value converted to JavaScript (Arrays, Directories,
+// .js~num(...)) and back: a .JSObject for anything that is not a string
+RexxRoutine1(RexxObjectPtr, JsValue, OPTIONAL_RexxObjectPtr, value)
+{
+    std::string s = newRequest();
+    fromRexx(context->threadContext, s, value);
