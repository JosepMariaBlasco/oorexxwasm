+        if (t === '0' || t === 'false') return false;
+        throw new TypeError('"' + s() + '" is not a logical value');
+      }
+      case 'I': return BigInt(s().trim());
+      case 'Y': return d.slice();
+      case 'O': { const [realm, id] = s().split('\t'); return deref(realm, Number(id)); }
+      case 'H': return handlerFunction(s());
+      case 'A': {
+        const n = Number(s()), a = new Array(n);
+        for (let i = 0; i < n; i++) a[i] = val(r);
+        return a;
+      }
+      case 'T': {
+        const n = Number(s()), o = {};
+        for (let i = 0; i < n; i++) { const k = r.str(); o[k] = val(r); }
+        return o;
+      }
+      default: throw new Error('bad value record ' + tag);
+    }
+  }
