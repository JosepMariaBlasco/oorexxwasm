+      if (opt.size && e !== null && typeof e === 'object') {
+        try {
+          if (opt.has('preventDefault') && typeof e.preventDefault === 'function') e.preventDefault();
+          if (opt.has('stopPropagation') && typeof e.stopPropagation === 'function') e.stopPropagation();
+          if (opt.has('stopImmediatePropagation') && typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
+        } catch (x) { /* not an Event after all */ }
+      }
+      const w = new Writer();
+      w.rec('H', opt.has('latest') ? id + '\tL' : max ? id + '\tM' + max : id);
+      w.rec('A', String(args.length));
+      for (const a of args) { try { put(w, a); } catch (x) { w.rec('N', ''); } }
+      emit(w.bytes());
+      return undefined;
+    };
+    handlerFns.set(id, f);
+    return f;
+  }
+  function close() {
+    closed = true;
+    handlerFns.clear();
+    for (let i = 1; i < objs.length; i++) objs[i] = undefined;
+    ids.clear();
+  }
+
+  // ---- case-insensitive names --------------------------------------------
+  const nameCache = new WeakMap();
+  function namesOf(o, fresh) {
+    const cacheable = (typeof o === 'object' || typeof o === 'function') &&
+      !Array.isArray(o) && !ArrayBuffer.isView(o) &&
+      !(Object.getPrototypeOf(o) === Object.prototype || Object.getPrototypeOf(o) === null);
+    let m = cacheable && !fresh ? nameCache.get(o) : undefined;
+    if (m) return m;
+    m = new Map();
+    // an array's own names are its indexes (and length): an index is never resolved here
+    const keys = Array.isArray(o) ? ['length'] : ArrayBuffer.isView(o) ? [] : Reflect.ownKeys(o);
+    for (const k of keys) {
+      if (typeof k !== 'string') continue;
+      const u = k.toUpperCase();
+      const l = m.get(u);
+      if (l) l.push(k); else m.set(u, [k]);
+    }
+    if (cacheable) nameCache.set(o, m);
+    return m;
+  }
+  function resolve(t, upper) {
+    if (/^(0|[1-9][0-9]*)$/.test(upper)) return upper;          // an index
+    const o = Object(t);
+    for (const fresh of [false, true]) {
+      for (let p = o; p !== null && p !== undefined; p = Object.getPrototypeOf(p)) {
+        const l = namesOf(p, fresh).get(upper);
+        if (l) {
+          if (l.length === 1) return l[0];
+          // window.document and window.Document, location and Location, ...:
+          // the one in camelCase (the instance), not the interface
+          const lower = l.filter((n) => /^[a-z]/.test(n));
+          if (lower.length === 1) return lower[0];
+          throw new TypeError(upper + ' is ambiguous for a ' + className(t) + ': ' + l.join(', ') +
+            ' (use o["name"] or o~invoke("name", ...) with the exact name)');
+        }
+      }
+    }
+    return undefined;
+  }
+
+  // the Rexx message NAME(args) sent to t
+  function message(t, upper, args) {
+    const name = resolve(t, upper);
+    if (name === undefined) {
+      if (args.length) throw new TypeError(an(className(t)) + ' has no method ' + upper);
+      return undefined;
+    }
+    const v = t[name];
+    if (typeof v === 'function') {
+      // o~Map: the constructor itself (o~Map~new), not a call without new
+      if (args.length === 0 && /^[A-Z]/.test(name) && Object.prototype.hasOwnProperty.call(v, 'prototype')) return v;
+      return Reflect.apply(v, t, args);
