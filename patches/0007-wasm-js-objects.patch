+  const LOCAL = isNode ? 'node' : 'worker';
+  const dec = new TextDecoder('utf-8');
+
+  // the heap views, current: another thread may have grown the memory
+  const views = () => { if (typeof growMemViews === 'function') growMemViews(); };
+
+  // an event for the interpreter's queue (js_event frees the copy)
