+EMSCRIPTEN_KEEPALIVE void *js_alloc(int n)                 { return malloc(n); }
+EMSCRIPTEN_KEEPALIVE void  js_finish(em_proxying_ctx *ctx) { emscripten_proxy_finish(ctx); }
+
+void js_event(char *data, int len);
+
+static void jsOnMain(em_proxying_ctx *ctx, void *arg)
+{
+    js_bridge_call(ctx, (JsRequest *)arg);
+}
