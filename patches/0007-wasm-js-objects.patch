+      case 2: { const t = val(r, 'the target'), name = r.text('the name'), args = val(r, ARGS); return message(t, name, args); }
+      case 3: { const t = val(r, 'the target'), name = r.text('the name'); return t[slot(t, name)]; }
+      case 4: { const t = val(r, 'the target'), name = r.text('the name'), v = val(r, 'the value'); t[slot(t, name)] = v; return undefined; }
+      case 5: {
