+// JsConstruct(object, class, args): new class(...args) for this Rexx object,
+// a pair (see Classes above); "realm<tab>id<tab>display"
+RexxRoutine3(RexxObjectPtr, JsConstruct, RexxObjectPtr, self, RexxObjectPtr, ext, RexxArrayObject, list)
+{
+    RexxThreadContext *c = context->threadContext;
+    serverSetup(c);
+    size_t id;
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        id = ++lastHandlerId;
+        peerStates[id].obj = self;
+        peerIds[self] = id;
+    }
+    std::string s = newRequest();
+    fromRexx(c, s, ext);
+    putRec(s, 'S', std::to_string(id));
+    args(c, s, list, 1);
+    std::string reply = jsCall(c, OP_CONSTRUCT, s);
+    RexxObjectPtr r = result(c, reply);
+    bool ok = r != NULLOBJECT && c->IsString(r);
+    size_t h = 0;
+    if (ok)
+    {
+        std::string ref = c->ObjectToStringValue(r);    // realm<tab>h<tab>display
+        size_t t = ref.find('\t');
+        if (t != std::string::npos) h = strtoul(ref.c_str() + t + 1, NULL, 10);
+    }
+    std::lock_guard<std::mutex> lock(eventLock);
+    if (!ok)                                        // failed: no pair
+    {
+        peerStates.erase(id);
+        peerIds.erase(self);
+    }
+    else peerStates[id].h = h;
+    return r;
+}
+
+// JsPeerArm(object): a new sentinel's number (the object is held by Rexx)
+RexxRoutine1(size_t, JsPeerArm, RexxObjectPtr, self)
+{
+    std::lock_guard<std::mutex> lock(eventLock);
+    auto id = peerIds.find(self);
+    if (id == peerIds.end()) return 0;
+    PeerState &pe = peerStates[id->second];
+    pe.armed = pe.received;
+    return ++pe.sentinel;
+}
+
+// JsPeerUninit(object, sentinel): the sentinel's UNINIT, run when Rexx no
+// longer held the object; "KEEP": now only JavaScript holds it (pinned here,
+// weak there); "REARM": a crossing came meanwhile, so Rexx may hold it: a
+// new sentinel; "" for an old sentinel, or an object that is not a pair
+RexxRoutine2(RexxStringObject, JsPeerUninit, RexxObjectPtr, self, size_t, sentinel)
+{
+    RexxThreadContext *c = context->threadContext;
+    // (no API call with eventLock held: one may run UNINIT methods, on this
+    // thread, that need it; so the pin is made first, and dropped if unused)
+    RexxObjectPtr pin = c->RequestGlobalReference(self);
+    const char *answer = "";
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        auto id = peerIds.find(self);
+        if (id != peerIds.end())
+        {
+            PeerState &pe = peerStates[id->second];
+            if (sentinel != pe.sentinel || pe.js || pe.dead) answer = "";
+            else if (pe.received != pe.armed) answer = "REARM";
+            else
+            {
+                pe.pin = pin;
+                pin = NULLOBJECT;
+                pe.js = true;
+                std::lock_guard<std::mutex> l2(releaseLock);
+                weakens.push_back({id->second, pe.h, pe.received});
+                answer = "KEEP";
+            }
+        }
+    }
+    if (pin != NULLOBJECT) c->ReleaseGlobalReference(pin);
+    return c->String(answer);
+}
+
+// JsSuper(object, class (or its "realm<tab>id"), kind, name, args): the base's member (G get, S set,
+// C call), for self~name:super
+RexxRoutine5(RexxObjectPtr, JsSuper, RexxObjectPtr, self, RexxObjectPtr, ext, CSTRING, kind, CSTRING, name,
+             RexxArrayObject, list)
+{
+    RexxThreadContext *c = context->threadContext;
+    std::string s = newRequest();
+    fromRexx(c, s, self);
+    if (isA(c, ext, jsObjectClass)) fromRexx(c, s, ext);
+    else putRec(s, 'O', c->ObjectToStringValue(ext));      // its "realm<tab>id"
+    putRec(s, 'S', kind);
+    putRec(s, 'S', name);
+    args(c, s, list, 1);
+    return request(c, OP_SUPER, s);
+}
+
+
+// JsSession(object): (the browser) ooRexx.js's start() gets its session object
+RexxRoutine1(int, JsSession, RexxObjectPtr, session)
+{
+    RexxThreadContext *c = context->threadContext;
+    std::string s = newRequest();
+    fromRexx(c, s, session);
+    request(c, OP_SESSION, s);
+    return 0;
+}
+
+static RexxMethodEntry jsMethods[] =
+{
+    REXX_METHOD(js_unknown, js_unknown),
+    REXX_METHOD(js_get, js_get),
+    REXX_METHOD(js_put, js_put),
+    REXX_METHOD(js_call, js_call),
+    REXX_METHOD(js_new, js_new),
+    REXX_METHOD(js_await, js_await),
+    REXX_METHOD(js_typeof, js_typeof),
+    REXX_METHOD(js_classname, js_classname),
+    REXX_METHOD(js_keys, js_keys),
+    REXX_METHOD(js_makearray, js_makearray),
+    REXX_METHOD(js_supplier, js_supplier),
+    REXX_METHOD(js_bytes, js_bytes),
+    REXX_METHOD(js_instanceof, js_instanceof),
+    REXX_METHOD(js_has, js_has),
+    REXX_METHOD(js_info, js_info),
+    REXX_METHOD(js_uninit, js_uninit),
+    REXX_LAST_METHOD()
+};
+
+static RexxRoutineEntry jsRoutines[] =
+{
+    REXX_TYPED_ROUTINE(JsSetup, JsSetup),
+    REXX_TYPED_ROUTINE(JsDefaultRealm, JsDefaultRealm),
+    REXX_TYPED_ROUTINE(JsGlobal, JsGlobal),
+    REXX_TYPED_ROUTINE(JsRequire, JsRequire),
+    REXX_TYPED_ROUTINE(JsImport, JsImport),
+    REXX_TYPED_ROUTINE(JsValue, JsValue),
+    REXX_TYPED_ROUTINE(JsHandlerId, JsHandlerId),
+    REXX_TYPED_ROUTINE(JsSyncSetup, JsSyncSetup),
+    REXX_TYPED_ROUTINE(JsHandlerRelease, JsHandlerRelease),
+    REXX_TYPED_ROUTINE(JsLoopGeneration, JsLoopGeneration),
+    REXX_TYPED_ROUTINE(JsStopLoops, JsStopLoops),
+    REXX_TYPED_ROUTINE(JsNextEvent, JsNextEvent),
+    REXX_TYPED_ROUTINE(JsExtend, JsExtend),
+    REXX_TYPED_ROUTINE(JsConstruct, JsConstruct),
+    REXX_TYPED_ROUTINE(JsSuper, JsSuper),
+    REXX_TYPED_ROUTINE(JsPeerArm, JsPeerArm),
+    REXX_TYPED_ROUTINE(JsPeerUninit, JsPeerUninit),
+    REXX_TYPED_ROUTINE(JsSession, JsSession),
+    REXX_LAST_ROUTINE()
+};
+
+static RexxPackageEntry jsPackage =
+{
+    STANDARD_PACKAGE_HEADER
+    REXX_INTERPRETER_5_0_0,
+    "js",
+    "1.0.0",
+    NULL,
+    NULL,
+    jsRoutines,
+    jsMethods
+};
+
+// found by wasm/extra-packages.cpp
+extern "C" RexxPackageEntry *orx_wasm_js_package(void)
+{
+    return &jsPackage;
+}
