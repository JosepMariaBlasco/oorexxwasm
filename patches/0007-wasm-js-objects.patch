+++ b/wasm/tests/js-arrays.rex
@@ -0,0 +1,169 @@
+/* js-arrays.rex: the shape of a Rexx Array in JavaScript, in the realm     */
+/* where Rexx runs: the worker's in the browser, Node's under Node.  An     */
+/* Array goes as an array (a copy) and keeps its size, an empty slot being  */
+/* undefined; a multi-dimensional Array goes as arrays nested by dimension, */
+/* the first outermost (a 2x3 Array is an array of 2 arrays of 3).  A copy  */
+/* keeps the structure: an Array that contains itself is an array that      */
+/* contains itself, one that appears twice is one array (also through       */
+/* Directories and StringTables); more than 1000 deep is an error.          */
+/* Subclasses are copied too, read by SUPPLIER; .js~ref(x) is by reference. */
+/* Prints one line per check; exits 1 if any fails.                         */
+.local~ok = 0; .local~bad = 0
+.local~fn = .js~Function~new("args", "body", "return new Function(...args.split(','), body)")
+json = F("x", "return JSON.stringify(x)")
+-- an array's shape, with undefined (JSON would say null) and holes told apart
+shape = F("x", "const d = (x) => Array.isArray(x) ? '[' + Array.from({length: x.length}," -
+  "(_, i) => i in x ? d(x[i]) : '<hole>').join(',') + ']' : x === undefined ? 'u' : typeof x === 'string' ? x : typeof x + ':' + x;" -
+  "return d(x)")
+
+call check "a one-dimensional Array: an array", json~call(.nil, .array~of("a", "b")) == '["a","b"]'
+s = .array~new(4); s[1] = 1; s[3] = "x"
+call check "a sparse Array keeps its size; empty slots are undefined, not holes", shape~call(.nil, s) == "[1,u,x,u]"
+m = .array~new(2, 2); m[1, 1] = 1; m[2, 2] = 4
+call check "2x2: an array of 2 arrays of 2", shape~call(.nil, m) == "[[1,u],[u,4]]"
+m = .array~new(2, 3); m[1, 2] = "b"; m[2, 1] = "d"
+call check "2x3: the first dimension outermost (m[i, j] is a[i-1][j-1])", -
+  shape~call(.nil, m) == "[[u,b,u],[d,u,u]]" & F("a", "return a[0][1] + a[1][0]")~call(.nil, m) == "bd"
+c = .array~new(2, 2, 2)
+do i = 1 to 2; do j = 1 to 2; do k = 1 to 2; c[i, j, k] = i || j || k; end; end; end
+call check "2x2x2: three levels", json~call(.nil, c) == '[[["111","112"],["121","122"]],[["211","212"],["221","222"]]]'
+call check "a dimension of size 0: empty arrays", json~call(.nil, .array~new(2, 0)) == "[[],[]]"
+g = .array~new(2, 2); g[3, 1] = "z"
+call check "an Array that grew: its dimensions now (" g~dimensions~makeString("L", "x") ")", -
+  shape~call(.nil, g) == "[[u,u],[u,u],[z,u]]"
+d = .directory~new; d["m"] = .array~new(1, 2); d["m"][1, 2] = .js~true
+call check "inside a Directory, with a .Boolean item", json~call(.nil, d) == '{"m":[[null,true]]}'
+call check "inside an Array", shape~call(.nil, .array~of(m, "y")) == "[[[u,b,u],[d,u,u]],y]"
+call check "a JavaScript array of arrays comes back by reference", -
+  F("", "return [[1, 2], [3, 4]]")~call(.nil)~isA(.JSObject)
+
+-- copies keep the structure: cycles and sharing
+a = .array~of(1, 2); a~append(a)
+call check "an Array that contains itself: a[2] is a", F("x", "return x.length === 3 && x[2] === x")~call(.nil, a)
+b = .array~of(1); c = .array~of(2, b); b~append(c)
+call check "two Arrays that contain each other: b[1][1] is b", F("x", "return x[1][1] === x && x[1] !== x")~call(.nil, b)
+r = .array~of(1); s = .array~of(r); t = .array~of(s); r~append(t)
+call check "a longer cycle (3 Arrays)", F("x", "return x[1][0][0] === x")~call(.nil, r)
+x = .array~of(9)
+call check "an Array that appears twice is one array", F("v", "return v[0] === v[1] && v[0] !== v[2]")~call(.nil, .array~of(x, x, .array~of(9)))
+d = .directory~new; da = .array~of(d); d["a"] = da
+call check "a cycle through a Directory", F("v", "return v[0].a === v")~call(.nil, da)
+st = .stringtable~new; st["k"] = 1
+call check "a StringTable that appears twice is one object", F("v", "return v[0] === v[1] && v[0].k === '1'")~call(.nil, .array~of(st, st))
+m = .array~new(2, 2); m[1, 1] = m; m[2, 2] = x
+call check "a multi-dimensional Array that contains itself", F("v", "return v[0][0] === v && v[1][1][0] === '9'")~call(.nil, m)
+call check "each value sent is copied on its own (two arguments, two copies)", -
+  F("p, q", "return p !== q && p[0] === p[1]")~call(.nil, .array~of(x, x), .array~of(x, x)) & -
+  F("p, q", "return p !== q")~call(.nil, x, x)
+call check "a Rexx method's result keeps it too (RexxProxy)", -
+  F("o", "const v = o.sendMessage('SELF'); return v[2] === v")~call(.nil, .Holder~new)
+deep = .array~new; cur = deep; do 999; n = .array~new; cur~append(n); cur = n; end
+call check "1000 levels deep: copied", F("v", "let k = 1; while (v.length) { v = v[0]; k++; } return k")~call(.nil, deep) == 1000
+cur~append(.array~new)
+signal on syntax name s1
+y = F("v", "return 1")~call(.nil, deep)
+s1:
+call check "1001 levels deep: SYNTAX 98.900, a RangeError", condition("O")~code == "98.900" & -
+  pos("RangeError: Arrays, Directories or StringTables nested more than 1000 deep", condition("O")~additional[1]) > 0
+
+-- subclasses are copied too, read by SUPPLIER (and DIMENSIONS); .js~ref(x) is by reference
+call check "an Array subclass is copied (an array)", json~call(.nil, .MyArray~of("a", "b")) == '["a","b"]'
+m = .MyArray~new(2, 2); m[1, 1] = 1; m[2, 2] = 4
+call check "a 2x2 Array subclass is copied nested; a sparse one keeps its size", -
+  shape~call(.nil, m) == "[[1,u],[u,4]]" & shape~call(.nil, .MyArray~new(3)~~put("x", 2)) == "[u,x,u]"
+m = .MyArray~new(2, 3); m[1, 1] = "a"
+call check "trailing empty slots: a 2x3 subclass with only m[1,1]; an empty 2x3; size 4, items at 1 and 3", -
+  shape~call(.nil, m) == "[[a,u,u],[u,u,u]]" & shape~call(.nil, .MyArray~new(2, 3)) == "[[u,u,u],[u,u,u]]" & -
+  shape~call(.nil, .MyArray~new(4)~~put("x", 1)~~put("y", 3)) == "[x,u,y,u]"
+d = .MyDir~new; d["k"] = "v"; t = .MyTable~new; t["k"] = "w"
+call check "Directory and StringTable subclasses are copied (plain objects)", -
+  json~call(.nil, d) == '{"k":"v"}' & json~call(.nil, t) == '{"k":"w"}'
+u = .UpperDir~new; u["a"] = "x"
+call check "an AT of its own is not what the copy reads (Directory and Array subclasses)", -
+  json~call(.nil, u) == '{"a":"x"}' & json~call(.nil, .AngleArray~of("p", "q")) == '["p","q"]'
+call check "a SUPPLIER of its own is honoured (Directory and Array subclasses)", -
+  json~call(.nil, .OwnSupplierDir~new) == '{"k1":"v1"}' & shape~call(.nil, .OwnSupplierArray~new(3)) == "[one,u,three]"
+c = .ComputedDir~new; c["stored"] = 1
+call check "an entry a subclass only computes (UNKNOWN) is not copied", json~call(.nil, c) == '{"stored":"1"}'
+r = .directory~new
+f = F("x", "x.put('from JavaScript', 'k'); return typeof x.at + ' ' + (typeof x.sendMessage0)")
+call check ".js~ref(d): a RexxProxy, and what JavaScript changes is in d", -
+  f~call(.nil, .js~ref(r)) == "function function" & r["k"] == "from JavaScript"
+same = F("x, y", "return x === y")
+call check ".js~ref: the same object is the same RexxProxy; also an Array; back in Rexx, itself", -
+  same~call(.nil, .js~ref(r), .js~ref(r)) & F("x", "return x")~call(.nil, .js~ref(r)) == r & -
+  F("x", "return Array.isArray(x) ? 'copy' : 'ref'")~call(.nil, .js~ref(.array~of(1))) == "ref"
+
+-- JavaScript's arrays from Rexx, past the end: an array grows, as a Rexx
+-- Array; a typed array cannot, so reading or writing there is an error
+a = F("", "return ['a', 'b', 'c']")~call(.nil)
+r = a[4]; a[5] = "e"
+call check "an array grows: a[4] is .js~undefined, a[5] = v makes it 5 long", -
+  r == .js~undefined & a~length == 5 & a[5] == "e"
+t = F("", "return new Uint8Array([10, 20, 30])")~call(.nil)
+call check "a typed array cannot grow: reading, writing, PUT past its end are errors naming its positions", -
+  past(t, "r") == "position 4 is past the end of an Uint8Array of 3 elements (positions 1 to 3; a typed array cannot grow)" & -
+  past(t, "w") == past(t, "r") & past(t, "p") == past(t, "r") & t~length == 3 & t[3] == 30
+
+-- an array or typed array answers as a Rexx Array; other objects as before
+s = F("", "const a = ['a', 'b', 'c', 'd']; delete a[1]; return a")~call(.nil)
+call check "a sparse array: items 3, size 4, dimension 1, dimension(1) 4, dimension(2) 0, dimensions [4]", -
+  s~items == 3 & s~size == 4 & s~dimension == 1 & s~dimension(1) == 4 & s~dimension(2) == 0 & -
+  s~dimensions~items == 1 & s~dimensions[1] == 4
+call check "hasIndex: 1 yes, 2 (a hole) no, 4 yes, 0 and 5 no", -
+  s~hasIndex(1) & \s~hasIndex(2) & s~hasIndex(4) & \s~hasIndex(0) & \s~hasIndex(5)
+t = F("", "return new Uint8Array([10, 20, 30])")~call(.nil)
+call check "a typed array: items 3, size 3, dimensions [3], hasIndex(3), not hasIndex(4)", -
+  t~items == 3 & t~size == 3 & t~dimensions[1] == 3 & t~hasIndex(3) & \t~hasIndex(4)
+m = F("", "return new Map([['x', 1], ['y', 2]])")~call(.nil)
+o = F("", "return {items: 'mine', size: 7}")~call(.nil)
+call check "other objects as before: a Map's size 2; an object's own items and size", -
+  m~size == 2 & o~items == "mine" & o~size == 7
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+past: procedure                     -- t[4] (r), t[4] = 1 (w), t~put(1, 4) (p): the RangeError's message
+  use arg t, how
+  signal on syntax name pastbad
+  select
+    when how == "r" then x = t[4]
+    when how == "w" then t[4] = 1
+    otherwise t~put(1, 4)
+  end
+  return "no error"
+pastbad:
+  m = condition("O")~additional[1]
+  parse var m "RangeError: " msg
+  return msg
+
+F: procedure                        -- F(params, body): a JavaScript function
+  return .fn~call(.nil, arg(1), arg(2))
+
+check: procedure
+  parse arg what, ok
+  if ok == 1 then do; .local~ok += 1; say "ok  " what; end
+  else do; .local~bad += 1; say "FAIL" what; end
+  return
+
+::class MyArray subclass Array
+::class MyDir subclass Directory
+::class MyTable subclass StringTable
+::class UpperDir subclass Directory
+::method at; forward class (super) continue; return result~upper
+::class AngleArray subclass Array
+::method at; forward class (super) continue; return "<"result">"
+::class OwnSupplierDir subclass Directory
+::method supplier; return .supplier~new(.array~of("v1"), .array~of("k1"))
+::class OwnSupplierArray subclass Array
+::method supplier; return .supplier~new(.array~of("one", "three"), .array~of(1, 3))
+::class ComputedDir subclass Directory
+::method unknown; use arg name; if name == "COMPUTED" then return "made on demand"; forward class (super)
+
+::class Holder
+::method self
+  a = .array~of(1, 2); a~append(a)
+  return a
+
+::requires "js.cls"
diff --git a/wasm/tests/js-booleans.rex b/wasm/tests/js-booleans.rex
