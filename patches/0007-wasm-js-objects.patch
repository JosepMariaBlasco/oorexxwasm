+      let p = 0;
+      for (const x of this.parts) { out.set(x, p); p += x.length; }
+      return out;
+    }
+  }
+
+  // a value from Rexx
+  function val(r) {
+    const { tag, d } = r.rec();
+    const s = () => dec.decode(d);
+    switch (tag) {
+      case 'S': return s();
+      case 'N': return null;
+      case 'U': return undefined;
+      case 'F': {
+        const t = s().trim(), n = Number(t);
+        if (Number.isNaN(n) && !/^[+-]?nan$/i.test(t)) throw new TypeError('"' + s() + '" is not a number');
