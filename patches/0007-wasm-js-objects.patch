+    if (jsUndefined == NULLOBJECT) jsUndefined = context->RequestGlobalReference(undefinedValue);
+    if (jsObjectClass == NULLOBJECT) jsObjectClass = context->RequestGlobalReference(objectClass);
+    if (jsTypedClass == NULLOBJECT) jsTypedClass = context->RequestGlobalReference(typedClass);
