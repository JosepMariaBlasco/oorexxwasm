+  const WAITED = 'Error: JavaScript is waiting for this Rexx thread (a synchronous handler), ' +
+    'so it cannot wait for ';
+  // one request (see the JsRequest layout in wasm/web-js.cpp)
+  Module['jsCall'] = function (req) {
+    const finish = (bytes) => {
+      const p = _js_alloc(bytes.length + 1);
+      views();
