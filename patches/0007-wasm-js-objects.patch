+extern "C"
+{
+
+// Shared with wasm/js-bridge.js (byte offsets in comments).
+typedef struct
+{
+    int32_t     op;         //  0: see JsOp
+    const char *data;       //  4: the request records
+    int32_t     dataLen;    //  8: their length in bytes
+    char       *reply;      // 12: set by JavaScript: malloc'ed reply
+    int32_t     replyLen;   // 16: its length in bytes
+    int32_t     state;      // 20: REQ_WAITING, REQ_REPLIED (js_done), REQ_CALLBACK (js_sync_call)
+    int32_t     thread;     // 24: the requesting thread
+    void       *sync;       // 28: the SyncCall when REQ_CALLBACK
+} JsRequest;
+
+enum { REQ_WAITING = 0, REQ_REPLIED = 1, REQ_CALLBACK = 2, REQ_CALLS = 3 };   // REQ_CALLS: calls from the page wait
+
+// the main runtime thread takes the queued requests in a microtask
+EM_JS(void, js_schedule_drain, (void), {
+    queueMicrotask(() => Module['jsDrain']());
+});
+// ... or now, while it waits for a synchronous handler
+EM_JS(void, js_drain_now, (void), {
+    Module['jsDrain']();
+});
+
+// the default realm of this process, decided on the calling thread
+EM_JS(int, js_is_node, (void), {
+    return (typeof process !== 'undefined' && process.versions && process.versions.node) ? 1 : 0;
+});
+
+EMSCRIPTEN_KEEPALIVE void *js_alloc(int n)                 { return malloc(n); }
+EMSCRIPTEN_KEEPALIVE void  js_free(void *p)               { free(p); }
+
+// the reply is in place (JavaScript, on the main runtime thread)
+EMSCRIPTEN_KEEPALIVE void js_done(JsRequest *req)
+{
+    __atomic_store_n(&req->state, REQ_REPLIED, __ATOMIC_SEQ_CST);
+    emscripten_futex_wake(&req->state, INT_MAX);
+}
+
+void js_event(char *data, int len);
+
+static void kickMain(void *)
+{
+    js_schedule_drain();
+}
+
+} // extern "C"
+
+enum JsOp
+{
+    OP_GLOBAL = 1,      // realm                       -> its globalThis
+    OP_MESSAGE = 2,     // target, NAME, args          -> the Rexx message NAME
+    OP_GET = 3,         // target, name                -> target[name]
+    OP_SET = 4,         // target, name, value         -> target[name] = value
+    OP_SETMESSAGE = 5,  // target, NAME, value         -> the Rexx message NAME=
+    OP_CALL = 6,        // target, name, args          -> target[name](...args), or target(...args)
+    OP_NEW = 7,         // target, args                -> new target(...args)
+    OP_AWAIT = 8,       // target                      -> the settled value
+    OP_INFO = 9,        // target, what, arg           -> typeof, class, keys, ...
+    OP_REQUIRE = 10,    // name                        -> require(name) (Node)
+    OP_IMPORT = 11,     // name                        -> import(name), a Promise
+    OP_VALUE = 12,      // value                       -> the value as JavaScript has it
+    OP_EXTEND = 13,     // base, class name, NAMES, names -> [new class, its overrides]
+    OP_CONSTRUCT = 14,  // class, peer id, args        -> "realm<tab>id<tab>display"
+    OP_SUPER = 15,      // target, class, kind, name, args -> the base's member
+    OP_SESSION = 17,    // value                       -> (page) ooRexx.js's start() gets its session
+};
+
+// ---- records ----------------------------------------------------------------
+
+struct Rec { char tag; std::string data; };
+
+static bool nextRec(const std::string &s, size_t &pos, Rec &rec)
+{
+    if (pos >= s.size()) return false;
+    rec.tag = s[pos++];
+    size_t colon = s.find(':', pos);
+    if (colon == std::string::npos) { pos = s.size(); return false; }
+    size_t len = strtoul(s.substr(pos, colon - pos).c_str(), NULL, 10);
+    rec.data = s.substr(colon + 1, len);
+    pos = colon + 1 + len;
+    return true;
+}
+
+static void putRec(std::string &s, char tag, const std::string &data)
+{
+    s += tag;
+    s += std::to_string(data.size());
+    s += ':';
+    s += data;
+}
+
+// ---- transport and synchronous handlers -------------------------------------
+
+static std::mutex queueLock;
+static std::deque<JsRequest *> queued;              // requests for the main runtime thread
+
+extern "C" EMSCRIPTEN_KEEPALIVE JsRequest *js_next_request(void)
+{
+    std::lock_guard<std::mutex> lock(queueLock);
+    if (queued.empty()) return NULL;
+    JsRequest *req = queued.front();
+    queued.pop_front();
+    return req;
+}
+
+static int32_t selfId() { return (int32_t)(intptr_t)pthread_self(); }
+
+// one call of a synchronous handler: H + A records, then R/E records back
+struct SyncCall
+{
+    std::string call;
+    std::string answer;
+    int32_t state = 0;                              // 1: answered
+};
+
+static std::string runCallback(RexxThreadContext *c, const std::string &call);
+
+// the requests whose threads wait now (js_event wakes them for the page's
+// calls), and how many of those calls are queued
+static std::mutex waitersLock;
+static std::vector<JsRequest *> waiters;
+static int32_t queuedCalls = 0;
+static bool runQueuedCall(RexxThreadContext *c, std::exception_ptr &escaped);
+
+// runCallback, for a call JavaScript waits for: a condition of Rexx trapped
+// below this native code (SIGNAL ON in the code that called JavaScript)
+// unwinds through here; it must not leave JavaScript waiting, nor this
+// thread's request half done (JavaScript would write into it later).  So
+// the call answers an error, and the unwinding is kept in escaped, to go on
+// when the request this thread waits for is over
+static std::string runCallbackGuarded(RexxThreadContext *c, const std::string &call, std::exception_ptr &escaped)
+{
+    try
+    {
+        return runCallback(c, call);
+    }
+    catch (...)
+    {
+        if (!escaped) escaped = std::current_exception();
+        std::string out;
+        putRec(out, 'E', "Error: a condition of Rexx went past this call, to a trap of the code that called JavaScript");
+        return out;
+    }
+}
+
+static void answered(SyncCall *sc)
+{
+    __atomic_store_n(&sc->state, 1, __ATOMIC_SEQ_CST);
+    emscripten_futex_wake(&sc->state, INT_MAX);
+}
+
+// the RexxAPI's I/O thread (rexxapi/common/platform/unix/SysNodeConnection.cpp)
+extern "C" int orxNetIoStart();
+
+// pass a request to the main runtime thread and wait for the reply, running
+// the synchronous handlers JavaScript calls meanwhile
+static std::string jsCall(RexxThreadContext *c, int op, const std::string &data)
+{
+    // Under Node, the RexxAPI's sockets need an event loop that runs while
+    // the main runtime thread waits for a synchronous handler: their own
+    // thread's.  Starting it takes the main runtime thread, which is free
+    // now (the first request cannot come from a handler), but may not be
+    // when the handler needs the RexxAPI (a queue, any external call).
+    static int32_t ioReady = 0;
+    if (!__atomic_load_n(&ioReady, __ATOMIC_SEQ_CST))
+    {
+        orxNetIoStart();
+        __atomic_store_n(&ioReady, 1, __ATOMIC_SEQ_CST);
+    }
+    JsRequest req = {};
+    req.op = op;
+    req.data = data.data();
+    req.dataLen = (int32_t)data.size();
+    req.thread = selfId();
+    {
+        std::lock_guard<std::mutex> lock(queueLock);
+        queued.push_back(&req);
+    }
+    if (!emscripten_proxy_async(emscripten_proxy_get_system_queue(),
+                                emscripten_main_runtime_thread_id(), kickMain, NULL))
+    {
+        {
+            std::lock_guard<std::mutex> lock(queueLock);
+            for (auto it = queued.begin(); it != queued.end(); ++it) if (*it == &req) { queued.erase(it); break; }
+        }
+        std::string r;
+        putRec(r, 'E', "the JavaScript realm is not reachable");
+        putRec(r, 'N', "");
+        return r;
+    }
+    // while it waits, the thread runs the page's calls that come (the page
+    // cannot wait: what it called may be what this request waits for)
+    {
+        std::lock_guard<std::mutex> lock(waitersLock);
+        waiters.push_back(&req);
+    }
+    std::exception_ptr escaped;          // a condition on its way to a trap below (runCallbackGuarded)
+    for (;;)
+    {
+        int32_t s = __atomic_load_n(&req.state, __ATOMIC_SEQ_CST);
+        if (s == REQ_REPLIED) break;
+        if (s == REQ_CALLBACK)
+        {
+            SyncCall *sc = (SyncCall *)req.sync;
+            sc->answer = runCallbackGuarded(c, sc->call, escaped);
+            __atomic_store_n(&req.state, REQ_WAITING, __ATOMIC_SEQ_CST);
+            answered(sc);
+            continue;
+        }
+        if (s == REQ_CALLS)
+        {
+            int32_t expected = REQ_CALLS;
+            __atomic_compare_exchange_n(&req.state, &expected, REQ_WAITING, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+            continue;
+        }
+        if (__atomic_load_n(&queuedCalls, __ATOMIC_SEQ_CST) > 0 && runQueuedCall(c, escaped)) continue;
+        emscripten_futex_wait(&req.state, s, INFINITY);
+    }
+    {
+        std::lock_guard<std::mutex> lock(waitersLock);
+        for (auto it = waiters.begin(); it != waiters.end(); ++it) if (*it == &req) { waiters.erase(it); break; }
+    }
+    std::string r(req.reply ? req.reply : "", req.replyLen);
+    free(req.reply);
+    if (escaped) std::rethrow_exception(escaped);
+    return r;
+}
+
+
+static RexxObjectPtr jsObjectClass = NULLOBJECT;    // .JSObject, see JsSetup()
+static RexxObjectPtr jsTypedClass = NULLOBJECT;     // .JSTyped: .js~num(x) and friends
+static RexxObjectPtr jsUndefined = NULLOBJECT;      // .js~undefined, the one object
+static RexxObjectPtr jsHandlerClass = NULLOBJECT;   // .JSHandler: .js~handler(obj, msg)
+static RexxObjectPtr jsBooleanClass = NULLOBJECT;   // .Boolean (boolean.cls, RFE #880)
+static RexxObjectPtr jsTrue = NULLOBJECT;           // .Boolean~true, .Boolean~false
+static RexxObjectPtr jsFalse = NULLOBJECT;
+static RexxObjectPtr jsEventClass = NULLOBJECT;     // .JSEvent: what .js~nextEvent gives
+
+// ---- events -------------------------------------------------------------------
+
+static std::mutex eventLock;                        // guards everything below
+static std::condition_variable eventCond;
+static std::deque<std::string> events;              // H id + A args, as JavaScript sent them
+static std::map<size_t, RexxObjectPtr> pinned;      // handler id -> its .JSHandler (a global reference)
+static size_t lastHandlerId = 0;
+static size_t stopGeneration = 0;                   // .js~stopEventLoop ends the loops started before
+
+static void dropEvent(const std::string &ev);
+
+// Rexx objects given to JavaScript as proxies: their ids (also in pinned) and
+// how many times each went without coming back (guarded by eventLock)
+static std::map<RexxObjectPtr, size_t> proxyIds;
+static std::map<size_t, size_t> proxyCounts;
+static std::vector<RexxObjectPtr> unpinned;         // global references to release, with a context
+
+// the pairs of .js~extend (see Classes above; guarded by eventLock)
+struct PeerState
+{
+    RexxObjectPtr obj = NULLOBJECT;                 // the Rexx object (kept alive by Rexx, or by pin)
+    RexxObjectPtr pin = NULLOBJECT;                 // a global reference while only JavaScript holds it
+    bool js = false;                                // only JavaScript holds it (weak there)
+    bool dead = false;                              // JavaScript collected its object
+    size_t received = 0;                            // crossings seen here
+    size_t armed = 0;                               // received when the current sentinel was made
+    size_t sentinel = 0;                            // the current sentinel's number
+    size_t h = 0;                                   // its JavaScript object's handle
+};
+static std::map<size_t, PeerState> peerStates;
+static std::map<RexxObjectPtr, size_t> peerIds;
+static std::vector<size_t> deadPeers;               // collected by JavaScript: jsFinal, then unpinned
+struct Weaken { size_t id, h, n; };
+static std::vector<Weaken> weakens;                 // sent with the next request (guarded by releaseLock)
+static std::mutex releaseLock;
+
+static int32_t serverThread = 0;                    // the server thread, once started (serverSetup)
+static void serverSetup(RexxThreadContext *c);
+
+static void releaseUnpinned(RexxThreadContext *c)
+{
+    std::vector<RexxObjectPtr> gone;
+    std::vector<std::pair<RexxObjectPtr, RexxObjectPtr>> over;    // pairs that are over: object, pin
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        if (unpinned.empty() && deadPeers.empty()) return;
+        gone.swap(unpinned);
+        for (size_t id : deadPeers)
+        {
+            auto it = peerStates.find(id);
+            if (it == peerStates.end()) continue;
+            over.push_back({it->second.obj, it->second.pin});
+            peerIds.erase(it->second.obj);
+            peerStates.erase(it);
+        }
+        deadPeers.clear();
+    }
+    for (RexxObjectPtr o : gone) c->ReleaseGlobalReference(o);
+    for (auto &p : over)
+    {
+        c->SendMessage0(p.first, "JSFINAL");        // the class's UNINIT, and the handle
+        if (c->CheckCondition()) c->ClearCondition();
+        if (p.second != NULLOBJECT) c->ReleaseGlobalReference(p.second);
+    }
+}
+
+// a pair's JavaScript object goes to Rexx (P, or an override's call): its
+// Rexx object, held by Rexx again; NULLOBJECT when id is not a pair
+static RexxObjectPtr peerCrossing(RexxThreadContext *c, size_t id)
+{
+    RexxObjectPtr obj, pin = NULLOBJECT;
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        auto it = peerStates.find(id);
+        if (it == peerStates.end() || it->second.dead) return NULLOBJECT;
+        PeerState &pe = it->second;
+        pe.received++;
+        obj = pe.obj;
+        if (pe.js)
+        {
+            pe.js = false;
+            pin = pe.pin;
+            pe.pin = NULLOBJECT;
+            std::lock_guard<std::mutex> l2(releaseLock);
+            for (auto w = weakens.begin(); w != weakens.end();)
+            {
+                if (w->id == id) w = weakens.erase(w); else ++w;
+            }
+        }
+    }
+    if (pin != NULLOBJECT)
+    {
+        // a new sentinel; JSARM answers the object (a local reference of
+        // this call) before the pin goes
+        RexxObjectPtr o = c->SendMessage0(obj, "JSARM");
+        if (c->CheckCondition()) c->ClearCondition();
+        if (o != NULLOBJECT) obj = o;
+        c->ReleaseGlobalReference(pin);
+    }
+    return obj;
+}
+
+// Z "id<tab>n": JavaScript collected a proxy that came over n times
+static void proxyRelease(const std::string &spec)
+{
+    size_t id = strtoul(spec.c_str(), NULL, 10);
+    size_t t = spec.find('\t');
+    size_t n = t == std::string::npos ? 0 : strtoul(spec.c_str() + t + 1, NULL, 10);
+    std::lock_guard<std::mutex> lock(eventLock);
+    auto it = proxyCounts.find(id);
+    if (it == proxyCounts.end()) return;
+    it->second = it->second > n ? it->second - n : 0;
+    if (it->second > 0) return;
+    proxyCounts.erase(it);
+    auto p = pinned.find(id);
+    if (p == pinned.end()) return;
+    proxyIds.erase(p->second);
+    unpinned.push_back(p->second);
+    pinned.erase(p);
+}
+
+// JavaScript collected a handler's function: nothing can call it any more,
+// so the handler is unpinned, once the events it left are taken (JsNextEvent)
+static std::set<size_t> collectedHandlers;
+static size_t eventHandler(const std::string &ev, bool *latest, size_t *max);
+static void handlerCollected(size_t id)
+{
+    std::lock_guard<std::mutex> lock(eventLock);
+    for (const std::string &ev : events)
+    {
+        if (eventHandler(ev, NULL, NULL) == id) { collectedHandlers.insert(id); return; }
+    }
+    auto p = pinned.find(id);
+    if (p == pinned.end()) return;
+    unpinned.push_back(p->second);
+    pinned.erase(p);
+}
+
+// the handler id of an event, whether it has option latest ("id<tab>L"),
+// and its option max n ("id<tab>Mn", 0 when none)
+static size_t eventHandler(const std::string &ev, bool *latest = NULL, size_t *max = NULL)
+{
+    if (ev.empty() || ev[0] != 'H') return 0;
+    size_t colon = ev.find(':'), len = strtoul(ev.c_str() + 1, NULL, 10);
+    std::string d = ev.substr(colon + 1, len);
+    if (latest) *latest = d.size() > 2 && d.compare(d.size() - 2, 2, "\tL") == 0;
+    if (max)
+    {
+        size_t t = d.find("\tM");
+        *max = t == std::string::npos ? 0 : strtoul(d.c_str() + t + 2, NULL, 10);
+    }
+    return strtoul(d.c_str(), NULL, 10);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void js_event(char *data, int len)
+{
+    std::string ev(data, len), old;
+    free(data);
+    if (!ev.empty() && ev[0] == 'Z')                // a proxy collected, not an event
+    {
+        size_t pos = 0;
+        Rec r;
+        if (nextRec(ev, pos, r)) proxyRelease(r.data);
+        return;
+    }
+    if (!ev.empty() && ev[0] == 'Q')                // a pair's JavaScript object collected
+    {
+        size_t pos = 0;
+        Rec r;
+        if (!nextRec(ev, pos, r)) return;
+        size_t id = strtoul(r.data.c_str(), NULL, 10);
+        std::lock_guard<std::mutex> lock(eventLock);
+        auto it = peerStates.find(id);
+        if (it != peerStates.end() && it->second.js && !it->second.dead)
+        {
+            it->second.dead = true;
+            deadPeers.push_back(id);
+        }
+        eventCond.notify_all();
+        return;
+    }
+    if (!ev.empty() && ev[0] == 'Y')                // a handler's function collected
+    {
+        size_t pos = 0;
+        Rec r;
+        if (nextRec(ev, pos, r)) handlerCollected(strtoul(r.data.c_str(), NULL, 10));
+        return;
+    }
+    if (!ev.empty() && ev[0] == 'C')                // a call from the page: queued as is
+    {
+        {
+            std::lock_guard<std::mutex> lock(eventLock);
+            events.push_back(std::move(ev));
+            __atomic_add_fetch(&queuedCalls, 1, __ATOMIC_SEQ_CST);
+        }
+        eventCond.notify_all();
+        std::lock_guard<std::mutex> lock(waitersLock);   // and the threads waiting for JavaScript
+        for (JsRequest *w : waiters)
+        {
+            int32_t expected = REQ_WAITING;
+            if (__atomic_compare_exchange_n(&w->state, &expected, REQ_CALLS, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+            {
+                emscripten_futex_wake(&w->state, INT_MAX);
+            }
+        }
+        return;
+    }
+    bool latest = false;
+    size_t max = 0;
+    size_t id = eventHandler(ev, &latest, &max);
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        bool replaced = false;
+        if (pinned.find(id) == pinned.end())    // released: nobody will take it
+        {
+            old.swap(ev);
+            replaced = true;
+        }
+        else if (latest)       // option latest: one waiting event per handler, the newest
+        {
+            for (std::string &q : events)
+            {
+                if (eventHandler(q) == id) { old.swap(q); q = std::move(ev); replaced = true; break; }
+            }
+        }
+        else if (max > 0)      // option max n: drop the handler's oldest when n wait
+        {
+            size_t waiting = 0;
+            for (const std::string &q : events) if (eventHandler(q) == id) waiting++;
+            if (waiting >= max)
+            {
+                for (auto it = events.begin(); it != events.end(); ++it)
+                {
+                    if (eventHandler(*it) == id) { old.swap(*it); events.erase(it); break; }
+                }
+            }
+        }
+        if (!replaced) events.push_back(std::move(ev));
+    }
+    if (!old.empty()) dropEvent(old);
+    eventCond.notify_all();
+}
+
+// handles whose .JSObject went away (UNINIT), released with the next request
+static std::vector<std::string> released;
+
+static std::string newRequest()
+{
+    std::string s;
+    std::lock_guard<std::mutex> lock(releaseLock);
+    for (const std::string &r : released) putRec(s, 'X', r);
+    released.clear();
+    for (const Weaken &w : weakens)
+    {
+        putRec(s, 'W', std::to_string(w.h) + "\t" + std::to_string(w.id) + "\t" + std::to_string(w.n));
+    }
+    weakens.clear();
+    return s;
+}
+
+// build the Rexx object for the value record at pos
+static RexxObjectPtr toRexx(RexxThreadContext *c, const std::string &s, size_t &pos)
+{
+    Rec r;
+    if (!nextRec(s, pos, r)) return c->Nil();
+    switch (r.tag)
+    {
+        case 'S': return c->String(r.data.data(), r.data.size());
+        case 'U': return jsUndefined != NULLOBJECT ? jsUndefined : c->Nil();
+        case 'L':                                   // a boolean: .Boolean~true or ~false
+            if (jsTrue == NULLOBJECT) return c->String(r.data.c_str());
+            return r.data == "1" ? jsTrue : jsFalse;
+        case 'O':
+        {
+            size_t t1 = r.data.find('\t'), t2 = r.data.find('\t', t1 + 1);
+            if (jsObjectClass == NULLOBJECT || t1 == std::string::npos || t2 == std::string::npos)
+            {
+                return c->String(r.data.c_str());
+            }
+            RexxArrayObject args = c->ArrayOfThree(c->String(r.data.substr(0, t1).c_str()),
+                                                   c->String(r.data.substr(t1 + 1, t2 - t1 - 1).c_str()),
+                                                   c->String(r.data.substr(t2 + 1).c_str()));
+            return c->SendMessage(jsObjectClass, "NEW", args);
+        }
+        case 'P':                                   // an extending class's instance: its Rexx object
+        {
+            RexxObjectPtr o = peerCrossing(c, strtoul(r.data.c_str(), NULL, 10));
+            return o != NULLOBJECT ? o : c->Nil();
+        }
+        case 'R':                                   // a RexxProxy: its Rexx object
+        {
+            std::lock_guard<std::mutex> lock(eventLock);
+            auto it = pinned.find(strtoul(r.data.c_str(), NULL, 10));
+            return it != pinned.end() ? it->second : c->Nil();
+        }
+        case 'A':
+        {
+            size_t n = strtoul(r.data.c_str(), NULL, 10);
+            RexxArrayObject a = c->NewArray(n);
+            for (size_t i = 1; i <= n; i++) c->ArrayPut(a, toRexx(c, s, pos), i);
+            return a;
+        }
+        default: return c->Nil();
+    }
+}
+
+static bool isA(RexxThreadContext *c, RexxObjectPtr v, RexxObjectPtr cls)
+{
+    return cls != NULLOBJECT && c->IsInstanceOf(v, (RexxClassObject)cls);
+}
+
+// what one conversion has copied so far: each Array, Directory or StringTable
+// copied gets an id (A or T + its size and the id), and when it comes again
+// it is sent as C + the id, so that JavaScript reuses the copy it made: an
+// Array that contains itself is an array that contains itself, an Array that
+// appears twice is one array.  Each value sent starts with an empty memo.
+struct CopyMemo
+{
+    std::map<RexxObjectPtr, size_t> ids;
+    size_t next = 0;
+    RexxObjectPtr top = NULLOBJECT;            // the value being sent
+};
+// Each item a copy reads (ArrayAt, AT) is a local reference of the native
+// method in progress, kept until it returns: released once copied, so that
+// a big Array does not grow the heap by one reference per item (the
+// container keeps the item alive, and the memo needs only its identity).
+// Not the value being sent itself (an Array that contains itself), which
+// the caller may hold only by its own local reference.
+// how deep copies may nest (the copy recurses here, and in JavaScript)
+static const int maxCopyDepth = 1000;
+
+// the items of an Array subclass, by index, as its SUPPLIER gives them
+typedef std::map<std::vector<size_t>, RexxObjectPtr> SuppliedItems;
+static void fromRexxDims(RexxThreadContext *c, std::string &out, RexxObjectPtr a,
+    RexxArrayObject dims, std::vector<size_t> &index, int depth, CopyMemo *memo, size_t id,
+    const SuppliedItems *items = nullptr);
+
+// what SUPPLIER gives, as DO WITH INDEX k ITEM v OVER x sees it: the (index,
+// item) pairs, in its order; how a subclass of Array, Directory or StringTable
+// is read, so that a SUPPLIER of its own is honoured
+static void supplied(RexxThreadContext *c, RexxObjectPtr v,
+    std::vector<std::pair<RexxObjectPtr, RexxObjectPtr>> &pairs)
+{
+    RexxObjectPtr s = c->SendMessage0(v, "SUPPLIER");
+    if (s == NULLOBJECT) return;
+    for (;;)
+    {
+        RexxObjectPtr more = c->SendMessage0(s, "AVAILABLE");
+        bool yes = more != NULLOBJECT && c->ObjectToStringValue(more) == std::string("1");
+        if (more != NULLOBJECT) c->ReleaseLocalReference(more);
+        if (!yes) break;
+        pairs.emplace_back(c->SendMessage0(s, "INDEX"), c->SendMessage0(s, "ITEM"));
+        RexxObjectPtr r = c->SendMessage0(s, "NEXT");
+        if (r != NULLOBJECT) c->ReleaseLocalReference(r);
+    }
+    c->ReleaseLocalReference(s);
+}
+
+// too deep (depth counts from 0): G + the message, which JavaScript raises as
+// a RangeError
+static bool tooDeep(std::string &out, int depth)
+{
+    if (depth < maxCopyDepth) return false;
+    putRec(out, 'G', "Arrays, Directories or StringTables nested more than " +
+           std::to_string(maxCopyDepth) + " deep cannot be copied to JavaScript");
+    return true;
+}
+
+// an Array, Directory or StringTable seen before in this conversion: C + its
+// id, and true (also when it is too deep); else a new id for it (in *id),
+// and false
+static bool copiedBefore(std::string &out, RexxObjectPtr v, int depth, CopyMemo *memo, size_t *id)
+{
+    if (tooDeep(out, depth)) return true;
+    auto seen = memo->ids.find(v);
+    if (seen != memo->ids.end()) { putRec(out, 'C', std::to_string(seen->second)); return true; }
+    *id = ++memo->next;
+    memo->ids[v] = *id;
+    return false;
+}
+
+// a Rexx object by reference: R + its id and its string as it is now (a
+// RexxProxy in JavaScript); any object that is not converted, and the
+// value of .js~ref(x)
+static void toProxy(RexxThreadContext *c, std::string &out, RexxObjectPtr v)
+{
+    if (__atomic_load_n(&serverThread, __ATOMIC_SEQ_CST) == 0) serverSetup(c);
+    std::string str = c->ObjectToStringValue(v);
+    if (c->CheckCondition()) c->ClearCondition();
+    size_t id;
+    RexxObjectPtr g = c->RequestGlobalReference(v);  // (not with eventLock held: see above)
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        auto it = proxyIds.find(v);
+        if (it != proxyIds.end()) id = it->second;
+        else
+        {
+            id = ++lastHandlerId;
+            pinned[id] = g;
+            proxyIds[g] = id;
+            g = NULLOBJECT;
+        }
+        proxyCounts[id]++;
+    }
+    if (g != NULLOBJECT) c->ReleaseGlobalReference(g);
+    putRec(out, 'R', std::to_string(id) + "\t" + str);
+}
+
+// the classes whose instances are copied (Array, Directory, StringTable),
+// subclasses included
+static RexxObjectPtr arrayClass = NULLOBJECT, directoryClass = NULLOBJECT,
+    stringTableClass = NULLOBJECT;
+static void copyClasses(RexxThreadContext *c)
+{
+    if (arrayClass != NULLOBJECT) return;
+    directoryClass = c->RequestGlobalReference(c->FindClass("DIRECTORY"));
+    stringTableClass = c->RequestGlobalReference(c->FindClass("STRINGTABLE"));
+    arrayClass = c->RequestGlobalReference(c->FindClass("ARRAY"));
+}
+
+// encode a Rexx value for JavaScript
+static void fromRexx(RexxThreadContext *c, std::string &out, RexxObjectPtr v, int depth = 0,
+    CopyMemo *memo = nullptr)
+{
+    CopyMemo top;
+    if (memo == nullptr) { memo = &top; top.top = v; }
+    if (v == NULLOBJECT) { putRec(out, 'U', ""); return; }
+    if (v == c->Nil()) { putRec(out, 'N', ""); return; }
+    copyClasses(c);
+    if (isA(c, v, jsObjectClass))
+    {
+        putRec(out, 'O', c->ObjectToStringValue(c->SendMessage0(v, "JSREF")));
+        return;
+    }
+    if (isA(c, v, jsBooleanClass))                         // a .Boolean (any subclass): a boolean
+    {
+        putRec(out, 'B', c->ObjectToStringValue(c->SendMessage0(v, "VALUE")));
+        return;
+    }
+    if (isA(c, v, jsHandlerClass))
+    {
+        size_t id = 0;
+        c->ObjectToStringSize(c->SendMessage0(v, "ID"), &id);
+        std::string options = c->ObjectToStringValue(c->SendMessage0(v, "OPTIONS"));
+        // (no API call with eventLock held: one may run UNINIT methods,
+        // on this thread, that need it)
+        RexxObjectPtr g = c->RequestGlobalReference(v);
+        {
+            std::lock_guard<std::mutex> lock(eventLock);
+            if (pinned.find(id) == pinned.end()) { pinned[id] = g; g = NULLOBJECT; }
+        }
+        if (g != NULLOBJECT) c->ReleaseGlobalReference(g);
+        putRec(out, 'H', std::to_string(id) + "\t" + options);
+        return;
+    }
+    if (isA(c, v, jsTypedClass))
+    {
+        std::string kind = c->ObjectToStringValue(c->SendMessage0(v, "KIND"));
+        RexxObjectPtr val = c->SendMessage0(v, "VALUE");
+        if (kind == "P") { toProxy(c, out, val); return; }   // .js~ref(x): by reference
+        std::string data = val == NULLOBJECT || val == c->Nil() ? "" : c->ObjectToStringValue(val);
+        putRec(out, kind.empty() ? 'U' : kind[0], data);
+        return;
+    }
+    if (c->IsArray(v) || isA(c, v, arrayClass))
+    {
+        size_t id;
+        if (copiedBefore(out, v, depth, memo, &id)) return;
+        // a multi-dimensional Array: arrays nested by dimension, the first
+        // outermost (a 2x3 Array is an array of 2 arrays of 3)
+        size_t ndims = 0;
+        c->ObjectToStringSize(c->SendMessage0(v, "DIMENSION"), &ndims);
+        // a subclass of Array: its shape from DIMENSIONS, its items from
+        // SUPPLIER (a slot SUPPLIER does not give is empty), whatever its
+        // dimensions
+        if (!c->IsArray(v))
+        {
+            RexxArrayObject dims = (RexxArrayObject)c->SendMessage0(v, "DIMENSIONS");
+            size_t nd = dims == NULLOBJECT ? 0 : c->ArraySize(dims);
+            std::vector<size_t> bound(nd);
+            for (size_t k = 0; k < nd; k++) c->ObjectToStringSize(c->ArrayAt(dims, k + 1), &bound[k]);
+            std::vector<std::pair<RexxObjectPtr, RexxObjectPtr>> pairs;
+            supplied(c, v, pairs);
+            SuppliedItems items;
+            for (auto &p : pairs)
+            {
+                std::vector<size_t> at;              // the index: a number, or an Array of numbers
+                if (c->IsArray(p.first))
+                    for (size_t k = 1; k <= c->ArraySize((RexxArrayObject)p.first); k++)
+                    {
+                        size_t x = 0;
+                        c->ObjectToStringSize(c->ArrayAt((RexxArrayObject)p.first, k), &x);
+                        at.push_back(x);
+                    }
+                else { size_t x = 0; c->ObjectToStringSize(p.first, &x); at.push_back(x); }
+                bool inside = at.size() == nd;
+                for (size_t k = 0; inside && k < nd; k++) inside = at[k] >= 1 && at[k] <= bound[k];
+                if (inside && p.second != NULLOBJECT) items[at] = p.second;
+                else if (p.second != NULLOBJECT && p.second != memo->top) c->ReleaseLocalReference(p.second);
+                c->ReleaseLocalReference(p.first);
+            }
+            std::vector<size_t> index;
+            if (nd > 0) fromRexxDims(c, out, v, dims, index, depth, memo, id, &items);
+            else putRec(out, 'A', "0\t" + std::to_string(id));
+            for (auto &e : items) if (e.second != memo->top) c->ReleaseLocalReference(e.second);
+            return;
+        }
+        if (ndims > 1)
+        {
+            std::vector<size_t> index;
+            fromRexxDims(c, out, v, (RexxArrayObject)c->SendMessage0(v, "DIMENSIONS"), index, depth, memo, id);
+            return;
+        }
+        size_t size = c->ArraySize((RexxArrayObject)v);
+        putRec(out, 'A', std::to_string(size) + "\t" + std::to_string(id));
+        for (size_t i = 1; i <= size; i++)
+        {
+            RexxObjectPtr item = c->ArrayAt((RexxArrayObject)v, i);
+            fromRexx(c, out, item, depth + 1, memo);
+            if (item != NULLOBJECT && item != memo->top) c->ReleaseLocalReference(item);
+        }
+        return;
+    }
+    // a Directory or StringTable, subclasses included: by ALLINDEXES and AT, a
+    // subclass by SUPPLIER (what it only computes, in UNKNOWN, is not copied)
+    if (c->IsDirectory(v) || c->IsStringTable(v) || isA(c, v, directoryClass) ||
+        isA(c, v, stringTableClass))
+    {
+        size_t id;
+        if (copiedBefore(out, v, depth, memo, &id)) return;
+        if (!c->IsDirectory(v) && !c->IsStringTable(v))
+        {
+            std::vector<std::pair<RexxObjectPtr, RexxObjectPtr>> pairs;
+            supplied(c, v, pairs);
+            putRec(out, 'T', std::to_string(pairs.size()) + "\t" + std::to_string(id));
+            for (auto &p : pairs)
+            {
+                putRec(out, 'K', c->ObjectToStringValue(p.first));
+                fromRexx(c, out, p.second, depth + 1, memo);
+                if (p.second != NULLOBJECT && p.second != memo->top) c->ReleaseLocalReference(p.second);
+                c->ReleaseLocalReference(p.first);
+            }
+            return;
+        }
+        RexxArrayObject keys = (RexxArrayObject)c->SendMessage0(v, "ALLINDEXES");
+        size_t n = c->ArrayItems(keys);
+        putRec(out, 'T', std::to_string(n) + "\t" + std::to_string(id));
+        for (size_t i = 1; i <= n; i++)
+        {
+            RexxObjectPtr k = c->ArrayAt(keys, i);
+            putRec(out, 'K', c->ObjectToStringValue(k));
+            RexxObjectPtr item = c->SendMessage1(v, "AT", k);
+            fromRexx(c, out, item, depth + 1, memo);
+            if (item != NULLOBJECT && item != memo->top) c->ReleaseLocalReference(item);
+            c->ReleaseLocalReference(k);
+        }
+        c->ReleaseLocalReference(keys);
+        return;
+    }
+    if (c->IsString(v))
+    {
+        RexxStringObject str = (RexxStringObject)v;
+        putRec(out, 'S', std::string(c->StringData(str), c->StringLength(str)));
+        return;
+    }
+    // a number is a String too (an internal integer or number object)
+    static RexxObjectPtr stringClass = NULLOBJECT;
+    if (stringClass == NULLOBJECT) stringClass = c->RequestGlobalReference(c->FindClass("STRING"));
+    if (c->IsInstanceOf(v, (RexxClassObject)stringClass))
+    {
+        putRec(out, 'S', c->ObjectToStringValue(v));
+        return;
+    }
+    // any other object: a RexxProxy
+    toProxy(c, out, v);
+}
+
+// one dimension of a multi-dimensional Array (fromRexx): index holds the
+// positions of the outer dimensions; the items are read with AT, by their
+// indexes, not by their place in the Array's storage (where the first
+// index varies fastest).  The outermost array carries the Array's id (memo).
+static void fromRexxDims(RexxThreadContext *c, std::string &out, RexxObjectPtr a,
+    RexxArrayObject dims, std::vector<size_t> &index, int depth, CopyMemo *memo, size_t id,
+    const SuppliedItems *items)
+{
+    size_t level = index.size() + 1, ndims = c->ArraySize(dims), n = 0;
+    c->ObjectToStringSize(c->ArrayAt(dims, level), &n);
+    if (level > 1 && tooDeep(out, depth)) return;
+    putRec(out, 'A', std::to_string(n) + (level == 1 ? "\t" + std::to_string(id) : std::string()));
+    for (size_t i = 1; i <= n; i++)
+    {
+        index.push_back(i);
+        if (level < ndims) fromRexxDims(c, out, a, dims, index, depth + 1, memo, 0, items);
+        else if (items != nullptr)                 // an Array subclass: what SUPPLIER gave
+        {
+            auto it = items->find(index);
+            fromRexx(c, out, it == items->end() ? NULLOBJECT : it->second, depth + 1, memo);
+        }
+        else
+        {
+            RexxArrayObject at = c->NewArray(ndims);
+            for (size_t k = 0; k < ndims; k++)
+            {
+                RexxObjectPtr n = c->StringSize(index[k]);
+                c->ArrayPut(at, n, k + 1);
+                c->ReleaseLocalReference(n);
+            }
+            // an empty slot is undefined, as in a one-dimensional Array (AT gives .nil)
+            RexxObjectPtr item = c->SendMessage(a, "AT", at);
+            if (item == c->Nil() && c->SendMessage(a, "HASINDEX", at) == c->False()) item = NULLOBJECT;
+            fromRexx(c, out, item, depth + 1, memo);
+            if (item != NULLOBJECT && item != memo->top) c->ReleaseLocalReference(item);
+            c->ReleaseLocalReference(at);
+        }
+        index.pop_back();
+    }
+}
+
+// a SYNTAX condition of Rexx (its condition object) raised again: the same
+// code and ADDITIONAL, so the same message, and its DESCRIPTION and RESULT
+static void reraise(RexxThreadContext *c, RexxObjectPtr cond)
+{
+    RexxObjectPtr code = cond != NULLOBJECT && c->IsDirectory(cond)
+        ? c->DirectoryAt((RexxDirectoryObject)cond, "CODE") : NULLOBJECT;
+    unsigned major = 0, minor = 0;
+    if (code == NULLOBJECT || sscanf(c->ObjectToStringValue(code), "%u.%u", &major, &minor) < 1 || major == 0)
+    {
+        c->RaiseException1(Rexx_Error_Execution_user_defined, c->String("JavaScript error: a RexxError without its condition"));
+        return;
+    }
+    RexxObjectPtr add = c->DirectoryAt((RexxDirectoryObject)cond, "ADDITIONAL");
+    if (add != NULLOBJECT && c->IsArray(add)) c->RaiseException(major * 1000 + minor, (RexxArrayObject)add);
+    else c->RaiseException0(major * 1000 + minor);
+    // the condition now raised is the one Rexx will see: give it what the
+    // original had that RaiseException does not take
+    RexxDirectoryObject raised = c->GetConditionInfo();
+    if (raised == NULLOBJECT) return;
+    for (const char *e : {"DESCRIPTION", "RESULT"})
+    {
+        RexxObjectPtr v = c->DirectoryAt((RexxDirectoryObject)cond, e);
+        if (v != NULLOBJECT) c->DirectoryPut(raised, v, e);
+    }
+}
+
+// the result of a reply: its value, or a raised SYNTAX 98.900 condition
+static RexxObjectPtr result(RexxThreadContext *c, const std::string &reply)
+{
+    size_t pos = 0;
+    Rec r;
+    if (!nextRec(reply, pos, r)) return c->Nil();
+    if (r.tag == 'R') return toRexx(c, reply, pos);
+    // D: a string that is not text (not UTF-8 to JavaScript, not well-formed
+    // back): an invalid data string, not an exception of JavaScript's
+    if (r.tag == 'D')
+    {
+        c->RaiseException(Rexx_Error_Invalid_data_string_user_defined,
+                          c->ArrayOfOne(c->String(r.data.data(), r.data.size())));
+        return NULLOBJECT;
+    }
+    // J: a RexxError that JavaScript let through, of a SYNTAX condition of
+    // Rexx (see conditionFields()): that condition, raised again as itself
+    if (r.tag == 'J')
+    {
+        reraise(c, toRexx(c, reply, pos));
+        return NULLOBJECT;
+    }
+    // E: the message, then the thrown value (a .JSObject for an Error), and
+    // its stack when it has one: ADDITIONAL [1] the message, [2] the value,
+    // [3] the stack
+    std::string msg = "JavaScript error: " + r.data;
+    RexxObjectPtr thrown = toRexx(c, reply, pos);
+    Rec stack;
+    if (nextRec(reply, pos, stack) && stack.tag == 'S' && !stack.data.empty())
+    {
+        c->RaiseException(Rexx_Error_Execution_user_defined, c->ArrayOfThree(c->String(msg.c_str()), thrown,
+            c->String(stack.data.data(), stack.data.size())));
+    }
+    else c->RaiseException(Rexx_Error_Execution_user_defined, c->ArrayOfTwo(c->String(msg.c_str()), thrown));
+    return NULLOBJECT;
+}
+
+static RexxObjectPtr request(RexxThreadContext *c, int op, const std::string &data)
+{
+    releaseUnpinned(c);
+    return result(c, jsCall(c, op, data));
+}
+
+// the fields of a condition, for JavaScript's RexxError (a T record after
+// the E): K name, S value for each entry it has (CONDITION, CODE, RC,
+// ERRORTEXT, PROGRAM, POSITION as line, TRACEBACK as its lines joined by
+// "\n"), and cause, what JavaScript threw, when the condition is the SYNTAX
+// 98.900 a JavaScript exception became (see result()).  Called with the
+// condition cleared
+static void conditionFields(RexxThreadContext *c, std::string &out, RexxDirectoryObject cond, wholenumber_t code)
+{
+    std::string fields;
+    size_t n = 0;
+    static const char *const entries[][2] = {
+        {"condition", "CONDITION"}, {"code", "CODE"}, {"rc", "RC"}, {"errorText", "ERRORTEXT"},
+        {"program", "PROGRAM"}, {"line", "POSITION"},
+    };
+    for (const auto &e : entries)
+    {
+        RexxObjectPtr v = c->DirectoryAt(cond, e[1]);
+        if (v == NULLOBJECT || v == c->Nil()) continue;
+        RexxStringObject s = c->ObjectToString(v);
+        putRec(fields, 'K', e[0]);
+        putRec(fields, 'S', std::string(c->StringData(s), c->StringLength(s)));
+        n++;
+    }
+    RexxObjectPtr tb = c->DirectoryAt(cond, "TRACEBACK");
+    if (tb != NULLOBJECT && tb != c->Nil())
+    {
+        RexxObjectPtr lines = c->SendMessage0(tb, "MAKEARRAY");
+        if (lines != NULLOBJECT && c->IsArray(lines))
+        {
+            std::string t;
+            size_t items = c->ArraySize((RexxArrayObject)lines);
+            for (size_t i = 1; i <= items; i++)
+            {
+                RexxObjectPtr l = c->ArrayAt((RexxArrayObject)lines, i);
+                if (l == NULLOBJECT) continue;
+                RexxStringObject s = c->ObjectToString(l);
+                if (!t.empty()) t += '\n';
+                t.append(c->StringData(s), c->StringLength(s));
+            }
+            putRec(fields, 'K', "traceback");
+            putRec(fields, 'S', t);
+            n++;
+        }
+    }
+    if (c->CheckCondition()) c->ClearCondition();
+    RexxObjectPtr add = c->DirectoryAt(cond, "ADDITIONAL");
+    RexxObjectPtr value = add != NULLOBJECT && c->IsArray(add) && c->ArraySize((RexxArrayObject)add) >= 2
+        ? c->ArrayAt((RexxArrayObject)add, 2) : NULLOBJECT;
+    if (code == Rexx_Error_Execution_user_defined && value != NULLOBJECT)
+    {
+        RexxObjectPtr first = c->ArrayAt((RexxArrayObject)add, 1);
+        static const char prefix[] = "JavaScript error: ";
+        if (first != NULLOBJECT && c->IsString(first) &&
+            strncmp(c->StringData((RexxStringObject)first), prefix, sizeof(prefix) - 1) == 0)
+        {
+            putRec(fields, 'K', "cause");
+            fromRexx(c, fields, value);
+            n++;
+        }
+    }
+    // and the condition itself, by reference, for a SYNTAX condition: a
+    // RexxError that JavaScript lets through comes back to Rexx as it (J)
+    if (code != 0)
+    {
+        putRec(fields, 'K', "rexx");
+        toProxy(c, fields, cond);
+        n++;
+    }
+    putRec(out, 'T', std::to_string(n));
+    out += fields;
+}
+
+// a synchronous handler's call, on a Rexx thread: the R/E records of its result
+static std::string runCallback(RexxThreadContext *c, const std::string &call)
+{
+    std::string out;
+    size_t pos = 0;
+    Rec r;
+    RexxObjectPtr handler = NULLOBJECT;
+    releaseUnpinned(c);
+    // H "id": a handler; M "id<tab>NAME": an override, method NAME of the
+    // Rexx object id (an instance of a class extending a JavaScript class),
+    // then S "realm<tab>id<tab>display" the first time (its JavaScript object,
+    // when a base constructor calls an override before the Rexx side knows it)
+    bool override = false;
+    std::string message;
+    if (nextRec(call, pos, r) && (r.tag == 'H' || r.tag == 'M'))
+    {
+        override = r.tag == 'M';
+        if (override)
+        {
+            size_t t = r.data.find('\t');
+            message = t == std::string::npos ? "" : r.data.substr(t + 1);
+        }
+        size_t id = strtoul(r.data.c_str(), NULL, 10);
+        if (override) handler = peerCrossing(c, id);
+        if (handler == NULLOBJECT)
+        {
+            std::lock_guard<std::mutex> lock(eventLock);
+            auto it = pinned.find(id);
+            if (it != pinned.end()) handler = it->second;
+        }
+    }
+    if (override && nextRec(call, pos, r) && r.tag == 'S' && handler != NULLOBJECT)
+    {
+        c->SendMessage1(handler, "JSBIND", c->String(r.data.c_str()));
+    }
+    if (handler == NULLOBJECT)                      // released meanwhile: undefined
+    {
+        putRec(out, 'R', "");
+        putRec(out, 'U', "");
+        return out;
+    }
+    RexxObjectPtr scope = override ? toRexx(c, call, pos) : NULLOBJECT;
+    if (scope == jsUndefined || scope == c->Nil()) scope = NULLOBJECT;
+    RexxArrayObject args = (RexxArrayObject)toRexx(c, call, pos);
+    RexxObjectPtr target = handler;
+    if (!override)
+    {
+        target = c->SendMessage0(handler, "TARGET");
+        message = c->ObjectToStringValue(c->SendMessage0(handler, "MESSAGE"));
+    }
+    if (scope != NULLOBJECT && !c->IsInstanceOf(scope, c->FindClass("CLASS")))
+    {
+        putRec(out, 'E', "Error 98.900: sendMessageScope: the scope must be a Rexx class");
+        putRec(out, 'N', "");
+        return out;
+    }
+    RexxObjectPtr value = scope != NULLOBJECT
+        ? c->SendMessageScoped(target, message.c_str(), (RexxClassObject)scope, args)
+        : c->SendMessage(target, message.c_str(), args);
+    if (c->CheckCondition())
+    {
+        RexxDirectoryObject cond = c->GetConditionInfo();
+        RexxCondition info = {};
+        c->DecodeConditionInfo(cond, &info);
+        std::string name = info.conditionName ? c->CString(info.conditionName) : "a condition";
+        std::string msg;
+        if (name == "SYNTAX")
+        {
+            msg = "Error " + std::to_string(info.code / 1000) + "." + std::to_string(info.code % 1000) + ": ";
+            msg += info.errortext ? c->CString(info.errortext) : "";
+            std::string detail = info.message ? c->CString(info.message) : "";
+            if (!detail.empty()) msg += " (" + detail + ")";
+        }
+        else msg = "condition " + name + " raised in " + message;
+        c->ClearCondition();
+        putRec(out, 'E', msg);
+        conditionFields(c, out, cond, info.code);
+        return out;
+    }
+    putRec(out, 'R', "");
+    fromRexx(c, out, value);
+    return out;
+}
+
+// the server thread: the calls of synchronous handlers made by JavaScript on
+// its own (a timer, a Node server), one at a time, each attached to the
+// interpreter for the call
+static RexxInstance *jsInstance = NULL;
+static std::mutex serverLock;
+static std::condition_variable serverCond;
+static std::deque<SyncCall *> serverQueue;
+
+static void *serverMain(void *)
+{
+    __atomic_store_n(&serverThread, selfId(), __ATOMIC_SEQ_CST);
+    emscripten_futex_wake(&serverThread, INT_MAX);
+    for (;;)
+    {
+        SyncCall *sc;
+        {
+            std::unique_lock<std::mutex> lock(serverLock);
+            serverCond.wait(lock, [] { return !serverQueue.empty(); });
+            sc = serverQueue.front();
+            serverQueue.pop_front();
+        }
+        RexxThreadContext *tc = NULL;
+        if (jsInstance != NULL && jsInstance->AttachThread(&tc))
+        {
+            std::string answer = runCallback(tc, sc->call);
+            tc->DetachThread();
+            if (!answer.empty() && answer[0] == 'E')        // nobody to throw it to
+            {
+                size_t pos = 0;
+                Rec r;
+                nextRec(answer, pos, r);
+                fprintf(stderr, "Error in a JavaScript handler: %s\n", r.data.c_str());
+            }
+        }
+        delete sc;
+    }
+    return NULL;
+}
+
+// the threads the main runtime thread is waiting for (a stack: calls nest)
+static std::vector<int32_t> awaited;
+
+// a request of a thread JavaScript waits for cannot wait for JavaScript
+extern "C" EMSCRIPTEN_KEEPALIVE int js_request_awaited(JsRequest *req)
+{
+    for (int32_t t : awaited) if (t == req->thread) return 1;
+    return 0;
+}
+
+// a malloc'ed copy of a reply
+static char *replyCopy(const std::string &answer, int32_t *outLen)
+{
+    char *out = (char *)malloc(answer.size() + 1);
+    memcpy(out, answer.data(), answer.size());
+    out[answer.size()] = 0;
+    *outLen = (int32_t)answer.size();
+    return out;
+}
+
+// a synchronous handler called (on the main runtime thread): run it on the
+// Rexx thread whose request is being done (req) and wait, doing the requests
+// that come meanwhile; or hand it to the server thread and go on (undefined);
+// a malloc'ed R/E reply
+extern "C" EMSCRIPTEN_KEEPALIVE char *js_sync_call(JsRequest *req, const char *data, int len, int32_t *outLen)
+{
+    std::string undefinedReply;
+    putRec(undefinedReply, 'R', "");
+    putRec(undefinedReply, 'U', "");
+    if (req == NULL)
+    {
+        if (__atomic_load_n(&serverThread, __ATOMIC_SEQ_CST) != 0)
+        {
+            SyncCall *call = new SyncCall;
+            call->call.assign(data, len);
+            {
+                std::lock_guard<std::mutex> lock(serverLock);
+                serverQueue.push_back(call);
+            }
+            serverCond.notify_one();
+        }
+        return replyCopy(undefinedReply, outLen);
+    }
+    SyncCall sc;
+    sc.call.assign(data, len);
+    int32_t who = req->thread;
+    req->sync = &sc;
+    __atomic_store_n(&req->state, REQ_CALLBACK, __ATOMIC_SEQ_CST);
+    emscripten_futex_wake(&req->state, INT_MAX);
+    awaited.push_back(who);
+    while (__atomic_load_n(&sc.state, __ATOMIC_SEQ_CST) == 0)
+    {
+        js_drain_now();
+        emscripten_proxy_execute_queue(emscripten_proxy_get_system_queue());
+        emscripten_futex_wait(&sc.state, 0, 1.0);
+    }
+    awaited.pop_back();
+    return replyCopy(sc.answer, outLen);
+}
