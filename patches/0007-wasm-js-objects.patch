+// JsSetup(.JSObject, .JSTyped, .JSHandler, .JSEvent, .js~undefined, .Boolean)
+RexxRoutine6(int, JsSetup, RexxObjectPtr, objectClass, RexxObjectPtr, typedClass,
+             RexxObjectPtr, handlerClass, RexxObjectPtr, eventClass, RexxObjectPtr, undefinedValue,
+             RexxObjectPtr, booleanClass)
+{
