+// UNINIT: the handle can go; released with the next request
+RexxMethod0(RexxObjectPtr, js_uninit)
+{
+    RexxObjectPtr ref = context->GetObjectVariable("JSREF");
+    if (ref != NULLOBJECT)
+    {
+        std::string r = context->ObjectToStringValue(ref);
+        std::lock_guard<std::mutex> lock(releaseLock);
+        released.push_back(r);
+    }
+    return NULLOBJECT;
+}
