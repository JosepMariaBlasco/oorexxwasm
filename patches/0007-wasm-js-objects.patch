+          items = Array.from(t); idx = items.map((_, i) => i + 1);
+        } else { idx = Object.keys(t); items = idx.map((k) => t[k]); }
+        return new RexxArray([new RexxArray(idx), new RexxArray(items)]);
+      }
+      case 'bytes': {
+        const b = t instanceof ArrayBuffer ? new Uint8Array(t) :
+          ArrayBuffer.isView(t) ? new Uint8Array(t.buffer, t.byteOffset, t.byteLength) : null;
+        if (!b) throw new TypeError(an(className(t)) + ' is not an ArrayBuffer or a typed array');
+        return new BytesForRexx(b);
+      }
+    }
+    throw new Error('unknown info ' + what);
+  }
+  class BytesForRexx { constructor(b) { this.b = b; } }
+
