+/*
+ * ooRexx/WASM browser build: JDOR on the HTML canvas.
+ *
+ * JDOR ("Java Drawing for ooRexx", Rony G. Flatscher, BSF4ooRexx850) is a Rexx
+ * command handler that makes Java2D available as commands:
+ *
+ *     address jdor
+ *     newImage 300 200; color red; moveTo 10 10; fillRect 100 50; winShow
+ *
+ * This is a port of its Java implementation (JavaDrawingHandler.java,
+ * version 100.20230718) to the browser's Canvas 2D, which descends from the
+ * same PostScript model: the commands, their arguments, aliases, return
+ * values (RC), canonical output (ADDRESS ... WITH OUTPUT), error and failure
+ * conditions and their return codes follow the Java handler.  Where the Java
+ * handler draws other than its documentation says (the size of an Arc2D,
+ * drawImage with a source rectangle), this port draws as Java does, so
+ * programs look the same; those places are marked "as Java".  Where it fails
+ * instead (draw3DRect fills, reset after pushGC, paint with a registered
+ * colour, printPos and winResizable as queries) or writes canonical output
+ * that cannot be replayed (gradientPaint, copyArea), this port does what the
+ * documentation says.
+ *
+ * Runs on the main runtime thread: the Web Worker hosting the run, which
+ * never blocks.  wasm/web-jdor.cpp passes each command here (see its comment
+ * for the reply format).  Every handler owns an image (an OffscreenCanvas)
+ * and a window; at most once per animation frame a visible window's image is
+ * sent to the page as an ImageBitmap (Module.orxJdor, set by the worker).
+ * The objects that commands return (colors, fonts, images, shapes, ...)
+ * become JdorObject instances on the Rexx side (wasm/web/jdor.cls), which
+ * carry a reference back to the object here.  They say what they are, JDOR
+ * objects of the browser build ("JDOR Image #99: 500x500, ..."), and the
+ * handler's errors read "JDOR (web): ...": nothing pretends to be Java.
+ */
+(function () {
+  'use strict';
+  if (typeof ENVIRONMENT_IS_PTHREAD !== 'undefined' && ENVIRONMENT_IS_PTHREAD) return;
+
+  // =========================================================================
+  // Java number formatting and parsing
+  // =========================================================================
+
+  // digits and exponent of a number's shortest representation, Java style
+  function javaFormat(mant, exp) {   // mant: digits without dot, exp: decimal exponent of first digit
+    if (exp >= -3 && exp < 7) {
+      if (exp >= 0) {
+        const intPart = mant.length > exp + 1 ? mant.slice(0, exp + 1) : mant + '0'.repeat(exp + 1 - mant.length);
+        const frac = mant.length > exp + 1 ? mant.slice(exp + 1) : '';
+        return intPart + '.' + (frac || '0');
+      }
+      return '0.' + '0'.repeat(-exp - 1) + mant;
+    }
+    return mant[0] + '.' + (mant.slice(1) || '0') + 'E' + exp;
+  }
+  function splitExp(s) {             // "d.dddde±n" -> [digits, exp]
+    const m = /^(\d)(?:\.(\d+))?e([+-]\d+)$/.exec(s);
+    let digits = m[1] + (m[2] || '');
+    digits = digits.replace(/0+$/, '') || '0';
+    return [digits, parseInt(m[3], 10)];
+  }
+  function jd(x) {                   // Double.toString
+    x = +x;
+    if (Number.isNaN(x)) return 'NaN';
+    if (x === Infinity) return 'Infinity';
+    if (x === -Infinity) return '-Infinity';
+    if (x === 0) return (Object.is(x, -0) ? '-' : '') + '0.0';
+    const neg = x < 0;
+    const [d, e] = splitExp(Math.abs(x).toExponential());
+    return (neg ? '-' : '') + javaFormat(d, e);
+  }
+  function jf(x) {                   // Float.toString
+    x = Math.fround(+x);
+    if (!Number.isFinite(x) || x === 0) return jd(x);
+    let s = null;
+    for (let p = 1; p <= 9; p++) {
+      s = Math.abs(x).toExponential(p - 1);
+      if (Math.fround(parseFloat(s)) === Math.abs(x)) break;
+    }
+    const [d, e] = splitExp(s);
+    return (x < 0 ? '-' : '') + javaFormat(d, e);
+  }
+
+  // An argument or command the handler rejects (where JDOR in Java throws a
+  // Java exception): the ERROR condition's description, "JDOR (web): msg".
+  class JdorError {
+    constructor(msg) { this.msg = msg; }
+    toString() { return 'JDOR (web): ' + this.msg; }
+  }
+  const nfe = (s) => new JdorError('not a number: "' + s + '"');
+  function iae(msg) { throw new JdorError(msg); }
+
+  function parseIntJ(s) {            // Integer.parseInt
+    if (!/^[+-]?\d+$/.test(s)) throw nfe(s);
+    const v = parseInt(s, 10);
+    if (v > 2147483647 || v < -2147483648) throw nfe(s);
+    return v;
+  }
