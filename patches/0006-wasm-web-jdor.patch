+  let queue = Promise.resolve();      // serialise commands that wait for the browser
+  function execute(op, address, command, isOR, varBytes) {
+    if (op === 2) {                   // a new handler
+      const h = new Handler();
+      const parts = []; rec(parts, 'R', ''); value(parts, h.obj);
+      return reply(parts);
+    }
+    if (op === 3) {                   // bind ADDRESS name -> handler (command: "Handler:id")
+      const id = parseInt(String(command).split(':')[1], 10), h = handlers.get(id);
+      const parts = [];
+      if (!h) rec(parts, 'C', 'FAILURE -1 0 not a JDOR handler');
+      else { environments.set(address, h); rec(parts, 'R', ''); value(parts, h.obj); }
+      return reply(parts);
+    }
+    const h = environments.get(address);
+    if (!h) { const parts = []; rec(parts, 'C', 'FAILURE -1 0 no JDOR handler for ADDRESS ' + address); return reply(parts); }
+    const vars = varBytes ? readVars(varBytes) : new Map();
+    let c;
+    try { c = process(h, command, isOR, vars); }
+    catch (e) {
+      if (e instanceof NeedVar) { const parts = []; rec(parts, 'W', e.name); return reply(parts); }
+      throw e;
+    }
+    if (!c.async) return replyFor(c, h);
+    return c.async.then(() => replyFor(c, h), (e) => {
+      c.out = c.out.filter((l) => !l.startsWith(c.canonical));
+      c.write('-- ERROR (argument): [' + command + ']');
