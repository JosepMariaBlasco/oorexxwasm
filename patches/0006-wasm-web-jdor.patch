+/*
+ * ooRexx/WASM browser build: the native side of JDOR, the drawing command
+ * handler of BSF4ooRexx (Rony G. Flatscher), on the HTML canvas.
+ *
+ * The drawing itself is JavaScript (wasm/web-jdor.js), on the main runtime
+ * thread: the Web Worker that hosts the run, which never blocks, owns the
+ * images (OffscreenCanvas) and sends what a window shows to the page.  This
+ * file is the Rexx side: the package "jdor" (::REQUIRES "jdor" LIBRARY, see
+ * wasm/web/jdor.cls) and a redirecting command handler.  Each command is
+ * passed, synchronously, to the main runtime thread (the interpreter runs
+ * on a pthread); the JavaScript side may finish the call later (decoding or
+ * encoding an image is asynchronous in the browser).
+ *
+ * The reply is a sequence of records "<tag><length>:<bytes>":
+ *   O line   write to the redirected output     E line  ... to redirected error
+ *   W name   resolve this Rexx variable and call again (no side effect yet)
+ *   V name   set this Rexx variable to the value record that follows
+ *   Z secs   sleep        C "ERROR|FAILURE rc nr message"   raise the condition
+ *   R        the command result: the value record that follows
+ * Values: S string, N .nil, J "kind<tab>ref<tab>display" (a JdorObject),
+ *   A count + values (an Array), T count + (K key, value) pairs (a StringTable),
+ *   U an unset variable.  The resolved variables go to JavaScript in the same
+ *   format, as K name + value records.
+ */
+
+#include <emscripten.h>
+#include <emscripten/proxying.h>
+#include <emscripten/threading.h>
+#include <oorexxapi.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+#include <time.h>
+#include <unistd.h>
+
+extern "C"
+{
+
+// Shared with wasm/web-jdor.js (byte offsets in comments).
+typedef struct
+{
+    const char *address;    //  0: the environment name
+    const char *command;    //  4: the command (UTF-8, NUL-terminated)
+    int32_t     op;         //  8: 1 command, 2 new handler, 3 bind address to handler
+    int32_t     handler;    // 12: handler id (op 3)
+    int32_t     outRedir;   // 16: output is redirected (op 1)
+    const char *vars;       // 20: resolved variables (records), or NULL
+    char       *reply;      // 24: set by JavaScript: malloc'ed reply
+    int32_t     replyLen;   // 28: its length in bytes
+} JdorRequest;
+
+EM_JS(void, jdor_js_call, (em_proxying_ctx *ctx, JdorRequest *req), {
+    Module['jdorCall'](ctx, req);
+});
+
+EMSCRIPTEN_KEEPALIVE void *jdor_alloc(int n)        { return malloc(n); }
+EMSCRIPTEN_KEEPALIVE void  jdor_finish(em_proxying_ctx *ctx) { emscripten_proxy_finish(ctx); }
+
+static void jdorOnMain(em_proxying_ctx *ctx, void *arg)
+{
+    jdor_js_call(ctx, (JdorRequest *)arg);
+}
+
+} // extern "C"
+
+// pass a request to the main runtime thread and wait for the reply
+static std::string jdorCall(JdorRequest &req)
+{
+    req.reply = NULL;
+    req.replyLen = 0;
+    if (!emscripten_proxy_sync_with_ctx(emscripten_proxy_get_system_queue(),
+                                        emscripten_main_runtime_thread_id(), jdorOnMain, &req))
+    {
+        return std::string("C30:FAILURE -99 0 JDOR is not available");
+    }
+    std::string r(req.reply ? req.reply : "", req.replyLen);
+    free(req.reply);
+    return r;
+}
+
+
+// ---- reply records ---------------------------------------------------------
+
+struct Rec { char tag; std::string data; };
+
+static bool nextRec(const std::string &s, size_t &pos, Rec &rec)
+{
+    if (pos >= s.size()) return false;
+    rec.tag = s[pos++];
+    size_t colon = s.find(':', pos);
+    if (colon == std::string::npos) { pos = s.size(); return false; }
+    size_t len = strtoul(s.substr(pos, colon - pos).c_str(), NULL, 10);
+    rec.data = s.substr(colon + 1, len);
+    pos = colon + 1 + len;
+    return true;
+}
+
+static void putRec(std::string &s, char tag, const std::string &data)
+{
+    s += tag;
+    s += std::to_string(data.size());
+    s += ':';
+    s += data;
+}
+
+static RexxObjectPtr jdorClass = NULLOBJECT;      // .JdorObject, see JdorSetup()
+
+// build the Rexx object for the value record at pos
+static RexxObjectPtr toRexx(RexxThreadContext *c, const std::string &s, size_t &pos)
+{
+    Rec r;
+    if (!nextRec(s, pos, r)) return c->Nil();
+    switch (r.tag)
+    {
+        case 'S': return c->String(r.data.c_str(), r.data.size());
+        case 'J':
+        {
+            size_t t1 = r.data.find('\t'), t2 = r.data.find('\t', t1 + 1);
+            if (jdorClass == NULLOBJECT || t1 == std::string::npos || t2 == std::string::npos)
+            {
+                return c->String(r.data.c_str());
+            }
+            RexxArrayObject args = c->ArrayOfThree(c->String(r.data.substr(0, t1).c_str()),
+                                                   c->String(r.data.substr(t1 + 1, t2 - t1 - 1).c_str()),
+                                                   c->String(r.data.substr(t2 + 1).c_str()));
+            return c->SendMessage(jdorClass, "NEW", args);
+        }
+        case 'A':
+        {
+            size_t n = strtoul(r.data.c_str(), NULL, 10);
+            RexxArrayObject a = c->NewArray(n);
+            for (size_t i = 1; i <= n; i++) c->ArrayPut(a, toRexx(c, s, pos), i);
+            return a;
+        }
+        case 'T':
+        {
+            size_t n = strtoul(r.data.c_str(), NULL, 10);
+            RexxObjectPtr st = c->SendMessage0(c->FindClass("STRINGTABLE"), "NEW");
+            for (size_t i = 0; i < n; i++)
+            {
+                Rec k;
+                if (!nextRec(s, pos, k)) break;
+                RexxObjectPtr v = toRexx(c, s, pos);
+                c->SendMessage2(st, "PUT", v, c->String(k.data.c_str()));
+            }
+            return st;
+        }
+        default: return c->Nil();
+    }
+}
+
+// encode the value of a Rexx variable for JavaScript
+static void fromRexx(RexxThreadContext *c, std::string &out, RexxObjectPtr v)
+{
+    if (v == NULLOBJECT) { putRec(out, 'U', ""); return; }
+    if (v == c->Nil()) { putRec(out, 'N', ""); return; }
+    if (jdorClass != NULLOBJECT && c->IsInstanceOf(v, (RexxClassObject)jdorClass))
+    {
+        putRec(out, 'J', c->ObjectToStringValue(c->SendMessage0(v, "JDORREF")));
+        return;
+    }
+    if (c->IsArray(v))
+    {
+        size_t n = c->ArrayItems((RexxArrayObject)v), size = c->ArraySize((RexxArrayObject)v);
+        std::string items;
+        size_t count = 0;
+        for (size_t i = 1; i <= size && count < n; i++)
+        {
+            RexxObjectPtr item = c->ArrayAt((RexxArrayObject)v, i);
+            if (item == NULLOBJECT) continue;
+            fromRexx(c, items, item);
+            count++;
+        }
+        putRec(out, 'A', std::to_string(count));
+        out += items;
+        return;
+    }
+    putRec(out, 'S', c->ObjectToStringValue(v));
+}
+
+
+// ---- the command handler ---------------------------------------------------
+
+// where in the program the command was issued, for error messages
+static std::string where(RexxExitContext *c)
+{
+    RexxObjectPtr ctx = c->GetCallerContext();
+    if (ctx == NULLOBJECT) return "";
+    std::string line = c->ObjectToStringValue(c->SendMessage0(ctx, "LINE"));
+    RexxObjectPtr exe = c->SendMessage0(ctx, "EXECUTABLE");
+    std::string kind = exe == NULLOBJECT ? "" :
+        c->ObjectToStringValue(c->SendMessage0(c->SendMessage0(exe, "CLASS"), "ID"));
+    for (auto &ch : kind) ch = tolower(ch);
+    std::string name = c->ObjectToStringValue(c->SendMessage0(ctx, "NAME"));
+    size_t slash = name.find_last_of('/');
+    if (slash != std::string::npos) name = name.substr(slash + 1);
+    return "line # " + line + " in " + kind + " [" + name + "]";
+}
+
+static void sleepSeconds(double secs)
+{
+    if (secs <= 0) return;
+    struct timespec ts;
+    ts.tv_sec = (time_t)secs;
+    ts.tv_nsec = (long)((secs - (double)ts.tv_sec) * 1e9);
+    nanosleep(&ts, NULL);
+}
+
+// run one command; returns the result and tells whether a condition was raised
+static RexxObjectPtr runCommand(RexxExitContext *c, RexxIORedirectorContext *io, const char *address,
+                                const std::string &command, bool &raised)
+{
+    std::string vars;
+    std::string reply;
+    raised = false;
+    for (int round = 0; round < 64; round++)
+    {
+        JdorRequest req = {};
+        req.address = address;
+        req.command = command.c_str();
+        req.op = 1;
+        req.outRedir = io->IsOutputRedirected() ? 1 : 0;
+        req.vars = vars.empty() ? NULL : vars.c_str();
+        reply = jdorCall(req);
+        // a variable to resolve?  then ask again with its value
+        size_t pos = 0;
+        Rec r;
+        bool again = false;
+        while (nextRec(reply, pos, r))
+        {
+            if (r.tag == 'W')
+            {
+                putRec(vars, 'K', r.data);
+                fromRexx(c->threadContext, vars, c->GetContextVariable(r.data.c_str()));
+                again = true;
+            }
+        }
+        if (!again) break;
+    }
+
+    RexxObjectPtr result = NULLOBJECT;
+    size_t pos = 0;
+    Rec r;
+    while (nextRec(reply, pos, r))
+    {
+        switch (r.tag)
+        {
+            case 'O': io->WriteOutput(r.data.c_str(), r.data.size()); break;
+            case 'E': io->WriteError(r.data.c_str(), r.data.size()); break;
+            case 'Z': sleepSeconds(strtod(r.data.c_str(), NULL)); break;
+            case 'V':
+            {
+                RexxObjectPtr v = toRexx(c->threadContext, reply, pos);
+                c->SetContextVariable(r.data.c_str(), v);
+                break;
+            }
+            case 'R': result = toRexx(c->threadContext, reply, pos); break;
+            case 'C':
+            {
+                // "ERROR|FAILURE rc nr message", formatted as the Java handler does
+                char type[16] = "", rc[32] = "";
+                int nr = 0, n = 0;
+                sscanf(r.data.c_str(), "%15s %31s %d %n", type, rc, &nr, &n);
+                std::string msg = r.data.substr(n);
+                char head[96];
+                snprintf(head, sizeof head, "%-7s %3s command # %3d [", type, rc, nr);
+                std::string full = head + command + "] " + where(c) + " cause: [" + msg + "]";
+                if (io->IsErrorRedirected()) io->WriteError(full.c_str(), full.size());
+                RexxThreadContext *t = c->threadContext;
+                RexxArrayObject add = t->ArrayOfFour(t->String(full.c_str()), t->String(command.c_str()),
+                                                     t->String(rc), c->GetCallerContext());
+                t->RaiseCondition(type, t->String(command.c_str()), add, t->String(rc));
+                result = t->String(rc);
+                raised = true;
+                break;
+            }
+            default: break;
+        }
+    }
+    return result;
+}
+
+static RexxObjectPtr RexxEntry jdorHandler(RexxExitContext *c, RexxStringObject address,
+                                           RexxStringObject command, RexxIORedirectorContext *io)
+{
+    const char *addr = c->CString(address);
+    bool raised = false;
+    RexxObjectPtr result = runCommand(c, io, addr, c->CString(command), raised);
+    if (!raised && io->IsInputRedirected())
+    {
+        // the commands come from the redirected input (the triggering one is
+        // processed first, like the Java handler does)
+        for (;;)
+        {
+            CSTRING data = NULL;
+            size_t len = 0;
+            io->ReadInput(&data, &len);
+            if (data == NULL) break;
+            result = runCommand(c, io, addr, std::string(data, len), raised);
+            if (raised || c->CheckCondition()) break;
+        }
+    }
+    return result;
+}
+
+
+// ---- the package "jdor" ----------------------------------------------------
+
+// JdorSetup(class): the class of the objects commands return (.JdorObject)
+RexxRoutine1(int, JdorSetup, RexxObjectPtr, cls)
+{
+    if (jdorClass == NULLOBJECT) jdorClass = context->RequestGlobalReference(cls);
+    return 0;
+}
+
+// JdorNewHandler(): a new drawing handler (an image and its window); returns
+// its reference (a JdorObject of kind HANDLER)
+RexxRoutine0(RexxObjectPtr, JdorNewHandler)
+{
+    JdorRequest req = {};
+    req.address = "";
+    req.command = "";
+    req.op = 2;
+    std::string reply = jdorCall(req);
+    size_t pos = 0;
+    Rec r;
+    while (nextRec(reply, pos, r))
+    {
+        if (r.tag == 'R') return toRexx(context->threadContext, reply, pos);
+    }
+    return context->Nil();
+}
+
+// JdorAddEnvironment(name, handler): commands to ADDRESS name go to handler
+RexxRoutine2(int, JdorAddEnvironment, CSTRING, name, RexxObjectPtr, handler)
+{
+    std::string ref;
+    if (jdorClass != NULLOBJECT && context->IsInstanceOf(handler, (RexxClassObject)jdorClass))
+    {
+        ref = context->ObjectToStringValue(context->SendMessage0(handler, "JDORREF"));
+    }
+    else
+    {
+        ref = context->ObjectToStringValue(handler);
+    }
+    std::string upper(name);
+    for (auto &ch : upper) ch = toupper(ch);
+    JdorRequest req = {};
+    req.address = upper.c_str();
+    req.command = ref.c_str();
+    req.op = 3;
+    std::string reply = jdorCall(req);
+    if (reply.find("C") == 0)
+    {
+        context->ThrowException1(Rexx_Error_Incorrect_call_user_defined, context->String("not a JDOR handler"));
+        return 1;
+    }
+    context->threadContext->AddCommandEnvironment(upper.c_str(), (REXXPFN)jdorHandler,
+                                                  REDIRECTING_COMMAND_ENVIRONMENT);
+    return 0;
+}
+
+static RexxRoutineEntry jdorRoutines[] =
+{
+    REXX_TYPED_ROUTINE(JdorSetup, JdorSetup),
+    REXX_TYPED_ROUTINE(JdorNewHandler, JdorNewHandler),
+    REXX_TYPED_ROUTINE(JdorAddEnvironment, JdorAddEnvironment),
+    REXX_LAST_ROUTINE()
+};
+
+static RexxPackageEntry jdorPackage =
+{
+    STANDARD_PACKAGE_HEADER
+    REXX_INTERPRETER_5_0_0,
+    "jdor",
+    "1.0.0",
+    NULL,
+    NULL,
+    jdorRoutines,
+    NULL
+};
+
+static const RexxLibraryPackage extraPackages[] =
+{
+    { "jdor", &jdorPackage },
+    { NULL, NULL }
+};
+
+// the hook in interpreter/package/PackageManager.cpp
+extern "C" const RexxLibraryPackage *orx_wasm_extra_packages(void)
+{
+    return extraPackages;
+}
