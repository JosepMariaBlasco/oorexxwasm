+/*
+ * BSF.CLS of the browser build of ooRexx/WASM: NOT the ooRexx-Java bridge.
+ * There is no Java in the browser.  This package provides just what JDOR
+ * programs written for BSF4ooRexx850 use, so they run unchanged on the JDOR
+ * handler of this build (see jdor.cls):
+ *
+ *    .bsf~new("org.oorexx.handlers.jdor.JavaDrawingHandler")
+ *    bsf.importClass("org.oorexx.handlers.jdor.JavaDrawingHandler")  (~new, ~version)
+ *    BsfCommandHandler("add", name, handler)
+ *    bsf.createJavaArrayOf(type, values...)   -> an ooRexx array
+ *    .java.lang.System~getProperty(name)      (a few properties)
+ *    pp(value)                                -> "[value]"
+ *
+ * Anything else raises a syntax error that says so.
+ */
+.local~setEntry("JAVA.LANG.SYSTEM", .BsfJavaLangSystem)
+
+::requires "jdor.cls"
+
+::class bsf public
+::method new class
+  use arg className
+  if className == "org.oorexx.handlers.jdor.JavaDrawingHandler" then return newJdorHandler()
+  raise syntax 93.900 array("BSF.CLS of ooRexx/WASM (no Java in the browser): only JDOR's handler is available, not" className)
+
+::routine bsf.importClass public
+  use arg className
+  if className == "org.oorexx.handlers.jdor.JavaDrawingHandler" then return .BsfJdorHandlerClass
+  raise syntax 93.900 array("BSF.CLS of ooRexx/WASM (no Java in the browser): only JDOR's handler is available, not" className)
+
+::routine bsf.loadClass public
+  use arg className
+  return bsf.importClass(className)
+
+::routine BsfCommandHandler public
+  use strict arg operation, name, handler=.nil
+  select
+    when operation~caselessEquals("add") then do
+      call bindJdorHandler name, handler
+      return .true
+    end
+    otherwise
+      raise syntax 93.900 array("BSF.CLS of ooRexx/WASM: BsfCommandHandler supports only ""add""")
+  end
+
+::routine bsf.createJavaArrayOf public
+  use arg type, ...
+  return arg(2, "array")
+
+::routine pp public
+  return "[" || arg(1)~string || "]"
+
+::class BsfJdorHandlerClass          -- what bsf.importClass returns for the handler class
+::method new class
+  return newJdorHandler()
+::method version class
+  return "100.20230718"
+::method string class
+  return "org.oorexx.handlers.jdor.JavaDrawingHandler"
+
+::class BsfJavaLangSystem
+::method getProperty class
+  use strict arg name, default=.nil
+  select case name
+    when "user.home" then return "/home/rexx"
+    when "user.dir" then return directory()
+    when "user.name" then return userid()
+    when "file.separator" then return "/"
+    when "path.separator" then return ":"
+    when "line.separator" then return "0a"x
+    when "os.name" then return "WebAssembly"
+    when "java.version" then return "none (ooRexx/WASM in the browser)"
+    otherwise return default
+  end
