+    if (s.indexOf('.') < 0) return parseIntJ(s);
+    const d = parseDoubleJ(s);
+    return Math.round(d) | 0;        // Math.round(double) -> (int)
+  }
+  const BOOLS = { '0': false, '1': true, '.FALSE': false, '.TRUE': true, 'FALSE': false, 'TRUE': true };
+  const isBool = (s) => Object.prototype.hasOwnProperty.call(BOOLS, s.toUpperCase());
+  const boolOf = (s) => BOOLS[s.toUpperCase()] === true;
+  const VARCHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_!?';
+  const isVarName = (s) => s.length > 0 && VARCHARS.indexOf(s[0]) >= 0;
+
+  // "(1,2,3)" -> numbers (JDOR's Rexx array expressions)
+  function arrayExpr(s, parse) {
+    const a = s.indexOf('(');
+    if (a < 0) return null;
+    const b = s.indexOf(')', a);
+    if (b < 0) return null;
