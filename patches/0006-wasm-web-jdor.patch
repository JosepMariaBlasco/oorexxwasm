+    const finish = (bytes) => {
+      const p = _jdor_alloc(bytes.length + 1);
+      HEAPU8.set(bytes, p);
+      HEAPU8[p + bytes.length] = 0;
+      HEAP32[(req + 24) >> 2] = p;
+      HEAP32[(req + 28) >> 2] = bytes.length;
+      _jdor_finish(ctx);
+    };
+    const fail = (e) => {
+      const parts = []; rec(parts, 'C', 'FAILURE -99 0 ' + (e && e.stack || e));
+      finish(reply(parts));
+    };
