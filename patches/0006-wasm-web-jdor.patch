index 62f7ae3..581badc 100755
--- a/wasm/build-web.sh
+++ b/wasm/build-web.sh
@@ -43,7 +43,8 @@
 #
 # Usage: wasm/build-web.sh [BUILD_DIR=build-wasm] [OUTDIR=BUILD_DIR/bin-web]
 #   (BUILD_DIR: a build made by wasm/build-wasm.sh; EM_CONFIG from it)
-# Output: OUTDIR/{rexx.js,rexx.wasm,rexx.data,ooRexx.js,ooRexx-worker.js}
+# Output: OUTDIR/{rexx.js,rexx.wasm,rexx.data,ooRexx.js,ooRexx-worker.js,
+#         polygon-clipping.umd.min.js (JDOR's areas, loaded on first use)}
 set -euo pipefail
 SRC=$(cd "$(dirname "$0")/.." && pwd)
 BUILD=$(cd "${1:-$SRC/build-wasm}" && pwd)
@@ -53,6 +54,10 @@ EMXX=$(sed -E 's/ .*//' "$BUILD/CMakeFiles/rexx_exe.dir/link.txt")
 
 # the interactive stdin (read() of fd 0 served from a ring in shared memory)
 "$EMXX" -O3 -pthread -c "$SRC/wasm/web-stdin.cpp" -o "$BUILD/web-stdin.o"
+# JDOR, the drawing command handler, on the canvas (package "jdor"); exceptions as
+# in CMakeLists.txt (exnref: a module that mixes encodings does not compile)
+"$EMXX" -O3 -std=gnu++11 -pthread -fwasm-exceptions -sWASM_LEGACY_EXCEPTIONS=0 -DHAVE_CONFIG_H -DOPSYS_EMSCRIPTEN \
+  -I"$SRC/api" -I"$SRC/api/platform/unix" -I"$BUILD" -c "$SRC/wasm/web-jdor.cpp" -o "$BUILD/web-jdor.o"
 
 # the portable extension classes (not ncurses: no native library here)
 PRELOAD=()
@@ -61,6 +66,10 @@ for cls in rxsock/socket.cls rxsock/streamsocket.cls rxsock/mime.cls rxsock/smtp
            csvStream/csvStream.cls dateparser/dateparser.cls; do
   PRELOAD+=("--preload-file" "$SRC/extensions/$cls@/usr/lib/ooRexx/$(basename "$cls")")
 done
+# JDOR's classes; BSF.CLS (also as bsf.cls) lets BSF4ooRexx's JDOR programs run unchanged
+PRELOAD+=("--preload-file" "$SRC/wasm/web/jdor.cls@/usr/lib/ooRexx/jdor.cls"
+          "--preload-file" "$SRC/wasm/web/BSF.CLS@/usr/lib/ooRexx/BSF.CLS"
+          "--preload-file" "$SRC/wasm/web/BSF.CLS@/usr/lib/ooRexx/bsf.cls")
 
 # Emscripten's default list plus mainScriptUrlOrBlob: the pthreads must load
 # rexx.js, not the worker script that hosts the runtime
@@ -72,12 +81,12 @@ wasm,websocket,mainScriptUrlOrBlob]"
 cmd=$(cat "$BUILD/CMakeFiles/rexx_exe.dir/link.txt")
 cmd=$(sed -E 's/--preload-file [^ ]+//g; s/-sENVIRONMENT=[^ ]+//' <<<"$cmd")
 cmd=${cmd//-o bin\/rexx.js/-o $OUT\/rexx.js}
-(cd "$BUILD" && eval "$cmd" "$BUILD/web-stdin.o" \
+(cd "$BUILD" && eval "$cmd" "$BUILD/web-stdin.o" "$BUILD/web-jdor.o" \
    -Wl,--wrap=read,--wrap=write \
    -sENVIRONMENT=web,worker -sMODULARIZE=1 -sEXPORT_NAME=createOoRexx \
    "-sINCOMING_MODULE_JS_API=$INCOMING" \
-   --pre-js "$SRC/wasm/web-pre.js" \
+   --pre-js "$SRC/wasm/web-pre.js" --pre-js "$SRC/wasm/web-jdor.js" \
    --preload-file "$BUILD/bin/rexx.img@/rexx.img" \
    "${PRELOAD[@]}" ${EXTRA_LDFLAGS:-})
-cp "$SRC/wasm/web/ooRexx.js" "$SRC/wasm/web/ooRexx-worker.js" "$OUT/"
+cp "$SRC/wasm/web/ooRexx.js" "$SRC/wasm/web/ooRexx-worker.js" "$SRC/wasm/web/polygon-clipping.umd.min.js" "$OUT/"
 ls -l "$OUT" | awk 'NR>1{print $5, $9}'
diff --git a/wasm/tests/web-api.html b/wasm/tests/web-api.html
index e3fc7a7..19d0aeb 100644
--- a/wasm/tests/web-api.html
+++ b/wasm/tests/web-api.html
@@ -44,6 +44,7 @@
 // (trace: the output marked as trace, errmsg: marked as an error message,
 // debug: one flag per input request, true when .debugInput asked)
 // inputs: lines typed one per input request (interactive stdin); then EOF
+// jdor: JDOR windows {win: {title, visible, frames, probe: [r,g,b,a] at o.probe}}
 let rexx = null;
 window.rexxReady = OoRexx.load().then((r) => { rexx = r; return true; }, (e) => String(e));
 window.rexxRun = async (source, o = {}) => {
@@ -52,16 +53,30 @@ window.rexxRun = async (source, o = {}) => {
   const mark = (t, kind) => { if (kind === 'trace') trace += t; else if (kind === 'error') errmsg += t; };
   const inputs = (o.inputs || []).slice();
   const files = Object.assign({ '/home/rexx/prog.rex': source }, o.files || {});
+  const jdor = {};
+  const onJdor = (m) => {
+    const w = jdor[m.win] = jdor[m.win] || { frames: 0 };
+    if (m.op === 'window') Object.assign(w, { title: m.title, visible: m.visible, frame: m.frame, width: m.width, height: m.height });
+    else if (m.op === 'frame') {
+      w.frames++;
+      if (o.probe) {
+        const c = new OffscreenCanvas(m.bitmap.width, m.bitmap.height), x = c.getContext('2d');
+        x.drawImage(m.bitmap, 0, 0);
+        w.probe = Array.from(x.getImageData(o.probe[0], o.probe[1], 1, 1).data);
+      }
+      m.bitmap.close();
+    }
+  };
   const run = rexx.run({
     args: ['prog.rex'].concat(o.args || []), files, stdin: o.stdin,
-    onOut: (t, kind) => { out += t; mark(t, kind); }, onErr: (t, kind) => { err += t; mark(t, kind); },
+    onOut: (t, kind) => { out += t; mark(t, kind); }, onErr: (t, kind) => { err += t; mark(t, kind); }, onJdor,
     onInput: (info) => { asks++; debug.push(!!(info && info.debug));
       if (inputs.length) run.write(inputs.shift() + '\n'); else run.close(); },
   });
   if (o.stopAfterMs) setTimeout(() => run.stop(), o.stopAfterMs);
   const r = await run.done;
   const files2 = {};
-  for (const [p, b] of Object.entries(r.files)) files2[p] = new TextDecoder().decode(b);
-  return { out, err, asks, trace, errmsg, debug, rc: r.rc, stopped: r.stopped, error: r.error, ms: Math.round(r.ms), files: files2 };
+  for (const [p, b] of Object.entries(r.files)) files2[p] = /\.png$/i.test(p) ? 'PNG ' + b.length : new TextDecoder().decode(b);
+  return { out, err, asks, trace, errmsg, debug, jdor, rc: r.rc, stopped: r.stopped, error: r.error, ms: Math.round(r.ms), files: files2 };
 };
 </script>
