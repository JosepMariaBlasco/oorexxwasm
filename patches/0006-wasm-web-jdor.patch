+/*
+ * JDOR in the browser build of ooRexx/WASM: the drawing command handler of
+ * BSF4ooRexx850 ("Java Drawing for ooRexx", Rony G. Flatscher), its commands
+ * on the HTML canvas (wasm/web-jdor.cpp, wasm/web-jdor.js).  No Java: the
+ * commands are served by the browser build itself.
+ *
+ *    address jdor                 -- select the JDOR environment
+ *    newImage 300 200; color red; fillRect 100 50; winShow
+ *    ::requires "jdor.cls"        -- set up the JDOR environment
+ *
+ * Requiring this package sets up the ADDRESS environment JDOR, served by a
+ * handler of its own (an image and its window, created when first used);
+ * a routine selects it with ADDRESS JDOR, as any other environment.
+ * addJdorHandler([name]) gives an environment (default JDOR) a new handler,
+ * for a second window ("call addJdorHandler 'SDOR'") or a fresh start.  The
+ * commands are documented in BSF4ooRexx's jdor_doc.html.
+ *
+ * Objects that commands return (colors, fonts, images, shapes, ...) are
+ * JdorObject instances that say what they are: STRING "a JDOR Image (#99)",
+ * TOSTRING "JDOR Image #99: 500x500, type 2 (ARGB), an OffscreenCanvas",
+ * KIND "Image"; the getters work (rc~width, rc~getWidth, rc~red), and
+ * passing one back by variable name works as in JDOR.
+ */
+call JdorSetup .JdorObject
+call addJdorHandler                 -- set up the JDOR environment
+
+/** Gives ADDRESS environmentName (default JDOR) a new JDOR handler and returns it. */
+::routine addJdorHandler public
+  use strict arg environmentName="JDOR"
+  h = JdorNewHandler()
+  call JdorAddEnvironment environmentName, h
+  return h
+
+/** Returns a new JDOR handler (an image and its window), not yet bound to an ADDRESS name. */
+::routine newJdorHandler public
+  return JdorNewHandler()
+
+/** Lets ADDRESS environmentName serve the commands with handler. */
+::routine bindJdorHandler public
+  use strict arg environmentName, handler
+  call JdorAddEnvironment environmentName, handler
+  return handler
+
+/** The version of JDOR whose commands this handler implements. */
+::routine jdorVersion public
+  return "100.20230718"
+
+::requires "jdor" LIBRARY
+
+/** An object of the JDOR handler (Color, Font, Image, Shape, ...). */
+::class JdorObject public
+::method init
+  expose jkind ref display attrs
+  use strict arg jkind, ref, rest
+  parse var rest display "09"x rest
+  attrs = .stringTable~new
+  do while rest \== ""
+    parse var rest pair "09"x rest
+    parse var pair k "=" v
+    attrs[k~upper] = v
+  end
+::method kind                       -- Color, Font, Image, Shape, Stroke, ...
+  expose attrs
+  return attrs["KIND"]
+::method jdorRef                    -- for the handler: which object this is
+  expose jkind ref
+  return jkind || "09"x || ref
+::method string                     -- a JDOR Image (#99)
+  expose ref attrs
+  return "a JDOR" attrs["KIND"] "(#"ref~substr(ref~pos(":") + 1)")"
+::method toString                   -- JDOR Image #99: what it is
+  expose display
+  return display
+::method unknown                    -- getters: x~size, x~getSize, x~isBold
+  expose attrs
+  use arg name, args
+  n = name~upper
+  if attrs~hasIndex(n) then return attrs[n]
+  if n~startsWith("GET"), attrs~hasIndex(n~substr(4)) then return attrs[n~substr(4)]
+  raise syntax 97.1 array(self, name)
