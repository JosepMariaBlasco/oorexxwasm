+/* "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT          */
+/* LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS          */
+/* FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT   */
+/* OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,      */
+/* SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED   */
+/* TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA,        */
+/* OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY     */
+/* OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING    */
+/* NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS         */
+/* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.               */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+/******************************************************************************/
+/* cmdhandler.cpp: command environments (ADDRESS) written in Rexx             */
+/*                                                                            */
+/* One native redirecting command handler serves every environment that      */
+/* .CommandHandler~register adds.  For each command it creates a             */
+/* .CommandContext (valid for that command only) and sends                    */
+/*                                                                            */
+/*     handlerObject~command(commandString, commandContext)                   */
+/*                                                                            */
+/* The context gives the Rexx code the command's redirected input, output    */
+/* and error (ADDRESS ... WITH) and the variables of the code that issued     */
+/* the command (the caller's variable pool, as classic subcommand handlers    */
+/* have).  The method's result is RC; the context can ask for an ERROR or     */
+/* FAILURE condition; a SYNTAX error in the method reaches the caller.        */
+/*                                                                            */
+/* The registrations live in .local (per interpreter instance, as the        */
+/* command environments themselves): .local~CommandHandlers, a Directory     */
+/* name -> handler object, and .local~CommandContext, the context class.     */
+/* Only the public native API is used (AddCommandEnvironment, the exit and    */
+/* I/O redirector contexts): nothing in the interpreter is changed.           */
+/******************************************************************************/
+
+#include "oorexxapi.h"
+#include <string.h>
+#include <string>
+
+// what a .CommandContext's CSELF buffer holds
+struct CommandState
+{
+    RexxExitContext         *exit;      // context of the code that issued the command
+    RexxIORedirectorContext *io;        // its ADDRESS ... WITH redirection
+    RexxThreadContext       *thread;    // the thread (activity) running the command
+    bool                     valid;     // only while the command runs
+};
+
+
+static std::string upper(const char *s, size_t len)
+{
+    std::string r(s, len);
+    for (size_t i = 0; i < r.size(); i++)
+    {
+        if (r[i] >= 'a' && r[i] <= 'z')
+        {
+            r[i] = (char)(r[i] - 'a' + 'A');
+        }
+    }
+    return r;
+}
+
+
+/**
+ * The command handler shared by every registered environment.
+ */
+static RexxObjectPtr RexxEntry commandHandler(RexxExitContext *c, RexxStringObject address,
+    RexxStringObject command, RexxIORedirectorContext *io)
+{
+    std::string name = upper(c->StringData(address), c->StringLength(address));
+    // .local~CommandHandlers[name] and .local~CommandContext (cmdhandler.cls)
+    RexxDirectoryObject local = c->GetLocalEnvironment();
+    RexxObjectPtr handlers = local != NULLOBJECT ? c->DirectoryAt(local, "COMMANDHANDLERS") : NULLOBJECT;
+    RexxObjectPtr handler = NULLOBJECT;
+    if (handlers != NULLOBJECT && c->IsDirectory(handlers))
+    {
+        handler = c->DirectoryAt((RexxDirectoryObject)handlers, name.c_str());
+    }
+    RexxObjectPtr contextClass = local != NULLOBJECT ? c->DirectoryAt(local, "COMMANDCONTEXT") : NULLOBJECT;
+    if (handler == NULLOBJECT || handler == c->Nil() || contextClass == NULLOBJECT)
+    {
+        // no handler (never registered, or deregistered): like an unknown environment
+        RexxObjectPtr rc = c->WholeNumber(RXSUBCOM_NOTREG);
+        c->RaiseCondition("FAILURE", command, NULLOBJECT, rc);
+        return rc;
+    }
+    RexxBufferObject buffer = c->NewBuffer(sizeof(CommandState));
+    CommandState *state = (CommandState *)c->BufferData(buffer);
+    state->exit = c;
+    state->io = io;
+    state->thread = c->threadContext;
+    state->valid = true;
+
+    RexxObjectPtr context = c->SendMessage2(contextClass, "NEW", buffer, address);
+    if (c->CheckCondition())
+    {
+        return NULLOBJECT;
+    }
+    RexxObjectPtr result = c->SendMessage2(handler, "COMMAND", command, context);
+    if (!c->CheckCondition())
+    {
+        // write what the output streams' charout left, while still valid
+        c->SendMessage0(context, "FINISH");
+    }
+    state->valid = false;               // the context is dead from now on
+    if (c->CheckCondition())
+    {
+        // a SYNTAX error in the handler: the interpreter raises it in the caller
+        return NULLOBJECT;
+    }
+
+    // did the handler ask for a condition (caller~raise)?
+    RexxObjectPtr pending = c->SendMessage0(context, "PENDING");
+    if (pending != NULLOBJECT && pending != c->Nil() && c->IsArray(pending))
+    {
+        RexxArrayObject request = (RexxArrayObject)pending;
+        CSTRING name = c->ObjectToStringValue(c->ArrayAt(request, 1));
+        RexxObjectPtr rc = c->ArrayAt(request, 2);
+        RexxObjectPtr description = c->ArrayAt(request, 3);
+        RexxObjectPtr additional = c->ArrayAt(request, 4);
+        if (strcmp(name, "SYNTAX") == 0)
+        {
+            // raised here, so it shows at the caller's ADDRESS clause, without
+            // the handler's frames; rc is the error number (major * 1000 + minor)
+            wholenumber_t code = 0;
+            c->ObjectToWholeNumber(rc, &code);
+            c->RaiseException((size_t)code, (RexxArrayObject)additional);
+            return NULLOBJECT;
+        }
+        RexxStringObject text = (description != NULLOBJECT && description != c->Nil())
+            ? c->ObjectToString(description) : command;
+        if (additional == c->Nil())
+        {
+            additional = NULLOBJECT;
+        }
+        c->RaiseCondition(name, text, additional, rc);
+        return rc;
+    }
+    return result != NULLOBJECT ? result : c->WholeNumber(0);
+}
+
+
+/**
+ * .CommandHandler~register's native part: makes the name a command
+ * environment of this interpreter instance served by commandHandler (the
+ * handler object itself is in .local~CommandHandlers).  Registering a name
+ * again changes nothing.
+ */
+RexxRoutine1(int, CmdHandler_Register, CSTRING, name)
+{
+    std::string key = upper(name, strlen(name));
+    context->threadContext->AddCommandEnvironment(key.c_str(), (REXXPFN)commandHandler,
+        REDIRECTING_COMMAND_ENVIRONMENT);
+    return 0;
+}
+
+
+/**
+ * The exit and I/O contexts belong to commandHandler's native activation,
+ * which is still running (inside SendMessage2) while the handler's methods
+ * use them from activations of their own.  Every blocking call through
+ * those contexts ends by turning off that outer activation's condition
+ * traps (ApiContext's destructor), so a SYNTAX error raised later in the
+ * handler would no longer be caught by commandHandler's SendMessage2 and
+ * would unwind through its C++ frames (a crash).  The non-blocking
+ * IsInputRedirected turns the traps on again without turning them off:
+ * call it after every blocking call through state->exit or state->io.
+ */
+static inline void retrap(CommandState *state)
+{
+    state->io->IsInputRedirected();
+}
+
+
+/**
+ * The state of a .CommandContext, or a SYNTAX error once its command ended
+ * or when it is used from another thread.  The exit and I/O contexts belong
+ * to the command's activity: used from another one (a method that REPLYs and
+ * goes on, or a thread the handler hands the context to) they would run on
+ * an activation another thread is using, and the command may end (and its
+ * contexts go away) meanwhile, whatever VALID said a moment before.
+ */
+static CommandState *liveState(RexxMethodContext *context, void *self)
+{
+    CommandState *state = (CommandState *)self;
+    if (state == NULL || !state->valid)
+    {
+        context->RaiseException1(Rexx_Error_Execution_user_defined,
+            context->String("this CommandContext belongs to a command that has ended"));
+        return NULL;
+    }
+    if (context->threadContext != state->thread)
+    {
+        context->RaiseException1(Rexx_Error_Execution_user_defined,
+            context->String("this CommandContext can only be used on the thread of its command"));
+        return NULL;
+    }
+    return state;
+}
+
+
+/**
+ * The next line of the redirected input, .nil at its end (the .CommandInput
+ * stream's readLine).
+ */
+RexxMethod1(RexxObjectPtr, CmdContext_LineIn, CSELF, self)
+{
+    CommandState *state = liveState(context, self);
+    if (state == NULL)
+    {
+        return NULLOBJECT;
+    }
+    CSTRING data = NULL;
+    size_t length = 0;
+    state->io->ReadInput(&data, &length);
+    retrap(state);
+    if (data == NULL)
+    {
+        return context->Nil();
+    }
+    return context->NewString(data, length);
+}
+
+
+/**
+ * write(stream, line): one line to the redirected output ("O") or error
+ * ("E") (the .CommandOutput streams').
+ */
+RexxMethod3(RexxObjectPtr, CmdContext_Write, CSTRING, stream, RexxStringObject, line, CSELF, self)
+{
+    CommandState *state = liveState(context, self);
+    if (state == NULL)
+    {
+        return NULLOBJECT;
+    }
+    if (stream[0] == 'E' || stream[0] == 'e')
+    {
+        state->io->WriteError(context->StringData(line), context->StringLength(line));
+        retrap(state);
+    }
+    else
+    {
+        state->io->WriteOutput(context->StringData(line), context->StringLength(line));
+        retrap(state);
+    }
+    return NULLOBJECT;
+}
+
+
+/**
+ * ~isRedirected(which): "Input", "Output", "Error" (first letter), or
+ * "Same" (output and error go to the same target).
+ */
+RexxMethod2(logical_t, CmdContext_IsRedirected, CSTRING, which, CSELF, self)
+{
+    CommandState *state = liveState(context, self);
+    if (state == NULL)
+    {
+        return 0;
+    }
+    switch (which[0])
+    {
+        case 'I': case 'i': return state->io->IsInputRedirected();
+        case 'O': case 'o': return state->io->IsOutputRedirected();
+        case 'E': case 'e': return state->io->IsErrorRedirected();
+        case 'S': case 's': return state->io->AreOutputAndErrorSameTarget();
+    }
+    context->RaiseException1(Rexx_Error_Incorrect_method_user_defined,
+        context->String("isRedirected: the argument must be Input, Output, Error or Same"));
+    return 0;
+}
+
+
+/**
+ * caller[name]: the caller's variable, or .nil when it has no value.
+ */
+RexxMethod2(RexxObjectPtr, CmdContext_GetVar, CSTRING, name, CSELF, self)
+{
+    CommandState *state = liveState(context, self);
+    if (state == NULL)
+    {
+        return NULLOBJECT;
+    }
+    RexxObjectPtr value = state->exit->GetContextVariable(name);
+    retrap(state);
+    return value == NULLOBJECT ? context->Nil() : value;
+}
+
+
+/**
+ * ~hasVar(name): whether the caller's variable has a value.
+ */
+RexxMethod2(logical_t, CmdContext_HasVar, CSTRING, name, CSELF, self)
+{
+    CommandState *state = liveState(context, self);
+    if (state == NULL)
+    {
+        return 0;
+    }
+    RexxObjectPtr value = state->exit->GetContextVariable(name);
+    retrap(state);
+    return value != NULLOBJECT;
+}
+
+
+/**
+ * caller[name] = value: assigns the caller's variable (simple, stem or
+ * compound; a compound's tail is resolved in the caller, as Rexx does).
+ */
+RexxMethod3(RexxObjectPtr, CmdContext_SetVar, CSTRING, name, RexxObjectPtr, value, CSELF, self)
+{
+    CommandState *state = liveState(context, self);
+    if (state == NULL)
+    {
+        return NULLOBJECT;
+    }
+    state->exit->SetContextVariable(name, value);
+    retrap(state);
+    return NULLOBJECT;
+}
+
+
+/**
+ * ~dropVar(name): drops the caller's variable.
+ */
+RexxMethod2(RexxObjectPtr, CmdContext_DropVar, CSTRING, name, CSELF, self)
+{
+    CommandState *state = liveState(context, self);
+    if (state == NULL)
+    {
+        return NULLOBJECT;
+    }
+    state->exit->DropContextVariable(name);
+    retrap(state);
+    return NULLOBJECT;
+}
+
+
+/**
+ * ~variables: a Directory with all the caller's variables.
+ */
+RexxMethod1(RexxObjectPtr, CmdContext_Variables, CSELF, self)
+{
+    CommandState *state = liveState(context, self);
+    if (state == NULL)
+    {
+        return NULLOBJECT;
+    }
+    RexxDirectoryObject all = state->exit->GetAllContextVariables();
+    retrap(state);
+    return all;
+}
+
+
+/**
+ * Nothing, or the SYNTAX error of liveState: for the methods written in
+ * Rexx that use no other native method (raise).
+ */
+RexxMethod1(int, CmdContext_Check, CSELF, self)
+{
+    liveState(context, self);
+    return 0;
+}
+
+
+/**
+ * ~isValid: whether the command is still running.
+ */
+RexxMethod1(logical_t, CmdContext_IsValid, CSELF, self)
+{
+    CommandState *state = (CommandState *)self;
+    return state != NULL && state->valid;
+}
+
+
+RexxRoutineEntry cmdhandler_routines[] =
+{
+    REXX_TYPED_ROUTINE(CmdHandler_Register, CmdHandler_Register),
+    REXX_LAST_ROUTINE()
+};
+
+RexxMethodEntry cmdhandler_methods[] =
+{
+    REXX_METHOD(CmdContext_LineIn,       CmdContext_LineIn),
+    REXX_METHOD(CmdContext_Write,        CmdContext_Write),
+    REXX_METHOD(CmdContext_IsRedirected, CmdContext_IsRedirected),
+    REXX_METHOD(CmdContext_GetVar,       CmdContext_GetVar),
+    REXX_METHOD(CmdContext_HasVar,       CmdContext_HasVar),
+    REXX_METHOD(CmdContext_SetVar,       CmdContext_SetVar),
+    REXX_METHOD(CmdContext_DropVar,      CmdContext_DropVar),
+    REXX_METHOD(CmdContext_Variables,    CmdContext_Variables),
+    REXX_METHOD(CmdContext_IsValid,      CmdContext_IsValid),
+    REXX_METHOD(CmdContext_Check,        CmdContext_Check),
+    REXX_LAST_METHOD()
+};
+
+RexxPackageEntry cmdhandler_package_entry =
+{
+    STANDARD_PACKAGE_HEADER
+    REXX_INTERPRETER_5_0_0,              // redirecting command handlers: 5.0
+    "cmdhandler",                        // name of the package
+    "1.0",                               // package information
+    NULL,                                // no load/unload functions
+    NULL,
+    cmdhandler_routines,                 // the exported routines
+    cmdhandler_methods                   // the exported methods
+};
+
+// package loading stub.
+OOREXX_GET_PACKAGE(cmdhandler);
