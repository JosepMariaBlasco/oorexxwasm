diff --git a/wasm/tests/cmdhandler.rex b/wasm/tests/cmdhandler.rex
new file mode 100644
index 0000000..54ebe1e
--- /dev/null
+++ b/wasm/tests/cmdhandler.rex
@@ -0,0 +1,418 @@
+/* cmdhandler.rex: tests of cmdhandler.cls (command environments written in */
+/* Rexx).  Portable: native and WASM builds.  Prints one line per check and */
+/* exits 1 if any fails.                                                    */
+/*   rexx cmdhandler.rex                                                    */
+signal on syntax name unexpected
+.local~ok = 0; .local~bad = 0
+
+.CommandHandler~register("t", .T~new)          -- lower case on purpose
+
+-- results and RC
+address t "RETURN 7";        call check "RC from the method", rc == 7
+address t "RETURN hello";    call check "RC any string", rc == "hello"
+address t "NOTHING";         call check "no result: RC 0", rc == 0
+address t "ENV";             call check "environment name", rc == "T"
+
+-- the caller's variables
+address t "SET greeting hola mundo"
+call check "caller[name] = value", greeting == "hola mundo"
+i = 3
+address t "SET a.i tres"
+call check "caller[] compound, tail resolved in the caller", a.3 == "tres"
+address t "SET s. 0"
+call check "caller[] stem (default value)", s.xyz == 0
+drop nope
+address t "HAS nope";        call check "hasVar unset", rc == 0
+address t "GET nope";        call check "caller[] with no value: its name", rc == "NOPE"
+k = "x y"
+address t "GET nope.k.1";    call check "caller[] with no value: the derived name", rc == "NOPE.x y.1"
+nilvar = .nil; t = .nil
+address t "GET nilvar";      call check "caller[] of a variable whose value is .nil: .nil", rc == "The NIL object"
+address t "GET nope.t";      call check "caller[] with no value, tail whose value is .nil", rc == "NOPE.The NIL object"
+drop t
+address t "SYNONYMS"
+call check "getVar/setVar: exact synonyms of [] and []=", rc == "1 NOPE2" & syn.k == 7
+address t "HAS greeting";    call check "hasVar set", rc == 1
+address t "GET greeting";    call check "caller[name]", rc == "hola mundo"
+address t "GET GrEeTiNg";    call check "caller[] names are not case-sensitive", rc == "hola mundo"
+address t "DROP greeting";   call check "dropVar", symbol("greeting") == "LIT"
+mine = "x"
+address t "VARS";            call check "variables: the caller's, not the handler's", rc == "1 0"
+address t "BADNAME";         call check "bad variable name: SYNTAX 93.900 caught inside", rc == "93.900"
+call check "variables inside a procedure", inproc() == "local"
+
+-- redirection
+in.1 = "uno"; in.2 = "dos"; in.0 = 2
+address t "UPPER" with input stem in. output stem out.
+call check "WITH INPUT / OUTPUT stems", out.0 == 2 & out.1 == "UNO" & out.2 == "DOS"
+arr = .array~of("a", "b", "c")
+address t "LINES" with input using (arr) output stem out.
+call check "input~arrayIn and output~arrayOut", out.0 == 2 & out.1 == 3 & out.2 == "a b c"
+address t "CHARS" with input stem in. output stem out.
+call check "charin, chars, charout, the rest by linein", out.0 == 2 & out.1 == "u|no" & out.2 == "4 dos"
+address t "CHAROUT" with output stem out.
+call check "charout without a line end: written when COMMAND returns", out.0 == 2 & out.1 == "ab" & out.2 == "cd"
+address t "EOF" with input stem in. output stem out.
+call check "linein at the end: NOTREADY and """"", out.0 == 1 & out.1 == "NOTREADY ''"
+address t "STREAMS" with input stem in. output stem out.
+call check "the streams are .InputStream / .OutputStream", out.1 == "1 1"
+address t "ERR oops" with error stem err.
+call check "WITH ERROR", err.0 == 1 & err.1 == "oops"
+address t "REDIR" with input stem in. output stem out.
+call check "isRedirected", rc == "1 1 0 0"
+address t "REDIR" with output stem both. error stem both.
+call check "isRedirected Same", rc == "0 1 1 1"
+address t "NOWITH input"
+call check "no WITH INPUT: caller~input is SYNTAX 98.900", rc == "98.900"
+address t "NOWITH output" with input stem in.
+call check "no WITH OUTPUT: caller~output is SYNTAX 98.900", rc == "98.900"
+address t "NOWITH error" with output stem out.
+call check "no WITH ERROR: caller~error is SYNTAX 98.900", rc == "98.900"
+
+-- conditions
+signal on error name gotError
+address t "RAISE ERROR 5"
+call check "ERROR raised", .false
+afterError:
+signal off error
+call on failure name gotFailure
+address t "RAISE FAILURE -2"
+call check "FAILURE trapped, RC", failed == -2 & rc == -2
+call off failure
+address t "RAISE ERROR 9"                      -- untrapped: just RC
+call check "untrapped ERROR sets RC", rc == 9
+
+signal on notready name gotNotready
+address t "RAISE NOTREADY 4"
+call check "NOTREADY raised", .false
+afterNotready:
+signal off notready
+signal on user boom name gotUser
+address t "RAISE USER BOOM 1"
+call check "USER BOOM raised", .false
+afterUser:
+signal off user boom
+address t "RAISE USER BOOM 2"                  -- untrapped: just RC
+call check "untrapped USER sets RC", rc == 2
+call on failure name gotSecond
+address t "TWICE"
+call check "a second raise is SYNTAX 93.900; the first stands", second == "FAILURE 5" & twice == "93.900"
+call off failure
+address t "BADRAISE"
+call check "raise: unknown condition, bad SYNTAX code: SYNTAX 93.900 inside", rc == "93.900 93.900 93.900"
+
+signal on syntax name gotRaisedSyntax
+address t "SYNTAXRAISE"
+call check "raise SYNTAX reaches the caller", .false
+afterRaisedSyntax:
+
+signal on syntax name gotHandlerSyntax
+address t "SYNTAXINSIDE"
+call check "RAISE SYNTAX in the handler reaches the caller", .false
+afterHandlerSyntax:
+signal on syntax name gotSyntax
+address t "DIVIDE"
+call check "SYNTAX in the handler reaches the caller", .false
+afterSyntax:
+signal on syntax name unexpected
+-- the same after the handler used the context (each such call used to
+-- turn off the trapping of the command's native activation: a crash)
+do verb over .array~of("SETDIVIDE", "GETDIVIDE", "VARSDIVIDE", "INDIVIDE", "OUTDIVIDE")
+  call check "SYNTAX after" verb~left(verb~length - 6)~lower "reaches the caller", syntaxAfter(verb) == "42.3"
+end
+-- and untrapped, which is what crashed: in a process of its own (skipped
+-- where there are no processes, as in a browser)
+exe = .rexxInfo~executable
+if exe \== .nil then do
+  child = .File~temporaryPath || "/cmdhandler-untrapped-" || time("S") || ".rex"
+  s = .stream~new(child); s~open("write replace")
+  s~lineout('.CommandHandler~register("T", .T~new)')
+  s~lineout('address t "X"')
+  s~lineout('::requires "cmdhandler.cls"')
+  s~lineout('::class T subclass CommandHandler')
+  s~lineout('::method command')
+  s~lineout('  use arg command, caller')
+  s~lineout('  caller["x"] = 1')
+  s~lineout('  return 1 / 0')
+  s~close
+  address system '"'exe'" "'child'"' with output stem co. error stem ce.
+  all = ""; do k = 1 to ce.0; all ||= ce.k" "; end; do k = 1 to co.0; all ||= co.k" "; end
+  if all = "" then say "skip  untrapped SYNTAX after caller[]= (no processes here)"
+  else call check "untrapped SYNTAX after caller[]=: the error, not a crash", all~pos("Error 42") > 0
+  call SysFileDelete child
+end
+
+-- stale context
+address t "KEEP" with input stem in.
+ctx = .local~kept
+call check "context invalid after its command", ctx~isValid == 0
+signal on syntax name gotStaleStream
+x = .local~keptIn~linein
+call check "stale input stream raises SYNTAX", .false
+afterStaleStream:
+signal on syntax name gotStale
+x = ctx["x"]
+call check "stale context raises SYNTAX", .false
+afterStale:
+signal on syntax name gotStaleRaise
+x = ctx~raise("ERROR", 1)
+call check "raise on a stale context raises SYNTAX", .false
+afterStaleRaise:
+signal on syntax name unexpected
+
+-- a method that REPLYs goes on in another thread: the context refuses it there
+.local~replied = .nil
+address t "REPLY"
+do 100 while .local~replied == .nil; call SysSleep 0.02; end
+call check "after REPLY (another thread) the context raises SYNTAX", .local~replied == "98.900"
+
+-- nesting, threads, registration
+.CommandHandler~register("u", .U~new)
+address t "NESTED"
+call check "a handler issuing a command to another handler", rc == "U:inner T:after"
+msg = .Threaded~new~start("run")
+call check "command from another thread", msg~result == "thread ok"
+.CommandHandler~register("t", .T2~new)
+address t "ANYTHING";        call check "register again replaces; inherit CommandHandler", rc == "T2"
+signal on syntax name gotNilHandler
+.CommandHandler~register("t", .nil)
+call check "register with .nil refused", .false
+afterNilHandler:
+address t "ANYTHING";        call check "still registered after the refused .nil", rc == "T2"
+.CommandHandler~deregister("t")
+call on failure name gotFailure
+address t "ANYTHING"
+call check "deregistered: FAILURE RC 30", failed == 30
+signal on syntax name gotNoSuchName
+.CommandHandler~deregister("nosuchname")
+call check "deregister a name with no handler: SYNTAX 93.900", .false
+afterNoSuchName:
+signal on syntax name unexpected
+.CommandHandler~register("t", .T2~new)
+address t "ANYTHING";        call check "register again after deregister", rc == "T2"
+call off failure
+signal on syntax name gotNoCommand
+.CommandHandler~register("v", .object~new)
+call check "a handler not inheriting .CommandHandler refused", .false
+afterNoCommand:
+signal on syntax name gotDuck
+.CommandHandler~register("v", .Duck~new)
+call check "COMMAND alone is not enough: .CommandHandler required", .false
+afterDuck:
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+gotError:      call check "ERROR raised", condition("C") == "ERROR" & rc == 5; signal afterError
+gotFailure:    failed = rc; return
+gotSyntax:     call check "SYNTAX in the handler reaches the caller", condition("O")~code == "42.3"; signal afterSyntax
+gotNoSuchName: call check "deregister a name with no handler: SYNTAX 93.900", condition("O")~code == "93.900"; signal afterNoSuchName
+gotStaleRaise: call check "raise on a stale context raises SYNTAX", condition("O")~code == "98.900"; signal afterStaleRaise
+gotStale:      call check "stale context raises SYNTAX", condition("O")~code == "98.900"; signal afterStale
+gotStaleStream: call check "stale input stream raises SYNTAX", condition("O")~code == "98.900"; signal afterStaleStream
+gotNotready:   call check "NOTREADY raised, RC, description", condition("C") == "NOTREADY" & rc == 4 & condition("D") == "no line"; signal afterNotready
+gotUser:       call check "USER BOOM raised, RC, description, additional", condition("C") == "USER BOOM" & rc == 1 & condition("D") == "RAISE USER BOOM 1" & condition("A") == "extra"; signal afterUser
+gotSecond:     second = condition("C") rc; return
+gotRaisedSyntax:
+  c = condition("O")
+  call check "raise SYNTAX: code and message", c~code == "98.900" & c~message == "the command is wrong."
+  call check "raise SYNTAX: at the ADDRESS clause, no frames of the handler", c~traceback~items == 1
+  signal afterRaisedSyntax
+gotHandlerSyntax:
+  c = condition("O")
+  call check "RAISE SYNTAX in the handler: its frames are shown", c~code == "88.900" & c~traceback~items > 1
+  signal afterHandlerSyntax
+gotNoCommand:  call check "a handler not inheriting .CommandHandler refused", condition("O")~code == "93.900"; signal afterNoCommand
+gotDuck:       call check "COMMAND alone is not enough: .CommandHandler required", condition("O")~code == "93.900"; signal afterDuck
+gotNilHandler: call check "register with .nil refused (SYNTAX 93.900)", condition("O")~code == "93.900"; signal afterNilHandler
+
+unexpected:
+  say "UNEXPECTED" condition("O")~code condition("O")~message "line" sigl
+  exit 1
+
+syntaxAfter: procedure
+  signal on syntax name syntaxAfterGot
+  i.0 = 1; i.1 = "a"
+  address t arg(1) with input stem i. output stem o.
+  return "none"
+syntaxAfterGot:
+  return condition("O")~code
+
+inproc: procedure
+  local = "x"
+  address t "SET local local"
+  return local
+
+check: procedure
+  use arg name, ok
+  if ok then do; .local~ok += 1; say "ok   " name; end
+  else do; .local~bad += 1; say "FAIL " name; end
+  return
+
+::requires "cmdhandler.cls"
+
+::class T subclass CommandHandler
+::method command
+  use arg cmd, ctx                         -- the documentation calls it caller
+  parse var cmd verb rest
+  select
+    when verb = "RETURN"  then return rest
+    when verb = "NOTHING" then return
+    when verb = "ENV"     then return ctx~environment
+    when verb = "SET"     then do
+      parse var rest name value
+      ctx[name] = value
+    end
+    when verb = "SYNONYMS" then do
+      ctx~setVar("syn.k", 7)
+      return (ctx~getVar("syn.k") == ctx["syn.k"]) ctx~getVar("nope2")
+    end
+    when verb = "HAS"     then return ctx~hasVar(rest)
+    when verb = "GET"     then return ctx[rest]~string
+    when verb = "DROP"    then ctx~dropVar(rest)
+    when verb = "VARS"    then do
+      handlerLocal = 1
+      v = ctx~variables
+      return v~hasIndex("MINE") v~hasIndex("HANDLERLOCAL")
+    end
+    when verb = "BADNAME" then return self~badName(ctx)
+    when verb = "UPPER"   then do
+      in = ctx~input; out = ctx~output
+      do while in~lines > 0
+        out~lineout(in~linein~upper)
+      end
+    end
+    when verb = "LINES"   then do
+      lines = ctx~input~arrayIn
+      ctx~output~arrayOut(.array~of(lines~items, lines~makeString("L", " ")))
+    end
+    when verb = "CHARS"   then do
+      in = ctx~input; out = ctx~output
+      out~charout(in~charin)               -- "u"
+      out~charout("|")
+      out~lineout(in~linein)               -- the rest of line 1: "no"
+      n = in~chars                         -- "dos" and a line end
+      out~lineout(n - .endOfLine~length + 1 in~linein)
+    end
+    when verb = "CHAROUT" then do
+      out = ctx~output
+      out~charout("ab" || .endOfLine || "c")
+      out~charout("d")                     -- no line end: flushed at the end
+    end
+    when verb = "EOF"     then return self~eof(ctx)
+    when verb = "STREAMS" then
+      ctx~output~lineout(ctx~input~isA(.InputStream) ctx~output~isA(.OutputStream))
+    when verb = "NOWITH"  then return self~noWith(ctx, rest)
+    when verb = "ERR"     then ctx~error~lineout(rest)
+    when verb = "REDIR"   then
+      return ctx~isRedirected("Input") ctx~isRedirected("Output"),
+             ctx~isRedirected("Error") ctx~isRedirected("Same")
+    when verb = "RAISE"   then do
+      parse var rest kind code
+      if kind = "ERROR" then return ctx~raiseError(code)
+      if kind = "FAILURE" then return ctx~raiseFailure(code)
+      if kind = "NOTREADY" then return ctx~raise("notready", code, "no line")
+      parse var code name code
+      return ctx~raise("user" name, code, , "extra")
+    end
+    when verb = "TWICE"   then do
+      x = ctx~raise("FAILURE", 5)
+      ctx["twice"] = self~oneRaise(ctx, .array~of("ERROR", 6))
+      return x
+    end
+    when verb = "BADRAISE"    then return self~badRaise(ctx)
+    when verb = "SYNTAXRAISE" then return ctx~raise("SYNTAX", 98.900, .array~of("the command is wrong"))
+    when verb = "SYNTAXINSIDE" then raise syntax 88.900 array("the handler failed")
+    when verb = "DIVIDE"  then return 1 / 0
+    when verb = "SETDIVIDE"  then do; ctx["x"] = 1; return 1 / 0; end
+    when verb = "GETDIVIDE"  then do; x = ctx["x"]; return 1 / 0; end
+    when verb = "VARSDIVIDE" then do; x = ctx~variables; return 1 / 0; end
+    when verb = "INDIVIDE"   then do; x = ctx~input~linein; return 1 / 0; end
+    when verb = "OUTDIVIDE"  then do; ctx~output~lineout("o"); return 1 / 0; end
+    when verb = "KEEP"    then do; .local~kept = ctx; .local~keptIn = ctx~input; end
+    when verb = "REPLY"   then do
+      reply 0
+      .local~replied = self~afterReply(ctx)
+      return
+    end
+    when verb = "NESTED"  then do
+      address u "INNER"
+      return rc "T:after"
+    end
+    otherwise return ctx~raiseFailure(-1)
+  end
+  return 0
+
+::method afterReply
+  use arg ctx
+  signal on syntax name refused
+  x = ctx["x"]
+  return "no error"
+refused:
+  return condition("O")~code
+
+::method badName
+  use arg ctx
+  signal on syntax name bad
+  ctx["1abc"] = 1
+  return "no error"
+bad:
+  return condition("O")~code
+
+::method eof
+  use arg ctx
+  in = ctx~input
+  do while in~lines > 0; x = in~linein; end
+  x = "unset"; seen = "no NOTREADY"
+  call on notready name eof               -- CALL ON: linein still returns
+  x = in~linein
+  ctx~output~lineout(seen "'" || x || "'")
+  return 0
+eof:
+  seen = condition("C")
+  return
+
+::method noWith
+  use arg ctx, which
+  signal on syntax name refused
+  x = ctx~send(which)
+  return "no error"
+refused:
+  return condition("O")~code
+
+-- three wrong raises, each caught: an unknown condition, a SYNTAX code that
+-- is not major.minor, and USER without a name
+::method badRaise
+  use arg ctx
+  codes = ""
+  do try over .array~of(.array~of("FOO", 1), .array~of("SYNTAX", 98), .array~of("USER", 1))
+    codes = codes self~oneRaise(ctx, try)
+  end
+  return codes~strip
+::method oneRaise
+  use arg ctx, try
+  signal on syntax name bad
+  x = ctx~raise(try[1], try[2])
+  return "no error"
+bad:
+  return condition("O")~code
+
+::class U subclass CommandHandler
+::method command
+  use arg cmd, ctx
+  return "U:inner"
+
+::class Base                             -- T2 has another superclass:
+::class T2 subclass Base inherit CommandHandler   -- the mixin is inherited
+::method command
+  return "T2"
+
+::class Duck                             -- has COMMAND, but no .CommandHandler
+::method command
+  return "quack"
+
+::class Threaded
+::method run
+  address t "RETURN thread ok"
+  return rc
