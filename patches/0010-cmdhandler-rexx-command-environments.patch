+/*----------------------------------------------------------------------------*/
+/*
+ * cmdhandler.cls: command environments (ADDRESS) written in Rexx.
+ *
+ *    .CommandHandler~register("UPPER", .Upper~new)
+ *    address upper "" with input stem in. output stem out.
+ *    ...
+ *
+ *    ::requires "cmdhandler.cls"               -- directives follow the prolog
+ *
+ *    ::class Upper inherit CommandHandler       -- or: subclass CommandHandler
+ *    ::method command
+ *      use arg command, caller                  -- caller: a .CommandContext
+ *      in = caller~input; out = caller~output
+ *      do while in~lines > 0
+ *        out~lineout(in~linein~upper)
+ *      end
+ *      return 0                                 -- becomes RC
+ *
+ * The handler is an object of a class that inherits .CommandHandler, a mixin
+ * class whose COMMAND method is abstract.  For every command the handler gets
+ * ~command(command, caller): the command (a String) and a .CommandContext.
+ * Its result is RC (0 when it returns nothing).  The .CommandContext is valid
+ * only while that command runs and only on its thread (afterwards, or from
+ * another thread: SYNTAX 98.900).  It gives:
+ *
+ *    ~input                 WITH INPUT as an .InputStream (linein, lines,
+ *                           charin, chars, arrayIn); at the end linein
+ *                           returns "" and raises NOTREADY
+ *    ~output, ~error        WITH OUTPUT / WITH ERROR as .OutputStreams
+ *                           (lineout, charout, arrayOut)
+ *                           (without the matching WITH, these three are a
+ *                           SYNTAX 98.900 error: check isRedirected first,
+ *                           and use .input~current, .output, .error instead)
+ *    ~isRedirected(which)   "Input", "Output", "Error" or "Same"
+ *    caller[name]           a variable of the code that issued the command
+ *                           (simple, stem or compound, the tail resolved
+ *                           there; with no value, its name, as in Rexx:
+ *                           FOO, A.x y; hasVar tells)
+ *    caller[name] = value   assigns it
+ *    ~getVar(name), ~setVar(name, value)   the same, by name
+ *    ~hasVar(name), ~dropVar(name), ~variables (a Directory of all of them)
+ *    ~raise(condition, rc [, description] [, additional])
+ *                           the command raises this condition (any that
+ *                           RAISE accepts but SYNTAX) with this RC, when
+ *                           COMMAND returns; returns rc; only one per
+ *                           command (a second one is SYNTAX 93.900)
+ *    ~raise("SYNTAX", code [, additional])
+ *                           a SYNTAX error at the caller's ADDRESS clause,
+ *                           without the handler's frames (for an error of the
+ *                           handler itself, use RAISE SYNTAX in it)
+ *    ~raiseError(rc), ~raiseFailure(rc)   shortcuts
+ *    ~environment           the ADDRESS name the command was sent to
+ *    ~isValid               whether the command is still running
+ *
+ * Idiom: "return caller~raise(...)".  A SYNTAX error in ~command reaches the
+ * code that issued the command.
+ * .CommandHandler~deregister(name) removes the handler: the name then
+ * behaves as an unknown environment (FAILURE, RC 30); a name with no handler
+ * is an error (SYNTAX 93.900).  A handler of .nil is an error too (SYNTAX
+ * 93.900), not a way to remove one.
+ *
+ * The registrations are in .local (one set per interpreter instance, as the
+ * command environments): .local~CommandHandlers, a Directory name -> handler,
+ * .local~CommandContext, the context class, and .local~CommandHandlerNames,
+ * the names whose native handler was added (once each: replacing or
+ * deregistering a handler does not add it again).
+ */
+
+::requires "cmdhandler" LIBRARY
+::routine CmdHandler_Register external "LIBRARY cmdhandler CmdHandler_Register"
+
+
+::class CommandHandler public mixinclass Object
+
+-- the handler of ADDRESS name: an object whose class inherits .CommandHandler
+::method register class
+  use strict arg name, handler
+  name = name~request("String")
+  if name == .nil | name == "" then
+    raise syntax 93.900 array("register: the environment name must be a non-empty string")
+  if handler == .nil then
+    raise syntax 93.900 array("register: the handler is .nil (to remove a handler, use .CommandHandler~deregister(name))")
+  if \handler~isA(.CommandHandler) then
+    raise syntax 93.900 array("register: the handler's class must inherit .CommandHandler")
+  if .local~commandHandlers == .nil then do
+    .local~commandHandlers = .directory~new
+    .local~commandContext = .CommandContext
+    .local~commandHandlerNames = .set~new
+  end
+  .local~commandHandlers[name~upper] = handler
+  -- the native handler is added once per name and instance, never again
+  -- (replacing or deregistering only changes .local~commandHandlers)
+  if \.local~commandHandlerNames~hasIndex(name~upper) then do
+    call CmdHandler_Register name
+    .local~commandHandlerNames~put(name~upper)
+  end
+  return
+
+-- remove the handler of ADDRESS name: the name then behaves as an unknown
+-- environment (FAILURE, RC 30); a name that has no handler is left alone
+::method deregister class
+  use strict arg name
+  name = name~request("String")
+  if name == .nil | name == "" then
+    raise syntax 93.900 array("deregister: the environment name must be a non-empty string")
+  handlers = .local~commandHandlers
+  if handlers == .nil then handlers = .directory~new
+  if \handlers~hasIndex(name~upper) then
+    raise syntax 93.900 array("deregister: there is no command handler named" name)
+  handlers~remove(name~upper)
+  return
+
+-- classes that inherit it implement it: use arg command, caller; return RC
+::method command abstract
+
+
+::class CommandContext public
+
+::attribute environment get
+-- for the native handler: the condition asked for with ~raise, or .nil
+::attribute pending get
+
+::method init
+  expose cself environment pending input output error
+  use strict arg cself, environment
+  pending = .nil; input = .nil; output = .nil; error = .nil
+
+::method isRedirected external "LIBRARY cmdhandler CmdContext_IsRedirected"
+::method isValid external "LIBRARY cmdhandler CmdContext_IsValid"
+::method check private external "LIBRARY cmdhandler CmdContext_Check"
+::method nativeGetVar private external "LIBRARY cmdhandler CmdContext_GetVar"
+::method nativeHasVar private external "LIBRARY cmdhandler CmdContext_HasVar"
+::method nativeSetVar private external "LIBRARY cmdhandler CmdContext_SetVar"
+::method nativeDropVar private external "LIBRARY cmdhandler CmdContext_DropVar"
+::method variables external "LIBRARY cmdhandler CmdContext_Variables"
+
+-- WITH INPUT / OUTPUT / ERROR as streams; only with that redirection
+::method input
+  expose cself input
+  if input == .nil then do
+    if \self~isRedirected("Input") then
+      raise syntax 98.900 array("the command was not given WITH INPUT; check isRedirected(""Input"") first")
+    input = .CommandInput~new(cself)
+  end
+  return input
+
+::method output
+  expose cself output
+  if output == .nil then do
+    if \self~isRedirected("Output") then
+      raise syntax 98.900 array("the command was not given WITH OUTPUT; check isRedirected(""Output"") first")
+    output = .CommandOutput~new(cself, "O")
+  end
+  return output
+
+::method error
+  expose cself error
+  if error == .nil then do
+    if \self~isRedirected("Error") then
+      raise syntax 98.900 array("the command was not given WITH ERROR; check isRedirected(""Error"") first")
+    error = .CommandOutput~new(cself, "E")
+  end
+  return error
+
+-- for the native handler, when COMMAND returns: write what charout left
+::method finish
+  expose output error
+  if output \== .nil then output~flush
+  if error \== .nil then error~flush
+
+-- the caller's variables: caller[name], caller[name] = value
+::method "[]"
+  use strict arg name
+  name = self~varName(name)
+  value = self~nativeGetVar(name)
+  if value \== .nil then return value
+  if self~hasVar(name) then return value  -- its value is .nil
+  return self~derivedName(name)        -- no value: its name, as in Rexx
+
+::method "[]="
+  use strict arg value, name
+  self~nativeSetVar(self~varName(name), value)
+
+-- exact synonyms of [] and []=, the names the host bridges' contexts use
+::method getVar
+  use strict arg name
+  return self[name]
+
+::method setVar
+  use strict arg name, value
+  self[name] = value
+
+::method hasVar
+  use strict arg name
+  return self~nativeHasVar(self~varName(name))
+
+::method dropVar
+  use strict arg name
+  self~nativeDropVar(self~varName(name))
+
+-- the name of a variable with no value, as Rexx gives it: the stem in upper
+-- case and each tail symbol replaced by its value in the caller (constant
+-- symbols, and variables with no value, in upper case): a.i is "A.x y" when
+-- i = "x y"
+::method derivedName private
+  use strict arg name
+  p = name~pos(".")
+  if p == 0 then return name~upper
+  derived = name~left(p)~upper
+  rest = name~substr(p + 1)
+  do forever
+    p = rest~pos(".")
+    if p == 0 then elem = rest
+    else elem = rest~left(p - 1)
+    if elem == "" then nop
+    else if elem~left(1)~dataType("W") then derived ||= elem~upper
+    else do
+      if self~hasVar(elem) then derived ||= self~nativeGetVar(elem)~string
+      else derived ||= elem~upper
+    end
+    if p == 0 then leave
+    derived ||= "."
+    rest = rest~substr(p + 1)
+  end
+  return derived
+
+-- a variable name (simple, stem or compound), or a SYNTAX error: the native
+-- API silently ignores names that are not variables
+::method varName private
+  use strict arg name
+  name = name~request("String")
+  if name \== .nil then do
+    first = name~left(1)
+    if name~dataType("V") & first \== "." & \first~dataType("W") then return name
+  end
+  raise syntax 93.900 array("not a Rexx variable name:" name)
+
+-- the condition the command raises when COMMAND returns (see the comment at
+-- the top); only one per command: a second call is an error (unlike the
+-- native RaiseCondition, where the last one wins: two are almost surely a
+-- mistake, and it is easier to allow them later than to forbid them)
+::method raise
+  expose pending
+  use strict arg condition, rc, description = .nil, additional = .nil
+  self~check                           -- ended, or another thread: 98.900
+  if pending \== .nil then
+    raise syntax 93.900 array("raise: a condition was already raised for this command")
+  condition = condition~request("String")
+  if condition == .nil then
+    raise syntax 93.900 array("raise: the condition must be a string")
+  parse upper value condition~space with name rest
+  if name == "SYNTAX" then do
+    -- raise("SYNTAX", code [, additional]): the third argument is additional
+    if rest \== "" | arg(4, "E") then
+      raise syntax 93.900 array("raise: SYNTAX takes an error code and an optional array of substitutions")
+    additional = description
+    if \rc~dataType("N") | rc~pos(".") == 0 then
+      raise syntax 93.900 array("raise: the SYNTAX error code must be major.minor, as 98.900; found" rc)
+    parse var rc major "." minor
+    if \major~dataType("W") | \minor~dataType("W") | major < 1 | major > 99 | minor < 1 | minor > 999 then
+      raise syntax 93.900 array("raise: the SYNTAX error code must be major.minor, as 98.900; found" rc)
+    if additional == .nil then additional = .array~new
+    else if \additional~isA(.Array) then additional = .array~of(additional)
+    pending = .array~of("SYNTAX", major * 1000 + minor, .nil, additional)
+    return rc
+  end
+  if name == "USER" then do
+    if rest == "" | rest~words > 1 then
+      raise syntax 93.900 array("raise: USER needs a condition name, as ""USER NAME""")
+    name = name rest
+  end
+  else if rest \== "" | wordpos(name, "ERROR FAILURE HALT LOSTDIGITS NOMETHOD NOSTRING NOTREADY NOVALUE") == 0 then
+    raise syntax 93.900 array("raise: not a condition RAISE accepts:" condition)
+  pending = .array~of(name, rc, description, additional)
+  return rc
+
+::method raiseError
+  use strict arg rc
+  return self~raise("ERROR", rc)
+
+::method raiseFailure
+  use strict arg rc
+  return self~raise("FAILURE", rc)
+
+
+-- WITH INPUT as an .InputStream (one per command; see .CommandContext~input)
+::class CommandInput public inherit InputStream
+
+::method init
+  expose cself buffer more
+  use strict arg cself
+  buffer = ""        -- characters read but not given yet (charin)
+  more = .nil        -- a line read ahead (lines), or .nil
+
+::method readLine private external "LIBRARY cmdhandler CmdContext_LineIn"
+
+-- the next line, read ahead if needed; .nil at the end
+::method nextLine private
+  expose more
+  if more \== .nil then do
+    line = more; more = .nil
+    return line
+  end
+  return self~readLine
+
+::method linein
+  expose buffer
+  use strict arg start = .nil, count = 1
+  if arg(1, "E") then raise syntax 93.963      -- no positioning
+  if count == 0 then return ""
+  if count \== 1 then raise syntax 93.963
+  if buffer \== "" then do                      -- the rest of what charin read
+    parse var buffer line (.endOfLine) buffer
+    return line
+  end
+  line = self~nextLine
+  if line == .nil then raise notready return ""
+  return line
+
+::method lines
+  expose buffer more
+  if buffer \== "" then return 1
+  if more == .nil then more = self~readLine
+  return more \== .nil
+
+::method charin
+  expose buffer
+  use strict arg start = .nil, count = 1
+  if arg(1, "E") then raise syntax 93.963      -- no positioning
+  do while buffer~length < count
+    line = self~nextLine
+    if line == .nil then leave
+    buffer ||= line || .endOfLine
+  end
+  chars = buffer~left(min(count, buffer~length))
+  buffer = buffer~substr(chars~length + 1)
+  if chars~length < count then raise notready return (chars)
+  return chars
+
+::method chars
+  expose buffer more
+  if buffer \== "" then return buffer~length
+  if more == .nil then more = self~readLine
+  if more == .nil then return 0
+  return more~length + .endOfLine~length
+
+
+-- WITH OUTPUT or WITH ERROR as an .OutputStream (see .CommandContext~output)
+::class CommandOutput public inherit OutputStream
+
+::method init
+  expose cself which partial
+  use strict arg cself, which
+  partial = ""       -- charout without a line end yet
+
+::method write private external "LIBRARY cmdhandler CmdContext_Write"
+
+::method lineout
+  expose which partial
+  use strict arg line = .nil
+  if arg(1, "O") then do                         -- lineout(): flush, as a close
+    self~flush
+    return 0
+  end
+  self~write(which, partial || line~string)
+  partial = ""
+  return 0
+
+::method charout
+  expose which partial
+  use strict arg string = "", start = .nil
+  if arg(2, "E") then raise syntax 93.963        -- no positioning
+  partial ||= string~string
+  -- whole lines go out now; the rest waits for lineout or the command's end
+  do while partial~pos(.endOfLine) > 0
+    parse var partial line (.endOfLine) partial
+    self~write(which, line)
+  end
+  return 0
+
+-- write what charout left (the native handler calls it when COMMAND returns)
+::method flush
+  expose which partial
+  if partial \== "" then self~write(which, partial)
+  partial = ""
+
+::method close
+  self~flush
