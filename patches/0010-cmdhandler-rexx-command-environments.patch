diff --git a/extensions/cmdhandler/tests/instances.cpp b/extensions/cmdhandler/tests/instances.cpp
new file mode 100644
index 0000000..6596dc4
--- /dev/null
+++ b/extensions/cmdhandler/tests/instances.cpp
@@ -0,0 +1,42 @@
+// instances.cpp: two interpreter instances in one process, each with its own
+// "T" command environment (cmdhandler's registrations are per instance, in
+// .local, as the environments themselves).  Native builds; from this directory:
+//   g++ -I../../../api -I../../../api/platform/unix instances.cpp \
+//       -L$BUILD/lib -lrexx -lrexxapi -o instances
+//   PATH=$BUILD/bin:$PATH LD_LIBRARY_PATH=$BUILD/lib ./instances
+// Uses reg.rex and ask.rex (next to it); prints "all ok" and exits 0.
+#include "oorexxapi.h"
+#include <stdio.h>
+#include <string.h>
+static RexxThreadContext *make(RexxInstance **inst)
+{
+    RexxThreadContext *t;
+    if (!RexxCreateInterpreter(inst, &t, NULL)) { printf("no instance\n"); return NULL; }
+    return t;
+}
+static const char *run(RexxThreadContext *t, const char *prog, const char *arg)
+{
+    RexxArrayObject args = arg ? t->ArrayOfOne(t->String(arg)) : t->NewArray(0);
+    RexxObjectPtr r = t->CallProgram(prog, args);
+    if (t->CheckCondition()) { t->ClearCondition(); return "(condition)"; }
+    return r ? t->ObjectToStringValue(r) : "(none)";
+}
+int main()
+{
+    RexxInstance *ia, *ib;
+    RexxThreadContext *a = make(&ia), *b = make(&ib);
+    int bad = 0;
+    #define CHECK(what, got, want) do { const char *g = (got); int ok = strcmp(g, want) == 0; bad += !ok; \
+        printf("%s %s: %s\n", ok ? "ok  " : "FAIL", what, g); } while (0)
+    CHECK("A registers T", run(a, "reg.rex", "A"), "A");
+    CHECK("B registers T", run(b, "reg.rex", "B"), "B");
+    CHECK("A still its own", run(a, "ask.rex", NULL), "A");
+    CHECK("B its own", run(b, "ask.rex", NULL), "B");
+    ia->Terminate();
+    CHECK("B after A terminated", run(b, "ask.rex", NULL), "B");
+    RexxInstance *ic; RexxThreadContext *c = make(&ic);
+    CHECK("a new instance has no T (RC 30)", run(c, "ask.rex", NULL), "30");
+    ib->Terminate(); ic->Terminate();
+    printf("%s\n", bad ? "FAILED" : "all ok");
+    return bad != 0;
+}
