diff --git a/wasm/web/jscommands.cls b/wasm/web/jscommands.cls
new file mode 100644
index 0000000..22126e2
--- /dev/null
+++ b/wasm/web/jscommands.cls
@@ -0,0 +1,117 @@
+/*----------------------------------------------------------------------------*/
+/*                                                                            */
+/* Copyright (c) 2026 Rexx Language Association. All rights reserved.         */
+/*                                                                            */
+/* This program and the accompanying materials are made available under       */
+/* the terms of the Common Public License v1.0 which accompanies this         */
+/* distribution. A copy is also available at the following address:          */
+/* https://www.oorexx.org/license.html                                        */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+/*
+ * jscommands.cls: command environments (ADDRESS) written in JavaScript, on
+ * top of cmdhandler.cls.  js.cls loads it on first use:
+ *
+ *    calc = .js~Function~new("command", "ctx", "return eval(command)")
+ *    .js~addCommandEnvironment("CALC", calc)
+ *    address calc "6 * 7"; say rc                 -- 42
+ *    .js~removeCommandEnvironment("CALC")         -- CALC: FAILURE, RC 30
+ *                                                 -- (a name with no handler: an error)
+ *
+ * The handler is a JavaScript function of any realm (.js, .js~page), called
+ * as fn(command, ctx) for each command.  What it returns is RC (undefined or
+ * null: 0); a Promise is waited for, and what it gives is RC.  ctx is the
+ * command's .CommandContext (cmdhandler.cls), a RexxProxy in JavaScript
+ * whose tests answer JavaScript booleans:
+ * ctx.lineIn(), ctx.lines(), ctx.output(x), ctx.error(x), ctx.isRedirected(k),
+ * ctx.getVar(n), ctx.hasVar(n), ctx.setVar(n, v), ctx.dropVar(n),
+ * ctx.variables(), ctx.environment(), ctx.isValid(), and
+ * "return ctx.raiseError(rc)", "return ctx.raiseFailure(rc)".  It is valid
+ * while the command runs; in the page its calls give Promises, as every call
+ * of Rexx there.  A JavaScript exception in the handler is SYNTAX 98.900 in
+ * the code that issued the command (additional: the message, what was
+ * thrown, its stack); a condition of Rexx that the handler lets through (a
+ * RexxError) is raised there as itself.
+ */
+
+::requires "cmdhandler.cls"
+::requires "js.cls"
+
+
+::class JSCommandHandler public subclass Object inherit CommandHandler
+
+-- .js~addCommandEnvironment(name, fn)
+::method add class
+  use strict arg name, fn
+  name = self~environmentName("addCommandEnvironment", name)
+  if fn == .nil then
+    raise syntax 93.900 array("addCommandEnvironment: the handler is .nil (to remove one, use removeCommandEnvironment)")
+  ok = fn~isA(.JSObject)
+  if ok then ok = fn~js.typeOf == "function"
+  if \ok then
+    raise syntax 93.900 array("addCommandEnvironment: the handler must be a JavaScript function, not" fn~string)
+  .CommandHandler~register(name, self~new(fn))
+  return
+
+-- .js~removeCommandEnvironment(name): FAILURE, RC 30, from now on; a name
+-- with no handler is an error
+::method remove class
+  use strict arg name
+  name = self~environmentName("removeCommandEnvironment", name)
+  handlers = .local~commandHandlers
+  if handlers \== .nil then if handlers~hasIndex(name~upper) then do
+    .CommandHandler~unregister(name)
+    return
