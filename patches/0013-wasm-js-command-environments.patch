diff --git a/wasm/tests/js-commands.rex b/wasm/tests/js-commands.rex
new file mode 100644
index 0000000..e072a36
--- /dev/null
+++ b/wasm/tests/js-commands.rex
@@ -0,0 +1,148 @@
+/*----------------------------------------------------------------------------*/
+/* Command environments written in JavaScript (.js~addCommandEnvironment,    */
+/* jscommands.cls on cmdhandler.cls), in the realm of .js: the worker's in   */
+/* the browser, Node's under Node.  Prints one line per check; exits 1 if    */
+/* any fails.                                                                 */
+/*----------------------------------------------------------------------------*/
+.local~ok = 0; .local~bad = 0
+.local~fn = .js~Function~new("args", "body", "return new Function(...args.split(','), body)")
+
+calc = F("command,ctx", -
+  "switch (command) {" -
+  "case 'none': return;" -
+  "case 'null': return null;" -
+  "case 'text': return 'abc';" -
+  "case 'number': return 6 * 7;" -
+  "case 'promise': return Promise.resolve(7);" -
+  "case 'later': return new Promise((r) => setTimeout(() => r(8), 10));" -
+  "case 'env': return ctx.environment();" -
+  "case 'vars': { const x = ctx.getVar('X'); ctx.setVar('Y', 'got ' + x); ctx.setVar('S.1', 'one');" -
+  "  ctx.dropVar('Z'); return [ctx.hasVar('X'), ctx.hasVar('Z'), ctx.getVar('NOPE') === null].join(' '); }" -
+  "case 'all': return Object.keys(ctx.variables()).includes('X') ? 'has X' : 'no X';" -
+  "case 'out': ctx.output('one'); ctx.output(['two', 'three']); ctx.error('err'); return 0;" -
+  "case 'in': { let l, n = 0, t = ''; while ((l = ctx.lineIn()) !== null) { n++; t += l; } return n + ' ' + t; }" -
+  "case 'lines': return ctx.lines().length;" -
+  "case 'redir': return ['Input', 'Output', 'Error'].map((k) => ctx.isRedirected(k)).join('');" -
+  "case 'error': return ctx.raiseError(5);" -
+  "case 'failure': return ctx.raiseFailure(-2);" -
+  "case 'throw': throw new TypeError('from the handler');" -
+  "case 'reject': return Promise.reject(new RangeError('rejected'));" -
+  "case 'badname': return ctx.getVar('1abc');" -
+  "case 'keep': globalThis.keptCtx = ctx; return ctx.isValid() ? 'valid' : 'not valid';" -
+  "case 'console': ctx.output('to the console, from JavaScript'); return 0;" -
+  "default: return 'unknown: ' + command; }")
+
+.js~addCommandEnvironment("calc", calc)        -- lower case on purpose
+address calc
+"none";                  call check "no result: RC 0", rc == 0
+"null";                  call check "null: RC 0", rc == 0
+"text";                  call check "a string: RC is it", rc == "abc"
+"number";                call check "a number: RC is it", rc == 42
+"promise";               call check "a Promise: waited for, RC its value", rc == 7
+"later";                 call check "a Promise settled later: waited for", rc == 8
+"env";                   call check "ctx.environment(): the ADDRESS name", rc == "CALC"
+x = 42; z = "gone"
+"vars";                  call check "ctx: getVar, hasVar, setVar, dropVar", rc == "true false true" & -
+                           y == "got 42" & s.1 == "one" & \var("Z")
+"all";                   call check "ctx.variables(): the caller's variables", rc == "has X"
+address calc "out" with output stem o. error stem e.
+call check "ctx.output: a string or an array, to WITH OUTPUT", o.0 == 3 & o.1 == "one" & o.3 == "three"
+call check "ctx.error: to WITH ERROR", e.0 == 1 & e.1 == "err"
+i.0 = 2; i.1 = "p"; i.2 = "q"
+address calc "in" with input stem i.; call check "ctx.lineIn(): WITH INPUT, null at its end", rc == "2 pq"
+"in";                    call check "ctx.lineIn() without WITH INPUT: null", rc == "0 "
+address calc "lines" with input stem i.; call check "ctx.lines(): all of WITH INPUT", rc == 2
+address calc "redir" with input stem i. output stem o.; call check "ctx.isRedirected: booleans", rc == "truetruefalse"
+"console";               call check "ctx.output without WITH: to the console (above)", rc == 0
+
+call on error name gotError
+"error";                 call check "ctx.raiseError(5): ERROR, RC 5", raised == "ERROR 5"
+call off error
+call on failure name gotFailure
+"failure";               call check "ctx.raiseFailure(-2): FAILURE, RC -2", raised == "FAILURE -2"
+call off failure
+
+signal on syntax name s1
+"throw"
+s1:
+c = condition("O"); a = c~additional
+call check "a JavaScript exception: SYNTAX 98.900 where the command was issued", c~code == "98.900"
+call check "  additional: the message, the TypeError, its stack", a~items == 3 & -
+  a[1] == "JavaScript error: TypeError: from the handler" & a[2]~isA(.JSObject) & a[2]~message == "from the handler"
+signal on syntax name s2
+"reject"
+s2:
+c = condition("O")
+call check "a rejected Promise: SYNTAX 98.900, the RangeError", c~code == "98.900" & c~additional[2]~message == "rejected"
+signal on syntax name s3
+"badname"
+s3:
+c = condition("O")
+call check "a Rexx condition the handler lets through: itself (93.900)", c~code == "93.900" & -
+  c~message~pos("not a Rexx variable name: 1abc") > 0
+
+"keep";                  call check "ctx.isValid() while the command runs", rc == "valid"
+call check "ctx after the command: not valid (a boolean)", F("", "return globalThis.keptCtx.isValid() === false")~call(.nil) == 1
+signal on syntax name s4
+F("", "return globalThis.keptCtx.getVar('X')")~call(.nil)
+s4:
+call check "ctx after the command: SYNTAX 98.900, as itself", condition("O")~code == "98.900" & -
+  condition("O")~additional[1]~pos("JavaScript error") == 0
+
+-- registering
+.js~addCommandEnvironment("calc", F("command,ctx", "return 'second'"))
+address calc "anything"; call check "registered again: replaced", rc == "second"
+.js~removeCommandEnvironment("CALC")
+call on failure name gotFailure
+raised = ""
+address calc "anything"; call check "removed: FAILURE, RC 30 (an unknown environment)", raised == "FAILURE 30"
+call off failure
+signal on syntax name s6
+.js~removeCommandEnvironment("calc")
+s6:
+call check "removed again: SYNTAX 93.900, no handler", condition("O")~code == "93.900" & -
+  condition("O")~message~pos("removeCommandEnvironment: no handler is registered for calc") > 0
+call check ".nil: SYNTAX 93.900, removeCommandEnvironment named", refused(.nil)~pos("93.900 ") == 1 & -
+  refused(.nil)~pos("removeCommandEnvironment") > 0
+call check "a Rexx string: SYNTAX 93.900", refused("return 1")~word(1) == "93.900"
+call check "a JavaScript object that is not a function: SYNTAX 93.900", refused(.js~newObject)~word(1) == "93.900"
+signal on syntax name s5
+.js~addCommandEnvironment("", calc)
+s5:
+call check "an empty name: SYNTAX 93.900", condition("O")~code == "93.900"
+-- the same through cmdhandler.cls: a JavaScript handler is a .CommandHandler
+.js~addCommandEnvironment("calc", calc)
+call check "a .JSCommandHandler is a .CommandHandler", .local~commandHandlers["CALC"]~isA(.CommandHandler)
+.CommandHandler~unregister("calc")
+raised = ""
+call on failure name gotFailure
+address calc "none"; call check ".CommandHandler~unregister removes it too", raised == "FAILURE 30"
+call off failure
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+gotError:   raised = condition("C") rc; return
+gotFailure: raised = condition("C") rc; return
+
+F: procedure                        -- F(params, body): a JavaScript function
+  return .fn~call(.nil, arg(1), arg(2))
+
+refused: procedure                  -- "code message" of .js~addCommandEnvironment("X", fn)
+  use arg fn
+  signal on syntax name refusedSyntax
+  .js~addCommandEnvironment("X", fn)
+  return "no error"
+refusedSyntax:
+  c = condition("O")
+  return c~code c~message
+
+check: procedure
+  parse arg what, ok
+  if ok == 1 then do; .local~ok += 1; say "ok  " what; end
+  else do; .local~bad += 1; say "FAIL" what; end
+  return
+
+::requires "js.cls"
+::requires "cmdhandler.cls"
