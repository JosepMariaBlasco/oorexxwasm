diff --git a/wasm/tests/fetch-server.py b/wasm/tests/fetch-server.py
new file mode 100644
index 0000000..1d84ec7
--- /dev/null
+++ b/wasm/tests/fetch-server.py
@@ -0,0 +1,36 @@
+# ADDRESS FETCH test server (wasm/tests/fetch.rex): python3 fetch-server.py PORT
+import sys, time, json
+from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
+class H(BaseHTTPRequestHandler):
+    def log_message(self, *a): pass
+    def send(self, code, body, ctype="text/plain", extra=()):
+        b = body if isinstance(body, bytes) else body.encode()
+        self.send_response(code); self.send_header("Content-Type", ctype)
+        self.send_header("Content-Length", str(len(b))); self.send_header("Access-Control-Allow-Origin", "*"); self.send_header("Access-Control-Expose-Headers", "X-Answer")
+        for k, v in extra: self.send_header(k, v)
+        self.end_headers()
+        if self.command != "HEAD":
+            try: self.wfile.write(b)
+            except (BrokenPipeError, ConnectionResetError): pass   # the client gave up (TIMEOUT)
+    def route(self):
+        n = int(self.headers.get("Content-Length") or 0)
+        body = self.rfile.read(n).decode() if n else ""
+        p = self.path
+        if p == "/data.json":
+            self.send(200, json.dumps({"items": [{"name": "uno"}, {"name": "dos", "tags": ["a", "b"]}],
+                "count": 2, "ok": True, "none": None, "Mixed Case": "yes"}), "application/json", [("X-Answer", "42")])
+        elif p == "/text": self.send(200, "l1\r\nl2\r\n")
+        elif p == "/echo": self.send(200, self.command + "|" + (self.headers.get("X-Test") or "-") + "|" + body)
+        elif p == "/ctype": self.send(200, (self.headers.get("Content-Type") or "-") + "|" + body)
+        elif p == "/slow": time.sleep(3); self.send(200, "late")
+        elif p == "/bin": self.send(200, bytes(range(256)), "application/octet-stream")
+        else: self.send(404, "not here")
+    def do_OPTIONS(self):
+        self.send_response(204)
+        for k, v in (("Access-Control-Allow-Origin", "*"), ("Access-Control-Allow-Headers", "*"),
+                     ("Access-Control-Allow-Methods", "GET, HEAD, POST, PUT, PATCH, DELETE"),
+                     ("Access-Control-Expose-Headers", "X-Answer")):
+            self.send_header(k, v)
+        self.end_headers()
+    do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = do_HEAD = route
+ThreadingHTTPServer(("127.0.0.1", int(sys.argv[1])), H).serve_forever()
diff --git a/wasm/tests/fetch.rex b/wasm/tests/fetch.rex
new file mode 100644
index 0000000..01451f3
--- /dev/null
+++ b/wasm/tests/fetch.rex
@@ -0,0 +1,138 @@
+/* fetch.rex: tests of ADDRESS FETCH (wasm/web/fetch.cls), Node and browser.  */
+/* Needs the server wasm/tests/fetch-server.py:                              */
+/*   python3 fetch-server.py 8123 &  rexx fetch.rex http://127.0.0.1:8123     */
+/* Prints one line per check; exits 1 if any fails.                          */
+parse arg base
+if base == "" then base = "http://127.0.0.1:8123"
+.local~ok = 0; .local~bad = 0
+address fetch
+
+address fetch "GET" base"/data.json" with output stem body.
+call check "GET: RC 0, body to WITH OUTPUT", rc == 0 & body.0 == 1 & body.1~pos('"count"') > 0
+"GET" base"/data.json INTO page"
+call check "GET INTO var: the body", rc == 0 & page~pos('"count"') > 0
+"GET INTO page2" base"/data.json"
+call check "INTO anywhere: before the URL", rc == 0 & page2 == page
+"STATUS INTO s";           call check "STATUS INTO", rc == 0 & s == 200
+"JSON INTO data"
+call check "JSON INTO: a Directory", rc == 0 & data~isA(.Directory) & data["count"] == 2
+call check "JSON INTO: arrays are Arrays", data["items"]~isA(.Array) & data["items"][2]["name"] == "dos"
+call check "JSON INTO: booleans and null", data["ok"] == .json~true & data["none"] == .nil & data~hasIndex("none")
+"JSON items.2.name INTO v";   call check "JSON path INTO, 1-based index", v == "dos"
+"JSON items.2.tags.1 INTO v"; call check "JSON nested array", v == "a"
+"JSON items INTO v";          call check "JSON path INTO: an Array", v~isA(.Array) & v~items == 2
+"JSON 'Mixed Case' INTO v";   call check "JSON quoted path, case kept", v == "yes"
+"JSON ok INTO v";             call check "JSON true: .JsonBoolean", v == .json~true
+names = ""
+do item over data["items"]; names = names item["name"]; end
+call check "DO OVER a JSON array", names == " uno dos"
+address fetch "JSON items.2.name" with output stem o.
+call check "JSON without INTO: to WITH OUTPUT", o.0 == 1 & o.1 == "dos"
+address fetch "JSON items.2" with output stem o.
+call check "JSON without INTO: objects as JSON text", o.1 == '{"name":"dos","tags":["a","b"]}'
+address fetch "JSON none" with output stem o.
+call check "JSON without INTO: null", o.1 == "null"
+"HEADERS X-Answer INTO v";   call check "HEADERS name INTO", v == 42
+"HEADERS X-Nothing INTO v";  call check "HEADERS absent name: empty", rc == 0 & v == ""
+"HEADERS INTO h"
+call check "HEADERS INTO: a StringTable", h~isA(.StringTable) & h["x-answer"] == 42
+address fetch "HEADERS" with output stem h.
+found = 0
+do i = 1 to h.0; if h.i~caselessPos("x-answer: 42") == 1 then found = 1; end
+call check "HEADERS to WITH OUTPUT", found
+"HEADERS INTO h."
+found = 0
+do i = 1 to h.0; if h.i~caselessPos("x-answer: 42") == 1 then found = 1; end
+call check "HEADERS INTO stem", found
+
+address fetch "GET" base"/text" with output stem t.
+call check "CRLF body: lines without CR", t.0 == 2 & t.1 == "l1" & t.2 == "l2"
+t.9 = "stale"
+"GET" base"/text INTO t."
+call check "GET INTO stem: lines, stem dropped first", t.0 == 2 & t.2 == "l2" & t.9 == "T.9"
+
+in.1 = "line one"; in.2 = "line two"; in.0 = 2
+"HEADER X-Test hello"
+address fetch "POST" base"/echo" with input stem in. output stem e.
+call check "POST: WITH INPUT body, request header", e.1 == "POST|hello|line one" & e.2 == "line two"
+"HEADER X-Test"
+address fetch "PUT" base"/echo" with input stem in. output stem e.
+call check "PUT; HEADER name drops it", e.1 == "PUT|-|line one"
+"HEADER X-Test 'two words'"
+"POST" base"/echo 'a body' INTO e"
+call check "POST quoted body; quoted header value", e == "POST|two words|a body"
+msg = "from a variable"
+"PATCH" base"/echo FROM msg INTO e"
+call check "PATCH FROM var", e == "PATCH|two words|from a variable"
+"HEADER RESET"
+d = .directory~new; d["name"] = "Ana"; d["n"] = 3
+"POST" base"/ctype JSON FROM d INTO e"
+call check "POST JSON FROM: json.cls text, Content-Type", e == 'application/json|{"n":3,"name":"Ana"}'
+"HEADER Content-Type 'application/vnd.x+json'"
+"POST" base"/ctype JSON FROM d INTO e"
+call check "POST JSON FROM: a HEADER Content-Type wins", e~left(23) == "application/vnd.x+json|"
+"HEADER RESET"
+address fetch "DELETE" base"/echo" with output stem e.
+call check "DELETE; HEADER RESET", e.1 == "DELETE|-|"
+"POST" base"/ctype INTO e JSON FROM d"
+call check "INTO anywhere: before JSON FROM", e == 'application/json|{"n":3,"name":"Ana"}'
+"POST" base"/echo 'INTO' INTO e"
+call check "a quoted INTO is a word, not a keyword", e == "POST|-|INTO"
+
+call on error name onError
+errorRc = ""
+address fetch "GET" base"/nope" with output stem n.
+call check "404: RC and ERROR", rc == 404 & errorRc == 404 & n.1 == "not here"
+
+errorRc = ""
+address fetch "JSON x" with error stem err.
+call check "JSON on a non-JSON body: RC 2, ERROR", rc == 2 & errorRc == 2 & err.1~pos("not JSON") > 0
+"GET" base"/data.json"
+errorRc = ""
+address fetch "JSON items.7.name" with error stem err.
+call check "JSON missing path: RC 1, ERROR, a message", rc == 1 & errorRc == 1 & err.1~pos("items.7") > 0
+call off error
+
+call on failure name onFailure
+failureRc = ""
+address fetch "GET http://127.0.0.1:1/x" with error stem err.
+call check "network error: RC -1, FAILURE, reason", rc == -1 & failureRc == -1 & err.0 == 1
+"TIMEOUT 0.5"
+address fetch "GET" base"/slow" with error stem err.
+call check "TIMEOUT", rc == -1 & err.0 == 1
+"TIMEOUT 0"
+address fetch "FROB x" with error stem err.
+call check "unknown command: RC -3, FAILURE", rc == -3 & err.1~pos("FROB") > 0
+address fetch "GET" base"/x extra" with error stem err.
+call check "extra words: RC -3", rc == -3 & err.1~pos("extra") > 0
+address fetch 'GET "unclosed' with error stem err.
+call check "quote not closed: RC -3", rc == -3 & err.1~pos("not closed") > 0
+address fetch "STATUS INTO a INTO b" with error stem err.
+call check "two INTO: RC -3", rc == -3
+drop nothing
+address fetch "POST" base"/echo FROM nothing" with error stem err.
+call check "FROM an unset variable: RC -3", rc == -3
+call off failure
+
+file = "fetch-test.bin"
+"SAVE" base"/bin" file
+data = charin(file, 1, 300); call stream file, "c", "close"
+call check "SAVE: bytes to a file", rc == 0 & data == xrange("00"x, "ff"x)
+call SysFileDelete file
+address fetch "HEAD" base"/data.json" with output stem hd.
+call check "HEAD: no body", rc == 0 & hd.0 == 0
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+onError:   errorRc = rc; return
+onFailure: failureRc = rc; return
+
+check: procedure
+  use arg name, ok
+  if ok then do; .local~ok += 1; say "ok   " name; end
+  else do; .local~bad += 1; say "FAIL " name; end
+  return
+
+::requires "fetch.cls"
