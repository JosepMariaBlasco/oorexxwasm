diff --git a/wasm/tests/dom.rex b/wasm/tests/dom.rex
new file mode 100644
index 0000000..02342de
--- /dev/null
+++ b/wasm/tests/dom.rex
@@ -0,0 +1,238 @@
+/* dom.rex: tests of ADDRESS DOM (wasm/web/dom.cls), in the browser.         */
+/* Run with the page realm granted and no root to start with:                */
+/*   run option js: {page: true}, dom: {root: null}                          */
+/* Events are made from Rexx (element~click, dispatchEvent), so the test    */
+/* needs nobody at the page.  Prints one line per check; exits 1 if any     */
+/* fails.                                                                    */
+.local~ok = 0; .local~bad = 0
+w = .js~page; doc = w~document
+address dom
+call on error name onError
+call on failure name onFailure
+
+-- no root yet
+call expect "TEXT x", -2, "FAILURE", "no root: RC -2"
+
+-- a panel
+'NEW "Test panel" AS p INTO body'
+call check "NEW: RC 0, INTO the body", rc == 0 & body~isA(.JSObject) & body["className"] == "body"
+panels = doc~querySelectorAll(".orx-dom-panel")
+call check "NEW: a panel on the page", panels~length == 1
+host = panels~item(0)
+call check "NEW: a Shadow DOM with the title", host~shadowRoot~querySelector(".title")~textContent == "Test panel"
+
+-- CREATE does not move the current element; labels
+'CREATE h h2 "A title"'
+'CREATE out p'
+'out: TEXT "hello world"'
+'h: TEXT INTO t'
+call check "CREATE + label by nickname", t == "A title"
+'h2: TEXT INTO t'
+call check "label by selector", t == "A title"
+'"p, h2": TEXT INTO t'
+call check "quoted label (a selector with blanks)", t == "A title"
+'TEXT INTO t'
+call check "CREATE did not move the current element (the body)", t == "A titlehello world"
+address dom "out: TEXT" with output stem o.
+call check "TEXT without INTO: to WITH OUTPUT", o.0 == 1 & o.1 == "hello world"
+call check "the panel's elements are in the Shadow DOM", host~shadowRoot~querySelector("p")~textContent == "hello world"
+call check "and not in the page", doc~body~textContent~pos("hello world") = 0
+
+-- LOCATE, UP, TOP
+'LOCATE out INTO el'
+msg = "from a variable"
+'TEXT FROM msg'
+call check "LOCATE INTO: a .JSObject; TEXT FROM var", el~isA(.JSObject) & el~textContent == msg
+'UP'
+'TEXT INTO t'
+call check "UP: to the parent", t == "A titlefrom a variable"
+call expect "UP", 2, "ERROR", "UP at the root: RC 2, ERROR"
+call expect "LOCATE nosuch", 2, "ERROR", "LOCATE not found: RC 2, ERROR"
+'LOCATE INTO el2 h'
+call check "INTO anywhere: LOCATE INTO el ref", rc == 0 & el2~tagName == "H2"
+'TOP'
+'CREATE INTO e2 tmp span "x"'
+call check "INTO anywhere: CREATE INTO el nick tag text", e2~textContent == "x" & e2~parentElement == body
+'tmp: REMOVE' 
+'LOCATE h'; 'TOP'; 'TEXT INTO t'
+call check "TOP", t~left(7) == "A title"
+
+-- wrong programs: FAILURE
+call expect "zzz: TEXT a", -4, "FAILURE", "unknown label: RC -4"
+call expect '"[[": TEXT a', -3, "FAILURE", "bad selector: RC -3"
+call expect "FROB", -3, "FAILURE", "unknown command: RC -3"
+call expect 'TEXT "unclosed', -3, "FAILURE", "quote not closed: RC -3"
+call expect "TEXT a b", -3, "FAILURE", "two values: RC -3"
+drop nothing
+call expect "TEXT FROM nothing", -3, "FAILURE", "FROM an unset variable: RC -3"
+call expect 'CREATE x "bad tag"', -5, "FAILURE", "a JavaScript error: RC -5"
+
+call expect "h: TEXT INTO a INTO b", -3, "FAILURE", "two INTO: RC -3"
+'out: TEXT "INTO"'
+'out: TEXT INTO t'
+call check "a quoted INTO is a word, not a keyword", t == "INTO"
+
+-- attributes, styles, classes, visibility
+'out: ATTR title "two words"'
+'out: ATTR title INTO v'
+call check "ATTR set and get", v == "two words" & el~getAttribute("title") == "two words"
+'out: ATTR nothing INTO v'
+call check "ATTR absent: empty", v == ""
+'out: STYLE color "rgb(255, 0, 0)"'
+'out: STYLE color INTO v'
+call check "STYLE set and get", v == "rgb(255, 0, 0)"
+'out: CLASS +a b c'
+'out: CLASS -a'
+'out: CLASS INTO v'
+call check "CLASS +, -, plain", v == "b c"
+'out: HIDE'
+call check "HIDE", el~hidden == 1
+'out: SHOW'
+call check "SHOW", el~hidden == 0
+
+-- fields and buttons
+'FIELD name "Your name" INTO f'
+call check "FIELD: an input with a label", f~tagName == "INPUT" & f~parentElement~querySelector("label")~textContent == "Your name"
+'name: VALUE Ana'
+'name: VALUE INTO v'
+call check "VALUE set and get", v == "Ana" & f~value == "Ana"
+'FIELD agree "I agree" CHECKBOX'
+'agree: VALUE 1'
+'agree: VALUE INTO v'
+call check "FIELD CHECKBOX: VALUE 1/0", v == 1
+'FIELD notes "" TEXTAREA INTO ta'
+call check "FIELD TEXTAREA", ta~tagName == "TEXTAREA"
+'name: DISABLE'
+call check "DISABLE", f~disabled == 1
+'name: ENABLE'
+call check "ENABLE", f~disabled == 0
+'BUTTON go "Go on" GO INTO b'
+call check "BUTTON", b~tagName == "BUTTON" & b~textContent == "Go on"
+
+-- events
+b~click
+'WAIT 2 INTO ev'
+call check "BUTTON with NAME: WAIT gets the click", rc == 0 & ev~isA(.DomEvent) & ev~name == "GO" & ev~target == "GO"
+call check ".DomEvent: element and jsEvent", ev~element == b & ev~jsEvent~type == "click"
+errorRaised = 0
+'WAIT 0.2 INTO ev'
+call check "WAIT: time over, RC 1, no ERROR", rc == 1 & errorRaised == 0 & \var("ev")
+'name: ON input TYPED'
+f~value = "Bob"
+f~dispatchEvent(w["Event"]~new("input"))
+'WAIT 2 INTO ev'
+call check "ON input: the event and the value", ev~name == "TYPED" & ev~value == "Bob" & ev~target == "NAME"
+'name: ON enter ENTERED'
+f~dispatchEvent(w["KeyboardEvent"]~new("keydown", w~eval("({key: 'a'})")))
+f~dispatchEvent(w["KeyboardEvent"]~new("keydown", w~eval("({key: 'Enter'})")))
+'WAIT 2 INTO ev'
+call check "ON enter: only the Enter key", ev~name == "ENTERED" & ev~key == "Enter"
+'name: OFF enter'
+f~dispatchEvent(w["KeyboardEvent"]~new("keydown", w~eval("({key: 'Enter'})")))
+'WAIT 0.3'
+call check "OFF", rc == 1
+-- a .js~handler and ADDRESS DOM together
+counter = .Counter~new
+'CREATE other span x INTO o'
+o~addEventListener("click", .js~handler(counter, "hit"))
+o~click; b~click
+'WAIT 2 INTO ev'
+call check "WAIT dispatches .js~handler events meanwhile", ev~name == "GO" & counter~hits == 1
+address dom "WAIT 2" with output stem n.
+b~click
+address dom "WAIT 2" with output stem n.
+call check "WAIT without INTO: the name to WITH OUTPUT", n.0 == 1 & n.1 == "GO"
+
+-- tables and lists
+rows = .array~of(.array~of("City", "Max"), .array~of("Barcelona", 24), .array~of("Girona", 22))
+'TABLE HEADER FROM rows INTO tb'
+call check "TABLE HEADER FROM an Array of Arrays", tb~tHead~rows~length == 1 & tb~tBodies~item(0)~rows~length == 2 & tb~rows~item(2)~cells~item(0)~textContent == "Girona"
+t.1 = "a" || "09"x || "b"; t.2 = "c" || "09"x || "d"; t.0 = 2
+'LOCATE table'
+address dom "TABLE" with input stem t.
+call check "TABLE on a table: rows replaced, WITH INPUT with tabs", tb~rows~length == 2 & tb~tHead == .nil & tb~rows~item(1)~cells~item(1)~textContent == "d"
+'TOP'
+'TABLE FROM t.'
+call check "TABLE FROM a stem", body~querySelectorAll("table")~length == 2
+items = .array~of("one", "two", "three")
+'LIST FROM items INTO ul'
+call check "LIST FROM an Array", ul~tagName == "UL" & ul~children~length == 3 & ul~lastElementChild~textContent == "three"
+
+-- CSS: the panel's own; the page's does not get in
+'CSS ".b { color: rgb(1, 2, 3) }"'
+'out: STYLE color "" '
+'out: STYLE color INTO v'
+call check "CSS: rules for the panel", v == "rgb(1, 2, 3)"
+pageStyle = doc~createElement("style"); pageStyle~textContent = "h2 { color: rgb(9, 9, 9) !important }"
+doc~head~appendChild(pageStyle)
+'h: STYLE color INTO v'
+call check "the page's CSS does not reach the panel", v \== "rgb(9, 9, 9)"
+pageStyle~remove
+
+-- REMOVE, CLEAR
+'out: REMOVE'
+call expect "out: TEXT a", -4, "FAILURE", "REMOVE: the nickname is gone"
+'CREATE box div'
+'box: CREATE - span one'
+'box: CREATE - span two'
+'box: CLEAR'
+'box: TEXT INTO v'
+call check "CLEAR", v == ""
+
+-- the close button: CLOSE, and no root any more
+host~shadowRoot~querySelector(".close")~click
+'WAIT 2 INTO ev'
+call check "the close button: CLOSE event", ev~name == "CLOSE" & ev~target == "P"
+call check "the panel is gone", doc~querySelectorAll(".orx-dom-panel")~length == 0
+call expect "TEXT x", -2, "FAILURE", "after CLOSE: no root"
+
+-- the CLOSE command, two panels, ROOT
+'NEW one AS first'
+'CREATE a p "in one"'
+'NEW two'
+'CREATE b p "in two"'
+call check "two panels", doc~querySelectorAll(".orx-dom-panel")~length == 2
+'ROOT first'
+'TEXT INTO v'
+call check "ROOT nickname: back to a panel", v == "in one"
+'CLOSE'
+call check "CLOSE: the panel goes", doc~querySelectorAll(".orx-dom-panel")~length == 1
+call expect "TEXT x", -2, "FAILURE", "after CLOSE: no root"
+'ROOT PAGE'
+'CREATE pg div "on the page" INTO d'
+call check "ROOT PAGE: on the page itself", d~parentElement == doc~body
+'pg: REMOVE'
+'b: CLOSE'
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+onError:   errorRaised = rc; return
+onFailure: return
+
+expect: procedure expose errorRaised
+  use arg command, wantRc, condition, name
+  errorRaised = ""
+  address dom command with error stem err.
+  ok = rc == wantRc
+  if condition == "ERROR" then ok = ok & errorRaised == wantRc
+  call check name, ok
+  return
+
+check: procedure
+  use arg name, ok
+  if ok then do; .local~ok += 1; say "ok   " name; end
+  else do; .local~bad += 1; say "FAIL " name; end
+  return
+
+::class Counter
+::attribute hits get
+::method init
+  expose hits
+  hits = 0
+::method hit
+  expose hits
+  hits += 1
+
+::requires "dom.cls"
