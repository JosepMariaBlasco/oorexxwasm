+                                        char **argv, RexxIORedirectorContext *ioContext)
+{
+    int flags = 0;
+    CSTRING inputBuffer = NULL;
+    size_t inputLength = 0;
+
+    if (ioContext->IsRedirectionRequested())
+    {
+        if (ioContext->IsInputRedirected())
+        {
+            flags |= WASM_CMD_INPUT;
+            ioContext->ReadInputBuffer(&inputBuffer, &inputLength);
+        }
+        if (ioContext->IsOutputRedirected())
+        {
+            flags |= WASM_CMD_OUTPUT;
+            if (ioContext->AreOutputAndErrorSameTarget())
+            {
+                flags |= WASM_CMD_SAME;
+            }
+        }
+        if (ioContext->IsErrorRedirected() && !ioContext->AreOutputAndErrorSameTarget())
+        {
+            flags |= WASM_CMD_ERROR;
+        }
+    }
+    else
+    {
+        // try to handle special commands like 'cd' or 'export' internally
+        RexxObjectPtr rc = NULLOBJECT;
+        if (handleCommandInternally(context, (char *)commandString, rc))
+        {
+            return rc;
+        }
+    }
+
+    char cwd[PATH_MAX];
+    if (getcwd(cwd, sizeof(cwd)) == NULL)
+    {
+        cwd[0] = '\0';
+    }
+
+    int rc = orxWasmCommandRun == NULL ? WASM_CMD_NO_PROCESSES :
+             orxWasmCommandRun(argv, getEnvironment(), cwd[0] != '\0' ? cwd : NULL,
+                               inputBuffer, (int)inputLength, flags);
+    if (rc == WASM_CMD_NO_PROCESSES)
+    {
+        return ErrorFailure(context, commandString);
+    }
+
+    if (flags & WASM_CMD_OUTPUT)
+    {
+        wasmCommandDeliver(ioContext, 0);
+    }
+    if (flags & WASM_CMD_ERROR)
+    {
+        wasmCommandDeliver(ioContext, 1);
+    }
+
+    // same mapping as the native code below
+    if (rc == UNKNOWN_COMMAND)
+    {
+        return ErrorFailure(context, commandString);
+    }
+    else if (rc != 0)
+    {
+        context->RaiseCondition("ERROR", context->String(commandString),
+          NULL, context->WholeNumberToObject(rc));
+        return NULLOBJECT;
+    }
+    return context->False();
+}
+#endif
