+// last orxWasmCommandRun() of this thread
+int orxWasmCommandResultLength(int which) __attribute__((weak));
+// copy it to buf and drop it
+void orxWasmCommandResultCopy(int which, char *buf) __attribute__((weak));
+
+/**
+ * The full path of the program that runs Rexx programs here (what a native
+ * build finds in /proc/self/exe), into buf; 0 if there is none or it does
