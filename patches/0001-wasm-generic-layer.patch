+/**
+ * WebAssembly has no signals.  The host catches SIGINT, SIGTERM and SIGHUP
+ * (under Node, wasm/node-pre.js, on the JavaScript main thread) and calls this,
+ * which does what signalHandler() does natively: a HALT in every running
+ * activity; and a sleep ends early (EINTR), as nanosleep() would.
+ *
+ * @param sig    The signal number (SIGINT, SIGTERM or SIGHUP).
+ *
+ * @return 1 if the HALT was posted, 0 if one is still pending (not yet seen
+ *         by the program), as Interpreter::haltAllActivities().
+ */
+extern "C" ORX_WASM_EXPORT(orxWasmSignal) int orxWasmSignal(int sig)
+{
+    RexxString *name = sig == SIGTERM ? GlobalNames::SIGTERM_STRING :
+                       sig == SIGHUP ? GlobalNames::SIGHUP_STRING : GlobalNames::SIGINT_STRING;
+    bool posted = Interpreter::haltAllActivities(name);
+    SysThread::interruptSleeps();
+    return posted ? 1 : 0;
+}
