+#define WASM_CMD_OUTPUT     2      // collect the output (orxWasmCommandResultCopy(0))
+#define WASM_CMD_ERROR      4      // collect the error output (orxWasmCommandResultCopy(1))
+#define WASM_CMD_SAME       8      // OUTPUT and ERROR to the same target, interleaved
+
+// orxWasmCommandRun(): the host has no processes
+#define WASM_CMD_NO_PROCESSES  (-100000)
