+// WebAssembly has no signals: the host turns SIGINT, SIGTERM and SIGHUP into
+// a HALT itself (orxWasmSignal(), SystemInterpreter.cpp; under Node,
+// wasm/node-pre.js).
+// Natively such a signal also ends a nanosleep() with EINTR, so that SysSleep
+// returns at once; here longSleep() waits on this counter instead, and
+// interruptSleeps() wakes every sleeper.
+static volatile uint32_t sleepInterrupts = 0;
+
+// milliseconds, for longSleep()
+static double wasmNowMs()
+{
+#if defined(__EMSCRIPTEN__)
+    return emscripten_get_now();
+#else
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return now.tv_sec * 1000.0 + now.tv_nsec / 1000000.0;
+#endif
+}
+
+// wait until sleepInterrupts is no longer seen, or ms milliseconds
+static void wasmSleepWait(uint32_t seen, double ms)
+{
+#if defined(__EMSCRIPTEN__)
+    emscripten_futex_wait((void *)&sleepInterrupts, seen, ms);
+#else
+    __builtin_wasm_memory_atomic_wait32((int *)&sleepInterrupts, (int)seen, (int64_t)(ms * 1000000.0));
+#endif
+}
+
+void SysThread::interruptSleeps()
+{
+    __atomic_add_fetch(&sleepInterrupts, 1, __ATOMIC_SEQ_CST);
+#if defined(__EMSCRIPTEN__)
+    emscripten_futex_wake((void *)&sleepInterrupts, INT_MAX);
+#else
+    __builtin_wasm_memory_atomic_notify((int *)&sleepInterrupts, UINT32_MAX);
+#endif
+}
+#endif
