diff --git a/common/platform/unix/SysLibrary.cpp b/common/platform/unix/SysLibrary.cpp
index c6c0386..2f8cae0 100644
--- a/common/platform/unix/SysLibrary.cpp
+++ b/common/platform/unix/SysLibrary.cpp
@@ -53,6 +53,59 @@
 #include <dlfcn.h>
 
 
+#if defined(ORX_WASM)
+// There is no dlopen in WebAssembly.  A build may instead link libraries in
+// and describe them with this table (a weak symbol: NULL in the builds that
+// link none): load() finds a library by name, getProcedure() a symbol in it,
+// so ::METHOD ... EXTERNAL "LIBRARY name ...", RxFuncAdd() and the
+// Rexx*Dll() registrations work for them unchanged.  A library may take
+// several entries (one per source file); the table ends with a NULL name.
+extern "C"
+{
+typedef struct { const char *name; void *address; } OrxWasmStaticSymbol;
+typedef struct { const char *name; const OrxWasmStaticSymbol *symbols; } OrxWasmStaticLibrary;
+const OrxWasmStaticLibrary *orx_wasm_static_libraries(void) __attribute__((weak));
+}
+
+/**
+ * Return the first static library entry called name, or NULL.
+ */
+static const OrxWasmStaticLibrary *findStaticLibrary(const char *name)
+{
+    if (orx_wasm_static_libraries == NULL)
+    {
+        return NULL;
+    }
+    for (const OrxWasmStaticLibrary *l = orx_wasm_static_libraries(); l->name != NULL; l++)
+    {
+        if (strcmp(l->name, name) == 0)
+        {
+            return l;
+        }
+    }
+    return NULL;
+}
+
+/**
+ * Is this handle one of the static library entries?
+ */
+static bool isStaticLibrary(void *handle)
+{
+    if (handle == NULL || orx_wasm_static_libraries == NULL)
+    {
+        return false;
+    }
+    for (const OrxWasmStaticLibrary *l = orx_wasm_static_libraries(); l->name != NULL; l++)
+    {
+        if ((void *)l == handle)
+        {
+            return true;
+        }
+    }
+    return false;
+}
+#endif
+
 #define MAX_LIBRARY_NAME_LENGTH 250
 #define LIBARY_NAME_BUFFER_LENGTH (1 + MAX_LIBRARY_NAME_LENGTH + sizeof("/usr/lib/lib") + sizeof(ORX_SHARED_LIBRARY_EXT))
 
@@ -68,6 +121,27 @@ void * SysLibrary::getProcedure(
 /* Function:  Resolve a named procedure in a library                          */
 /******************************************************************************/
 {
+#if defined(ORX_WASM)
+    if (isStaticLibrary(libraryHandle))
+    {
+        const char *library = ((const OrxWasmStaticLibrary *)libraryHandle)->name;
+        for (const OrxWasmStaticLibrary *l = (const OrxWasmStaticLibrary *)libraryHandle; l->name != NULL; l++)
+        {
+            if (strcmp(l->name, library) != 0)
+            {
+                continue;
+            }
+            for (const OrxWasmStaticSymbol *s = l->symbols; s->name != NULL; s++)
+            {
+                if (strcmp(s->name, name) == 0)
+                {
+                    return s->address;
+                }
+            }
+        }
+        return NULL;
+    }
+#endif
     return dlsym(libraryHandle, name);
 }
 
@@ -85,6 +159,15 @@ bool SysLibrary::load(
         return false;
     }
 
+#if defined(ORX_WASM)
+    const OrxWasmStaticLibrary *linkedIn = findStaticLibrary(name);
+    if (linkedIn != NULL)
+    {
+        libraryHandle = (void *)linkedIn;
+        return true;
+    }
+#endif
+
     snprintf(nameBuffer, LIBARY_NAME_BUFFER_LENGTH, "lib%s%s", name, ORX_SHARED_LIBRARY_EXT);
     // try loading directly
     libraryHandle = dlopen(nameBuffer, RTLD_LAZY);
