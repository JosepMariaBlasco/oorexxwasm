+#/* Redistributions in binary form must reproduce the above copyright          */
+#/* notice, this list of conditions and the following disclaimer in            */
+#/* the documentation and/or other materials provided with the distribution.   */
+#/*                                                                            */
+#/* Neither the name of Rexx Language Association nor the names                */
+#/* of its contributors may be used to endorse or promote products             */
+#/* derived from this software without specific prior written permission.      */
+#/*                                                                            */
+#/* THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS        */
+#/* "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT          */
+#/* LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS          */
+#/* FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT   */
+#/* OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,      */
+#/* SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED   */
+#/* TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA,        */
+#/* OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY     */
+#/* OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING    */
+#/* NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS         */
+#/* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.               */
+#/*                                                                            */
+#/*----------------------------------------------------------------------------*/
+set -uo pipefail
+# Node qualification of the MEMFS build (BUILD/bin, WebSocket sockets against
+# a local RFC6455 echo server).  Every check asserts its expected output;
+# exit status 1 and "QUALIFICATION FAIL (n): ..." if any check fails.
+BUILD=${1:?usage: qualify-node.sh /path/to/build-dir}
+ROOT=$(cd "$(dirname "$0")/../.." && pwd)
+BIN="$BUILD/bin"
+PORT=${OOREXX_WASM_TEST_PORT:-50010}
+mkdir -p "$BIN/node_modules/ws"
+cp "$ROOT/wasm/node-ws-compat/index.js" "$BIN/node_modules/ws/index.js"
+# GNU timeout (Linux coreutils); on macOS Homebrew's coreutils also has gtimeout
+TIMEOUT=$(command -v timeout || command -v gtimeout) || { echo 'qualification needs GNU timeout (macOS: brew install coreutils)' >&2; exit 2; }
+python3 -c 'import websockets' >/dev/null || { echo 'python package websockets is required for qualification' >&2; exit 2; }
+OOREXX_WASM_TEST_PORT="$PORT" python3 "$ROOT/wasm/tests/ws_echo.py" >"$BUILD/ws_echo.log" 2>&1 &
+SERVER=$!
+trap 'kill "$SERVER" 2>/dev/null || true' EXIT
+sleep 0.5
+cd "$BIN"
+
+# check TITLE REGEX... -- COMMAND...
+# Runs COMMAND, prints its output, and requires
+# every REGEX to match some output line and the exit status to be 0.
+FAILED=()
+check() {
+  local title=$1; shift
+  local pats=() p miss=() out rc
+  while [[ $1 != -- ]]; do pats+=("$1"); shift; done; shift
+  echo "== $title =="
+  out=$("$TIMEOUT" 60 "$@" 2>&1); rc=$?
+  printf '%s\n' "$out"
+  for p in "${pats[@]}"; do grep -Eq -- "$p" <<<"$out" || miss+=("/$p/"); done
+  (( rc == 0 )) || miss+=("exit status $rc")
+  if (( ${#miss[@]} )); then
+    FAILED+=("$title"); printf 'FAIL: %s: expected %s\n' "$title" "${miss[*]}"
+  fi
+}
+
+check 'version' '^Open Object Rexx Version 5\.3\.0' '^Addressing mode: 32$' -- node ./rexx.js -v
+
+check 'core' '^1267650600228229401496703205376$' '^ananab$' -- node ./rexx.js -e 'numeric digits 50; say 2 ** 100; say "banana"~reverse'
+
+check 'RxSock primitive' '^5\.3\.0$' '^socket=[0-9]+$' '^close=0$' -- node ./rexx.js -e 'say SockVersion(); s=SockSocket("AF_INET","SOCK_STREAM","IPPROTO_TCP"); say "socket="s; say "close="SockClose(s)'
+
+check 'WebSocket echo' '^connect= 0 send= 29 recv= 29 same= 1$' -- node ./rexx.js -e "s=SockSocket(\"AF_INET\",\"SOCK_STREAM\",\"IPPROTO_TCP\"); h.!family=\"AF_INET\"; h.!addr=\"127.0.0.1\"; h.!port=\"$PORT\"; rc=SockConnect(s,\"h.!\"); msg=\"Hello from ooRexx/WASM RxSock\"; n1=SockSend(s,msg); n2=SockRecv(s,\"back\",4096); say \"connect=\" rc \"send=\" n1 \"recv=\" n2 \"same=\" (back==msg); call SockClose s"
+
+check 'stream semantics 5000 bytes' '^len= 5000 same= 1$' -- node ./rexx.js -e "s=SockSocket(\"AF_INET\",\"SOCK_STREAM\",\"IPPROTO_TCP\"); h.!family=\"AF_INET\"; h.!addr=\"127.0.0.1\"; h.!port=\"$PORT\"; call SockConnect s,\"h.!\"; msg=copies(\"X\",5000); call SockSend s,msg; all=\"\"; do i=1 to 5; n=SockRecv(s,\"part\",1000); all=all||part; end; say \"len=\" length(all) \"same=\" (all==msg); call SockClose s"
+
+check 'binary transparency' '^len= 15 same= 1 hex= 00010D0A7F80FEFF41004200FF1020$' -- node ./rexx.js -e "s=SockSocket(\"AF_INET\",\"SOCK_STREAM\",\"IPPROTO_TCP\"); h.!family=\"AF_INET\"; h.!addr=\"127.0.0.1\"; h.!port=\"$PORT\"; call SockConnect s,\"h.!\"; msg=\"00010D0A7F80FEFF41004200FF1020\"x; call SockSend s,msg; n=SockRecv(s,\"back\",100); say \"len=\" n \"same=\" (back==msg) \"hex=\" c2x(back); call SockClose s"
+
+check 'select timeout/readiness' '^timeout=0 elapsed=0\.(09|[1-4][0-9])' '^ready=1 data=ready$' -- node ./rexx.js -e "s=SockSocket(\"AF_INET\",\"SOCK_STREAM\",\"IPPROTO_TCP\"); h.!family=\"AF_INET\"; h.!addr=\"127.0.0.1\"; h.!port=\"$PORT\"; call SockConnect s,\"h.!\"; r.0=1;r.1=s;w.0=0;e.0=0;call time \"R\";rc=SockSelect(\"r.\",\"w.\",\"e.\",0.10); say \"timeout=\"rc \"elapsed=\"time(\"E\"); call SockSend s,\"ready\"; r.0=1;r.1=s;rc=SockSelect(\"r.\",\"w.\",\"e.\",1); n=SockRecv(s,\"back\",10); say \"ready=\"rc \"data=\"back; call SockClose s"
+
+check 'nonblocking connect' '^connect=-1 errno=EINPROGRESS select=1 so_error=0$' -- node ./rexx.js -e "s=SockSocket(\"AF_INET\",\"SOCK_STREAM\",\"IPPROTO_TCP\"); call SockIoctl s,\"FIONBIO\",1; h.!family=\"AF_INET\"; h.!addr=\"127.0.0.1\"; h.!port=\"$PORT\"; rc=SockConnect(s,\"h.!\"); saved=errno; r.0=0;w.0=1;w.1=s;e.0=0; sr=SockSelect(\"r.\",\"w.\",\"e.\",1); call SockGetSockOpt s,\"SOL_SOCKET\",\"SO_ERROR\",\"soerr\"; say \"connect=\"rc \"errno=\"saved \"select=\"sr \"so_error=\"soerr; call SockClose s"
+
+BADPORT=$((PORT+1))
+check 'refused blocking connect' '^connect= -1 errno= ECONNREFUSED$' -- node ./rexx.js -e "s=SockSocket(\"AF_INET\",\"SOCK_STREAM\",\"IPPROTO_TCP\"); h.!family=\"AF_INET\"; h.!addr=\"127.0.0.1\"; h.!port=\"$BADPORT\"; rc=SockConnect(s,\"h.!\"); say \"connect=\" rc \"errno=\" errno; call SockClose s"
+
+check 'high level StreamSocket / DNS' '^localhost_addr= [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' '^open= READY: out= 25 in= Hello from StreamSocket state= READY$' '^close= READY:$' -- node ./rexx.js -e "call SockGetHostByName \"localhost\",\"hi.!\"; say \"localhost_addr=\" hi.!addr; s=.StreamSocket~new(\"localhost\",$PORT); o=s~open; n=s~lineOut(\"Hello from StreamSocket\"); b=s~lineIn; say \"open=\" o \"out=\" n \"in=\" b \"state=\" s~state; say \"close=\" s~close; ::requires \"/streamsocket.cls\""
+
+if (( ${#FAILED[@]} )); then
+  echo "QUALIFICATION FAIL (${#FAILED[@]}): ${FAILED[*]}"
+  exit 1
+fi
+echo 'QUALIFICATION PASS'
