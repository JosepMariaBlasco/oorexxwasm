+/* SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED   */
+/* TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA,        */
+/* OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY     */
+/* OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING    */
+/* NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS         */
+/* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.               */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+/*
+ * ooRexx/WASM: run gethostbyname()'s name lookup on the main thread.
+ *
+ * Emscripten's SOCKFS fakes DNS: a host name is mapped to a synthetic IPv4
+ * address in a JS table ($DNS), and connect() maps it back to the name to
+ * build the WebSocket URL.  With -sPROXY_TO_PTHREAD the interpreter runs on a
+ * worker, while socket syscalls (and getaddrinfo) are proxied to the main
+ * thread.  _emscripten_lookup_name, used by gethostbyname(), is not proxied,
+ * so the mapping was created in the worker's own $DNS table and connect() on
+ * the main thread could not translate the synthetic address back
+ * (.StreamSocket~new("localhost", port) -> ECONNREFUSED).  Proxying the lookup
+ * keeps a single $DNS table on the main thread.
+ */
+addToLibrary({
+  _emscripten_lookup_name__deps: ['$UTF8ToString', '$DNS', '$inetPton4'],
+  _emscripten_lookup_name__proxy: 'sync',
+  _emscripten_lookup_name: (name) => {
+    var nameString = UTF8ToString(name);
+    return inetPton4(DNS.lookup_name(nameString));
+  },
+});
