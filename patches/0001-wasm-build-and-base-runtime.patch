+if (EMSCRIPTEN)
+  # native WebAssembly exceptions, the standardized ones (exnref): the legacy
+  # encoding is deprecated (Firefox warns).  WebKit's wasm interpreter before
+  # 26.6 does not catch an exception thrown by a call_indirect that ends a
+  # try body (either encoding); with exnref the compiler produces that shape
+  # far less often (4 sites instead of 52), so a Rexx error raised in cold
+  # code, e.g. on a new thread, no longer kills the run there.
+  # Needs Chrome 137, Firefox 131, Safari 18.4, Node 22.
+  # Every object with exceptions must use the same encoding (wasm/build-web.sh
+  # compiles web-jdor.cpp with it too): Chromium rejects a module that mixes.
+  set(ORX_WASM_EH -fwasm-exceptions -sWASM_LEGACY_EXCEPTIONS=0)
