+import asyncio, os
+import websockets
+PORT=int(os.environ.get('OOREXX_WASM_TEST_PORT','50010'))
+async def echo(ws):
+    async for message in ws:
+        await ws.send(message)
+async def main():
+    async with websockets.serve(echo, '127.0.0.1', PORT, subprotocols=['binary']):
+        await asyncio.Future()
+asyncio.run(main())
