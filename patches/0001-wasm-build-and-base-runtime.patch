+LLVM_ROOT = '$TC/bin'
+BINARYEN_ROOT = '$TC'
+EMSCRIPTEN_ROOT = '$TC/emscripten'
+NODE_JS = ['$NODE']
+CFG
+
+export EM_CONFIG="$BUILD/.emscripten"
+export PATH="$TC/bin:$TC/emscripten:$PATH"
+
+emcmake cmake -S "$SRC" -B "$BUILD" \
+  -C "$SRC/cmake/wasm-emscripten-6.0.9-cache.cmake" \
+  -DCMAKE_BUILD_TYPE=Release \
+  -DORX_ENABLE_IPO=OFF
+cmake --build "$BUILD" --target rexx_exe -j"${JOBS:-4}"
+
+echo
+echo "WASM runtime built in $BUILD/bin"
+ls -lh "$BUILD/bin/rexx.js" "$BUILD/bin/rexx.wasm" "$BUILD/bin/rexx.data" "$BUILD/bin/rexx.img"
