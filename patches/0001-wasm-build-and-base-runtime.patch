+'use strict';
+// Minimal client-only compatibility layer for Emscripten SOCKFS under Node 22.
+// Emscripten calls require('ws'); Node 22 already has a WHATWG WebSocket client.
+const NativeWebSocket = globalThis.WebSocket;
+if (typeof NativeWebSocket !== 'function') throw new Error('Node built-in WebSocket unavailable');
+class WsCompat {
+  constructor(url, protocols) { this._ws = new NativeWebSocket(url, protocols); }
+  static get CONNECTING(){return NativeWebSocket.CONNECTING} static get OPEN(){return NativeWebSocket.OPEN}
+  static get CLOSING(){return NativeWebSocket.CLOSING} static get CLOSED(){return NativeWebSocket.CLOSED}
+  get CONNECTING(){return NativeWebSocket.CONNECTING} get OPEN(){return NativeWebSocket.OPEN}
+  get CLOSING(){return NativeWebSocket.CLOSING} get CLOSED(){return NativeWebSocket.CLOSED}
+  get readyState(){return this._ws.readyState} get url(){return this._ws.url}
+  set binaryType(v){this._ws.binaryType=v} get binaryType(){return this._ws.binaryType}
+  send(data){return this._ws.send(data)} close(...args){return this._ws.close(...args)}
+  on(event, handler) {
+    if (event === 'message') this._ws.addEventListener('message', async ev => {
+      let d=ev.data;
+      if (d instanceof ArrayBuffer) handler(Buffer.from(d), true);
+      else if (ArrayBuffer.isView(d)) handler(Buffer.from(d.buffer,d.byteOffset,d.byteLength), true);
+      else if (typeof d === 'string') handler(Buffer.from(d), false);
+      else if (d?.arrayBuffer) handler(Buffer.from(await d.arrayBuffer()), true);
+    });
+    else if (event === 'open') this._ws.addEventListener('open', ()=>handler());
+    else if (event === 'close') this._ws.addEventListener('close', ()=>handler());
+    else if (event === 'error') this._ws.addEventListener('error', ev=>handler(ev));
+    return this;
+  }
+}
+// Listening sockets are not supported (as in the browser): make SOCKFS's
+// listen() fail with EOPNOTSUPP instead of crashing the runtime with
+// "WebSocketServer is not a constructor".  Emscripten's syscall wrappers turn
+// an exception named ErrnoError into -errno.
+class WsServerUnsupported {
+  constructor() { const e = new Error('listening sockets are not supported'); e.name = 'ErrnoError'; e.errno = 138; throw e; }
+}
+WsCompat.Server = WsServerUnsupported;
+module.exports=WsCompat;
