diff --git a/common/platform/unix/SysProcess.cpp b/common/platform/unix/SysProcess.cpp
index 69b1869..485a701 100644
--- a/common/platform/unix/SysProcess.cpp
+++ b/common/platform/unix/SysProcess.cpp
@@ -179,6 +179,81 @@ void SysProcess::getUserID(char *buffer)
     buffer[MAX_USERID_LENGTH-1] = '\0';
 }
 
+#if defined(__EMSCRIPTEN__)
+#include <emscripten.h>
+
+/*
+ * WASM: Emscripten's libc has no passwd database (getpwnam()/getpwuid() always
+ * fail), so USERID(), "cd ~user" and the like would find no user.  The link
+ * wraps both functions (-Wl,--wrap=getpwnam,--wrap=getpwuid) to provide the one
+ * user the process runs as: under Node the host user (os.userInfo()), in the
+ * browser the synthetic user "wasm" with $HOME as its home directory.
+ */
+EM_JS(int, wasmUserInfo, (char *buf, int size), {
+    if (typeof process !== 'object' || !process.versions || !process.versions.node ||
+        typeof require !== 'function')
+    {
+        return 0;
+    }
+    try
+    {
+        var u = require('os').userInfo();
+        var text = u.username + '\n' + u.homedir + '\n' + (u.shell || '/bin/sh');
+        if (lengthBytesUTF8(text) >= size) return 0;
+        stringToUTF8(text, buf, size);
+        return 1;
+    }
+    catch (e)
+    {
+        return 0;
+    }
+});
+
+static struct passwd *wasmCurrentUser()
+{
+    static char text[1024];
+    static struct passwd entry;
+    if (!wasmUserInfo(text, sizeof(text)))
+    {
+        const char *home = getenv("HOME");
+        snprintf(text, sizeof(text), "wasm\n%s\n/bin/sh", home != NULL ? home : "/");
+    }
