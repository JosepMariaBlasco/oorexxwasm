+/* https://www.oorexx.org/license.html                                        */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+/**
+ * In-process connection to the Rexx API server (WebAssembly build).
+ *
+ * A WASM process cannot start or reach the rxapi daemon, so the server code
+ * (queues, registrations, macrospace) is linked into the interpreter and the
+ * client talks to it through this connection: the request written by
+ * ClientMessage is decoded and dispatched on the calling thread when the
+ * client starts reading the reply.  The message protocol and the server code
+ * are unchanged; only the transport is replaced.
+ */
+#ifndef SysLoopbackConnection_Included
+#define SysLoopbackConnection_Included
+
+#include <stddef.h>
+#include <stdlib.h>
+#include "CSStream.hpp"
+#include <vector>
+
+class SysLoopbackConnection : public ApiConnection
+{
+public:
+    SysLoopbackConnection() : ApiConnection(), replyPos(0) { }
+    ~SysLoopbackConnection() { }
+    bool read(void *buf, size_t bufsize, size_t *bytesread) override;
+    bool write(void *buf, size_t bufsize, size_t *byteswritten) override;
+    bool write(void *buf, size_t bufsize, void *buf2, size_t buf2size, size_t *byteswritten) override;
+    bool disconnect() override { return true; }
+
+protected:
+    void serve();
+
+    std::vector<char> request;   // bytes written by the client, not yet served
+    std::vector<char> reply;     // the server's answer
+    size_t replyPos;             // read position in the reply
+};
+
+#endif
diff --git a/rexxapi/server/APIServer.cpp b/rexxapi/server/APIServer.cpp
index f388983..dbbfe2f 100644
--- a/rexxapi/server/APIServer.cpp
+++ b/rexxapi/server/APIServer.cpp
@@ -214,6 +214,47 @@ void APIServer::processMessages(ApiConnection *connection)
 }
 
 
+#if defined(__EMSCRIPTEN__)
+/**
+ * Process a single message for an in-process client (WebAssembly build, see
+ * SysLoopbackConnection): the same dispatching as processMessages(), without
+ * a connection to read from or reply to.
+ *
+ * @param message The request; the result is placed back into it.
+ */
+void APIServer::processMessage(ServiceMessage &message)
+{
+    message.result = MESSAGE_OK;     // unconditionally zero the result
+    try
+    {
+        switch (message.messageTarget)
+        {
+            case QueueManager:
+            case RegistrationManager:
+            case MacroSpaceManager:
+            {
+                getInstance(message)->dispatch(message);
+                break;
+            }
+
+            case APIManager:
+            {
+                // there is no connection to close in process
+                if (message.operation != CLOSE_CONNECTION)
+                {
+                    dispatch(message);
+                }
+                break;
+            }
+        }
+    } catch (std::bad_alloc &)
+    {
+        message.result = SERVER_ERROR;
+    }
+}
+#endif
+
+
 /**
  * Dispatch an API server control message.
  *
