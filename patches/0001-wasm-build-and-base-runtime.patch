+set -euo pipefail
+
+# TOOLCHAIN: the "upstream" directory of an emsdk installation (with
+# emscripten/ and bin/), or an extracted official wasm-binaries.tar.xz (whose
+# top level contains install/)
+if [[ $# -lt 1 || $# -gt 2 ]]; then
+  echo "usage: $0 TOOLCHAIN [build-dir]   (TOOLCHAIN: emsdk/upstream or extracted wasm-binaries)" >&2
+  exit 2
+fi
+
+TC=$(cd "$1" && pwd)
+[[ -x "$TC/emscripten/emcc" ]] || TC=$TC/install
+SRC=$(cd "$(dirname "$0")/.." && pwd)
+BUILD=${2:-"$SRC/build-wasm"}
+mkdir -p "$BUILD"
+BUILD=$(cd "$BUILD" && pwd)
+NODE=$(command -v node)
+
+if [[ ! -x "$TC/emscripten/emcc" ]]; then
+  echo "no emscripten/emcc under $1 (or $1/install)" >&2
+  exit 2
+fi
+
