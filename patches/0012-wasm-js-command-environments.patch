+// COMMAND(command, caller) of a .JSCommandHandler (js.cls): fn(command, ctx),
+// ctx a .JSCommandContext on caller; what fn gives is RC (undefined or null:
+// 0; a thenable is waited for).  Native, so that no Rexx activation stands
+// between the code that issued the command and JavaScript: a condition that
+// Rexx code the function calls raises (USER ... RETURN, a HALT given back as
+// a HALT) reaches that code as itself; one that the API holds when this
+// returns (a SYNTAX) is raised there by the interpreter
+RexxMethod2(RexxObjectPtr, js_command, RexxObjectPtr, command, RexxObjectPtr, caller)
+{
+    RexxThreadContext *c = context->threadContext;
+    RexxObjectPtr fn = context->GetObjectVariable("FN");
+    RexxClassObject ctxClass = context->FindContextClass("JSCOMMANDCONTEXT");
+    if (fn == NULLOBJECT || ctxClass == NULLOBJECT) return context->WholeNumberToObject(0);
+    RexxObjectPtr ctx = c->SendMessage1(ctxClass, "NEW", caller);
+    if (c->CheckCondition()) return NULLOBJECT;
+    RexxArrayObject a = c->ArrayOfThree(c->Nil(), command, ctx);
+    RexxObjectPtr r = c->SendMessage(fn, "CALL", a);
+    if (c->CheckCondition()) return NULLOBJECT;
+    if (r != NULLOBJECT && isA(c, r, jsObjectClass))
+    {
+        RexxObjectPtr then = c->SendMessage1(r, "[]", c->String("then"));
+        if (c->CheckCondition()) return NULLOBJECT;
+        if (then != NULLOBJECT && isA(c, then, jsObjectClass))
+        {
+            RexxObjectPtr type = c->SendMessage0(then, "JS.TYPEOF");
+            if (c->CheckCondition()) return NULLOBJECT;
+            if (type != NULLOBJECT && c->ObjectToStringValue(type) == std::string("function"))
+            {
+                r = c->SendMessage0(r, "AWAIT");
+                if (c->CheckCondition()) return NULLOBJECT;
+            }
+        }
+    }
+    if (r == NULLOBJECT || r == c->Nil() || r == jsUndefined) return context->WholeNumberToObject(0);
+    return r;
+}
