diff --git a/wasm/tests/js-commands.rex b/wasm/tests/js-commands.rex
new file mode 100644
index 0000000..65047e8
--- /dev/null
+++ b/wasm/tests/js-commands.rex
@@ -0,0 +1,347 @@
+/*----------------------------------------------------------------------------*/
+/* Command environments written in JavaScript (.JSCommandHandler, one of    */
+/* the interpreter's .CommandHandlers), in the realm of .js: the worker's in */
+/* the browser, Node's under Node.  Prints one line per check; exits 1 if    */
+/* any fails.                                                                 */
+/*----------------------------------------------------------------------------*/
+.local~ok = 0; .local~bad = 0
+.local~fn = .js~Function~new("args", "body", "return new Function(...args.split(','), body)")
+
+calc = F("command,ctx", -
+  "switch (command) {" -
+  "case 'none': return;" -
+  "case 'null': return null;" -
+  "case 'text': return 'abc';" -
+  "case 'number': return 6 * 7;" -
+  "case 'promise': return Promise.resolve(7);" -
+  "case 'negative': return -3;" -
+  "case 'thenable': return { then(ok) { ok(9); } };" -
+  "case 'user': return 'JavaScript went on: ' + globalThis.thing.user();" -
+  "case 'later': return new Promise((r) => setTimeout(() => r(8), 10));" -
+  "case 'env': return ctx.environment();" -
+  "case 'vars': { const x = ctx.getVar('X'); ctx.setVar('Y', 'got ' + x); ctx.setVar('S.1', 'one');" -
+  "  ctx.dropVar('Z'); return [ctx.hasVar('X'), ctx.hasVar('Z'), ctx.getVar('NOPE') === 'NOPE'].join(' '); }" -
+  "case 'all': return Object.keys(ctx.variables()).includes('X') ? 'has X' : 'no X';" -
+  "case 'out': ctx.output().lineout('one'); ctx.output().arrayOut(['two', 'three']); ctx.error().lineout('err'); return 0;" -
+  "case 'in': { if (!ctx.isRedirected('Input')) return 'no input'; const i = ctx.input(); let n = 0, t = '';" -
+  "  while (i.lines() > 0) { n++; t += i.linein(); } return n + ' ' + t; }" -
+  "case 'lines': return ctx.input().arrayIn().length;" -
+  "case 'noout': ctx.output().lineout('x'); return 0;" -
+  "case 'bracket': return ctx.sendMessage('[]', ['X']);" -
+  "case 'redir': return ['Input', 'Output', 'Error'].map((k) => ctx.isRedirected(k)).join('');" -
+  "case 'error': return ctx.raiseError(5);" -
+  "case 'failure': return ctx.raiseFailure(-2);" -
+  "case 'raiseuser': return ctx.raise('USER MINE', 4, 'from JavaScript');" -
+  "case 'halt': globalThis.thing.halts(); return 0;" -
+  "case 'raisehalt': return ctx.raise('HALT', 5);" -
+  "case 'errorhalt': ctx.raiseError(5); globalThis.thing.halts(); return 5;" -
+  "case 'halthere': globalThis.thing.haltHere(); return 6;" -
+  "case 'twice': ctx.raiseError(1); return ctx.raiseError(2);" -
+  "case 'throw': throw new TypeError('from the handler');" -
+  "case 'reject': return Promise.reject(new RangeError('rejected'));" -
+  "case 'badname': return ctx.getVar('1abc');" -
+  "case 'keep': globalThis.keptCtx = ctx; return ctx.isValid() ? 'valid' : 'not valid';" -
+  "default: return 'unknown: ' + command; }")
+
+call check "register: .nil, nothing covered", .CommandHandler~register("calc", .JSCommandHandler~new(calc)) == .nil   -- lower case on purpose
+address calc
+"none";                  call check "no result: RC 0", rc == 0
+"null";                  call check "null: RC 0", rc == 0
+"text";                  call check "a string: RC is it", rc == "abc"
+"number";                call check "a number: RC is it", rc == 42
+"promise";               call check "a Promise: waited for, RC its value", rc == 7
+"later";                 call check "a Promise settled later: waited for", rc == 8
+"thenable";              call check "a thenable (not a Promise): waited for", rc == 9
+call on error name gotError; call on failure name gotFailure; raised = ""
+"negative";              call check "a negative RC raises nothing", rc == -3 & raised == ""
+call off error; call off failure
+"env";                   call check "ctx.environment(): the ADDRESS name", rc == "CALC"
+x = 42; z = "gone"
+"vars";                  call check "ctx: getVar, hasVar, setVar, dropVar", rc == "true false true" & -
+                           y == "got 42" & s.1 == "one" & \var("Z")
+"all";                   call check "ctx.variables(): the caller's variables", rc == "has X"
+address calc "out" with output stem o. error stem e.
+call check "ctx.output(): the WITH OUTPUT stream (lineout, arrayOut)", o.0 == 3 & o.1 == "one" & o.3 == "three"
+call check "ctx.error(): the WITH ERROR stream", e.0 == 1 & e.1 == "err"
+i.0 = 2; i.1 = "p"; i.2 = "q"
+address calc "in" with input stem i.; call check "ctx.input(): the WITH INPUT stream (lines, linein)", rc == "2 pq"
+"in";                    call check "ctx.isRedirected('Input') without WITH INPUT: false", rc == "no input"
+address calc "lines" with input stem i.; call check "ctx.input().arrayIn(): all of WITH INPUT", rc == 2
+address calc "redir" with input stem i. output stem o.; call check "ctx.isRedirected: booleans", rc == "truetruefalse"
+signal on syntax name s7
+"noout"
+s7:
+call check "ctx.output() without WITH OUTPUT: SYNTAX 98.900, the core's", condition("O")~code == "98.900" & -
+  condition("O")~message~pos("not given WITH OUTPUT") > 0
+x = 42
+"bracket";               call check "ctx[name] (the message []): the caller's variable", rc == 42
+-- a USER condition that a Rexx handler raises reaches the trap of the code
+-- that issued the command, as itself; so does one that Rexx code a
+-- JavaScript handler's function calls raises (COMMAND is native: no Rexx
+-- activation in between), as in plain Rexx: SIGNAL ON traps it (the command
+-- does not finish), CALL ON runs and the function goes on (RC its result),
+-- untrapped it is ignored
+.CommandHandler~register("REXXH", .RaisingHandler~new)
+call userCommand "REXXH", "raise"
+call check "a Rexx handler that raises USER: the caller's SIGNAL ON, as itself", -
+  .local~userTrapped == "USER MINE | the description | two"
+.js~globalThis["thing"] = .Thing~new
+call userCommand "CALC", "user"
+call check "USER from Rexx code the function calls: SIGNAL ON, as itself", -
+  .local~userTrapped == "USER MINE | the description | two"
+call check "USER from Rexx code the function calls: CALL ON, the function goes on", -
+  userCallOn() == "USER MINE the description rc JavaScript went on: 7"
+address calc "user";     call check "USER from Rexx code the function calls: untrapped, ignored", -
+  rc == "JavaScript went on: 7"
+-- NOTREADY, ERROR and FAILURE the same; ERROR's and FAILURE's RC too (a
+-- CALL ON ERROR trap sets RC, as for a RAISE ERROR in plain Rexx)
+.CommandHandler~register("RAISES", .JSCommandHandler~new(F("command,ctx", -
+  "return 'JavaScript went on: ' + globalThis.thing.raises(command)")))
+cases = .array~of( -
+  .array~of("NOTREADY", "NOTREADY | the description | The NIL object", "CALL ON NOTREADY | JavaScript went on: 8", "JavaScript went on: 8"), -
+  .array~of("ERROR", "ERROR | the description | 5", "CALL ON ERROR | 5", "JavaScript went on: 9"), -
+  .array~of("FAILURE", "FAILURE | the description | 6", "CALL ON FAILURE | 6", "JavaScript went on: 10"))
+do k over cases
+  call check k[1] "from Rexx code the function calls: SIGNAL ON, as itself (RC too)", cmdSignalOn(k[1]) == k[2]
+  call check k[1] "from Rexx code the function calls: CALL ON, the function goes on", cmdCallOn(k[1]) == k[3]
+  address raises k[1];   call check k[1] "from Rexx code the function calls: untrapped, ignored", rc == k[4]
+end
+call check "deregister RAISES", .CommandHandler~deregister("RAISES")~isA(.JSCommandHandler)
+
+call on error name gotError
+"error";                 call check "ctx.raiseError(5): ERROR, RC 5", raised == "ERROR 5"
+call off error
+call on failure name gotFailure
+"failure";               call check "ctx.raiseFailure(-2): FAILURE, RC -2", raised == "FAILURE -2"
+call off failure
+call userCommand "CALC", "raiseuser"
+call check "ctx.raise('USER MINE', 4, ...): the caller's SIGNAL ON, as itself", -
+  .local~userTrapped == "USER MINE | from JavaScript | -" & .local~userRc == 4
+signal on syntax name s0
+"twice"
+s0:
+c = condition("O")
+call check "a second ctx.raise in one command: SYNTAX 93.900", c~code == "93.900" & -
+  c~message~pos("already raised") > 0
+-- with ::OPTIONS ERROR SYNTAX it is still the condition raised (ooRexx #2119,
+-- fixed in r13282: before, SYNTAX 98.970 even when trapped)
+opts = .Routine~new("opts", .array~of('signal on user mine name got', 'address calc "raiseuser"', -
+  'return "no trap, rc" rc', 'got: return condition("C") "rc" rc', '::options error syntax'))
+call check "ctx.raise under ::OPTIONS ERROR SYNTAX: still USER MINE", opts~call == "USER MINE rc 4"
+-- a HALT: ctx.raise("HALT") is a HALT for the code that issued the command,
+-- as for the interpreter's command handlers; so is a HALT that Rexx code the
+-- JavaScript function calls leaves untrapped (there is JavaScript in between:
+-- a HALT given back as a HALT), while a HALT raised in a routine that a
+-- handler written in Rexx calls reaches the issuer as SYNTAX 4.1, as in plain
+-- Rexx
+.js~globalThis["thing"] = .Thing~new
+call check "raisehalt: SIGNAL ON HALT traps it", haltSignalOn("raisehalt") == "HALT"
+call check "raisehalt: CALL ON HALT after the next clause", haltCallOn("raisehalt") == "HALT rc 5"
+call check "raisehalt: untrapped, SYNTAX 4.1", haltUntrapped("raisehalt") == "SYNTAX 4.1"
+call check "halt (Rexx code the function calls): SIGNAL ON HALT traps it", haltSignalOn("halt") == "HALT"
+call check "halt (Rexx code the function calls): CALL ON HALT after the next clause", haltCallOn("halt") == "HALT rc 0"
+call check "halt (Rexx code the function calls): untrapped, SYNTAX 4.1", haltUntrapped("halt") == "SYNTAX 4.1"
+-- RAISE HALT in a method that JavaScript calls on the issuer's thread: the
+-- SIGNAL ON HALT of the issuer (and COMMAND's own) must not unwind through
+-- JavaScript's frames; the call answers JavaScript, which finishes, first
+call check "raise halt in a method JavaScript calls: SIGNAL ON HALT traps it", haltSignalOn("halthere") == "HALT"
+call check "raise halt in a method JavaScript calls: CALL ON HALT after the next clause", haltCallOn("halthere") == "HALT rc 6"
+call check "raise halt in a method JavaScript calls: untrapped, SYNTAX 4.1", haltUntrapped("halthere") == "SYNTAX 4.1"
+call check "halt after ctx.raiseError: SIGNAL ON HALT traps the HALT", haltSignalOn("errorhalt") == "HALT"
+call check "halt after ctx.raiseError: CALL ON gets both, ERROR first", haltErrorCallOn() == "ERROR HALT rc 5"
+.CommandHandler~register("REXXHALT", .HaltingHandler~new)
+call check "a handler in Rexx: a routine's HALT is SYNTAX 4.1, as in plain Rexx", haltSignalOn("halt", "REXXHALT") == "SYNTAX 4.1"
+
+signal on syntax name s1
+"throw"
+s1:
+c = condition("O"); a = c~additional
+call check "a JavaScript exception: SYNTAX 98.900 where the command was issued", c~code == "98.900"
+call check "  additional: the message, the TypeError, its stack", a~items == 3 & -
+  a[1] == "JavaScript error: TypeError: from the handler" & a[2]~isA(.JSObject) & a[2]~message == "from the handler"
+signal on syntax name s2
+"reject"
+s2:
+c = condition("O")
+call check "a rejected Promise: SYNTAX 98.900, the RangeError", c~code == "98.900" & c~additional[2]~message == "rejected"
+signal on syntax name s3
+"badname"
+s3:
+c = condition("O")
+call check "a Rexx condition the handler lets through: itself (93.900)", c~code == "93.900" & -
+  c~message~pos("not a Rexx variable name: 1abc") > 0
+
+"keep";                  call check "ctx.isValid() while the command runs", rc == "valid"
+call check "ctx after the command: not valid (a boolean)", F("", "return globalThis.keptCtx.isValid() === false")~call(.nil) == 1
+signal on syntax name s4
+F("", "return globalThis.keptCtx.getVar('X')")~call(.nil)
+s4:
+call check "ctx after the command: SYNTAX 98.900, as itself", condition("O")~code == "98.900" & -
+  condition("O")~additional[1]~pos("JavaScript error") == 0
+
+-- registering: the interpreter's .CommandHandler
+first = .CommandHandler~handler("calc")
+call check "a .JSCommandHandler is a .CommandHandler", first~isA(.CommandHandler) & first~isA(.JSCommandHandler)
+second = .JSCommandHandler~new(F("command,ctx", "return 'second'"))
+call check "registered again: stacked, the covered one returned", .CommandHandler~register("calc", second) == first
+address calc "anything"; call check "the new one answers", rc == "second"
+call check "handlers: both, the one in use first", .CommandHandler~handlers("CALC")~items == 2 & -
+  .CommandHandler~handlers("CALC")[1] == second
+call check "deregister: the one removed", .CommandHandler~deregister("CALC") == second
+"text";                  call check "the covered one answers again", rc == "abc"
+call check "deregister again: the first one", .CommandHandler~deregister("calc") == first
+call on failure name gotFailure
+raised = ""
+address calc "anything"; call check "none left: FAILURE, RC 30 (an unknown environment)", raised == "FAILURE 30"
+call off failure
+signal on syntax name s6
+.CommandHandler~deregister("calc")
+s6:
+call check "deregister with nothing registered: SYNTAX 93.900", condition("O")~code == "93.900"
+call check ".JSCommandHandler~new(.nil): SYNTAX 93.900", refused(.nil)~word(1) == "93.900"
+call check "a Rexx string: SYNTAX 93.900", refused("return 1")~word(1) == "93.900"
+call check "a JavaScript object that is not a function: SYNTAX 93.900", refused(.js~newObject)~word(1) == "93.900"
+signal on syntax name s5
+.CommandHandler~register("", .JSCommandHandler~new(calc))
+s5:
+call check "an empty name: SYNTAX 93.900", condition("O")~code == "93.900"
+call check "function: the JavaScript function", first~function == calc
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+gotError:   raised = condition("C") rc; return
+gotFailure: raised = condition("C") rc; return
+
+cmdSignalOn: procedure               -- SIGNAL ON c around ADDRESS RAISES c
+  use arg c                          -- (no INTERPRET "SIGNAL ON": it can set the trap in the caller)
+  select
+    when c == "NOTREADY" then signal on notready name cmdSignalled
+    when c == "ERROR" then signal on error name cmdSignalled
+    otherwise signal on failure name cmdSignalled
+  end
+  address raises c
+  return "not trapped, rc" rc
+cmdSignalled:
+  return condition("C") "|" condition("D") "|" condition("O")~rc
+
+cmdCallOn: procedure                 -- CALL ON c around ADDRESS RAISES c: then RC
+  use arg c
+  .local~cmdCalled = ""
+  select
+    when c == "NOTREADY" then call on notready name cmdCalledOn
+    when c == "ERROR" then call on error name cmdCalledOn
+    otherwise call on failure name cmdCalledOn
+  end
+  address raises c
+  nop
+  return .local~cmdCalled "|" rc
+cmdCalledOn:
+  .local~cmdCalled = "CALL ON" condition("C")
+  return
+
+userCallOn: procedure                -- CALL ON USER MINE around the command
+  .local~called = ""
+  call on user mine name userCalled
+  address calc "user"
+  nop
+  return .local~called "rc" rc
+userCalled: .local~called = condition("C") condition("D"); return
+
+userCommand: procedure              -- SIGNAL ON USER MINE around ADDRESS env command
+  use arg env, command
+  signal on user mine name userSignalled
+  address value env
+  command
+  .local~userTrapped = "no trap: rc" rc
+  return
+userSignalled:
+  c = condition("O")
+  if c~additional == .nil then extra = "-"; else extra = c~additional[2]
+  .local~userTrapped = c~condition "|" c~description "|" extra
+  .local~userRc = rc
+  return
+
+haltSignalOn: procedure
+  use arg cmd, env = "CALC"
+  signal on halt name hs; signal on syntax name hx
+  address value env
+  cmd
+  return "nothing"
+hs: return "HALT"
+hx: return "SYNTAX" condition("O")~code
+
+haltCallOn: procedure               -- CALL ON HALT runs after the next clause
+  use arg cmd
+  .local~halted = ""
+  call on halt name hc; signal on syntax name hy
+  address calc cmd
+  nop
+  return .local~halted "rc" rc
+hc: .local~halted = "HALT"; return
+
+haltErrorCallOn: procedure          -- both conditions, each by its CALL ON
+  .local~halted = ""
+  call on halt name hec; call on error name hee; signal on syntax name hez
+  address calc "errorhalt"
+  nop
+  return strip(.local~halted) "rc" rc
+hec: .local~halted = .local~halted "HALT"; return
+hee: .local~halted = .local~halted "ERROR"; return
+hez: return "SYNTAX" condition("O")~code
+hy: return "SYNTAX" condition("O")~code
+
+haltUntrapped: procedure
+  use arg cmd
+  signal on syntax name hz
+  address calc cmd
+  return "nothing"
+hz: return "SYNTAX" condition("O")~code
+
+F: procedure                        -- F(params, body): a JavaScript function
+  return .fn~call(.nil, arg(1), arg(2))
+
+refused: procedure                  -- "code message" of .JSCommandHandler~new(fn)
+  use arg fn
+  signal on syntax name refusedSyntax
+  h = .JSCommandHandler~new(fn)
+  return "no error"
+refusedSyntax:
+  c = condition("O")
+  return c~code c~message
+
+check: procedure
+  parse arg what, ok
+  if ok == 1 then do; .local~ok += 1; say "ok  " what; end
+  else do; .local~bad += 1; say "FAIL" what; end
+  return
+
+::requires "js.cls"
+
+::class Thing
+::method haltHere                   -- a HALT raised in the method itself
+  raise halt
+::method halts                      -- a HALT in a routine: it does not reach the issuer's traps
+  call haltsHere
+::method user
+  raise user mine description "the description" additional ("one", "two") return 7
+::method raises                     -- NOTREADY, ERROR (RC 5) or FAILURE (RC 6)
+  use arg c
+  if c == "NOTREADY" then raise notready description "the description" return 8
+  if c == "ERROR" then raise error 5 description "the description" return 9
+  raise failure 6 description "the description" return 10
+
+::class RaisingHandler subclass CommandHandler
+::method command
+  use arg command
+  if command == "raise" then raise user mine description "the description" additional ("one", "two") return 7
+  return .Thing~new~user
+
+::class HaltingHandler subclass CommandHandler
+::method command
+  call haltsHere
+  return 0
+
+::routine haltsHere
+  raise halt
diff --git a/wasm/tests/qualify-node-cli.sh b/wasm/tests/qualify-node-cli.sh
index 0bad7e6..2c02bb8 100755
--- a/wasm/tests/qualify-node-cli.sh
+++ b/wasm/tests/qualify-node-cli.sh
@@ -505,6 +505,11 @@ check "JavaScript objects: the RexxAPI while JavaScript waits for a handler" '^s
 check "a logic error ends the process with a non-zero status" '^Logic error: cannot locate startup image' '^status=[1-9]' -- \
   "mkdir noimg && cp '$NB/rexx.js' '$NB/rexx.wasm' noimg/ && cd noimg && PATH=/usr/bin:/bin '$(command -v node)' rexx.js -e 'say 1'; echo status=\$?"
 
+# --- command environments written in JavaScript (.JSCommandHandler in js.cls,
+# one of the interpreter's .CommandHandlers), portable test
+check "command handlers in JavaScript (.JSCommandHandler)" '^72 passed, 0 failed$' '!^FAIL ' -- \
+  "$X '$(cd "$(dirname "$0")" && pwd)/js-commands.rex'"
+
 # --- ADDRESS FETCH (wasm/web/fetch.cls over .CommandHandler and js.cls), portable test
 "$TIMEOUT" 120 python3 "$(cd "$(dirname "$0")" && pwd)/fetch-server.py" 50125 >/dev/null 2>&1 &
 FETCH_SRV=$!; sleep 0.5
diff --git a/wasm/tests/web-api.py b/wasm/tests/web-api.py
index af4da2f..6d87154 100755
--- a/wasm/tests/web-api.py
+++ b/wasm/tests/web-api.py
@@ -99,6 +99,28 @@ CASES = [
      lambda r: "[1,2]" in r["out"].replace(" ", "")),
   ("requires rxregexp", 'm = .RegularExpression~new("a+b"); say m~match("aaab")\n::requires "rxregexp.cls"',
