diff --git a/common/platform/unix/SysProcess.cpp b/common/platform/unix/SysProcess.cpp
index ab57a5b..c9773d8 100644
--- a/common/platform/unix/SysProcess.cpp
+++ b/common/platform/unix/SysProcess.cpp
@@ -254,6 +254,47 @@ int SysProcess::localErrno(int e)
     return e;
 }
 
+#if defined(__EMSCRIPTEN__)
+
+/**
+ * WASM: the directory of the loaded rexx.js under Node (with a trailing
+ * slash) into buf; returns 0 if there is none (browser) or it does not fit.
+ * /proc/self/exe would name the node binary, and there is no dladdr().  The
+ * Node command-line build puts its `rexx` launcher and rexx.img there.
+ */
+EM_JS(int, wasmScriptDirectory, (char *buf, int size), {
+    if (typeof process !== 'object' || !process.versions || !process.versions.node ||
+        typeof scriptDirectory !== 'string' || scriptDirectory.length === 0 ||
+        scriptDirectory.charAt(0) !== '/')
+    {
+        return 0;
+    }
+    if (lengthBytesUTF8(scriptDirectory) >= size) return 0;
+    stringToUTF8(scriptDirectory, buf, size);
+    return 1;
+});
+
+/**
+ * The host functions for .RexxInfo~executable and ~libraryPath
+ * (SysWasmHost.hpp): under Node, the `rexx` launcher next to rexx.js and the
+ * directory of rexx.js, if this file system can see them (NODERAWFS).
+ */
+extern "C" int orxWasmExecutablePath(char *buf, int size)
+{
+    if (size < 5 || !wasmScriptDirectory(buf, size - 5))
+    {
+        return 0;
+    }
+    strcat(buf, "rexx");
+    return 1;
+}
+
+extern "C" int orxWasmLibraryDirectory(char *buf, int size)
+{
+    return wasmScriptDirectory(buf, size);
+}
+#endif
+
 
