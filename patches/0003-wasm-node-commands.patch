+# Relink the WASM runtime (no recompilation of the interpreter) as a
+# Node-only command-line ooRexx: the host file system (NODERAWFS), the host
+# environment variables and external commands as host processes.
+#
+# Usage: wasm/build-node.sh [BUILD_DIR=build-wasm] [OUTDIR=BUILD_DIR/bin-node]
+#   (BUILD_DIR: a build made by wasm/build-wasm.sh; EM_CONFIG from it)
+#   EXTRA_LDFLAGS="--profiling-funcs" wasm/build-node.sh ...  (wasm function names)
+# Output: OUTDIR/{rexx.js,rexx.wasm,rexx.img,*.cls} and the launchers
+#   rexx, rexxc (shell scripts running node rexx.js)
+set -euo pipefail
+SRC=$(cd "$(dirname "$0")/.." && pwd)
+BUILD=$(cd "${1:-$SRC/build-wasm}" && pwd)
+OUT=${2:-$BUILD/bin-node}; mkdir -p "$OUT"; OUT=$(cd "$OUT" && pwd)
+export EM_CONFIG="$BUILD/.emscripten"
+
+cmd=$(cat "$BUILD/CMakeFiles/rexx_exe.dir/link.txt")
+cmd=$(sed -E 's/--preload-file [^ ]+//g; s/-sENVIRONMENT=[^ ]+//; s/-sFORCE_FILESYSTEM=1//' <<<"$cmd")
+cmd=${cmd//-o bin\/rexx.js/-o $OUT\/rexx.js}
+(cd "$BUILD" && eval "$cmd" -sNODERAWFS=1 -sENVIRONMENT=node \
+   --pre-js "$SRC/wasm/node-pre.js" ${EXTRA_LDFLAGS:-})
+cp "$BUILD/bin/rexx.img" "$OUT/"
+# rexxtry, as native installs have it next to rexx (rexx rexxtry)
+cp "$SRC/samples/rexxtry.rex" "$OUT/"
+# the portable extension classes (::REQUIRES finds them next to rexx.img via
+# PATH), as wasm/build-web.sh: not the Windows ones (ooDialog, OLE, winsystm),
+# not ncurses (no native library here)
+for cls in rxsock/socket.cls rxsock/streamsocket.cls rxsock/mime.cls rxsock/smtp.cls \
+           rxftp/rxftp.cls rxregexp/rxregexp.cls json/json.cls yaml/yaml.cls \
+           logicalwrapper/logicalwrapper.cls \
+           csvStream/csvStream.cls dateparser/dateparser.cls; do
+  cp "$SRC/extensions/$cls" "$OUT/"
+done
+
+launcher() {   # launcher NAME [rexx.js option]
+  cat > "$OUT/$1" <<SH
+#!/usr/bin/env bash
+# ooRexx/WASM $1 (Node, host file system); rexx.img and the classes via PATH
+DIR=\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)
+PATH="\$DIR:\$PATH" exec node "\$DIR/rexx.js" ${2:+$2 }"\$@"
+SH
+  chmod +x "$OUT/$1"
+}
+launcher rexx
+# multi-call tools of the same rexx.js/rexx.wasm (see wasm/rexxc-main.cpp)
+for tool in rexxc; do
+  launcher $tool --orx-wasm-$tool
+done
+ls -l "$OUT" | awk 'NR>1 && $9 !~ /\.cls$/ {print $5, $9}'
