+// interpreter's clock has sub-millisecond resolution (TimeSupport.cpp): a file
+// written now would look older than the time it was written at, and
+// fractional times set on a file would be cut.  The same wall clock with the
+// resolution of performance.now() keeps them in step, as native file systems
+// do.  Top level, for the runtime's worker (MEMFS lives there) and pthreads.
+try {
+  if (typeof performance !== 'undefined' && performance.timeOrigin)
+    Date.now = function() { return performance.timeOrigin + performance.now(); };
+} catch (e) {}
+
+Module['preRun'] = (Module['preRun'] || []).concat([function() {
+  // ---- output -------------------------------------------------------------
+  var KINDS = ['plain', 'trace', 'error'];
+  function kindNow() {                      // what the interpreter is writing (web-stdin.cpp)
+    return KINDS[Atomics.load(HEAP32, (ring + 24) >> 2)] || 'plain';
+  }
+  function batcher(sink) {
+    var buf = [], scheduled = false, kind = 'plain';
+    function flush() {
+      scheduled = false;
+      if (buf.length === 0) return;
+      var bytes = new Uint8Array(buf);
+      buf = [];
+      if (Module[sink]) Module[sink](bytes, kind);
+    }
+    return {
+      put: function(b) {
+        var k = kindNow();
+        if (k !== kind) { flush(); kind = k; }
+        buf.push(b & 255);
+        if (buf.length >= 65536) flush();
+        else if (!scheduled) { scheduled = true; setTimeout(flush, 0); }
+      },
+      flush: flush
+    };
+  }
+  var out = batcher('orxOut'), err = batcher('orxErr');
+  Module['orxFlush'] = function() { out.flush(); err.flush(); };
+  TTY.default_tty_ops.put_char = function(tty, val) { if (val !== null) out.put(val); };
+  TTY.default_tty_ops.fsync = function(tty) { out.flush(); };
+  TTY.default_tty1_ops.put_char = function(tty, val) { if (val !== null) err.put(val); };
+  TTY.default_tty1_ops.fsync = function(tty) { err.flush(); };
+
+  // ---- standard input ring (layout: wasm/web-stdin.cpp) --------------------
+  var ring = _orx_wasm_stdin_ring(), size = _orx_wasm_stdin_ring_size();
+  var SEQ = ring >> 2, EOF = (ring + 4) >> 2, WAITING = (ring + 8) >> 2,
+      HEAD = (ring + 12) >> 2, TAIL = (ring + 16) >> 2, ACTIVE = (ring + 20) >> 2,
+      DATA = ring + 32;
+  var pending = [], closed = false;        // bytes the ring could not take yet
+
+  function pump() {
+    var head = Atomics.load(HEAPU32, HEAD), tail = Atomics.load(HEAPU32, TAIL);
+    var room = size - ((head - tail) >>> 0), moved = 0;
+    while (pending.length && room > 0) {
+      var chunk = pending[0], n = Math.min(chunk.length, room);
+      for (var i = 0; i < n; i++) HEAPU8[DATA + ((head + i) >>> 0) % size] = chunk[i];
+      head = (head + n) >>> 0;
+      room -= n; moved += n;
+      if (n === chunk.length) pending.shift(); else pending[0] = chunk.subarray(n);
+    }
+    if (moved) Atomics.store(HEAPU32, HEAD, head);
+    if (closed && pending.length === 0) Atomics.store(HEAP32, EOF, 1);
+    if (moved || closed) { Atomics.add(HEAP32, SEQ, 1); Atomics.notify(HEAP32, SEQ); }
