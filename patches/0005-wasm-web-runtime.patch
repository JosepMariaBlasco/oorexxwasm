+"""Assertions over the browser API of the web build (wasm/build-web.sh).
+
+Usage: python3 wasm/tests/web-api.py BIN_WEB
+  BIN_WEB: the output directory of wasm/build-web.sh
+Serves BIN_WEB (plus wasm/tests/web-api.html, copied into it) with COOP/COEP
+on 127.0.0.1:8001 and runs the cases in headless Chromium.  Needs Python
+Playwright with Chromium.  Exit status 1 on any failure.
+"""
+import json, os, shutil, subprocess, sys, time
+from playwright.sync_api import sync_playwright
+
+if len(sys.argv) != 2:
+    sys.exit("usage: web-api.py BIN_WEB")
+BIN = sys.argv[1]
+SRC = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+shutil.copy(f"{SRC}/wasm/tests/web-api.html", BIN)
+srv = subprocess.Popen([sys.executable, "-c", f"""
+import os, sys
+from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler
+os.chdir({BIN!r})
+class H(SimpleHTTPRequestHandler):
+    def end_headers(self):
+        self.send_header('Cross-Origin-Opener-Policy','same-origin')
+        self.send_header('Cross-Origin-Embedder-Policy','require-corp')
+        self.send_header('Cache-Control','no-store')
+        super().end_headers()
+    def log_message(self, *a): pass
+ThreadingHTTPServer(('127.0.0.1',8001),H).serve_forever()
+"""])
+import atexit; atexit.register(srv.terminate)
+time.sleep(0.7)
+
+CASES = [
+  ("say", 'say "hello"', {}, lambda r: r["out"] == "hello\n" and r["rc"] == 0),
+  ("rc", 'exit 3', {}, lambda r: r["rc"] == 3),
+  ("utf8", 'say "añø€"', {}, lambda r: r["out"] == "añø€\n"),
+  ("stderr", 'call lineout "STDERR", "oops"', {}, lambda r: r["err"] == "oops\n"),
+  ("syntax error", 'say 1 +', {}, lambda r: "Error 35" in r["err"] and r["rc"] != 0),
+  ("fixed stdin", 'do while lines() > 0; parse pull l; say "<"l">"; end',
+     {"stdin": "a\nb\nc\n"}, lambda r: r["out"] == "<a>\n<b>\n<c>\n"),
+  ("interactive pull", 'call charout , "Name? "; parse pull n; say "Hi" n"!"; pull x; say "x=" x',
+     {"inputs": ["Ana", "two"]}, lambda r: r["out"] == "Name? Hi Ana!\nx= TWO\n" and r["asks"] == 2),
+  ("eof", 'l = linein(); say "eof=" lines() "["l"]"; say "done"', {"inputs": []},
+     lambda r: r["out"].endswith("done\n") and r["asks"] >= 1),
+  # transient stream: CHARS() is 1 while data is waiting (as native ooRexx)
+  ("chars()", 'say chars(); parse pull .; say chars()', {"stdin": "abc\n"}, lambda r: r["out"] == "1\n0\n"),
+  ("stop loop", 'do forever; nop; end', {"stopAfterMs": 1500},
+     lambda r: r["stopped"] and r["rc"] is None),
+  ("start threads", 'do i = 1 to 3; o = .x~new; o~start("go", i); end; call syssleep 0.5\n'
+                    '::class x; ::method go; use arg i; say "t" i',
+     {}, lambda r: sorted(r["out"].split("\n")[:3]) == ["t 1", "t 2", "t 3"]),
+  ("files out", 'call lineout "out.txt", "data"; call lineout "out.txt"', {},
+     lambda r: r["files"].get("/home/rexx/out.txt") == "data\n"),
+  ("files in", 'say linein("in.txt")', {"files": {"/home/rexx/in.txt": "from page\n"}},
+     lambda r: r["out"] == "from page\n"),
+  ("requires json", 'j = .json~new; say j~toJSON(.array~of(1,2))\n::requires "json.cls"', {},
+     lambda r: "[1,2]" in r["out"].replace(" ", "")),
+  ("requires rxregexp", 'm = .RegularExpression~new("a+b"); say m~match("aaab")\n::requires "rxregexp.cls"',
+     {}, lambda r: r["out"] == "1\n"),
+  ("rexxtry", 'call "/home/rexx/rexxtry.rex"',
+     {"files": {"/home/rexx/rexxtry.rex": open(f"{SRC}/samples/rexxtry.rex").read()},
+      "inputs": ["say 6*7", "x = 'abc'; say reverse(x)", "exit"]},
+     lambda r: "42\n" in r["out"] and "cba\n" in r["out"] and r["asks"] == 3),
+  ("args", 'parse arg a; say "["a"]"', {"args": ["x", "y"]}, lambda r: r["out"] == "[x y]\n"),
+  ("trace ?", 'trace ?r; a = 1; b = 2; say a + b', {"inputs": ["", "", "", ""]},
+     lambda r: r["out"].endswith("3\n") and r["asks"] >= 2),
+  # what the interpreter writes is marked: trace lines, error messages
+  ("trace marked", 'call lineout "STDERR", "plain"; trace r; a = 1 + 2; trace off', {},
+     lambda r: "*-* a = 1 + 2" in r["trace"] and ">>>" in r["trace"] and "plain" not in r["trace"]
+               and "plain\n" in r["err"] and r["errmsg"] == ""),
+  ("error marked", 'x = 1\ncall nosuchroutine', {},
+     lambda r: "Error 43 running" in r["errmsg"] and "Error 43.1:" in r["errmsg"]
+               and "*-* call nosuchroutine" in r["trace"] and "Error" not in r["trace"]),
+  ("trace to stdout", '.traceOutput~destination(.output); trace r; a = 1', {},
+     lambda r: "*-* a = 1" in r["out"] and "*-* a = 1" in r["trace"] and r["err"] == ""),
+  # interactive trace reads .debugInput, PULL reads .input: each request says which
+  ("debug input", 'trace ?r; a = 1; pull x; say "x=[" || x || "]"', {"inputs": [""] * 8},
+     lambda r: "x=[]" in r["out"] and True in r["debug"] and False in r["debug"]),
+  # the marks are per thread: several threads tracing and writing at once
+  ("marks per thread", '.traceObject~option = "s"; c = .c~new\n'
+                       'do i = 1 to 4; .w~new~start("run", i, c); end; c~wait(4); say "total" c~n\n'
+                       '::class w; ::method run; use arg n, c\n'
+                       '  do step = 1 to 3; call SysSleep 0.01 * n; say "  worker" n "step" step; end; c~add\n'
+                       '::class c; ::attribute n get; ::method init; expose n; n = 0\n'
+                       '::method add; expose n; n += 1\n'
+                       '::method wait; expose n; use arg k; guard on when n >= k\n'
+                       '::options trace r', {},
+     lambda r: r["out"].count("  worker") == 12 and "total 4\n" in r["out"] and "*-*" in r["err"]
+               and r["err"] == r["trace"] and r["errmsg"] == ""),
+]
+
+fails = 0; ran = 0
+with sync_playwright() as p:
+    b = p.chromium.launch(args=["--no-sandbox"])
+    pg = b.new_page()
+    pg.goto("http://127.0.0.1:8001/web-api.html")
+    ready = pg.evaluate("window.rexxReady")
+    if ready is not True:
+        print("FAIL load:", ready); sys.exit(1)
+    only = os.environ.get("ONLY")
+    for name, src, opts, check in CASES:
+        if only and only not in name: continue
+        try:
+            r = pg.evaluate("([s, o]) => window.rexxRun(s, o)", [src, opts])
+        except Exception as e:
+            r = {"exception": str(e)}
+        try: ok = check(r)
+        except Exception: ok = False
+        fails += not ok; ran += 1
+        print(("ok  " if ok else "FAIL"), f"{name:20}", json.dumps(r, ensure_ascii=False)[:300] if not ok or os.environ.get("SHOW") else f"{r.get('ms')} ms")
+    b.close()
+srv.terminate()
+print(f"== {ran - fails} passed, {fails} failed")
+sys.exit(1 if fails else 0)
