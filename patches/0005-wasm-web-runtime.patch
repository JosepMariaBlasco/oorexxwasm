+      }
+    })(dir.replace(/\/$/, ''));
+    return found;
+  };
+
+  if (Module['orxReady']) Module['orxReady']();
+}]);
diff --git a/wasm/web-stdin.cpp b/wasm/web-stdin.cpp
new file mode 100644
index 0000000..0167faa
--- /dev/null
+++ b/wasm/web-stdin.cpp
@@ -0,0 +1,157 @@
+/*----------------------------------------------------------------------------*/
+/*                                                                            */
+/* Copyright (c) 2026 Rexx Language Association. All rights reserved.         */
+/*                                                                            */
+/* This program and the accompanying materials are made available under       */
+/* the terms of the Common Public License v1.0 which accompanies this         */
+/* distribution. A copy is also available at the following address:          */
+/* https://www.oorexx.org/license.html                                        */
+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+/*
+ * Interactive standard input for the browser build (wasm/build-web.sh).
+ *
+ * In the browser the interpreter runs on a pthread (PROXY_TO_PTHREAD) and the
+ * Emscripten file system lives on the main runtime thread, where blocking is
+ * not allowed: a read() of the TTY there cannot wait for the user.  So the
+ * web link wraps read() (-Wl,--wrap=read) and serves fd 0 here, on the
+ * calling thread: bytes come from a small ring in the shared linear memory,
+ * filled by the main runtime thread (wasm/web-pre.js) when the page supplies
+ * input, and the reader waits on a futex.  When the ring is empty the reader
+ * tells the main runtime thread that input is wanted, which forwards the
+ * request to the page.  Every other descriptor goes to the real read().
+ *
+ * The page side is single producer (the main runtime thread), the consumer
+ * side is serialized by a mutex (two Rexx threads may read STDIN).
+ */
+
+#include <emscripten.h>
+#include <emscripten/threading.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <string.h>
+#include <unistd.h>
+
+#define ORX_STDIN_RING_SIZE 65536
+
+extern "C"
+{
+
+// Shared with wasm/web-pre.js: keep the layout in sync (offsets in bytes).
+typedef struct
+{
+    volatile int32_t  seq;      //  0: bumped by the producer on every change
+    volatile int32_t  eof;      //  4: producer: no more input after the ring
+    volatile int32_t  waiting;  //  8: consumer: blocked for input
+    volatile uint32_t head;     // 12: producer write position (mod size)
+    volatile uint32_t tail;     // 16: consumer read position (mod size)
+    volatile int32_t  active;   // 20: producer: the page serves stdin
+    volatile int32_t  kind;     // 24: during a write to fd 1/2, the writer's mark (0 plain, 1 trace, 2 error)
+    volatile int32_t  debug;    // 28: the reader's mark: the read in progress is .debugInput's
+    char data[ORX_STDIN_RING_SIZE];  // 32
+} OrxStdinRing;
+
+static OrxStdinRing orxStdinRing;
+static pthread_mutex_t orxStdinLock = PTHREAD_MUTEX_INITIALIZER;
+
+EMSCRIPTEN_KEEPALIVE void *orx_wasm_stdin_ring(void)
+{
+    return &orxStdinRing;
+}
+
+EMSCRIPTEN_KEEPALIVE int orx_wasm_stdin_ring_size(void)
+{
+    return ORX_STDIN_RING_SIZE;
+}
+
+// The interpreter's hook (weak in interpreter/concurrency/Activity.cpp): marks
+// what the calling thread is doing (which 0: writing 1 trace, 2 an error
+// message, 0 other output; which 1: the read in progress is .debugInput's).
+// The marks are the thread's own (several Rexx threads write at once); each
+// write to standard output or error, and each read of standard input,
+// publishes the writer's or reader's mark in the ring for the page, which
+// reads it while the bytes are written or the input is requested.  A value
+// < 0 only queries.  Returns the previous value.
+static __thread int32_t threadKind = 0, threadDebug = 0;
+
+int orx_wasm_mark(int which, int value)
+{
+    int32_t *slot = which == 0 ? &threadKind : &threadDebug;
+    int32_t previous = *slot;
+    if (value >= 0)
+    {
+        *slot = value;
+    }
+    return previous;
+}
+
+// Writes to standard output and error, one at a time, each with its thread's
+// mark in the ring (the write is proxied, synchronously, to the main runtime
+// thread, where web-pre.js reads the mark as the bytes arrive).
+static pthread_mutex_t orxOutLock = PTHREAD_MUTEX_INITIALIZER;
+ssize_t __real_write(int fd, const void *buf, size_t count);
+
+ssize_t __wrap_write(int fd, const void *buf, size_t count)
+{
+    if (fd != 1 && fd != 2)
+    {
+        return __real_write(fd, buf, count);
+    }
+    pthread_mutex_lock(&orxOutLock);
+    __atomic_store_n(&orxStdinRing.kind, threadKind, __ATOMIC_SEQ_CST);
+    ssize_t written = __real_write(fd, buf, count);
+    __atomic_store_n(&orxStdinRing.kind, 0, __ATOMIC_SEQ_CST);
+    pthread_mutex_unlock(&orxOutLock);
+    return written;
+}
+
+ssize_t __real_read(int fd, void *buf, size_t count);
+
+ssize_t __wrap_read(int fd, void *buf, size_t count)
+{
+    if (fd != 0 || !__atomic_load_n(&orxStdinRing.active, __ATOMIC_SEQ_CST))
+    {
+        return __real_read(fd, buf, count);
+    }
+    if (count == 0)
+    {
+        return 0;
+    }
+
+    pthread_mutex_lock(&orxStdinLock);
+    __atomic_store_n(&orxStdinRing.debug, threadDebug, __ATOMIC_SEQ_CST);   // for the page's request
+    ssize_t got = 0;
+    for (;;)
+    {
+        int32_t seq = __atomic_load_n(&orxStdinRing.seq, __ATOMIC_SEQ_CST);
+        uint32_t head = __atomic_load_n(&orxStdinRing.head, __ATOMIC_SEQ_CST);
+        uint32_t tail = orxStdinRing.tail;
+        if (head != tail)
+        {
+            // like a terminal in canonical mode: return what is there
+            while (tail != head && (size_t)got < count)
+            {
+                ((char *)buf)[got++] = orxStdinRing.data[tail % ORX_STDIN_RING_SIZE];
+                tail++;
+            }
+            __atomic_store_n(&orxStdinRing.tail, tail, __ATOMIC_SEQ_CST);
+            break;
+        }
+        if (__atomic_load_n(&orxStdinRing.eof, __ATOMIC_SEQ_CST))
+        {
+            break;          // end of file: got == 0
+        }
+        // empty: ask the page for input (asynchronously: the main runtime
+        // thread may be busy serving our own proxied calls) and wait
+        if (!__atomic_exchange_n(&orxStdinRing.waiting, 1, __ATOMIC_SEQ_CST))
+        {
+            MAIN_THREAD_ASYNC_EM_ASM({ if (Module['orxStdinWanted']) Module['orxStdinWanted'](); });
+        }
+        emscripten_futex_wait((void *)&orxStdinRing.seq, seq, 1000.0);
+    }
+    __atomic_store_n(&orxStdinRing.waiting, 0, __ATOMIC_SEQ_CST);
+    pthread_mutex_unlock(&orxStdinLock);
+    return got;
+}
+
+}
