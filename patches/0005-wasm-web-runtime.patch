+ * page -> worker: {type:'run', scriptUrl, wasmModule, data, args, files, cwd,
+ *                  env, stdin}   (stdin: null = interactive, else Uint8Array
+ *                  followed by end of file)
+ *                 {type:'stdin', bytes}   {type:'eof'}
