+# Relink the WASM runtime for the browser (no recompilation of the
+# interpreter): a modular build (createOoRexx factory) meant to run inside a
+# Web Worker (web/ooRexx-worker.js), with interactive standard input
+# (web-stdin.cpp + web-pre.js) and every portable extension class preloaded
+# into /usr/lib/ooRexx (REXX_PATH).  The page API is web/ooRexx.js.
+#
+# Usage: wasm/build-web.sh [BUILD_DIR=build-wasm] [OUTDIR=BUILD_DIR/bin-web]
+#   (BUILD_DIR: a build made by wasm/build-wasm.sh; EM_CONFIG from it)
+# Output: OUTDIR/{rexx.js,rexx.wasm,rexx.data,ooRexx.js,ooRexx-worker.js}
+set -euo pipefail
+SRC=$(cd "$(dirname "$0")/.." && pwd)
+BUILD=$(cd "${1:-$SRC/build-wasm}" && pwd)
+OUT=${2:-$BUILD/bin-web}; mkdir -p "$OUT"; OUT=$(cd "$OUT" && pwd)
+export EM_CONFIG="$BUILD/.emscripten"
+EMXX=$(sed -E 's/ .*//' "$BUILD/CMakeFiles/rexx_exe.dir/link.txt")
+
+# the interactive stdin (read() of fd 0 served from a ring in shared memory)
+"$EMXX" -O3 -pthread -c "$SRC/wasm/web-stdin.cpp" -o "$BUILD/web-stdin.o"
+
+# the portable extension classes (not ncurses: no native library here)
+PRELOAD=()
+for cls in rxsock/socket.cls rxsock/streamsocket.cls rxsock/mime.cls rxsock/smtp.cls \
+           rxftp/rxftp.cls rxregexp/rxregexp.cls json/json.cls yaml/yaml.cls \
+           csvStream/csvStream.cls dateparser/dateparser.cls; do
+  PRELOAD+=("--preload-file" "$SRC/extensions/$cls@/usr/lib/ooRexx/$(basename "$cls")")
+done
+
+# Emscripten's default list plus mainScriptUrlOrBlob: the pthreads must load
+# rexx.js, not the worker script that hosts the runtime
+INCOMING="[ENVIRONMENT,arguments,canvas,dynamicLibraries,elementPointerLock,instantiateWasm,\
+locateFile,monitorRunDependencies,noExitRuntime,noInitialRun,onAbort,onExit,onRuntimeInitialized,\
+postRun,preInit,preRun,print,printErr,setStatus,statusMessage,stderr,stdin,stdout,thisProgram,\
+wasm,websocket,mainScriptUrlOrBlob]"
+
+cmd=$(cat "$BUILD/CMakeFiles/rexx_exe.dir/link.txt")
+cmd=$(sed -E 's/--preload-file [^ ]+//g; s/-sENVIRONMENT=[^ ]+//' <<<"$cmd")
+cmd=${cmd//-o bin\/rexx.js/-o $OUT\/rexx.js}
+(cd "$BUILD" && eval "$cmd" "$BUILD/web-stdin.o" \
+   -Wl,--wrap=read,--wrap=write \
+   -sENVIRONMENT=web,worker -sMODULARIZE=1 -sEXPORT_NAME=createOoRexx \
+   "-sINCOMING_MODULE_JS_API=$INCOMING" \
+   --pre-js "$SRC/wasm/web-pre.js" \
+   --preload-file "$BUILD/bin/rexx.img@/rexx.img" \
+   "${PRELOAD[@]}" ${EXTRA_LDFLAGS:-})
+cp "$SRC/wasm/web/ooRexx.js" "$SRC/wasm/web/ooRexx-worker.js" "$OUT/"
+ls -l "$OUT" | awk 'NR>1{print $5, $9}'
