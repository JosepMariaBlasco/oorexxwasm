+// The WebAssembly browser build (wasm/web-stdin.cpp) defines this hook to tell
+// the page what goes to it: trace lines, error messages, reads of .debugInput.
+// Weak: the other builds do not have it.
+extern "C" int orx_wasm_mark(int which, int value) __attribute__((weak));
+
+/**
+ * While alive, marks what the interpreter is doing for the browser build:
+ * which = 0, the kind of output (1 trace, 2 error message; an error message
+ * keeps its kind through the trace output that writes it); which = 1, a read
+ * of interactive debug input.
+ */
+class WasmMark
+{
+  public:
+    WasmMark(int which, int value)
+    {
+        if (orx_wasm_mark != nullptr)
+        {
+            slot = which;
+            previous = orx_wasm_mark(which, -1);
+            if (!(which == 0 && value == 1 && previous == 2))
+            {
+                orx_wasm_mark(which, value);
+            }
+        }
+    }
+    ~WasmMark()
+    {
+        if (slot >= 0)
+        {
+            orx_wasm_mark(slot, previous);
+        }
+    }
+  private:
+    int slot = -1;
+    int previous = 0;
+};
+#else
+class WasmMark
+{
+  public:
+    WasmMark(int, int) { }
+};
+#endif
