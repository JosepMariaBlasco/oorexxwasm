+  importScripts(msg.scriptUrl);
+  const base = msg.scriptUrl.slice(0, msg.scriptUrl.lastIndexOf('/') + 1);
+  const textBytes = (s) => new TextEncoder().encode(s + '\n');
+  const cfg = {
+    arguments: msg.args || [],
+    orxFiles: msg.files || {},
+    orxCwd: cwd,
+    orxEnv: msg.env || {},
+    mainScriptUrlOrBlob: msg.scriptUrl,
+    locateFile: (p) => base + p,
+    instantiateWasm(imports, receive) {
+      WebAssembly.instantiate(msg.wasmModule, imports).then((inst) => receive(inst, msg.wasmModule),
