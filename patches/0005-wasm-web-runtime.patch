+      return {};
+    },
+    getPreloadedPackage: () => msg.data,
+    orxOut: (b, kind) => post({ type: 'out', bytes: b, kind }, [b.buffer]),
+    orxErr: (b, kind) => post({ type: 'err', bytes: b, kind }, [b.buffer]),
+    orxStdinWanted: (debug) => post({ type: 'input', debug: !!debug }),
+    print: (s) => post({ type: 'err', bytes: textBytes(s) }),
+    printErr: (s) => post({ type: 'err', bytes: textBytes(s) }),
+    orxReady: () => {
+      // called by wasm/web-pre.js once the stdin ring is ready
+      const q = queued; queued = [];
+      if (msg.stdin) { M.orxStdinWrite(msg.stdin); M.orxStdinClose(); }
+      for (const m of q) feed(m);
+    },
+    onExit: (rc) => finish(rc),
+    onAbort: (what) => post({ type: 'error', message: 'abort: ' + what }),
+  };
+  M = cfg;
+  createOoRexx(cfg).catch((e) => {
+    if (e && e.name === 'ExitStatus') return;
+    post({ type: 'error', message: String(e && e.stack || e) });
+  });
+};
