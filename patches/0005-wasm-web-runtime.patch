+/*
+ * ooRexx/WASM in the browser: the page-side API.
+ *
+ *   <script src="ooRexx.js"></script>
+ *   const rexx = await OoRexx.load();            // fetch + compile once
+ *   const run = rexx.run({
+ *     args: ['prog.rex'], files: {'/home/rexx/prog.rex': source},
+ *     onOut: (text) => ..., onErr: (text) => ..., onInput: () => ...,
+ *   });
+ *   run.write('a line\n'); run.close();           // interactive stdin
+ *   run.stop();                                    // terminate the run
+ *   const {rc, files, stopped, ms} = await run.done;
+ *
+ * Each run gets a fresh interpreter in its own Web Worker (ooRexx-worker.js),
+ * so runs are isolated and stop() always works, even in an endless loop.
+ * The wasm module is compiled once and the preloaded file package (rexx.img
+ * and the extension classes) fetched once, then handed to every run.
+ *
+ * Needs a cross-origin isolated page (COOP: same-origin, COEP: require-corp)
+ * for SharedArrayBuffer: the interpreter uses threads.
+ *
+ * run() options:
+ *   args   program arguments, as on the command line (default [])
+ *   files  {path: string | Uint8Array} written before the run (strings as UTF-8)
+ *   cwd    working directory (default '/home/rexx'); the files under it are
+ *          returned in done.files
+ *   env    environment variables
+ *   stdin  undefined: interactive (write/close, onInput when the program
+ *          waits); a string or Uint8Array: the whole standard input
+ *   onOut, onErr   (text, kind) => void, decoded as UTF-8 as it arrives;
+ *                  kind is what the interpreter was writing: 'trace' (trace
+ *                  lines, and the traceback of an error), 'error' (an error
+ *                  message) or 'plain' (anything else).  Trace and error
+ *                  messages go where .traceOutput sends them: .error, so
+ *                  onErr, unless the program redirects it.
+ *   onInput        ({debug}) => void, the program is waiting for standard
+ *                  input; debug is true when it is interactive trace reading
+ *                  (.debugInput) rather than the program
