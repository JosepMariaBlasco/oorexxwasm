+      var names;
+      try { names = FS.readdir(d); } catch (e) { return; }
+      for (var i = 0; i < names.length; i++) {
+        if (names[i] === '.' || names[i] === '..') continue;
+        var p = d + '/' + names[i], st = FS.stat(p);
+        if (FS.isDir(st.mode)) walk(p);
