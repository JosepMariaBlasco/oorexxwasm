+      p += '/' + parts[i];
+      try { FS.mkdir(p); } catch (e) { /* exists */ }
+    }
+  }
+  var files = Module['orxFiles'] || {};
+  for (var path in files) {
+    mkdirs(path.slice(0, path.lastIndexOf('/')));
+    FS.writeFile(path, files[path]);
+  }
+  if (Module['orxCwd']) { mkdirs(Module['orxCwd']); FS.chdir(Module['orxCwd']); }
