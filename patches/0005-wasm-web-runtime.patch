+    if (closed || !bytes.length) return;
+    pending.push(bytes);
+    pump();
+  };
+  Module['orxStdinClose'] = function() { closed = true; pump(); };
+  Module['orxStdinAvailable'] = function() {
+    var n = (Atomics.load(HEAPU32, HEAD) - Atomics.load(HEAPU32, TAIL)) >>> 0;
+    for (var i = 0; i < pending.length; i++) n += pending[i].length;
+    return n;
+  };
+  var wanted = Module['orxStdinWanted'];
+  Module['orxStdinWanted'] = function() {
+    pump();                                 // the ring may have room again
+    if (Atomics.load(HEAP32, WAITING) && Atomics.load(HEAPU32, HEAD) === Atomics.load(HEAPU32, TAIL) &&
