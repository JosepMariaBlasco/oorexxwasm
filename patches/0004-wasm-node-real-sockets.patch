diff --git a/wasm/emscripten-dns-proxy.js b/wasm/emscripten-dns-proxy.js
index fe09488..6d38c01 100644
--- a/wasm/emscripten-dns-proxy.js
+++ b/wasm/emscripten-dns-proxy.js
@@ -54,4 +54,55 @@ addToLibrary({
     var nameString = UTF8ToString(name);
     return inetPton4(DNS.lookup_name(nameString));
   },
+
+  /*
+   * Real name resolution for the Node build with real sockets
+   * (-sNODERAWSOCKETS, see wasm/node-sockets-pre.js): Emscripten's fake DNS
+   * would hand out 172.29.x.y addresses that node:net cannot use, never fails
+   * and knows no reverse names.  Used by rxsock instead of gethostbyname,
+   * gethostbyaddr and gethostname (wasmGetHostByName etc. in rxsockfn.cpp).
+   *   mode 0: arg = host name   -> "name\naddr\naddr..." (IPv4, dns.lookup:
+   *                                /etc/hosts + resolver, like getaddrinfo)
+   *   mode 1: arg = IPv4 string -> "name\naddr"  (dns.lookupService: getnameinfo)
+   *   mode 2: (no arg)          -> "hostname"    (os.hostname)
+   *   mode 3: (no arg)          -> "addr"        first non-loopback IPv4
+   *                                interface address (SockGetHostId)
+   * Returns the length written to out (NUL-terminated, truncated to outLen),
+   * -1 if the name/address is unknown, -2 if not available here (browser,
+   * WebSocket sockets): the caller then uses the libc function.
+   * Proxied to the main thread and asynchronous there (__async): the calling
+   * pthread blocks until the promise settles, the main event loop keeps
+   * running.  Only called from pthreads (the interpreter runs on one).
+   */
+  orxNodeResolve__deps: ['$UTF8ToString', '$stringToUTF8'],
+  orxNodeResolve__proxy: 'sync',
+  orxNodeResolve__async: true,
+  orxNodeResolve: (mode, arg, out, outLen) => {
+    if (!ENVIRONMENT_IS_NODE || typeof nodeSockOps == 'undefined') return Promise.resolve(-2);
+    var req = process.getBuiltinModule || require;
+    var dns = req('dns');
+    var put = (text) => { stringToUTF8(text, out, outLen); return Math.min(text.length, outLen - 1); };
+    if (mode == 2) return Promise.resolve(put(req('os').hostname()));
+    if (mode == 3) {
+      var ifs = req('os').networkInterfaces();
+      for (var n in ifs) for (var i of ifs[n]) {
+        if (i.family == 'IPv4' && !i.internal) return Promise.resolve(put(i.address));
+      }
+      return Promise.resolve(-1);
+    }
+    var name = UTF8ToString(arg);
+    return new Promise((resolve) => {
+      if (mode == 0) {
+        dns.lookup(name, { family: 4, all: true }, (err, addrs) => {
+          if (err || !addrs.length) resolve(-1);
+          else resolve(put([name].concat(addrs.map((a) => a.address)).join('\n')));
+        });
+      } else {
+        dns.lookupService(name, 0, (err, host) => {
+          if (err || !host) resolve(-1);
+          else resolve(put(host + '\n' + name));
+        });
+      }
+    });
+  },
 });
