diff --git a/extensions/rxsock/rxsockfn.cpp b/extensions/rxsock/rxsockfn.cpp
index fd47f6b..247ac33 100644
--- a/extensions/rxsock/rxsockfn.cpp
+++ b/extensions/rxsock/rxsockfn.cpp
@@ -80,6 +80,153 @@
 // stays free to deliver WebSocket events.  So a plain sleep is enough to wait
 // for readiness: no Asyncify needed.
 static inline void wasmSocketYield() { usleep(1000); }
+
+// Emscripten's socket syscalls never block: accept/recv/recvfrom on a
+// blocking socket report EAGAIN when nothing is there yet.  Restore blocking
+// semantics: call this after such an EAGAIN; it returns true when the caller
+// should retry, false when it should give up with errno set: non-blocking
+// socket (EAGAIN stays), pending socket error (SO_ERROR), or the socket's
+// SO_RCVTIMEO elapsed (EAGAIN, as natively).  deadline starts at -1.
+static bool wasmBlockingRetry(int sock, double &deadline)
+{
+    if (errno != EAGAIN && errno != EWOULDBLOCK)
+    {
+        return false;
+    }
+    int socketFlags = fcntl(sock, F_GETFL, 0);
+    if (socketFlags >= 0 && (socketFlags & O_NONBLOCK) != 0)
+    {
+        return false;
+    }
+    int socketError = 0;
+    socklen_t errorLength = sizeof(socketError);
+    if (getsockopt(sock, SOL_SOCKET, SO_ERROR, &socketError, &errorLength) == 0 && socketError != 0)
+    {
+        errno = socketError;
+        return false;
+    }
+    double now = emscripten_get_now();
+    if (deadline < 0)
+    {
+        deadline = 0;                  // no timeout
+        struct timeval tv = { 0, 0 };
+        socklen_t tvLength = sizeof(tv);
+        if (getsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &tv, &tvLength) == 0 && (tv.tv_sec != 0 || tv.tv_usec != 0))
+        {
+            deadline = now + (double)tv.tv_sec * 1000.0 + (double)tv.tv_usec / 1000.0;
+        }
+    }
+    else if (deadline > 0 && now >= deadline)
+    {
+        errno = EAGAIN;
+        return false;
+    }
+    wasmSocketYield();
+    return true;
+}
+
+// Name resolution.  Emscripten's resolver is a fake (synthetic 172.29.x.y
+// addresses that only its WebSocket emulation understands, lookups never
+// fail, no reverse names, host name "emscripten").  With real sockets under
+// Node, orxNodeResolve (wasm/emscripten-dns-proxy.js) asks the host instead;
+// elsewhere it returns -2 and the libc functions are used.  Results live in
+// static storage, like the libc functions they replace.
+extern "C" int orxNodeResolve(int mode, const char *arg, char *out, int outLen);
+
+#define WASM_MAX_ADDRS 16
+static char            wasmHostText[1024];
+static char           *wasmHostAliases[1];
+static struct in_addr  wasmHostAddrs[WASM_MAX_ADDRS];
+static char           *wasmHostAddrList[WASM_MAX_ADDRS + 1];
+static struct hostent  wasmHostEnt;
+
+// builds wasmHostEnt from orxNodeResolve's "name\naddr\naddr..." text
+static struct hostent *wasmHostEntFromText()
+{
+    char *next = strchr(wasmHostText, '\n');
+    int count = 0;
+    while (next != NULL && count < WASM_MAX_ADDRS)
+    {
+        *next++ = '\0';
+        char *addr = next;
+        next = strchr(addr, '\n');
+        if (next != NULL)
+        {
+            *next = '\0';
+        }
+        if (inet_aton(addr, &wasmHostAddrs[count]))
+        {
+            wasmHostAddrList[count] = (char *)&wasmHostAddrs[count];
+            count++;
+        }
+        if (next != NULL)
+        {
+            *next = '\n';              // restore the separator for the loop
+        }
+    }
+    if (count == 0)
+    {
+        h_errno = HOST_NOT_FOUND;
+        return NULL;
+    }
+    wasmHostAddrList[count] = NULL;
+    wasmHostAliases[0] = NULL;
+    wasmHostEnt.h_name = wasmHostText;
+    wasmHostEnt.h_aliases = wasmHostAliases;
+    wasmHostEnt.h_addrtype = AF_INET;
+    wasmHostEnt.h_length = sizeof(struct in_addr);
+    wasmHostEnt.h_addr_list = wasmHostAddrList;
+    return &wasmHostEnt;
+}
+
+static struct hostent *wasmGetHostByName(const char *name)
+{
+    int rc = orxNodeResolve(0, name, wasmHostText, sizeof(wasmHostText));
+    if (rc == -2)
+    {
+        return gethostbyname(name);
+    }
+    if (rc < 0)
+    {
+        h_errno = HOST_NOT_FOUND;
+        return NULL;
+    }
+    return wasmHostEntFromText();
+}
+
+static struct hostent *wasmGetHostByAddr(const void *addr, socklen_t len, int type)
+{
+    if (type != AF_INET || len != sizeof(struct in_addr))
+    {
+        return gethostbyaddr(addr, len, type);
+    }
+    char addrText[INET_ADDRSTRLEN];
+    inet_ntop(AF_INET, addr, addrText, sizeof(addrText));
+    int rc = orxNodeResolve(1, addrText, wasmHostText, sizeof(wasmHostText));
+    if (rc == -2)
+    {
+        return gethostbyaddr(addr, len, type);
+    }
+    if (rc < 0)
+    {
+        h_errno = HOST_NOT_FOUND;
+        return NULL;
+    }
+    return wasmHostEntFromText();
+}
+
+static int wasmGetHostName(char *name, size_t len)
+{
+    if (orxNodeResolve(2, NULL, name, (int)len) < 0)
+    {
+        return gethostname(name, len);
+    }
+    return 0;
+}
+
+#define gethostbyname(name)            wasmGetHostByName(name)
+#define gethostbyaddr(addr, len, type) wasmGetHostByAddr(addr, len, type)
+#define gethostname(name, len)         wasmGetHostName(name, len)
 #endif
 
 #if defined( HAVE_SYS_SELECT_H )
@@ -153,6 +300,14 @@ RexxRoutine2(int, SockAccept, int, sock, OPTIONAL_RexxObjectPtr, stemSource)
     nameLen = sizeof(addr);
     // (int) cast avoids C4244 on Windows 64-bit
     int rc = (int)accept(sock, (struct sockaddr *)&addr, &nameLen);
+#if defined(__EMSCRIPTEN__)
+    double deadline = -1;
+    while (rc < 0 && wasmBlockingRetry(sock, deadline))
+    {
+        nameLen = sizeof(addr);
+        rc = (int)accept(sock, (struct sockaddr *)&addr, &nameLen);
+    }
+#endif
 
     // set the errno variables
     setErrno(context, rc >= 0);
@@ -398,6 +553,16 @@ RexxRoutine2(int, SockGetHostByName, CSTRING, name, RexxObjectPtr, stemSource)
 RexxRoutine0(RexxStringObject, SockGetHostId)
 {
     in_addr ia;
+#if defined(__EMSCRIPTEN__)
+    // getifaddrs() is not available: ask Node for the interface addresses
+    char wasmAddr[INET_ADDRSTRLEN + 1];
+    int wasmRc = orxNodeResolve(3, NULL, wasmAddr, sizeof(wasmAddr));
+    if (wasmRc != -2)
+    {
+        setErrno(context, wasmRc >= 0);
+        return context->String(wasmRc >= 0 ? wasmAddr : "0.0.0.0");
+    }
+#endif
 #ifdef WIN32
     char     pszBuff[256];                   // hostnames should be 255 chars or less
     PHOSTENT pHostEnt;                       // ptr to hostent structure
@@ -790,18 +955,9 @@ RexxRoutine4(int, SockRecv, int, sock, CSTRING, var, int, dataLen, OPTIONAL_CSTR
      *---------------------------------------------------------------*/
     rc = recv(sock, pBuffer, dataLen, flags);
 #if defined(__EMSCRIPTEN__)
-    int socketFlags = fcntl(sock, F_GETFL, 0);
-    bool blockingSocket = socketFlags < 0 || (socketFlags & O_NONBLOCK) == 0;
-    while (rc < 0 && (errno == EAGAIN || errno == EWOULDBLOCK) && blockingSocket)
+    double deadline = -1;
+    while (rc < 0 && wasmBlockingRetry(sock, deadline))
     {
-        int socketError = 0;
-        socklen_t errorLength = sizeof(socketError);
-        if (getsockopt(sock, SOL_SOCKET, SO_ERROR, &socketError, &errorLength) == 0 && socketError != 0)
-        {
-            errno = socketError;
-            break;
-        }
-        wasmSocketYield();
         rc = recv(sock, pBuffer, dataLen, flags);
     }
 #endif
@@ -897,6 +1053,14 @@ RexxRoutine5(int, SockRecvFrom, int, sock, CSTRING, var, int, dataLen, RexxObjec
      * call function
      *---------------------------------------------------------------*/
     int rc = recvfrom(sock,pBuffer,dataLen,flags,(struct sockaddr *)&addr,&addr_size);
+#if defined(__EMSCRIPTEN__)
+    double deadline = -1;
+    while (rc < 0 && wasmBlockingRetry(sock, deadline))
+    {
+        addr_size = sizeof(addr);
+        rc = recvfrom(sock,pBuffer,dataLen,flags,(struct sockaddr *)&addr,&addr_size);
+    }
+#endif
 
     // set the errno information
     setErrno(context, rc >= 0);
