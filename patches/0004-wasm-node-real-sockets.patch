+// --pre-js for the Node command-line build linked with -sNODERAWSOCKETS (real
+// TCP/UDP through node:net/node:dgram instead of WebSocket emulation).
+// Completes Emscripten 6.0.9's backend where ooRexx needs more:
+//  - SO_RCVTIMEO / SO_SNDTIMEO: the backend accepts and drops them, and
+//    getsockopt fails with ENOPROTOOPT.  Store them per socket; rxsock's
+//    blocking loops (wasmBlockingRetry) honour SO_RCVTIMEO like the kernel.
+//    wasm32 musl uses the 64-bit-time options 66/67 (struct timeval =
+//    {int64 tv_sec, int32 tv_usec, 4 bytes padding}); the old 20/21 take
+//    {long sec, long usec}.
+//  - SOL_SOCKET options Node cannot apply (SO_DEBUG, SO_DONTROUTE,
+//    SO_OOBINLINE, SO_RCVLOWAT, SO_SNDLOWAT) and SO_REUSEADDR (libuv forces
+//    it on at bind; the backend always reports 1): remember the value set and
+//    report it back with the Linux defaults, so programs see what they set.
+Module['preRun'] = (Module['preRun'] || []).concat([function() {
+  if (typeof nodeSockOps == 'undefined') return;
+  var setsockopt = nodeSockOps.setsockopt, getsockopt = nodeSockOps.getsockopt;
+  var SOL_SOCKET = 1;
+  var TIMEO = { 20: ['rcvtimeo', 8], 21: ['sndtimeo', 8], 66: ['rcvtimeo', 16], 67: ['sndtimeo', 16] };
+  // optname: [default, boolean]
+  var STORED = { 1: [0, 1], 2: [0, 1], 5: [0, 1], 10: [0, 1], 18: [1, 0], 19: [1, 0] };
+  nodeSockOps.setsockopt = function(sock, level, optname, optval, optlen) {
+    var st = level === SOL_SOCKET && STORED[optname];
+    if (st) {
+      if (optlen < 4) return -28;                        // EINVAL
+      var rc = setsockopt.apply(this, arguments);
+      if (rc) return rc;
+      var val = HEAP32[optval >> 2];
+      sock.opts ||= {};
