+# Qualification of the Node command-line build (wasm/build-node.sh), with
+# assertions: exit status 0 and "QUALIFICATION PASS" only if every check
+# passes; otherwise "QUALIFICATION FAIL (n): ..." and exit status 1.
+#
+# Usage: wasm/tests/qualify-node-cli.sh BIN_NODE
+#   BIN_NODE: the output directory of wasm/build-node.sh (with the rexx,
+#   rexxc, rxqueue and rxsubcom launchers), e.g. /tmp/oorexx-wasm-build/bin-node
+# Needs node and python3.  Uses the TCP/UDP ports 50110-50119 on 127.0.0.1.
+set -uo pipefail
+NB=$(cd "${1:?usage: qualify-node-cli.sh BIN_NODE}" && pwd)
+[[ -x $NB/rexx ]] || { echo "no $NB/rexx (run wasm/build-node.sh)" >&2; exit 2; }
+T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
+# GNU timeout (Linux coreutils); on macOS Homebrew's coreutils also has gtimeout
+TIMEOUT=$(command -v timeout || command -v gtimeout) || { echo 'qualification needs GNU timeout (macOS: brew install coreutils)' >&2; exit 2; }
+export NB
+X="\"$NB/rexx\""
+PASSED=0; FAILED=()
+
+# check TITLE REGEX... -- SHELL-SNIPPET
+# Runs the snippet (bash, in a scratch directory, 90 s timeout) and prints
+# its output; every REGEX must match some line of the output (stdout+stderr)
+# and the exit status must be 0.  A REGEX starting with '!' must match no line.
+check() {
+  local title=$1; shift
+  local pats=() p miss=() out rc
+  while [[ $1 != -- ]]; do pats+=("$1"); shift; done; shift
+  out=$(cd "$T" && "$TIMEOUT" 90 bash -c "$1" 2>&1); rc=$?
+  for p in "${pats[@]}"; do
+    if [[ $p == !* ]]; then grep -Eq -- "${p:1}" <<<"$out" && miss+=("no /${p:1}/")
+    else grep -Eq -- "$p" <<<"$out" || miss+=("/$p/"); fi
+  done
+  (( rc == 0 )) || miss+=("exit status $rc")
+  if (( ${#miss[@]} )); then
+    FAILED+=("$title"); printf 'FAIL  %s\n      expected: %s\n' "$title" "${miss[*]}"
+    tail -n 8 <<<"$out" | sed 's/^/      | /'
+  else
+    PASSED=$((PASSED+1)); printf 'ok    %s\n' "$title"
+  fi
+}
+
+# --- host files, environment, external commands, rexxc
+cat > "$T/cmds.rex" <<'EOF'
+'echo hi'; say 'rc='rc
+address system 'exit 3'; say 'rc='rc
+address system 'printf "a\nb\n"' with output stem o.; say 'stem='o.0 o.2
+EOF
+check "host files + environment" '^hola$' '^env=xyz$' -- \
+  "QTEST_VAR=xyz $X -e 'call lineout \"$T/h.txt\",\"hola\"; call lineout \"$T/h.txt\"; say linein(\"$T/h.txt\"); say \"env=\"value(\"QTEST_VAR\",,\"ENVIRONMENT\")' && test -f '$T/h.txt'"
+check "external commands: output, rc, ADDRESS WITH" '^hi$' '^rc=0$' '^rc=3$' '^stem=2 b$' -- "$X cmds.rex"
+check "host errno values (stream ERROR:2)" '^ERROR:2$' -- \
+  "$X -e 'say stream(\"$T/no/such/dir/x\", \"c\", \"open read\")'"
+# --- LINES() / CHARS() on the host's stdin (ioctl FIONREAD answered in node-pre.js)
+printf 'uno\ndos\ntres\n' > "$T/in3.txt"
+check "LINES() on stdin: terminal-less, empty, pipe, file, loop" '^devnull=0$' '^empty=0$' '^pipe=1$' '^file=1 chars=13$' '^loop=3$' -- \
+  "printf 'devnull='; $X -e 'say lines()' </dev/null; printf 'empty='; true | $X -e 'say lines()'; printf 'pipe='; cat in3.txt | $X -e 'say lines()'; printf 'file='; $X -e 'say lines() \"chars=\"chars()' < in3.txt; printf 'loop='; cat in3.txt | $X -e 'n = 0; do while lines() > 0; parse pull l; n = n + 1; end; say n'"
+check "rexxtry next to rexx (rexx rexxtry)" '^42$' -- "cd / && printf 'say 6*7\\nexit\\n' | $X rexxtry"
+check ".RexxInfo~executable" "^$NB/rexx\$" -- "$X -e 'say .RexxInfo~executable'"
+check "rexxc compile + run" '^compiled ok$' -- \
+  "echo 'say \"compiled ok\"' > c.rex && \"$NB/rexxc\" c.rex c.rxc >/dev/null && $X c.rxc"
+
+
+
+echo
+if (( ${#FAILED[@]} )); then
+  echo "QUALIFICATION FAIL (${#FAILED[@]}): ${FAILED[*]}"
+  exit 1
+fi
+echo "QUALIFICATION PASS ($PASSED checks)"
