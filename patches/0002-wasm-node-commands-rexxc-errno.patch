+/*----------------------------------------------------------------------------*/
+// Pre-js of the Node command-line build (wasm/build-node.sh).
+Module['preRun'] = (Module['preRun'] || []).concat([function() {
+  // the host environment is the environment of the Rexx process
+  for (var k in process.env) ENV[k] = process.env[k];
+  // Emscripten 6.0.9 NODERAWFS: FS.fstat() dereferences stream.node, which
+  // the streams of the standard handles (fd 0-2) opened by NODERAWFS do not
+  // have (TypeError on node_ops); ask Node directly for those.
+  var origFstat = FS.fstat;
+  FS.fstat = function(fd) {
+    var st = FS.getStream(fd);
+    if (st && !st.stream_ops && !st.node && st.nfd !== undefined) {
+      try { return fs.fstatSync(st.nfd); }
+      catch (e) { if (e.code) throw new FS.ErrnoError(ERRNO_CODES[e.code]); throw e; }
+    }
+    return origFstat(fd);
+  };
+
+  // LINES()/CHARS() on STDIN: SysFile::hasData() asks ioctl(FIONREAD), which
+  // Emscripten answers 0 (success) without writing the count, so the caller
+  // saw whatever its variable held (LINES() was always 1).  Answer it for the
+  // host's fd 0: a regular file, the bytes left; a terminal, /dev/null or any
+  // other device, 0; a pipe or socket, Node cannot ask without reading, so
+  // the bytes are read ahead (this waits for the writer, where native ooRexx
+  // would answer 0 if it has not written yet) and served to the next reads.
+  var FIONREAD = 0x541B, stdinAhead = null, origIoctl = FS.ioctl, origRead = FS.read;
+  function stdinAvailable(stream) {
+    if (stdinAhead && stdinAhead.length) return stdinAhead.length;
+    var st;
+    try { st = fs.fstatSync(0); } catch (e) { return 0; }
+    if (st.isFile()) return Math.max(0, st.size - stream.position);
+    if (!st.isFIFO() && !st.isSocket()) return 0;
+    var buf = Buffer.alloc(65536), n = 0;
+    try { n = fs.readSync(0, buf, 0, buf.length, null); }
+    catch (e) { if (e.code !== 'EAGAIN' && e.code !== 'EOF') throw e; }
+    stdinAhead = buf.subarray(0, n);
+    return n;
+  }
+  FS.ioctl = function(stream, cmd, arg) {
+    if (cmd === FIONREAD && stream.nfd === 0) {
+      HEAP32[arg >> 2] = stdinAvailable(stream);
+      return 0;
+    }
+    return origIoctl(stream, cmd, arg);
+  };
+  FS.read = function(stream, buffer, offset, length, position) {
+    if (stream.nfd === 0 && stdinAhead && stdinAhead.length && position === undefined) {
+      var n = Math.min(length, stdinAhead.length);
+      buffer.set(stdinAhead.subarray(0, n), offset);
+      stdinAhead = stdinAhead.subarray(n);
+      stream.position += n;
+      return n;
+    }
+    return origRead(stream, buffer, offset, length, position);
+  };
+}]);
