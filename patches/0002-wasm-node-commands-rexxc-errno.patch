+           rxftp/rxftp.cls rxregexp/rxregexp.cls json/json.cls yaml/yaml.cls \
+           csvStream/csvStream.cls dateparser/dateparser.cls; do
+  cp "$SRC/extensions/$cls" "$OUT/"
+done
+
+launcher() {   # launcher NAME [rexx.js option]
+  cat > "$OUT/$1" <<SH
+#!/usr/bin/env bash
+# ooRexx/WASM $1 (Node, host file system); rexx.img and the classes via PATH
+DIR=\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)
+PATH="\$DIR:\$PATH" exec node "\$DIR/rexx.js" ${2:+$2 }"\$@"
