+int SysProcess::hostErrno(int e)
+{
+#if defined(__EMSCRIPTEN__)
+    for (size_t i = 0; i < sizeof(wasmErrnoTable) / sizeof(wasmErrnoTable[0]); i++)
+    {
+        if (wasmErrnoTable[i].wasm == e)
+        {
+            return wasmErrnoTable[i].host;
+        }
+    }
+#endif
+    return e;
+}
+
+int SysProcess::localErrno(int e)
+{
+#if defined(__EMSCRIPTEN__)
+    for (size_t i = 0; i < sizeof(wasmErrnoTable) / sizeof(wasmErrnoTable[0]); i++)
+    {
+        if (wasmErrnoTable[i].host == e)
+        {
+            return wasmErrnoTable[i].wasm;
+        }
+    }
+#endif
+    return e;
+}
