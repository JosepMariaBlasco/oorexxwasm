+/*
+ * External commands in the WASM build.
+ *
+ * Under Node a command runs as a real host process through
+ * child_process.spawnSync().  The interpreter runs on a pthread
+ * (PROXY_TO_PTHREAD), i.e. a Node worker thread, where blocking is legal, so
+ * the call is made directly on the calling thread: concurrent Rexx threads
+ * can run commands at the same time and the JS main thread stays free.
+ * Without redirection the child inherits the real stdin/stdout/stderr; with
+ * ADDRESS ... WITH redirection INPUT is passed as a buffer and OUTPUT/ERROR
+ * are collected as buffers.  Interleaved OUTPUT+ERROR (same target) is done
+ * by a tiny sh wrapper that does 2>&1 and then exec's the original argv, so
+ * argv is preserved exactly.
+ *
+ * The child gets the interpreter's environment (environ, as changed by
+ * SET/EXPORT/VALUE(...,'ENVIRONMENT'); if PATH is still Emscripten's default
+ * "/", the host PATH) and current directory, provided the
+ * latter exists on the host (it does with NODERAWFS; with MEMFS it may not,
+ * then the child starts in the Node process' directory).
+ *
+ * In the browser there are no processes: commands fail closed (FAILURE,
+ * RC 127), as before.
+ *
+ * Results (OUTPUT/ERROR buffers) are kept in a per-thread JS global between
+ * the run and the copy calls; each JS worker has its own globalThis, and a
+ * thread runs one command at a time.
+ */
+
+// flags for wasmCommandRun
+#define WASM_CMD_INPUT      1
+#define WASM_CMD_OUTPUT     2
+#define WASM_CMD_ERROR      4
+#define WASM_CMD_SAME       8      // OUTPUT and ERROR to the same target
+
+// special return codes of wasmCommandRun
+#define WASM_CMD_NO_PROCESSES  (-100000)
+
+EM_JS(int, wasmCommandRun, (char **argv, char **envp, const char *cwd,
+                            const char *input, int inputLength, int flags), {
+    if (typeof process !== 'object' || !process.versions || !process.versions.node ||
+        typeof require !== 'function')
+    {
+        return -100000;                        // no processes in the browser
+    }
+    var cp = require('child_process');
+    var fs = require('fs');
+    var os = require('os');
+    var u32 = new Uint32Array(wasmMemory.buffer);
+    var strings = function(p) {
+        var list = [];
+        if (!p) return list;
+        for (var i = p >> 2; u32[i] !== 0; i++) list.push(UTF8ToString(u32[i]));
+        return list;
+    };
+    var args = strings(argv);
+    var env = {};
+    strings(envp).forEach(function(e) {
+        var eq = e.indexOf('=');
+        if (eq > 0) env[e.substring(0, eq)] = e.substring(eq + 1);
+    });
+    // a runtime that did not import the host environment (the MEMFS build)
+    // has Emscripten's default PATH=/; search the host PATH then
+    if ((env.PATH === undefined || env.PATH === '/') && process.env.PATH)
+    {
+        env.PATH = process.env.PATH;
+    }
+    var dir = cwd ? UTF8ToString(cwd) : undefined;
+    try { if (!dir || !fs.statSync(dir).isDirectory()) dir = undefined; }
+    catch (e) { dir = undefined; }
+
+    var file = args[0];
+    var rest = args.slice(1);
+    if (flags & 8)
+    {   // OUTPUT and ERROR interleaved into one target
+        rest = ['-c', 'exec 2>&1; exec "$0" "$@"', file].concat(rest);
+        file = '/bin/sh';
+    }
+    var options = {
+        cwd: dir, env: env, argv0: args[0],
+        maxBuffer: 0x7fffffff,
+        stdio: [(flags & 1) ? 'pipe' : 'inherit',
+                (flags & 2) ? 'pipe' : 'inherit',
+                ((flags & 4) && !(flags & 8)) ? 'pipe' : 'inherit']
+    };
+    if (flags & 1)
+    {
+        options.input = inputLength > 0 ?
+            Buffer.from(new Uint8Array(wasmMemory.buffer, input, inputLength)) :
+            Buffer.alloc(0);
+    }
+    globalThis.__orxCmd = null;
+    var r;
+    try
+    {
+        // throws synchronously for bad arguments, e.g. an empty command
+        // name (ADDRESS PATH ''); natively posix_spawnp() fails: FAILURE
+        r = cp.spawnSync(file, rest, options);
+    }
+    catch (e)
+    {
+        return 127;
+    }
+    globalThis.__orxCmd = [r.stdout || null, r.stderr || null];
+    if (r.error)
+    {
+        // EPIPE: the command did not read all of INPUT -- not an error
+        if (r.error.code === 'EPIPE' && r.status !== null) return r.status;
+        return 127;                            // could not start: unknown command
+    }
+    if (r.status !== null) return r.status;
+    var sig = r.signal ? (os.constants.signals[r.signal] || 1) : 1;
+    return -sig;
+});
+
+// length of the collected OUTPUT (0) or ERROR (1) buffer
+EM_JS(int, wasmCommandResultLength, (int which), {
+    var res = globalThis.__orxCmd;
+    return (res && res[which]) ? res[which].length : 0;
+});
+
+// copy the collected OUTPUT (0) or ERROR (1) buffer to buf, then drop it
+EM_JS(void, wasmCommandResultCopy, (int which, char *buf), {
+    var res = globalThis.__orxCmd;
+    if (res && res[which])
+    {
+        new Uint8Array(wasmMemory.buffer).set(res[which], buf);
+        res[which] = null;
+    }
+});
+
+/**
+ * Hand a collected OUTPUT/ERROR buffer to the redirection context.
+ */
+static void wasmCommandDeliver(RexxIORedirectorContext *ioContext, int which)
+{
+    int length = wasmCommandResultLength(which);
+    if (length <= 0)
+    {
+        return;
+    }
+    char *buffer = (char *)malloc(length);
+    if (buffer == NULL)
+    {
+        return;
+    }
+    wasmCommandResultCopy(which, buffer);
+    if (which == 0)
+    {
+        ioContext->WriteOutputBuffer(buffer, length);
+    }
+    else
+    {
+        ioContext->WriteErrorBuffer(buffer, length);
+    }
+    free(buffer);
+}
+
+/**
+ * WASM version of the process part of ioCommandHandler (see above).
+ */
+static RexxObjectPtr wasmCommandHandler(RexxExitContext *context, CSTRING commandString,
+                                        char **argv, RexxIORedirectorContext *ioContext)
+{
+    int flags = 0;
+    CSTRING inputBuffer = NULL;
+    size_t inputLength = 0;
+
+    if (ioContext->IsRedirectionRequested())
+    {
+        if (ioContext->IsInputRedirected())
+        {
+            flags |= WASM_CMD_INPUT;
+            ioContext->ReadInputBuffer(&inputBuffer, &inputLength);
+        }
