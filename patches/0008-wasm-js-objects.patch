+/*                                                                            */
+/*----------------------------------------------------------------------------*/
+/*
+ * ooRexx/WASM: a realm of the JavaScript bridge (.JSObject, see
+ * wasm/web-js.cpp and wasm/web/js.cls): orxJsRealm(name, emit, syncCall,
+ * hooks) makes one, with handle(op, bytes) -> reply bytes (or a Promise of
+ * them) and release(id).
+ * Loaded as a --pre-js in the browser build (realm "worker", the Web Worker
+ * that hosts the run) and in the Node command-line build (realm "node"),
+ * where wasm/js-bridge.js passes it the interpreter's requests, and by
+ * ooRexx.js in the page (realm "page", the DOM), which gets the requests for
+ * it from the worker by postMessage.  A realm runs on a thread that never
+ * blocks.
+ *
+ *  - handles: every object, function or symbol handed to Rexx gets an id in
+ *    its realm, the same id for the same object (so identity holds), counted:
+ *    one count per .JSObject made for it, given back when that .JSObject is
+ *    garbage collected (its UNINIT).  Id 0 is globalThis, for good;
+ *  - names: ooRexx uppercases every message name, so o~getElementById
+ *    arrives as GETELEMENTBYID; it is resolved case-insensitively along the
+ *    prototype chain (the nearest object that has a match wins; of two
+ *    matches there, the one starting in lowercase, as window.document over
+ *    window.Document; else an error), with the names of each prototype cached;
+ *  - handlers: a .JSHandler (record H) becomes a function of this realm, the
+ *    same one each time (so removeEventListener works); called, it does what
+ *    its options say to its first argument (preventDefault, stopPropagation,
+ *    stopImmediatePropagation).  Synchronous (no option queued, and a realm
+ *    given syncCall: the Web Worker, Node), it passes syncCall(bytes) the call
+ *    (H "id" + A arguments) and returns what it answers: the Rexx method's
+ *    result (or a RexxError thrown) when a Rexx thread was waiting for
+ *    JavaScript, else undefined (the method runs on a thread of its own);
+ *    queued (option queued, or the page), it passes emit(bytes) the
+ *    event (H "id", or "id<tab>L" for option latest, + A arguments, for
+ *    js_event in web-js.cpp) and returns undefined at once;
+ *  - classes (.js~extend, only with syncCall): a class extending the base
+ *    whose overrides pass syncCall M "peer<tab>NAME" (+ S the instance's
+ *    reference the first time, U after) + A arguments, as a synchronous
+ *    handler; an instance made by Rexx (CONSTRUCT) has a peer, the Rexx
+ *    object's id, until DETACH, and goes to Rexx as P "peer"; without one
+ *    the overrides run the base's members;
+ *  - values, records and ops: see web-js.cpp.
+ */
+var orxJsRealm = (function () {
+  'use strict';
+  const isNode = typeof process !== 'undefined' && !!(process.versions && process.versions.node);
+
+  // a realm: REALM is its name (worker, node, page); emit(bytes) hands the
+  // interpreter an event; syncCall(bytes) calls Rexx and waits (where
+  // JavaScript can wait: the worker, Node); hooks (the page, from ooRexx.js):
