+/** A Rexx object and message for JavaScript to call (.js~handler). */
+::class JSHandler public
+::attribute target get
+::attribute message get
+::attribute options get
+::attribute id get
+::method init
+  expose target message options id
+  use strict arg target, message, options = ""
+  message = message~upper
+  known = "preventDefault stopPropagation stopImmediatePropagation latest max queued"
+  opts = ""
+  words = options~space~makeArray(" ")
+  do i = 1 to words~items
+    word = words[i]
+    p = wordPos(word~upper, known~upper)
+    if p = 0 then raise syntax 98.900 array(".js~handler: unknown option" word "(known:" known")")
+    opts = opts known~word(p)
+    if word~upper == "MAX" then do          -- max n: n a whole number > 0
+      i += 1
+      n = words[i]
+      if n == .nil then n = ""
+      if \datatype(n, "W") then raise syntax 98.900 array(".js~handler: max needs a whole number > 0, found" n)
+      if n < 1 then raise syntax 98.900 array(".js~handler: max needs a whole number > 0, found" n)
+      opts = opts (n + 0)
+    end
+  end
+  -- latest and max n are about the queue: they make the handler queued
+  if (wordPos("latest", opts) > 0 | wordPos("max", opts) > 0) & wordPos("queued", opts) = 0 then opts = opts "queued"
+  options = opts~strip
+  id = JsHandlerId()
+  if wordPos("queued", options) = 0 then call JsSyncSetup
+::method release                    -- no more events from it
+  expose id
+  call JsHandlerRelease id
+::method string
+  expose target message
+  return "a JSHandler ("target"~"message")"
+
+/** What ooRexx.js's start() gives the page: Rexx code to run (see Sessions above). */
+::class JSSession public
+::method init
+  expose context
+  -- the parent package of what the session makes: sees js.cls, and every
+  -- package made gets added to it
+  context = .Routine~new("session", "nop")~package
+  context~addPackage(.context~package)
+::method eval unguarded             -- eval(source, args...): source as a routine, its result
+  use strict arg source, ...
+  r = self~routine("eval", source)
+  args = arg(2, "A")
+  drop result
+  r~callWith(args)
+  if var("RESULT") then return result
+::method routine unguarded          -- routine(name, source): a Routine
+  expose context
+  use strict arg name, source
+  r = .Routine~new(name, self~lines(source), context)
+  p = r~package                     -- kept if it defines anything for later code
+  if p~publicClasses~items + p~publicRoutines~items > 0 then context~addPackage(p)
+  return r
+::method loadPackage unguarded      -- loadPackage(name [, source]): a Package, its prolog run
+  expose context
+  use strict arg name, source = .nil
+  if source == .nil then p = .Package~new(name)
+  else p = .Package~new(name, self~lines(source), context)
+  context~addPackage(p)
+  return p
+::method lines private              -- source text (a string, maybe with line ends) as an Array of lines
+  use arg source
+  if source~isA(.String) then return source~makeArray
+  return source
+::method string
+  return "a JSSession"
+
+/** One call of a handler's JavaScript function (.js~nextEvent). */
+::class JSEvent public
+::attribute handler get
+::attribute arguments get
+::method init
+  expose handler arguments
+  use strict arg handler, arguments
+::method target
+  expose handler
+  return handler~target
+::method message
+  expose handler
+  return handler~message
+::method dispatch                   -- the handler's message to its object, with the call's arguments
+  expose handler arguments
+  if var("RESULT") then drop result
+  handler~target~sendWith(handler~message, arguments)
+  if var("RESULT") then return result
+::method string
+  expose handler arguments
+  return "a JSEvent ("handler~target"~"handler~message", "arguments~items "arguments)"
+
+/** A Rexx value with a JavaScript type forced (.js~num, .js~bool, ...). */
+::class JSTyped public
+::attribute kind get
+::attribute value get
+::method undefined class unguarded  -- the one .js~undefined
+  expose undefined
+  if var("UNDEFINED") then return undefined
+  undefined = self~new("U", "")
+  return undefined
+::method init
+  expose kind value
+  use strict arg kind, value
+::method string
+  expose kind value
+  if kind == "U" then return "undefined"
+  return value
