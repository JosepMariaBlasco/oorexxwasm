+  'use strict';
+  const isNode = typeof process !== 'undefined' && !!(process.versions && process.versions.node);
+  const LOCAL = isNode ? 'node' : 'worker';
+  const dec = new TextDecoder('utf-8');
+
+  // the heap views, current: another thread may have grown the memory
+  const views = () => { if (typeof growMemViews === 'function') growMemViews(); };
+
+  // an event for the interpreter's queue (js_event frees the copy)
+  function emit(bytes) {
+    const p = _js_alloc(bytes.length + 1);
+    views();
+    HEAPU8.set(bytes, p);
+    _js_event(p, bytes.length);
+  }
+  Module['jsEvent'] = emit;
+
+  // a call of Rexx from the page (the page cannot wait): queued as an event,
+  // C "id" + the call; the answer, from web-js.cpp's pageCall, goes back to
+  // the page for the call's Promise
+  Module['jsCallQueued'] = function (id, bytes) {
+    const head = new TextEncoder().encode('C' + String(id).length + ':' + id);
+    const all = new Uint8Array(head.length + bytes.length);
+    all.set(head); all.set(bytes, head.length);
+    emit(all);
+  };
+  Module['jsCallReply'] = function (id, p, len) {
+    views();
+    const bytes = HEAPU8.slice(p, p + len);
+    _js_free(p);
+    toPage({ type: 'callReply', id, bytes }, [bytes.buffer]);
+  };
+
+  // Node: the program's end is the process's end, as with native ooRexx, even
+  // if JavaScript objects it made (a server, a timer) would keep Node running
+  if (isNode) {
+    const chained = Module['onExit'];
+    Module['onExit'] = (rc) => { if (chained) chained(rc); process.exit(rc); };
+  }
+  // the requests being done now, innermost last (a synchronous handler called
+  // meanwhile runs on the thread of the last one)
+  const serving = [];
+  function syncCall(bytes) {
+    const req = serving.length ? serving[serving.length - 1] : 0;
+    const p = _js_alloc(bytes.length + 1), lenp = _js_alloc(4);
+    views();
+    HEAPU8.set(bytes, p);
+    const out = _js_sync_call(req, p, bytes.length, lenp);
+    views();
+    const reply = HEAPU8.slice(out, out + HEAP32[lenp >> 2]);
+    _js_free(p); _js_free(lenp); _js_free(out);
+    return reply;
+  }
