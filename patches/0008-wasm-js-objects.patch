+    if (realm !== LOCAL && (isNode || realm !== 'page')) {
+      return 'there is no JavaScript realm "' + realm + '" here (this is realm "' + LOCAL + '")';
+    }
+    return 'JavaScript is not available: the page running ooRexx did not grant the ' + realm +
+      ' realm (ooRexx run option js: {' + realm + ': true})';
+  }
