+  // the realm a request is for (r: just after the X records)
+  function realmOf(op, r) {
+    if (op === 1) return r.str();
+    if (op === 17) return 'page';                  // SESSION: for ooRexx.js
+    if (((op >= 2 && op <= 9) || (op >= 13 && op <= 16)) && r.more() && r.peek() === 'O') {
+      return dec.decode(r.rec().d).split('\t')[0];
+    }
+    return LOCAL;
+  }
+
+  // ---- the page realm, through ooRexx.js ----------------------------------
+  let pageSeq = 0;
+  const pageWaiting = new Map();
+  Module['jsPageReply'] = function (id, bytes) {
+    const finish = pageWaiting.get(id);
+    pageWaiting.delete(id);
+    if (finish) finish(bytes);
+  };
+  function toPage(msg, transfer) {
+    if (typeof Module['orxJsPage'] !== 'function') return false;
+    Module['orxJsPage'](msg, transfer);
+    return true;
+  }
+
+  // the requests queued by wasm/web-js.cpp (jsCall), in a microtask or while
+  // waiting for a synchronous handler
+  Module['jsDrain'] = function () {
+    let req;
+    while ((req = _js_next_request())) Module['jsCall'](req);
+  };
+
+  const WAITED = 'Error: JavaScript is waiting for this Rexx thread (a synchronous handler), ' +
+    'so it cannot wait for ';
+  // one request (see the JsRequest layout in wasm/web-js.cpp)
+  Module['jsCall'] = function (req) {
+    const finish = (bytes) => {
+      const p = _js_alloc(bytes.length + 1);
+      views();
+      HEAPU8.set(bytes, p);
+      HEAPU8[p + bytes.length] = 0;
+      HEAP32[(req + 12) >> 2] = p;
+      HEAP32[(req + 16) >> 2] = bytes.length;
+      _js_done(req);
+    };
+    let op, rest, realm;
+    try {
+      views();
+      op = HEAP32[req >> 2];
+      const dp = HEAPU32[(req + 4) >> 2], dl = HEAP32[(req + 8) >> 2];
+      const bytes = HEAPU8.slice(dp, dp + dl);
+      const r = new local.Reader(bytes);
+      const pageIds = [];
+      while (r.more() && r.peek() === 'X') {
+        const [rr, ...ids] = dec.decode(r.rec().d).split('\t');
+        if (rr === LOCAL) for (const id of ids) local.release(Number(id));
+        else if (rr === 'page') pageIds.push(...ids.map(Number));
+      }
+      if (pageIds.length) toPage({ type: 'release', ids: pageIds });
+      rest = bytes.slice(r.p);
+      realm = realmOf(op, new local.Reader(rest));
+    } catch (e) { finish(local.errorText('Error: ' + (e && e.message || e))); return; }
+
+    if (!granted(realm) && op !== 17) { finish(local.errorText('Error: ' + refusal(realm))); return; }
+    if (realm === LOCAL) {
+      let out;
+      serving.push(req);
+      try { out = local.handle(op, rest); } finally { serving.pop(); }
+      if (out instanceof Uint8Array) finish(out);
+      else if (_js_request_awaited(req)) finish(local.errorText(WAITED + 'a Promise now'));
+      else out.then(finish);
+      return;
+    }
+    // the page
+    if (_js_request_awaited(req)) { finish(local.errorText(WAITED + 'the page')); return; }
+    const id = ++pageSeq;
+    pageWaiting.set(id, finish);
+    if (!toPage({ type: 'call', id, op, bytes: rest }, [rest.buffer])) {
+      pageWaiting.delete(id);
+      finish(local.errorText('Error: the page realm is not reachable'));
+    }
+  };
+})();
