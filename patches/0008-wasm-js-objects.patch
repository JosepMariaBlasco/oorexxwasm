+/*----------------------------------------------------------------------------*/
+/*
+ * ooRexx/WASM: the native side of the JavaScript bridge, the package "js"
+ * (::REQUIRES "js" LIBRARY, see wasm/web/js.cls).  A .JSObject stands for one
+ * JavaScript object of a realm (the runtime's Web Worker in the browser,
+ * Node's main thread under Node); its methods are native and pass each
+ * operation, synchronously, to the main runtime thread, where
+ * wasm/js-bridge.js does it (the interpreter runs on a pthread, the realm
+ * thread never blocks; JavaScript may finish the call later, as for ~await).
+ *
+ * Request and reply are sequences of records "<tag><length>:<bytes>".
+ * Values, both ways:
+ *   S string (UTF-8)    N null (.nil)    U undefined (.js~undefined; to
+ *   JavaScript, also an omitted argument)
+ *   O "realm<tab>id"  (to JavaScript) / "realm<tab>id<tab>display" (back)
+ *   A count + values (an Array)    T count + (K key, value) (a plain object)
+ *   F number   B boolean ("1"/"0")   I bigint   Y bytes (Uint8Array)
+ *   H "id<tab>options"  (to JavaScript) a .JSHandler: that realm's function
+ *                       for it (see Handlers below)
+ *   V "name"            (to JavaScript) a global by name, as a script sees it
+ *   P "id"              (back) an instance of a Rexx class extending a
+ *                       JavaScript class: the Rexx object itself (pinned)
+ *   R "id<tab>string"   (to JavaScript) any other Rexx object (not a string,
+ *                       Array, Directory, StringTable): a RexxProxy there,
+ *                       for the pinned object id (see Proxies below)
+ *   R "id"              (back) such a proxy: the Rexx object itself
+ * A request starts with any number of X "realm<tab>id..." records (handles
+ * whose .JSObject was garbage collected), then the operands of the op.
+ * The reply is R + a value, or E + message + the thrown value.
+ *
+ * Transport: a request goes into a queue here (queued) and the main runtime
+ * thread is told (kickMain); it takes the queue's requests in a microtask
+ * (Module.jsDrain), outside Emscripten's proxying queue, which is not
+ * reentrant: while that thread waits for a synchronous handler (below) it
+ * keeps taking both this queue and Emscripten's (the pthreads' system
+ * calls).  The requesting thread waits on its request's state.
+ *
+ * Handlers: a .JSHandler without option queued is synchronous in the local
+ * realm (the Web Worker, Node), as .net~handler: its function runs the Rexx
+ * method at once (js_sync_call).  Called while JavaScript does a request of a
+ * Rexx thread (a comparator for sort, forEach, dispatchEvent), it runs on
+ * that thread (so its guards are its own) and JavaScript waits for its result;
+ * a condition is thrown as a RexxError.  That thread cannot wait for
+ * JavaScript in turn while JavaScript waits for it (a Promise, the page):
+ * such a request is an error.  Called by JavaScript on its own (a timer, a
+ * Node server, a Promise settling), it runs on the server thread, attached to
+ * the interpreter for the call, and JavaScript does not wait (it gets
+ * undefined): the realm's thread must stay free, as what finishes later
+ * (sockets, the RexxAPI daemon under Node, the page) needs its event loop; a
+ * condition there is reported on the standard error.  In the page every
+ * handler is queued: the page's thread cannot wait.
+ *
+ * Proxies: a Rexx object that is not converted goes to JavaScript as a
+ * RexxProxy (js-realm.js): pinned here, one id per object, counted once each
+ * time it goes; JavaScript gives the counts back (an event Z "id<tab>n")
+ * when it collects the proxy, and at zero the object is unpinned.  Its
+ * methods are synchronous calls, as handlers' (M "id<tab>NAME" + U + the
+ * scope or U + A).
+ *
+ * Classes (.js~extend): the overrides of a JavaScript class extending another
+ * call the Rexx object's method as a synchronous handler calls its message
+ * (records M "id<tab>NAME" + S/U + A).  The Rexx object of an instance (made
+ * by .MyClass~new, JsConstruct) is pinned, as a handler, until .js~detach.
+ *
+ * Events: a queued handler's function, called by JavaScript in its realm, returns at
+ * once and hands js_event() (on the main runtime thread; from the page by
+ * postMessage) the records H "id" + A (its arguments).  They wait in a queue
+ * until a Rexx thread takes them (.js~nextEvent, .js~eventLoop) and sends the
+ * handler's message; with option latest ("id<tab>L") a new event replaces the
+ * handler's event still waiting, if any (mousemove, scroll, resize), and
+ * with option max n ("id<tab>Mn") the handler's oldest waiting event is
+ * dropped when n are already waiting.  A handler stays pinned (reachable from here) from the
+ * first time it goes to JavaScript until its ~release or the end of the run.
+ *
+ * Calls from the page: the page cannot wait, so its calls of Rexx (a
+ * RexxProxy's methods, the session of ooRexx.js's start()) are queued as
+ * events, C "call id" + the call's records (M "id<tab>NAME" + U + scope + A),
+ * and the Rexx thread that takes events runs them in turn, as the page's
+ * handlers' events (JsNextEvent does it and goes on waiting); the result (R/E
+ * records) goes back to the page, which settles the call's Promise.
+ */
+
+#include <emscripten.h>
+#include <emscripten/proxying.h>
+#include <emscripten/threading.h>
+#include <oorexxapi.h>
+#include <chrono>
+#include <cstdio>
+#include <climits>
+#include <cmath>
+#include <pthread.h>
+#include <thread>
+#include <condition_variable>
+#include <deque>
+#include <map>
+#include <mutex>
+#include <stdlib.h>
+#include <string.h>
+#include <string>
+#include <vector>
+
+extern "C"
+{
+
+// Shared with wasm/js-bridge.js (byte offsets in comments).
+typedef struct
+{
+    int32_t     op;         //  0: see JsOp
+    const char *data;       //  4: the request records
+    int32_t     dataLen;    //  8: their length in bytes
+    char       *reply;      // 12: set by JavaScript: malloc'ed reply
+    int32_t     replyLen;   // 16: its length in bytes
+    int32_t     state;      // 20: REQ_WAITING, REQ_REPLIED (js_done), REQ_CALLBACK (js_sync_call)
+    int32_t     thread;     // 24: the requesting thread
+    void       *sync;       // 28: the SyncCall when REQ_CALLBACK
+} JsRequest;
+
+enum { REQ_WAITING = 0, REQ_REPLIED = 1, REQ_CALLBACK = 2, REQ_CALLS = 3 };   // REQ_CALLS: calls from the page wait
+
+// the main runtime thread takes the queued requests in a microtask
+EM_JS(void, js_schedule_drain, (void), {
+    queueMicrotask(() => Module['jsDrain']());
+});
+// ... or now, while it waits for a synchronous handler
+EM_JS(void, js_drain_now, (void), {
+    Module['jsDrain']();
+});
+
+// the default realm of this process, decided on the calling thread
+EM_JS(int, js_is_node, (void), {
+    return (typeof process !== 'undefined' && process.versions && process.versions.node) ? 1 : 0;
+});
+
+EMSCRIPTEN_KEEPALIVE void *js_alloc(int n)                 { return malloc(n); }
+EMSCRIPTEN_KEEPALIVE void  js_free(void *p)               { free(p); }
+
+// the reply is in place (JavaScript, on the main runtime thread)
+EMSCRIPTEN_KEEPALIVE void js_done(JsRequest *req)
+{
+    __atomic_store_n(&req->state, REQ_REPLIED, __ATOMIC_SEQ_CST);
+    emscripten_futex_wake(&req->state, INT_MAX);
+}
+
+void js_event(char *data, int len);
+
+static void kickMain(void *)
+{
+    js_schedule_drain();
+}
+
+} // extern "C"
+
+enum JsOp
+{
+    OP_GLOBAL = 1,      // realm                       -> its globalThis
+    OP_MESSAGE = 2,     // target, NAME, args          -> the Rexx message NAME
+    OP_GET = 3,         // target, name                -> target[name]
+    OP_SET = 4,         // target, name, value         -> target[name] = value
+    OP_SETMESSAGE = 5,  // target, NAME, value         -> the Rexx message NAME=
+    OP_CALL = 6,        // target, name, args          -> target[name](...args), or target(...args)
+    OP_NEW = 7,         // target, args                -> new target(...args)
+    OP_AWAIT = 8,       // target                      -> the settled value
+    OP_INFO = 9,        // target, what, arg           -> typeof, class, keys, ...
+    OP_REQUIRE = 10,    // name                        -> require(name) (Node)
+    OP_IMPORT = 11,     // name                        -> import(name), a Promise
+    OP_VALUE = 12,      // value                       -> the value as JavaScript has it
+    OP_EXTEND = 13,     // base, class name, NAMES, names -> [new class, its overrides]
+    OP_CONSTRUCT = 14,  // class, peer id, args        -> "realm<tab>id<tab>display"
+    OP_SUPER = 15,      // target, class, kind, name, args -> the base's member
+    OP_DETACH = 16,     // target                      -> the peer id it had ("" if none)
+    OP_SESSION = 17,    // value                       -> (page) ooRexx.js's start() gets its session
+};
+
+// ---- records ----------------------------------------------------------------
+
+struct Rec { char tag; std::string data; };
+
+static bool nextRec(const std::string &s, size_t &pos, Rec &rec)
+{
+    if (pos >= s.size()) return false;
+    rec.tag = s[pos++];
+    size_t colon = s.find(':', pos);
+    if (colon == std::string::npos) { pos = s.size(); return false; }
+    size_t len = strtoul(s.substr(pos, colon - pos).c_str(), NULL, 10);
+    rec.data = s.substr(colon + 1, len);
+    pos = colon + 1 + len;
+    return true;
+}
+
+static void putRec(std::string &s, char tag, const std::string &data)
+{
+    s += tag;
+    s += std::to_string(data.size());
+    s += ':';
+    s += data;
+}
+
+// ---- transport and synchronous handlers -------------------------------------
+
+static std::mutex queueLock;
+static std::deque<JsRequest *> queued;              // requests for the main runtime thread
+
+extern "C" EMSCRIPTEN_KEEPALIVE JsRequest *js_next_request(void)
+{
+    std::lock_guard<std::mutex> lock(queueLock);
+    if (queued.empty()) return NULL;
+    JsRequest *req = queued.front();
+    queued.pop_front();
+    return req;
+}
+
+static int32_t selfId() { return (int32_t)(intptr_t)pthread_self(); }
+
+// one call of a synchronous handler: H + A records, then R/E records back
+struct SyncCall
+{
+    std::string call;
+    std::string answer;
+    int32_t state = 0;                              // 1: answered
+};
+
+static std::string runCallback(RexxThreadContext *c, const std::string &call);
+
+// the requests whose threads wait now (js_event wakes them for the page's
+// calls), and how many of those calls are queued
+static std::mutex waitersLock;
+static std::vector<JsRequest *> waiters;
+static int32_t queuedCalls = 0;
+static bool runQueuedCall(RexxThreadContext *c);
+
+static void answered(SyncCall *sc)
+{
+    __atomic_store_n(&sc->state, 1, __ATOMIC_SEQ_CST);
+    emscripten_futex_wake(&sc->state, INT_MAX);
+}
+
+// pass a request to the main runtime thread and wait for the reply, running
+// the synchronous handlers JavaScript calls meanwhile
+static std::string jsCall(RexxThreadContext *c, int op, const std::string &data)
+{
+    JsRequest req = {};
+    req.op = op;
+    req.data = data.data();
+    req.dataLen = (int32_t)data.size();
+    req.thread = selfId();
+    {
+        std::lock_guard<std::mutex> lock(queueLock);
+        queued.push_back(&req);
+    }
+    if (!emscripten_proxy_async(emscripten_proxy_get_system_queue(),
+                                emscripten_main_runtime_thread_id(), kickMain, NULL))
+    {
+        {
+            std::lock_guard<std::mutex> lock(queueLock);
+            for (auto it = queued.begin(); it != queued.end(); ++it) if (*it == &req) { queued.erase(it); break; }
+        }
+        std::string r;
+        putRec(r, 'E', "the JavaScript realm is not reachable");
+        putRec(r, 'N', "");
+        return r;
+    }
+    // while it waits, the thread runs the page's calls that come (the page
+    // cannot wait: what it called may be what this request waits for)
+    {
+        std::lock_guard<std::mutex> lock(waitersLock);
+        waiters.push_back(&req);
+    }
+    for (;;)
+    {
+        int32_t s = __atomic_load_n(&req.state, __ATOMIC_SEQ_CST);
+        if (s == REQ_REPLIED) break;
+        if (s == REQ_CALLBACK)
+        {
+            SyncCall *sc = (SyncCall *)req.sync;
+            sc->answer = runCallback(c, sc->call);
+            __atomic_store_n(&req.state, REQ_WAITING, __ATOMIC_SEQ_CST);
+            answered(sc);
+            continue;
+        }
+        if (s == REQ_CALLS)
+        {
+            int32_t expected = REQ_CALLS;
+            __atomic_compare_exchange_n(&req.state, &expected, REQ_WAITING, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+            continue;
+        }
+        if (__atomic_load_n(&queuedCalls, __ATOMIC_SEQ_CST) > 0 && runQueuedCall(c)) continue;
+        emscripten_futex_wait(&req.state, s, INFINITY);
+    }
+    {
+        std::lock_guard<std::mutex> lock(waitersLock);
+        for (auto it = waiters.begin(); it != waiters.end(); ++it) if (*it == &req) { waiters.erase(it); break; }
+    }
+    std::string r(req.reply ? req.reply : "", req.replyLen);
+    free(req.reply);
+    return r;
+}
+
+
+static RexxObjectPtr jsObjectClass = NULLOBJECT;    // .JSObject, see JsSetup()
+static RexxObjectPtr jsTypedClass = NULLOBJECT;     // .JSTyped: .js~num(x) and friends
+static RexxObjectPtr jsUndefined = NULLOBJECT;      // .js~undefined, the one object
+static RexxObjectPtr jsHandlerClass = NULLOBJECT;   // .JSHandler: .js~handler(obj, msg)
+static RexxObjectPtr jsEventClass = NULLOBJECT;     // .JSEvent: what .js~nextEvent gives
+
+// ---- events -------------------------------------------------------------------
+
+static std::mutex eventLock;                        // guards everything below
+static std::condition_variable eventCond;
+static std::deque<std::string> events;              // H id + A args, as JavaScript sent them
+static std::map<size_t, RexxObjectPtr> pinned;      // handler id -> its .JSHandler (a global reference)
+static size_t lastHandlerId = 0;
+static size_t stopGeneration = 0;                   // .js~stopEventLoop ends the loops started before
+
+static void dropEvent(const std::string &ev);
+
+// Rexx objects given to JavaScript as proxies: their ids (also in pinned) and
+// how many times each went without coming back (guarded by eventLock)
+static std::map<RexxObjectPtr, size_t> proxyIds;
+static std::map<size_t, size_t> proxyCounts;
+static std::vector<RexxObjectPtr> unpinned;         // global references to release, with a context
+
+static int32_t serverThread = 0;                    // the server thread, once started (serverSetup)
+static void serverSetup(RexxThreadContext *c);
+
+static void releaseUnpinned(RexxThreadContext *c)
+{
+    std::vector<RexxObjectPtr> gone;
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        if (unpinned.empty()) return;
+        gone.swap(unpinned);
+    }
+    for (RexxObjectPtr o : gone) c->ReleaseGlobalReference(o);
+}
+
+// Z "id<tab>n": JavaScript collected a proxy that came over n times
+static void proxyRelease(const std::string &spec)
+{
+    size_t id = strtoul(spec.c_str(), NULL, 10);
+    size_t t = spec.find('\t');
+    size_t n = t == std::string::npos ? 0 : strtoul(spec.c_str() + t + 1, NULL, 10);
+    std::lock_guard<std::mutex> lock(eventLock);
+    auto it = proxyCounts.find(id);
+    if (it == proxyCounts.end()) return;
+    it->second = it->second > n ? it->second - n : 0;
+    if (it->second > 0) return;
+    proxyCounts.erase(it);
+    auto p = pinned.find(id);
+    if (p == pinned.end()) return;
+    proxyIds.erase(p->second);
+    unpinned.push_back(p->second);
+    pinned.erase(p);
+}
+
+// the handler id of an event, whether it has option latest ("id<tab>L"),
+// and its option max n ("id<tab>Mn", 0 when none)
+static size_t eventHandler(const std::string &ev, bool *latest = NULL, size_t *max = NULL)
+{
+    if (ev.empty() || ev[0] != 'H') return 0;
+    size_t colon = ev.find(':'), len = strtoul(ev.c_str() + 1, NULL, 10);
+    std::string d = ev.substr(colon + 1, len);
+    if (latest) *latest = d.size() > 2 && d.compare(d.size() - 2, 2, "\tL") == 0;
+    if (max)
+    {
+        size_t t = d.find("\tM");
+        *max = t == std::string::npos ? 0 : strtoul(d.c_str() + t + 2, NULL, 10);
+    }
+    return strtoul(d.c_str(), NULL, 10);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void js_event(char *data, int len)
+{
+    std::string ev(data, len), old;
+    free(data);
+    if (!ev.empty() && ev[0] == 'Z')                // a proxy collected, not an event
+    {
+        size_t pos = 0;
+        Rec r;
+        if (nextRec(ev, pos, r)) proxyRelease(r.data);
+        return;
+    }
+    if (!ev.empty() && ev[0] == 'C')                // a call from the page: queued as is
+    {
+        {
+            std::lock_guard<std::mutex> lock(eventLock);
+            events.push_back(std::move(ev));
+            __atomic_add_fetch(&queuedCalls, 1, __ATOMIC_SEQ_CST);
+        }
+        eventCond.notify_all();
+        std::lock_guard<std::mutex> lock(waitersLock);   // and the threads waiting for JavaScript
+        for (JsRequest *w : waiters)
+        {
+            int32_t expected = REQ_WAITING;
+            if (__atomic_compare_exchange_n(&w->state, &expected, REQ_CALLS, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+            {
+                emscripten_futex_wake(&w->state, INT_MAX);
+            }
+        }
+        return;
+    }
+    bool latest = false;
+    size_t max = 0;
+    size_t id = eventHandler(ev, &latest, &max);
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        bool replaced = false;
+        if (pinned.find(id) == pinned.end())    // released: nobody will take it
+        {
+            old.swap(ev);
+            replaced = true;
+        }
+        else if (latest)       // option latest: one waiting event per handler, the newest
+        {
+            for (std::string &q : events)
+            {
+                if (eventHandler(q) == id) { old.swap(q); q = std::move(ev); replaced = true; break; }
+            }
+        }
+        else if (max > 0)      // option max n: drop the handler's oldest when n wait
+        {
+            size_t waiting = 0;
+            for (const std::string &q : events) if (eventHandler(q) == id) waiting++;
+            if (waiting >= max)
+            {
+                for (auto it = events.begin(); it != events.end(); ++it)
+                {
+                    if (eventHandler(*it) == id) { old.swap(*it); events.erase(it); break; }
+                }
+            }
+        }
+        if (!replaced) events.push_back(std::move(ev));
+    }
+    if (!old.empty()) dropEvent(old);
+    eventCond.notify_all();
+}
+
+// handles whose .JSObject went away (UNINIT), released with the next request
+static std::mutex releaseLock;
+static std::vector<std::string> released;
+
+static std::string newRequest()
+{
+    std::string s;
+    std::lock_guard<std::mutex> lock(releaseLock);
+    for (const std::string &r : released) putRec(s, 'X', r);
+    released.clear();
+    return s;
+}
+
+// build the Rexx object for the value record at pos
+static RexxObjectPtr toRexx(RexxThreadContext *c, const std::string &s, size_t &pos)
+{
+    Rec r;
+    if (!nextRec(s, pos, r)) return c->Nil();
+    switch (r.tag)
+    {
+        case 'S': return c->String(r.data.data(), r.data.size());
+        case 'U': return jsUndefined != NULLOBJECT ? jsUndefined : c->Nil();
+        case 'O':
+        {
+            size_t t1 = r.data.find('\t'), t2 = r.data.find('\t', t1 + 1);
+            if (jsObjectClass == NULLOBJECT || t1 == std::string::npos || t2 == std::string::npos)
+            {
+                return c->String(r.data.c_str());
+            }
+            RexxArrayObject args = c->ArrayOfThree(c->String(r.data.substr(0, t1).c_str()),
+                                                   c->String(r.data.substr(t1 + 1, t2 - t1 - 1).c_str()),
+                                                   c->String(r.data.substr(t2 + 1).c_str()));
+            return c->SendMessage(jsObjectClass, "NEW", args);
+        }
+        case 'R':                                   // a RexxProxy: its Rexx object
+        case 'P':                                   // an extending class's instance: its Rexx object
+        {
+            std::lock_guard<std::mutex> lock(eventLock);
+            auto it = pinned.find(strtoul(r.data.c_str(), NULL, 10));
+            return it != pinned.end() ? it->second : c->Nil();
+        }
+        case 'A':
+        {
+            size_t n = strtoul(r.data.c_str(), NULL, 10);
+            RexxArrayObject a = c->NewArray(n);
+            for (size_t i = 1; i <= n; i++) c->ArrayPut(a, toRexx(c, s, pos), i);
+            return a;
+        }
+        default: return c->Nil();
+    }
+}
+
+static bool isA(RexxThreadContext *c, RexxObjectPtr v, RexxObjectPtr cls)
+{
+    return cls != NULLOBJECT && c->IsInstanceOf(v, (RexxClassObject)cls);
+}
+
+// encode a Rexx value for JavaScript
+static void fromRexx(RexxThreadContext *c, std::string &out, RexxObjectPtr v, int depth = 0)
+{
+    if (v == NULLOBJECT) { putRec(out, 'U', ""); return; }
+    if (v == c->Nil()) { putRec(out, 'N', ""); return; }
+    if (depth > 64) { putRec(out, 'N', ""); return; }        // a cycle: cut it
+    if (isA(c, v, jsObjectClass))
+    {
+        putRec(out, 'O', c->ObjectToStringValue(c->SendMessage0(v, "JSREF")));
+        return;
+    }
+    if (isA(c, v, jsHandlerClass))
+    {
+        size_t id = 0;
+        c->ObjectToStringSize(c->SendMessage0(v, "ID"), &id);
+        std::string options = c->ObjectToStringValue(c->SendMessage0(v, "OPTIONS"));
+        {
+            std::lock_guard<std::mutex> lock(eventLock);
+            if (pinned.find(id) == pinned.end()) pinned[id] = c->RequestGlobalReference(v);
+        }
+        putRec(out, 'H', std::to_string(id) + "\t" + options);
+        return;
+    }
+    if (isA(c, v, jsTypedClass))
+    {
+        std::string kind = c->ObjectToStringValue(c->SendMessage0(v, "KIND"));
+        RexxObjectPtr val = c->SendMessage0(v, "VALUE");
+        std::string data = val == NULLOBJECT || val == c->Nil() ? "" : c->ObjectToStringValue(val);
+        putRec(out, kind.empty() ? 'U' : kind[0], data);
+        return;
+    }
+    if (c->IsArray(v))
+    {
+        size_t size = c->ArraySize((RexxArrayObject)v);
+        putRec(out, 'A', std::to_string(size));
+        for (size_t i = 1; i <= size; i++) fromRexx(c, out, c->ArrayAt((RexxArrayObject)v, i), depth + 1);
+        return;
+    }
+    if (c->IsDirectory(v) || c->IsStringTable(v))
+    {
+        RexxArrayObject keys = (RexxArrayObject)c->SendMessage0(v, "ALLINDEXES");
+        size_t n = c->ArrayItems(keys);
+        putRec(out, 'T', std::to_string(n));
+        for (size_t i = 1; i <= n; i++)
+        {
+            RexxObjectPtr k = c->ArrayAt(keys, i);
+            putRec(out, 'K', c->ObjectToStringValue(k));
+            fromRexx(c, out, c->SendMessage1(v, "AT", k), depth + 1);
+        }
+        return;
+    }
+    if (c->IsString(v))
+    {
+        RexxStringObject str = (RexxStringObject)v;
+        putRec(out, 'S', std::string(c->StringData(str), c->StringLength(str)));
+        return;
+    }
+    // a number is a String too (an internal integer or number object)
+    static RexxObjectPtr stringClass = NULLOBJECT;
+    if (stringClass == NULLOBJECT) stringClass = c->RequestGlobalReference(c->FindClass("STRING"));
+    if (c->IsInstanceOf(v, (RexxClassObject)stringClass))
+    {
+        putRec(out, 'S', c->ObjectToStringValue(v));
+        return;
+    }
+    // any other object: a RexxProxy, with its string as it is now
+    if (__atomic_load_n(&serverThread, __ATOMIC_SEQ_CST) == 0) serverSetup(c);
+    std::string str = c->ObjectToStringValue(v);
+    if (c->CheckCondition()) c->ClearCondition();
+    size_t id;
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        auto it = proxyIds.find(v);
+        if (it != proxyIds.end()) id = it->second;
+        else
+        {
+            id = ++lastHandlerId;
+            RexxObjectPtr g = c->RequestGlobalReference(v);
+            pinned[id] = g;
+            proxyIds[g] = id;
+        }
+        proxyCounts[id]++;
+    }
+    putRec(out, 'R', std::to_string(id) + "\t" + str);
+}
+
+// the result of a reply: its value, or a raised SYNTAX 98.900 condition
+static RexxObjectPtr result(RexxThreadContext *c, const std::string &reply)
+{
+    size_t pos = 0;
+    Rec r;
+    if (!nextRec(reply, pos, r)) return c->Nil();
+    if (r.tag == 'R') return toRexx(c, reply, pos);
+    // E: the message, then the thrown value (a .JSObject for an Error)
+    std::string msg = "JavaScript error: " + r.data;
+    RexxObjectPtr thrown = toRexx(c, reply, pos);
+    c->RaiseException(Rexx_Error_Execution_user_defined, c->ArrayOfTwo(c->String(msg.c_str()), thrown));
+    return NULLOBJECT;
+}
+
+static RexxObjectPtr request(RexxThreadContext *c, int op, const std::string &data)
+{
+    releaseUnpinned(c);
+    return result(c, jsCall(c, op, data));
+}
+
+// a synchronous handler's call, on a Rexx thread: the R/E records of its result
+static std::string runCallback(RexxThreadContext *c, const std::string &call)
+{
+    std::string out;
+    size_t pos = 0;
+    Rec r;
+    RexxObjectPtr handler = NULLOBJECT;
+    releaseUnpinned(c);
+    // H "id": a handler; M "id<tab>NAME": an override, method NAME of the
+    // Rexx object id (an instance of a class extending a JavaScript class),
+    // then S "realm<tab>id<tab>display" the first time (its JavaScript object,
+    // when a base constructor calls an override before the Rexx side knows it)
+    bool override = false;
+    std::string message;
+    if (nextRec(call, pos, r) && (r.tag == 'H' || r.tag == 'M'))
+    {
+        override = r.tag == 'M';
+        if (override)
+        {
+            size_t t = r.data.find('\t');
+            message = t == std::string::npos ? "" : r.data.substr(t + 1);
+        }
+        std::lock_guard<std::mutex> lock(eventLock);
+        auto it = pinned.find(strtoul(r.data.c_str(), NULL, 10));
+        if (it != pinned.end()) handler = it->second;
+    }
+    if (override && nextRec(call, pos, r) && r.tag == 'S' && handler != NULLOBJECT)
+    {
+        c->SendMessage1(handler, "JSBIND", c->String(r.data.c_str()));
+    }
+    if (handler == NULLOBJECT)                      // released meanwhile: undefined
+    {
+        putRec(out, 'R', "");
+        putRec(out, 'U', "");
+        return out;
+    }
+    RexxObjectPtr scope = override ? toRexx(c, call, pos) : NULLOBJECT;
+    if (scope == jsUndefined || scope == c->Nil()) scope = NULLOBJECT;
+    RexxArrayObject args = (RexxArrayObject)toRexx(c, call, pos);
+    RexxObjectPtr target = handler;
+    if (!override)
+    {
+        target = c->SendMessage0(handler, "TARGET");
+        message = c->ObjectToStringValue(c->SendMessage0(handler, "MESSAGE"));
+    }
+    if (scope != NULLOBJECT && !c->IsInstanceOf(scope, c->FindClass("CLASS")))
+    {
+        putRec(out, 'E', "Error 98.900: sendMessageScope: the scope must be a Rexx class");
+        putRec(out, 'N', "");
+        return out;
+    }
+    RexxObjectPtr value = scope != NULLOBJECT
+        ? c->SendMessageScoped(target, message.c_str(), (RexxClassObject)scope, args)
+        : c->SendMessage(target, message.c_str(), args);
+    if (c->CheckCondition())
+    {
+        RexxDirectoryObject cond = c->GetConditionInfo();
+        RexxCondition info = {};
+        c->DecodeConditionInfo(cond, &info);
+        std::string name = info.conditionName ? c->CString(info.conditionName) : "a condition";
+        std::string msg;
+        if (name == "SYNTAX")
+        {
+            msg = "Error " + std::to_string(info.code / 1000) + "." + std::to_string(info.code % 1000) + ": ";
+            msg += info.errortext ? c->CString(info.errortext) : "";
+            std::string detail = info.message ? c->CString(info.message) : "";
+            if (!detail.empty()) msg += " (" + detail + ")";
+        }
+        else msg = "condition " + name + " raised in " + message;
+        c->ClearCondition();
+        putRec(out, 'E', msg);
+        putRec(out, 'N', "");
+        return out;
+    }
+    putRec(out, 'R', "");
+    fromRexx(c, out, value);
+    return out;
+}
+
+// the server thread: the calls of synchronous handlers made by JavaScript on
+// its own (a timer, a Node server), one at a time, each attached to the
+// interpreter for the call
+static RexxInstance *jsInstance = NULL;
+static std::mutex serverLock;
+static std::condition_variable serverCond;
+static std::deque<SyncCall *> serverQueue;
+
+static void *serverMain(void *)
+{
+    __atomic_store_n(&serverThread, selfId(), __ATOMIC_SEQ_CST);
+    emscripten_futex_wake(&serverThread, INT_MAX);
+    for (;;)
+    {
+        SyncCall *sc;
+        {
+            std::unique_lock<std::mutex> lock(serverLock);
+            serverCond.wait(lock, [] { return !serverQueue.empty(); });
+            sc = serverQueue.front();
+            serverQueue.pop_front();
+        }
+        RexxThreadContext *tc = NULL;
+        if (jsInstance != NULL && jsInstance->AttachThread(&tc))
+        {
+            std::string answer = runCallback(tc, sc->call);
+            tc->DetachThread();
+            if (!answer.empty() && answer[0] == 'E')        // nobody to throw it to
+            {
+                size_t pos = 0;
+                Rec r;
+                nextRec(answer, pos, r);
+                fprintf(stderr, "Error in a JavaScript handler: %s\n", r.data.c_str());
+            }
+        }
+        delete sc;
+    }
+    return NULL;
+}
+
+// the threads the main runtime thread is waiting for (a stack: calls nest)
+static std::vector<int32_t> awaited;
+
+// a request of a thread JavaScript waits for cannot wait for JavaScript
+extern "C" EMSCRIPTEN_KEEPALIVE int js_request_awaited(JsRequest *req)
+{
+    for (int32_t t : awaited) if (t == req->thread) return 1;
+    return 0;
+}
+
+// a malloc'ed copy of a reply
+static char *replyCopy(const std::string &answer, int32_t *outLen)
+{
+    char *out = (char *)malloc(answer.size() + 1);
+    memcpy(out, answer.data(), answer.size());
+    out[answer.size()] = 0;
+    *outLen = (int32_t)answer.size();
+    return out;
+}
+
+// a synchronous handler called (on the main runtime thread): run it on the
+// Rexx thread whose request is being done (req) and wait, doing the requests
+// that come meanwhile; or hand it to the server thread and go on (undefined);
+// a malloc'ed R/E reply
+extern "C" EMSCRIPTEN_KEEPALIVE char *js_sync_call(JsRequest *req, const char *data, int len, int32_t *outLen)
+{
+    std::string undefinedReply;
+    putRec(undefinedReply, 'R', "");
+    putRec(undefinedReply, 'U', "");
+    if (req == NULL)
+    {
+        if (__atomic_load_n(&serverThread, __ATOMIC_SEQ_CST) != 0)
+        {
+            SyncCall *call = new SyncCall;
+            call->call.assign(data, len);
+            {
+                std::lock_guard<std::mutex> lock(serverLock);
+                serverQueue.push_back(call);
+            }
+            serverCond.notify_one();
+        }
+        return replyCopy(undefinedReply, outLen);
+    }
+    SyncCall sc;
+    sc.call.assign(data, len);
+    int32_t who = req->thread;
+    req->sync = &sc;
+    __atomic_store_n(&req->state, REQ_CALLBACK, __ATOMIC_SEQ_CST);
+    emscripten_futex_wake(&req->state, INT_MAX);
+    awaited.push_back(who);
+    while (__atomic_load_n(&sc.state, __ATOMIC_SEQ_CST) == 0)
+    {
+        js_drain_now();
+        emscripten_proxy_execute_queue(emscripten_proxy_get_system_queue());
+        emscripten_futex_wait(&sc.state, 0, 1.0);
+    }
+    awaited.pop_back();
+    return replyCopy(sc.answer, outLen);
+}
+
+// the target record of a method: this .JSObject
+static void target(RexxMethodContext *context, std::string &out)
+{
+    RexxObjectPtr ref = context->GetObjectVariable("JSREF");
+    putRec(out, 'O', ref == NULLOBJECT ? "" : context->ObjectToStringValue(ref));
+}
+
+static void args(RexxThreadContext *c, std::string &out, RexxArrayObject list, size_t from)
+{
+    size_t size = list == NULLOBJECT ? 0 : c->ArraySize(list);
+    size_t n = size >= from ? size - from + 1 : 0;
+    putRec(out, 'A', std::to_string(n));
+    for (size_t i = from; i <= size; i++) fromRexx(c, out, c->ArrayAt(list, i));
+}
+
+
+// ---- .JSObject's methods -------------------------------------------------------
+
+// UNKNOWN: o~name, o~name(args), o~name = value
+RexxMethod2(RexxObjectPtr, js_unknown, CSTRING, name, RexxArrayObject, list)
+{
+    RexxThreadContext *c = context->threadContext;
+    std::string n(name), s = newRequest();
+    target(context, s);
+    if (n.size() > 1 && n.back() == '=')
+    {
+        putRec(s, 'S', n.substr(0, n.size() - 1));
+        fromRexx(c, s, c->ArraySize(list) >= 1 ? c->ArrayAt(list, 1) : NULLOBJECT);
+        request(c, OP_SETMESSAGE, s);
+        return NULLOBJECT;
+    }
+    putRec(s, 'S', n);
+    args(c, s, list, 1);
+    return request(c, OP_MESSAGE, s);
+}
+
+// [](name): the property, case-exact
+RexxMethod1(RexxObjectPtr, js_get, RexxObjectPtr, name)
+{
+    std::string s = newRequest();
+    target(context, s);
+    putRec(s, 'S', context->ObjectToStringValue(name));
+    return request(context->threadContext, OP_GET, s);
+}
+
+// []=(value, name): set the property, case-exact (created if need be)
+RexxMethod2(RexxObjectPtr, js_put, OPTIONAL_RexxObjectPtr, value, RexxObjectPtr, name)
+{
+    std::string s = newRequest();
+    target(context, s);
+    putRec(s, 'S', context->ObjectToStringValue(name));
+    fromRexx(context->threadContext, s, value);
+    request(context->threadContext, OP_SET, s);
+    return NULLOBJECT;
+}
+
+// INVOKE(name, args...): call method name, case-exact; INVOKE(.nil, args...): call this function
+RexxMethod1(RexxObjectPtr, js_call, ARGLIST, list)
+{
+    RexxThreadContext *c = context->threadContext;
+    if (c->ArraySize(list) < 1 || c->ArrayAt(list, 1) == NULLOBJECT)
+    {
+        context->RaiseException1(Rexx_Error_Incorrect_method_minarg, context->WholeNumberToObject(1));
+        return NULLOBJECT;
+    }
+    std::string s = newRequest();
+    target(context, s);
+    RexxObjectPtr name = c->ArrayAt(list, 1);
+    if (name == c->Nil()) putRec(s, 'N', "");
+    else putRec(s, 'S', context->ObjectToStringValue(name));
+    args(c, s, list, 2);
+    return request(c, OP_CALL, s);
+}
+
+// NEW(args...): new this(...args)
+RexxMethod1(RexxObjectPtr, js_new, ARGLIST, list)
+{
+    std::string s = newRequest();
+    target(context, s);
+    args(context->threadContext, s, list, 1);
+    return request(context->threadContext, OP_NEW, s);
+}
+
+// AWAIT: wait for this Promise (or thenable); its value, or its rejection as an error
+RexxMethod0(RexxObjectPtr, js_await)
+{
+    std::string s = newRequest();
+    target(context, s);
+    return request(context->threadContext, OP_AWAIT, s);
+}
+
+// introspection: TYPEOF, CLASSNAME, PROPERTYNAMES, MAKEARRAY, SUPPLIER (its data), BYTESTRING,
+// INSTANCEOF(c), HASPROPERTY(n)
+static RexxObjectPtr info(RexxMethodContext *context, const char *what, RexxObjectPtr arg)
+{
+    std::string s = newRequest();
+    target(context, s);
+    putRec(s, 'S', what);
+    fromRexx(context->threadContext, s, arg);
+    return request(context->threadContext, OP_INFO, s);
+}
+
+RexxMethod0(RexxObjectPtr, js_typeof)    { return info(context, "typeof", NULLOBJECT); }
+RexxMethod0(RexxObjectPtr, js_classname) { return info(context, "class", NULLOBJECT); }
+RexxMethod0(RexxObjectPtr, js_keys)      { return info(context, "keys", NULLOBJECT); }
+RexxMethod0(RexxObjectPtr, js_makearray) { return info(context, "array", NULLOBJECT); }
+RexxMethod0(RexxObjectPtr, js_supplier)  { return info(context, "supplier", NULLOBJECT); }
+RexxMethod0(RexxObjectPtr, js_bytes)     { return info(context, "bytes", NULLOBJECT); }
+RexxMethod1(RexxObjectPtr, js_instanceof, RexxObjectPtr, cls) { return info(context, "instanceof", cls); }
+RexxMethod1(RexxObjectPtr, js_has, RexxObjectPtr, name)       { return info(context, "has", name); }
+
+// UNINIT: the handle can go; released with the next request
+RexxMethod0(RexxObjectPtr, js_uninit)
+{
+    RexxObjectPtr ref = context->GetObjectVariable("JSREF");
+    if (ref != NULLOBJECT)
+    {
+        std::string r = context->ObjectToStringValue(ref);
+        std::lock_guard<std::mutex> lock(releaseLock);
+        released.push_back(r);
+    }
+    return NULLOBJECT;
+}
+
+
+// ---- routines for js.cls ------------------------------------------------------------
+
+// JsSetup(.JSObject, .JSTyped, .JSHandler, .JSEvent, .js~undefined)
+RexxRoutine5(int, JsSetup, RexxObjectPtr, objectClass, RexxObjectPtr, typedClass,
+             RexxObjectPtr, handlerClass, RexxObjectPtr, eventClass, RexxObjectPtr, undefinedValue)
+{
+    jsInstance = context->threadContext->instance;
+    if (jsUndefined == NULLOBJECT) jsUndefined = context->RequestGlobalReference(undefinedValue);
+    if (jsObjectClass == NULLOBJECT) jsObjectClass = context->RequestGlobalReference(objectClass);
+    if (jsTypedClass == NULLOBJECT) jsTypedClass = context->RequestGlobalReference(typedClass);
+    if (jsHandlerClass == NULLOBJECT) jsHandlerClass = context->RequestGlobalReference(handlerClass);
+    if (jsEventClass == NULLOBJECT) jsEventClass = context->RequestGlobalReference(eventClass);
+    return 0;
+}
+
+// ready for JavaScript's own calls of Rexx (the server thread): for
+// synchronous handlers, overrides and proxies
+static void serverSetup(RexxThreadContext *c)
+{
+    static std::once_flag once;
+    jsInstance = c->instance;
+    // the stack of a Rexx thread (std::thread's default, 64 KiB, overflows
+    // silently: WebAssembly has no guard page)
+    std::call_once(once, [] {
+        pthread_attr_t attr;
+        pthread_attr_init(&attr);
+        pthread_attr_setstacksize(&attr, 8 * 1024 * 1024);
+        pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+        pthread_t t;
+        pthread_create(&t, &attr, serverMain, NULL);
+        pthread_attr_destroy(&attr);
+    });
+    while (__atomic_load_n(&serverThread, __ATOMIC_SEQ_CST) == 0) emscripten_futex_wait(&serverThread, 0, 10.0);
+}
+
+// JsSyncSetup(): ready for synchronous handlers
+RexxRoutine0(int, JsSyncSetup)
+{
+    serverSetup(context->threadContext);
+    return 0;
+}
+
+// JsHandlerId(): a new handler id
+RexxRoutine0(size_t, JsHandlerId)
+{
+    std::lock_guard<std::mutex> lock(eventLock);
+    return ++lastHandlerId;
+}
+
+// JsHandlerRelease(id): unpin it; its events still waiting, and those that
+// come later, are dropped (passed to JavaScript again, it starts afresh)
+RexxRoutine1(int, JsHandlerRelease, size_t, id)
+{
+    RexxObjectPtr h = NULLOBJECT;
+    std::vector<std::string> gone;
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        auto it = pinned.find(id);
+        if (it != pinned.end()) { h = it->second; pinned.erase(it); }
+        for (auto q = events.begin(); q != events.end(); )
+        {
+            if (eventHandler(*q) == id) { gone.push_back(std::move(*q)); q = events.erase(q); }
+            else ++q;
+        }
+    }
+    for (const std::string &ev : gone) dropEvent(ev);
+    if (h != NULLOBJECT) context->ReleaseGlobalReference(h);
+    return 0;
+}
+
+// the objects handed over with an event nobody will get: released
+static void dropEvent(const std::string &ev)
+{
+    size_t pos = 0;
+    Rec r;
+    std::lock_guard<std::mutex> lock(releaseLock);
+    while (nextRec(ev, pos, r))
+    {
+        if (r.tag != 'O') continue;
+        size_t t1 = r.data.find('\t'), t2 = r.data.find('\t', t1 + 1);
+        if (t1 != std::string::npos) released.push_back(r.data.substr(0, t2));
+    }
+}
+
+// JsLoopGeneration(): for JsNextEvent's stop check
+RexxRoutine0(size_t, JsLoopGeneration)
+{
+    std::lock_guard<std::mutex> lock(eventLock);
+    return stopGeneration;
+}
+
+// JsStopLoops(): every JsNextEvent waiting with an older generation returns .nil
+RexxRoutine0(int, JsStopLoops)
+{
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        stopGeneration++;
+    }
+    eventCond.notify_all();
+    return 0;
+}
+
+// a call from the page (C "call id" + the call): run it, and its answer goes
+// back for the call's Promise (Module.jsCallReply, on the main runtime thread,
+// copies it and frees it)
+static void pageCall(RexxThreadContext *c, const std::string &ev)
+{
+    size_t pos = 0;
+    Rec r;
+    if (!nextRec(ev, pos, r)) return;
+    double id = strtod(r.data.c_str(), NULL);
+    std::string answer = runCallback(c, ev.substr(pos));
+    int32_t len = 0;
+    char *copy = replyCopy(answer, &len);
+    MAIN_THREAD_ASYNC_EM_ASM({ Module['jsCallReply']($0, $1, $2); }, id, copy, len);
+}
+
+// a thread waiting for JavaScript: the first call from the page queued, run
+// (false: none)
+static bool runQueuedCall(RexxThreadContext *c)
+{
+    std::string ev;
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        for (auto it = events.begin(); it != events.end(); ++it)
+        {
+            if (!it->empty() && (*it)[0] == 'C')
+            {
+                ev = std::move(*it);
+                events.erase(it);
+                __atomic_sub_fetch(&queuedCalls, 1, __ATOMIC_SEQ_CST);
+                break;
+            }
+        }
+    }
+    if (ev.empty()) return false;
+    pageCall(c, ev);
+    return true;
+}
+
+// JsNextEvent([seconds] [, generation]): the next event (a .JSEvent), or .nil
+// when the seconds are over (none: no limit) or, given a generation, when
+// JsStopLoops was called since
+RexxRoutine2(RexxObjectPtr, JsNextEvent, OPTIONAL_double, seconds, OPTIONAL_RexxObjectPtr, gen)
+{
+    size_t generation = 0;
+    bool loop = gen != NULLOBJECT && context->ObjectToStringSize(gen, &generation);
+    bool forever = argumentOmitted(1) || seconds < 0;
+    auto deadline = std::chrono::steady_clock::now() +
+        std::chrono::microseconds(forever ? 0 : (long long)(seconds * 1e6));
+    for (;;)
+    {
+        std::string ev;
+        RexxObjectPtr handler = NULLOBJECT;
+        {
+            std::unique_lock<std::mutex> lock(eventLock);
+            auto ready = [&] { return !events.empty() || (loop && stopGeneration != generation); };
+            if (forever) eventCond.wait(lock, ready);
+            else if (!eventCond.wait_until(lock, deadline, ready)) return context->Nil();
+            if (loop && stopGeneration != generation) return context->Nil();
+            ev = std::move(events.front());
+            events.pop_front();
+            size_t pos = 0;
+            Rec r;
+            if (!ev.empty() && ev[0] == 'C')                            // a call: run below
+            {
+                __atomic_sub_fetch(&queuedCalls, 1, __ATOMIC_SEQ_CST);
+            }
+            else if (nextRec(ev, pos, r) && r.tag == 'H')
+            {
+                auto it = pinned.find(strtoul(r.data.c_str(), NULL, 10));
+                if (it != pinned.end()) handler = it->second;
+            }
+        }
+        if (!ev.empty() && ev[0] == 'C') { pageCall(context->threadContext, ev); continue; }
+        if (handler == NULLOBJECT) { dropEvent(ev); continue; }     // released meanwhile
+        size_t pos = 0;
+        Rec r;
+        nextRec(ev, pos, r);                                       // H
+        RexxObjectPtr args = toRexx(context->threadContext, ev, pos);
+        return context->SendMessage2(jsEventClass, "NEW", handler, args);
+    }
+}
+
+// JsDefaultRealm(): "node" under Node, else "worker"
+RexxRoutine0(RexxObjectPtr, JsDefaultRealm)
+{
+    return context->String(js_is_node() ? "node" : "worker");
+}
+
+// JsGlobal(realm): that realm's globalThis
+RexxRoutine1(RexxObjectPtr, JsGlobal, CSTRING, realm)
+{
+    std::string s = newRequest();
+    putRec(s, 'S', realm);
+    return request(context->threadContext, OP_GLOBAL, s);
+}
+
+// JsRequire(name), JsImport(name): Node's require(); import() (a Promise)
+RexxRoutine1(RexxObjectPtr, JsRequire, CSTRING, name)
+{
+    std::string s = newRequest();
+    putRec(s, 'S', name);
+    return request(context->threadContext, OP_REQUIRE, s);
+}
+
+RexxRoutine1(RexxObjectPtr, JsImport, CSTRING, name)
+{
+    std::string s = newRequest();
+    putRec(s, 'S', name);
+    return request(context->threadContext, OP_IMPORT, s);
+}
+
+// JsValue(value): the value converted to JavaScript (Arrays, Directories,
+// .js~num(...)) and back: a .JSObject for anything that is not a string
+RexxRoutine1(RexxObjectPtr, JsValue, OPTIONAL_RexxObjectPtr, value)
+{
+    std::string s = newRequest();
+    fromRexx(context->threadContext, s, value);
+    return request(context->threadContext, OP_VALUE, s);
+}
+
+// ---- Rexx classes extending JavaScript classes (.js~extend) ---------------------
+
+// JsExtend(base, class name, NAMES, names): base a .JSObject (a class) or the
+// name of a global; NAMES the Rexx class's methods, names the exact JavaScript
+// names to add; an Array [the new class, its overrides]
+RexxRoutine4(RexxObjectPtr, JsExtend, RexxObjectPtr, base, CSTRING, name, RexxArrayObject, rexxNames,
+             RexxArrayObject, exact)
+{
+    RexxThreadContext *c = context->threadContext;
+    std::string s = newRequest();
+    if (isA(c, base, jsObjectClass)) fromRexx(c, s, base);
+    else putRec(s, 'V', c->ObjectToStringValue(base));
+    putRec(s, 'S', name);
+    args(c, s, rexxNames, 1);
+    args(c, s, exact, 1);
+    return request(c, OP_EXTEND, s);
+}
+
+// JsConstruct(object, class, args): new class(...args) for this Rexx object,
+// pinned (its peer) until .js~detach; "realm<tab>id<tab>display"
+RexxRoutine3(RexxObjectPtr, JsConstruct, RexxObjectPtr, self, RexxObjectPtr, ext, RexxArrayObject, list)
+{
+    RexxThreadContext *c = context->threadContext;
+    serverSetup(c);
+    size_t id;
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        id = ++lastHandlerId;
+        pinned[id] = c->RequestGlobalReference(self);
+    }
+    std::string s = newRequest();
+    fromRexx(c, s, ext);
+    putRec(s, 'S', std::to_string(id));
+    args(c, s, list, 1);
+    std::string reply = jsCall(c, OP_CONSTRUCT, s);
+    if (reply.empty() || reply[0] != 'R')           // failed: no peer
+    {
+        RexxObjectPtr h = NULLOBJECT;
+        {
+            std::lock_guard<std::mutex> lock(eventLock);
+            auto it = pinned.find(id);
+            if (it != pinned.end()) { h = it->second; pinned.erase(it); }
+        }
+        if (h != NULLOBJECT) c->ReleaseGlobalReference(h);
+    }
+    return result(c, reply);
+}
+
+// JsSuper(object, class (or its "realm<tab>id"), kind, name, args): the base's member (G get, S set,
+// C call), for self~name:super
+RexxRoutine5(RexxObjectPtr, JsSuper, RexxObjectPtr, self, RexxObjectPtr, ext, CSTRING, kind, CSTRING, name,
+             RexxArrayObject, list)
+{
+    RexxThreadContext *c = context->threadContext;
+    std::string s = newRequest();
+    fromRexx(c, s, self);
+    if (isA(c, ext, jsObjectClass)) fromRexx(c, s, ext);
+    else putRec(s, 'O', c->ObjectToStringValue(ext));      // its "realm<tab>id"
+    putRec(s, 'S', kind);
+    putRec(s, 'S', name);
+    args(c, s, list, 1);
+    return request(c, OP_SUPER, s);
+}
+
+// JsDetach(object): JavaScript forgets its Rexx object, which is unpinned
+RexxRoutine1(int, JsDetach, RexxObjectPtr, self)
+{
+    RexxThreadContext *c = context->threadContext;
+    std::string s = newRequest();
+    fromRexx(c, s, self);
+    RexxObjectPtr r = request(c, OP_DETACH, s);
+    if (r == NULLOBJECT) return 0;
+    size_t id = 0;
+    if (!c->ObjectToStringSize(r, &id) || id == 0) return 0;
+    RexxObjectPtr h = NULLOBJECT;
+    {
+        std::lock_guard<std::mutex> lock(eventLock);
+        auto it = pinned.find(id);
+        if (it != pinned.end()) { h = it->second; pinned.erase(it); }
+    }
+    if (h != NULLOBJECT) c->ReleaseGlobalReference(h);
+    return 0;
+}
+
+// JsSession(object): (the browser) ooRexx.js's start() gets its session object
+RexxRoutine1(int, JsSession, RexxObjectPtr, session)
+{
+    RexxThreadContext *c = context->threadContext;
+    std::string s = newRequest();
+    fromRexx(c, s, session);
+    request(c, OP_SESSION, s);
+    return 0;
+}
+
+static RexxMethodEntry jsMethods[] =
+{
+    REXX_METHOD(js_unknown, js_unknown),
+    REXX_METHOD(js_get, js_get),
+    REXX_METHOD(js_put, js_put),
+    REXX_METHOD(js_call, js_call),
+    REXX_METHOD(js_new, js_new),
+    REXX_METHOD(js_await, js_await),
+    REXX_METHOD(js_typeof, js_typeof),
+    REXX_METHOD(js_classname, js_classname),
+    REXX_METHOD(js_keys, js_keys),
+    REXX_METHOD(js_makearray, js_makearray),
+    REXX_METHOD(js_supplier, js_supplier),
+    REXX_METHOD(js_bytes, js_bytes),
+    REXX_METHOD(js_instanceof, js_instanceof),
+    REXX_METHOD(js_has, js_has),
+    REXX_METHOD(js_uninit, js_uninit),
+    REXX_LAST_METHOD()
+};
+
+static RexxRoutineEntry jsRoutines[] =
+{
+    REXX_TYPED_ROUTINE(JsSetup, JsSetup),
+    REXX_TYPED_ROUTINE(JsDefaultRealm, JsDefaultRealm),
+    REXX_TYPED_ROUTINE(JsGlobal, JsGlobal),
+    REXX_TYPED_ROUTINE(JsRequire, JsRequire),
+    REXX_TYPED_ROUTINE(JsImport, JsImport),
+    REXX_TYPED_ROUTINE(JsValue, JsValue),
+    REXX_TYPED_ROUTINE(JsHandlerId, JsHandlerId),
+    REXX_TYPED_ROUTINE(JsSyncSetup, JsSyncSetup),
+    REXX_TYPED_ROUTINE(JsHandlerRelease, JsHandlerRelease),
+    REXX_TYPED_ROUTINE(JsLoopGeneration, JsLoopGeneration),
+    REXX_TYPED_ROUTINE(JsStopLoops, JsStopLoops),
+    REXX_TYPED_ROUTINE(JsNextEvent, JsNextEvent),
+    REXX_TYPED_ROUTINE(JsExtend, JsExtend),
+    REXX_TYPED_ROUTINE(JsConstruct, JsConstruct),
+    REXX_TYPED_ROUTINE(JsSuper, JsSuper),
+    REXX_TYPED_ROUTINE(JsDetach, JsDetach),
+    REXX_TYPED_ROUTINE(JsSession, JsSession),
+    REXX_LAST_ROUTINE()
+};
+
+static RexxPackageEntry jsPackage =
+{
+    STANDARD_PACKAGE_HEADER
+    REXX_INTERPRETER_5_0_0,
+    "js",
+    "1.0.0",
+    NULL,
+    NULL,
+    jsRoutines,
+    jsMethods
+};
+
+// found by wasm/extra-packages.cpp
+extern "C" RexxPackageEntry *orx_wasm_js_package(void)
+{
+    return &jsPackage;
+}
