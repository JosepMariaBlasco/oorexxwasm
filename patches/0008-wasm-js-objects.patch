+          // window.document and window.Document, location and Location, ...:
+          // the one in camelCase (the instance), not the interface
+          const lower = l.filter((n) => /^[a-z]/.test(n));
+          if (lower.length === 1) return lower[0];
+          throw new TypeError(upper + ' is ambiguous for a ' + className(t) + ': ' + l.join(', ') +
+            ' (use o["name"] or o~invoke("name", ...) with the exact name)');
+        }
+      }
+    }
+    return undefined;
+  }
+
+  // the Rexx message NAME(args) sent to t
+  function message(t, upper, args) {
+    const name = resolve(t, upper);
+    if (name === undefined) {
+      if (args.length) throw new TypeError(an(className(t)) + ' has no method ' + upper);
+      return undefined;
+    }
+    const v = t[name];
+    if (typeof v === 'function') {
+      // o~Map: the constructor itself (o~Map~new), not a call without new
+      if (args.length === 0 && /^[A-Z]/.test(name) && Object.prototype.hasOwnProperty.call(v, 'prototype')) return v;
+      return Reflect.apply(v, t, args);
+    }
+    if (args.length) throw new TypeError(name + ' is not a function');
+    return v;
+  }
+
+  function info(t, what, arg) {
+    switch (what) {
+      case 'typeof': return typeof t;
+      case 'class': return className(t);
+      case 'keys': return new RexxArray(Object.keys(t));
+      case 'has': return String(arg) in Object(t);
+      case 'instanceof': return typeof arg === 'function' && t instanceof arg;
+      case 'array': {
+        if (t === null || t === undefined || typeof t[Symbol.iterator] !== 'function') {
+          throw new TypeError(an(className(t)) + ' is not iterable (DO WITH INDEX k ITEM v OVER o' +
+            ' goes over its properties; o~propertyNames gives their names)');
+        }
+        return new RexxArray(Array.from(t));
+      }
+      case 'supplier': {
+        // [indexes, items]: a Map's keys and values; an array's 1..n and
+        // items (as o[i]); a list (NodeList, HTMLCollection...: iterable, with
+        // a length) 0..n-1 and items, as its o[i]; any other iterable 1..n and
+        // values; anything else, its own enumerable properties
+        let idx, items;
+        if (t instanceof Map) { idx = Array.from(t.keys()); items = Array.from(t.values()); }
+        else if (t !== null && t !== undefined && typeof t[Symbol.iterator] === 'function') {
+          const base = !fromOne(t) && typeof t.length === 'number' ? 0 : 1;
+          items = Array.from(t); idx = items.map((_, i) => i + base);
+        } else { idx = Object.keys(t); items = idx.map((k) => t[k]); }
+        return new RexxArray([new RexxArray(idx), new RexxArray(items)]);
+      }
+      case 'bytes': {
+        const b = t instanceof ArrayBuffer ? new Uint8Array(t) :
+          ArrayBuffer.isView(t) ? new Uint8Array(t.buffer, t.byteOffset, t.byteLength) : null;
+        if (!b) throw new TypeError(an(className(t)) + ' is not an ArrayBuffer or a typed array');
+        return new BytesForRexx(b);
+      }
+    }
+    throw new Error('unknown info ' + what);
+  }
+  class BytesForRexx { constructor(b) { this.b = b; } }
+
+  let nodeRequire = null;
+  function requireFromCwd(name) {
+    if (!nodeRequire) nodeRequire = require('node:module').createRequire;
+    return nodeRequire(require('node:path').join(process.cwd(), 'rexx-program.js'))(name);
+  }
+  const dynamicImport = new Function('s', 'return import(s)');
+  function importModule(name) {
+    if (isNode && /^\.{0,2}\//.test(name)) {
+      name = require('node:url').pathToFileURL(require('node:path').resolve(process.cwd(), name)).href;
+    }
+    return dynamicImport(name);
+  }
+
+  const PENDING = {};
+  let pending = null;
+  function run(op, r) {
+    while (r.more() && r.peek() === 'X') {
+      const [realm, id] = r.str().split('\t');
+      if (realm === REALM) release(Number(id));
+    }
+    switch (op) {
+      case 1: {                                   // GLOBAL realm
+        const realm = r.str();
+        if (realm === REALM) return globalThis;
+        throw new Error('there is no JavaScript realm "' + realm + '" here (this is realm "' + REALM + '")');
+      }
+      case 2: { const t = val(r), name = r.str(), args = val(r); return message(t, name, args); }
+      case 3: { const t = val(r), name = r.str(); return t[slot(t, name)]; }
+      case 4: { const t = val(r), name = r.str(), v = val(r); t[slot(t, name)] = v; return undefined; }
+      case 5: {
+        const t = val(r), upper = r.str(), v = val(r);
+        const name = resolve(t, upper);
+        if (name === undefined) {
+          throw new TypeError(an(className(t)) + ' has no property ' + upper +
+            ' (o["exactName"] = value creates one)');
+        }
+        t[name] = v;
+        return undefined;
+      }
+      case 6: {
+        const t = val(r), name = val(r), args = val(r);
+        if (name === null) {
+          if (typeof t !== 'function') throw new TypeError(an(className(t)) + ' is not a function');
+          return Reflect.apply(t, undefined, args);
+        }
+        const f = t[name];
+        if (typeof f !== 'function') throw new TypeError(name + ' is not a function');
+        return Reflect.apply(f, t, args);
+      }
+      case 7: { const t = val(r), args = val(r); return Reflect.construct(t, args); }
+      case 8: {
+        const t = val(r);
+        if (t === null || (typeof t !== 'object' && typeof t !== 'function') || typeof t.then !== 'function') return t;
+        pending = Promise.resolve(t);
+        return PENDING;
+      }
+      case 9: { const t = val(r), what = r.str(), arg = val(r); return info(t, what, arg); }
+      case 10: {
+        if (!isNode) throw new Error('require() is only available under Node');
+        return requireFromCwd(r.str());
+      }
+      case 11: return importModule(r.str());
+      case 12: return val(r);
+      case 13: {
+        const base = val(r), name = r.str(), rexxNames = val(r), exact = val(r);
+        return extend(base, name, rexxNames, exact);
+      }
+      case 14: { const ext = val(r), peer = Number(r.str()), args = val(r); return construct(ext, peer, args); }
+      case 15: {
+        const t = val(r), ext = val(r), kind = r.str(), k = r.str(), args = val(r);
+        return superMember(t, ext, kind, k, args);
+      }
+      case 16: return detach(val(r));
+      case 17: {                                  // SESSION: for ooRexx.js's start()
+        const v = val(r);
+        if (typeof hooks.session !== 'function') throw new Error('nobody is waiting for a session here');
+        hooks.session(v);
+        return undefined;
+      }
+    }
+    throw new Error('unknown op ' + op);
+  }
+
+  function okReply(v) {
+    const w = new Writer();
+    w.rec('R', '');
+    if (v instanceof BytesForRexx) w.rec('S', v.b.slice());
+    else put(w, v);
+    return w.bytes();
+  }
+  function errReply(e) {
+    const w = new Writer();
+    let msg;
+    try {
+      msg = e instanceof Error || (e && typeof e === 'object' && 'message' in e && 'name' in e)
+        ? e.name + ': ' + e.message : String(e);
+    } catch (x) { msg = 'an exception'; }
+    w.rec('E', msg);
+    try { put(w, e); } catch (x) { w.rec('N', ''); }
+    return w.bytes();
+  }
+
+  // one request (the records after any X): its reply, now or later (a Promise)
+  function handleRequest(op, bytes) {
+    let v;
+    try { v = run(op, new Reader(bytes)); } catch (e) { return errReply(e); }
+    if (v === PENDING) {
+      const p = pending; pending = null;
+      return p.then((x) => okReply(x), (e) => errReply(e));
+    }
+    try { return okReply(v); } catch (e) { return errReply(e); }
+  }
+  // a reply for an error of the bridge itself (no thrown value)
+  function errorText(msg) {
+    const w = new Writer();
+    w.rec('E', msg); w.rec('N', '');
+    return w.bytes();
+  }
+
+  return { realm: REALM, handle: handleRequest, release, close, errorText, Reader };
+  };
+})();
diff --git a/wasm/tests/js-extend.rex b/wasm/tests/js-extend.rex
new file mode 100644
index 0000000..46bf571
--- /dev/null
+++ b/wasm/tests/js-extend.rex
@@ -0,0 +1,154 @@
+/* js-extend.rex: tests of Rexx classes extending JavaScript classes          */
+/* (.js~extend, wasm/web/js.cls), in the realm where Rexx runs: the worker's   */
+/* in the browser, Node's under Node.  Prints one line per check; exits 1 if  */
+/* any fails.                                                                 */
+.local~ok = 0; .local~bad = 0
+js = .js
+mk = js~Function~new("src", "return new Function(src)()")   -- a value made by a JavaScript script
+
+-- a JavaScript class, with a method that calls another (age), a getter and
+-- setter (label), a constructor that calls an overridable method (kind)
+car = mk~invoke(.nil, "return class Car {" -
+  "  constructor(name, year) { this.name = name; this.year = year; this.made = this.kind(); }" -
+  "  age() { return 2026 - this.year; }" -
+  "  describe() { return this.name + ' is ' + this.age(); }" -
+  "  kind() { return 'car'; }" -
+  "  honk() { return 'beep'; }" -
+  "  get label() { return '[' + this.name + ']'; }" -
+  "  set label(v) { this.name = v; }" -
+  "  static wheels() { return 4; }" -
+  "}")
+js["Car"] = car
+
+ext = .js~extend(.MyCar, "Car")
+call check "extend answers a JavaScript class", ext~typeOf == "function"
+call check "its name is the Rexx class's", ext["name"] == "MYCAR"
+call check "it extends the base", ext["prototype"]~instanceOf(car)
+
+c = .MyCar~new("Seat", 2020)
+call check "an instance is a JSObject and a MyCar", c~isA(.JSObject) & c~isA(.MyCar)
+call check "the JavaScript object is a Car", c~instanceOf(car) & c~instanceOf(ext)
+call check "Rexx calls its own method", c~age == 7
+call check "JavaScript calls the override (describe -> this.age())", c~describe == "Seat is 7"
+call check "~name:super reaches JavaScript's age()", c~baseAge == 6
+call check "a method not overridden is JavaScript's", c~honk == "beep"
+call check "INIT ran and passed the arguments on", c~inits == 1 & c["year"] == 2020
+call check "the base constructor reached the override (self usable)", c["made"] == "rexx kind of Seat"
+call check "getter overridden", c["label"] == "<Seat>"
+call check "getter: ~label:super", c~superLabel == "[Seat]"
+c["label"] = "Ibiza"
+call check "setter overridden (Rexx saw it, then the base's)", c~lastSet == "Ibiza" & c["name"] == "IBIZA"
+
+-- identity: the instance comes back from JavaScript as the Rexx object itself
+a = js~newArray(c, "x")
+back = a[1]
+call check "identity: back from JavaScript as the same Rexx object", back == c & back~isA(.MyCar)
+call check "identity: the same object, Rexx's ==", back~identityHash == c~identityHash
+
+-- a condition in an override is a RexxError in JavaScript
+probe = mk~invoke(.nil, "return (o) => { try { o.age(); return 'no error' } catch (e) { return e.name + ': ' + e.message } }")
+c~failNext = 1
+r = probe~invoke(.nil, c)
+call check "a condition is a RexxError in JavaScript", r~left(10) == "RexxError:" & r~pos("Error 41") > 0
+call check "and it does not stay", c~describe == "IBIZA is 7"
+
+-- a JavaScript caller with its own array of them: sort with a method of the instances
+cars = js~newArray(.MyCar~new("B", 2001), .MyCar~new("A", 2010), .MyCar~new("C", 1990))
+sorter = mk~invoke(.nil, "return (l) => l.sort((x, y) => x.age() - y.age()).map((x) => x.name).join(',')")
+call check "JavaScript sorts by the Rexx override", sorter~invoke(.nil, cars) == "A,B,C"
+
+-- exact names the base does not have
+.js~extend(.Greeter, js~Object, "greetMe")
+g = .Greeter~new
+call check "an exact name added: JavaScript calls it", mk~invoke(.nil, "return (o) => o.greetMe('Ana')")~invoke(.nil, g) == "hola Ana"
+call check "without the exact name it is not there", mk~invoke(.nil, "return (o) => typeof o.other")~invoke(.nil, g) == "undefined"
+
+-- a Rexx subclass of the extending class
+s = .SportsCar~new("Cupra", 2024)
+call check "a Rexx subclass: JavaScript reaches the inherited override", s~describe == "Cupra is 3"
+call check "a Rexx subclass: ~kind:super is MyCar's", s~kind == "fast rexx kind of Cupra"
+
+-- made by JavaScript (no Rexx object): the base's behaviour
+plain = ext~new("Plain", 2000)
+call check "made by JavaScript: no Rexx object, the base's methods", plain~describe == "Plain is 26" & \plain~isA(.MyCar)
+
+-- detach
+d = .MyCar~new("Gone", 2016)
+call check "before detach", d~describe == "Gone is 11"
+.js~detach(d)
+call check "after detach JavaScript runs the base's", d~describe == "Gone is 10"
+call check "after detach it comes back as a plain JSObject", \js~newArray(d)[1]~isA(.MyCar)
+
+-- errors
+signal on syntax name e1
+.js~extend(.MyCar, "Car")
+call check "extending twice is an error", .false
+e1: call check "extending twice is an error", condition("O")~code == 98.900
+signal on syntax name e2
+.js~extend(.NotJs, "Car")
+call check "a class that is not a JSObject is refused", .false
+e2: call check "a class that is not a JSObject is refused", condition("O")~message~pos("JSObject") > 0
+signal on syntax name e3
+.js~extend(.Lone, "NoSuchClassAnywhere")
+call check "an unknown base is an error", .false
+e3: call check "an unknown base is an error", condition("O")~code == 98.900
+signal on syntax name e4
+.js~extend(.Lone, js~Math)
+call check "a base that is not a class is an error", .false
+e4: call check "a base that is not a class is an error", condition("O")~message~pos("not a class") > 0
+signal off syntax
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+check: procedure
+  use arg name, ok
+  if ok then do; .local~ok += 1; say "ok   " name; end
+  else do; .local~bad += 1; say "FAIL " name; end
+  return
+
+::requires "js.cls"
+
+::class MyCar subclass JSObject
+::attribute inits get
+::attribute lastSet get
+::attribute failNext set
+::method init
+  expose inits
+  use arg name, year
+  inits = 0
+  self~init:super(name, year)
+  inits += 1
+::method age
+  expose failNext
+  if failNext == 1 then do
+    failNext = 0
+    return 1 + "no number"
+  end
+  return self~age:super + 1
+::method baseAge
+  return self~age:super
+::method kind                       -- called by Car's constructor
+  return "rexx kind of" self["name"]
+::method label                      -- the getter
+  return "<"self["name"]">"
+::method superLabel
+  return self~label:super
+::method "LABEL="                   -- the setter
+  expose lastSet
+  use arg v
+  lastSet = v
+  self~"LABEL=":super(v~upper)
+
+::class SportsCar subclass MyCar
+::method kind
+  return "fast" self~kind:super
+
+::class Greeter subclass JSObject
+::method greetMe
+  use arg who
+  return "hola" who
+
+::class NotJs
+::class Lone subclass JSObject
diff --git a/wasm/tests/js-proxy.rex b/wasm/tests/js-proxy.rex
new file mode 100644
index 0000000..097ccd1
--- /dev/null
+++ b/wasm/tests/js-proxy.rex
@@ -0,0 +1,127 @@
+/* js-proxy.rex: tests of Rexx objects in JavaScript (RexxProxy,           */
+/* wasm/js-realm.js), in the realm where Rexx runs: the worker's in the     */
+/* browser, Node's under Node.  Prints one line per check; exits 1 if any   */
+/* fails.                                                                   */
+.local~ok = 0; .local~bad = 0
+js = .js
+.local~fn = js~Function~new("args", "body", "return new Function(...args.split(','), body)")
+
+acct = .Account~new(100)
+
+typeOf = F("o", "return typeof o + ' ' + (o instanceof RexxProxy)")
+call check "a Rexx object is a RexxProxy in JavaScript", typeOf~invoke(.nil, acct) == "object true"
+call check "strings still go as strings", F("o", "return typeof o")~invoke(.nil, "abc") == "string"
+call check "numbers too (5 is an integer object inside Rexx)", F("o", "return typeof o")~invoke(.nil, 5) == "string"
+call check "Arrays still go as copies", F("o", "return Array.isArray(o) + ' ' + o.length")~invoke(.nil, .array~of(1, 2)) == "true 2"
+
+call check "direct call: o.deposit(50) sends DEPOSIT", F("o", "return o.deposit(50)")~invoke(.nil, acct) == 150
+call check "sendMessage(name, args)", F("o", "return o.sendMessage('deposit', [10])")~invoke(.nil, acct) == 160
+call check "sendMessage0..5", F("o", "return o.sendMessage0('balance') + '/' + o.sendMessage2('sum', 3, 4)")~invoke(.nil, acct) == "160/7"
+call check "a method with no result gives undefined", F("o", "return o.nothing() === undefined")~invoke(.nil, acct) == 1
+call check "arguments: JavaScript objects arrive as JSObjects", -
+  F("o", "return o.kindOf({a: 1}, [1], null, undefined, 5)")~invoke(.nil, acct) == "JSObject JSObject nil undefined 5"
+
+-- identity, both ways
+same = F("a, b", "return a === b")
+call check "identity: the same Rexx object is the same proxy", same~invoke(.nil, acct, acct) == 1
+keep = F("o", "globalThis.kept = o; return o")
+call check "round trip: the proxy comes back as the Rexx object", keep~invoke(.nil, acct) == acct
+call check "round trip later, from a JavaScript variable", js~kept == acct
+call check "kept and given again: still the same proxy", F("o", "return o === globalThis.kept")~invoke(.nil, acct) == 1
+
+-- the string
+call check "String(o) is the Rexx object's string", F("o", "return String(o) + '|' + `${o}`")~invoke(.nil, acct) == "an Account of 160|an Account of 160"
+call check "o.string() asks Rexx now", F("o", "return o.string()")~invoke(.nil, acct) == "an Account of 160"
+el = js~Object~new
+el["text"] = acct
+call check "a JavaScript property set to it holds the proxy", el["text"] == acct
+
+-- classes: JavaScript makes Rexx objects
+mk = F("C", "const a = C.new(7); return a.deposit(1)")
+call check "a class: C.new(7) in JavaScript", mk~invoke(.nil, .Account) == 8
+call check "a new object comes back as itself", F("C", "return C.new(3)")~invoke(.nil, .Account)~class == .Account
+
+-- conditions
+err = F("o", "try { o.deposit('lots'); return 'no error' } catch (e) { return e.name + ' ' + (e instanceof RexxError) + ' ' + e.message }")
+r = err~invoke(.nil, acct)
+call check "a condition is a RexxError", r~word(1) == "RexxError" & r~word(2) == "true" & r~pos("Error 41") > 0
+r = F("o", "try { o.noSuchMethod(); return 'no error' } catch (e) { return e.message }")~invoke(.nil, acct)
+call check "an unknown message is Error 97", r~pos("Error 97") > 0
+
+-- sendMessageScope
+s = .Savings~new(10)
+call check "the subclass's method", F("o", "return o.describe()")~invoke(.nil, s) == "savings 10"
+call check "sendMessageScope: from the superclass", F("o, C", "return o.sendMessageScope('describe', C)")~invoke(.nil, s, .Account) == "account 10"
+r = F("o", "try { o.sendMessageScope('describe', 'x'); return 'no error' } catch (e) { return e.name }")~invoke(.nil, s)
+call check "sendMessageScope: the scope must be a class", r == "TypeError"
+
+-- not a property bag; not a thenable
+r = F("o", "try { o.x = 1; return 'no error' } catch (e) { return e.name }")~invoke(.nil, acct)
+call check "setting a property is a TypeError", r == "TypeError"
+call check "not a thenable: a Promise of it resolves to it", js~Promise~resolve(acct)~await == acct
+call check "a function obtained twice is the same", F("o", "return o.deposit === o.deposit")~invoke(.nil, acct) == 1
+
+-- JavaScript keeps a list of Rexx objects and works with them
+list = js~newArray(.Account~new(5), .Account~new(1), .Account~new(3))
+sorted = F("l", "return l.sort((a, b) => a.balance() - b.balance()).map((a) => a.balance()).join(',')")
+call check "JavaScript sorts Rexx objects by a Rexx method", sorted~invoke(.nil, list) == "1,3,5"
+
+-- JavaScript calls on its own (a timer): on a thread of its own
+later = .Account~new(0)
+F("o", "setTimeout(() => o.deposit(42), 5)")~invoke(.nil, later)
+do 100 while later~balance == 0; call SysSleep 0.02; end
+call check "a timer calls a Rexx object's method", later~balance == 42
+
+say
+say .ok "passed," .bad "failed"
+exit .bad > 0
+
+F: procedure                        -- F(params, body): a JavaScript function
+  return .fn~invoke(.nil, arg(1), arg(2))
+
+check: procedure
+  use arg name, ok
+  if ok then do; .local~ok += 1; say "ok   " name; end
+  else do; .local~bad += 1; say "FAIL " name; end
+  return
+
+::requires "js.cls"
+
+::class Account
+::attribute balance get
+::method init
+  expose balance
+  use strict arg balance
+::method deposit
+  expose balance
+  use strict arg amount
+  balance += amount
+  return balance
+::method sum
+  use arg a, b
+  return a + b
+::method nothing
+  return
+::method kindOf
+  out = ""
+  do i = 1 to arg()
+    a = arg(i)
+    select
+      when a~isA(.JSObject) then out ||= " JSObject"
+      when a == .nil then out ||= " nil"
+      when a == .js~undefined then out ||= " undefined"
+      otherwise out ||= " "a
+    end
+  end
+  return out~strip
+::method describe
+  expose balance
+  return "account" balance
+::method string
+  expose balance
+  return "an Account of" balance
+
+::class Savings subclass Account
+::method describe
+  expose balance
+  return "savings" self~balance
diff --git a/wasm/tests/qualify-node-cli.sh b/wasm/tests/qualify-node-cli.sh
