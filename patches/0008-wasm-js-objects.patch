+    if kind == "S" then
+      src = "signal on syntax; use arg v; call JsSuper self," extref", 'S', '"jsname"', .array~of(v);" -
+            "return; syntax: raise propagate"
+    else
+      src = "signal on syntax; return JsSuper(self," extref", '"kind"', '"jsname"', arg(1, 'A'));" -
+            "syntax: raise propagate"
+    m = .Method~new(rexxname, src, .context~package)
+    m~setPrivate
+    mixin~define(rexxname, m)
+  end
+  cls~inherit(mixin)
+  .JSObject~extensions[cls] = ext
+  return ext
+syntax: raise propagate
+::method detach unguarded           -- .js~detach(o): JavaScript forgets o (and o can be collected)
+  signal on syntax
+  use strict arg o
+  if \o~isA(.JSObject) then raise syntax 98.900 array(".js~detach: not a JSObject:" o)
+  call JsDetach o
+  return
+syntax: raise propagate
+::method handler unguarded          -- .js~handler(object, message [, options]): see Events above
+  signal on syntax
+  use strict arg target, message, options = ""
+  return .JSHandler~new(target, message, options)
+syntax: raise propagate
+::method nextEvent unguarded        -- the next event (a .JSEvent), or .nil after seconds
+  signal on syntax
+  use strict arg seconds = (-1)
+  if \datatype(seconds, "N") then raise syntax 98.900 array(".js~nextEvent: seconds must be a number, found" seconds)
+  if seconds < 0 then return JsNextEvent()
+  return JsNextEvent(seconds)
+syntax: raise propagate
+::method eventLoop unguarded        -- dispatch events until .js~stopEventLoop
+  generation = JsLoopGeneration()
+  do forever
+    event = JsNextEvent(, generation)
+    if event == .nil then return
+    event~dispatch
+  end
+::method stopEventLoop unguarded    -- end every .js~eventLoop running now
+  call JsStopLoops
+::method session unguarded          -- (ooRexx.js's start()) give the page a .JSSession and take events, for good
+  call JsSession .JSSession~new
+  do forever
+    self~eventLoop
+  end
+::method value unguarded            -- x as JavaScript sees it (a .JSObject unless a string)
+  signal on syntax
+  use strict arg x
+  return JsValue(x)
+syntax: raise propagate
