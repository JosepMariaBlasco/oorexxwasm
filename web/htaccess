# ooRexx for WebAssembly (Apache 2.4; needs mod_headers, optionally mod_deflate)
#
# The interpreter uses threads, i.e. SharedArrayBuffer, which browsers only
# allow in a cross-origin isolated page: the first two headers are mandatory.
# With them, whatever the page loads from other sites must be sent with
# Cross-Origin-Resource-Policy: cross-origin (or CORS) by those sites.
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

AddType application/wasm .wasm
AddType application/octet-stream .data
AddType text/javascript .js .mjs
AddType text/plain .rex .cls

# rexx.wasm and rexx.data compress to ~40%
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/plain application/javascript application/json application/wasm application/octet-stream
</IfModule>

# No "Options" or "DirectoryIndex" here: they need AllowOverride Options /
# Indexes, which many servers do not grant (500 Internal Server Error).
